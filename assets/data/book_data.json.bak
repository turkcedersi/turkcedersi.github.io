    ],
    "120": [
      {
        "id": "p120_etk1",
        "title": "1. Etkinlik: Kelime ve Anlam Tablosu",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.5,
            "width": 12.0,
            "text": "adalet"
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 25.8,
            "width": 46.0,
            "text": "Hak ve hukuka uygun davranma durumu."
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 29.8,
            "width": 43.0,
            "text": "Hak ve hukuka uygunluk, türe, doğruluk."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 36.2,
            "width": 12.0,
            "text": "akıl"
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 35.5,
            "width": 46.0,
            "text": "Doğruyu yanlıştan ayırma yetisi."
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 39.5,
            "width": 43.0,
            "text": "Düşünme, kavrama ve yargılama gücü, us."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 45.8,
            "width": 12.0,
            "text": "kut"
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 45.1,
            "width": 46.0,
            "text": "Uğur, talih, ilahi bağış ve lütuf."
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 49.1,
            "width": 43.0,
            "text": "Devlet kuşu, mutluluk, kutsal uğur."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 55.4,
            "width": 12.0,
            "text": "bey"
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 54.7,
            "width": 46.0,
            "text": "Devleti yöneten üst düzey lider."
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 58.7,
            "width": 43.0,
            "text": "Bir topluluğun başı, yönetici, hükümdar."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 65.0,
            "width": 12.0,
            "text": "töre"
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 64.3,
            "width": 46.0,
            "text": "Toplumsal düzeni sağlayan kurallar."
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 68.3,
            "width": 43.0,
            "text": "Bir toplulukta yerleşmiş ahlak ve kanunlar."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 74.6,
            "width": 12.0,
            "text": "saadet"
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 73.9,
            "width": 46.0,
            "text": "İç huzuru, daimi sevinç hâli."
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 77.9,
            "width": 43.0,
            "text": "Kutluluk, ongunluk, mutluluk."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 84.2,
            "width": 12.0,
            "text": "vezir"
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 83.5,
            "width": 46.0,
            "text": "Hükümdarın en yetkili baş danışmanı."
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 87.5,
            "width": 43.0,
            "text": "Devlet yönetiminde hükümdardan sonra gelen zat."
          }
        ]
      }
    ],
    "121": [
      {
        "id": "p121_etk3",
        "title": "3. Etkinlik: Serim Bölümü İncelemesi",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.0,
            "top": 55.26,
            "width": 77.0,
            "text": "Öyküleyici metinlerde serim bölümü; olayların geçtiği zaman ve mekânın tanıtıldığı,"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 57.88,
            "width": 77.0,
            "text": "başlıca kahramanların özellikleriyle takdim edildiği ve merakın uyandırıldığı kısımdır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 60.45,
            "width": 77.0,
            "text": "Okuyucu bu bölümde olayın geçtiği ortama ve kişilerin genel özelliklerine hazırlanır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 63.01,
            "width": 77.0,
            "text": "Düğüm bölümünde derinleşecek çatışmanın ilk tohumları serim bölümünde atılır."
          },
          {
            "type": "mark",
            "left": 11.7,
            "top": 76.8,
            "width": 2.2,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 61.5,
            "top": 76.6,
            "width": 26.0,
            "text": "Hükümdar ve saray çevresi"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 79.87,
            "width": 77.0,
            "text": "ayrıntılı biçimde tasvir edilmiş, adaletin ve aklın önemi simgesel unsurlarla anlatılmıştır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 82.5,
            "width": 77.0,
            "text": "Üç ayaklı taht ve şerbet gibi metaforlar merak uyandırarak düğüm bölümüne zemin hazırlamıştır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 85.06,
            "width": 77.0,
            "text": "Karakterlerin özellikleri ve devlet yönetimindeki rolleri açıkça sezdirilmiştir."
          }
        ]
      }
    ],
    "122": [
      {
        "id": "p122_etk4_5",
        "title": "4. & 5. Etkinlik: Adalet İlkeleri ve İkna Yöntemleri",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 70.38,
            "width": 78.0,
            "text": "Adaletli bir yönetim; toplumda barışı, güveni ve kardeşlik bağlarını güçlendirir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 75.19,
            "width": 78.0,
            "text": "Hukukun üstün olduğu bir devlette insanlar yarınlarına umutla ve huzurla bakar."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 80.06,
            "width": 78.0,
            "text": "Örneğin okulumuzda kuralların herkese eşit uygulanması adalet duygumuzu pekiştirir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 85.19,
            "width": 78.0,
            "text": "Tarih boyunca adaletle hükmeden devletler uzun ömürlü ve mamur olmuştur."
          },
          {
            "type": "mark",
            "left": 12.1,
            "top": 46.5,
            "width": 2.2,
            "text": "✓"
          },
          {
            "type": "mark",
            "left": 66.8,
            "top": 46.5,
            "width": 2.2,
            "text": "✓"
          },
          {
            "type": "mark",
            "left": 39.4,
            "top": 54.2,
            "width": 2.2,
            "text": "✓"
          }
        ]
      }
    ],
    "123": [
      {
        "id": "p123_etk6_7",
        "title": "6. & 7. Etkinlik: Haklar ve Cümle Tamamlama",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "blank",
            "left": 28.0,
            "top": 64.1,
            "width": 43.0,
            "text": "barış ve sevgi dolu bir dünyada yaşamak"
          },
          {
            "type": "blank",
            "left": 18.0,
            "top": 67.37,
            "width": 38.0,
            "text": "Her türlü ayrımcılıktan uzak, sağlıklı bir"
          },
          {
            "type": "blank",
            "left": 18.0,
            "top": 70.64,
            "width": 38.0,
            "text": "Düşüncelerimi özgürce dile getirmeye"
          },
          {
            "type": "blank",
            "left": 18.0,
            "top": 73.85,
            "width": 38.0,
            "text": "Eğitim almak ve yeteneklerimi geliştirmek"
          },
          {
            "type": "blank",
            "left": 43.0,
            "top": 76.28,
            "width": 38.0,
            "text": "şefkatli ve güvenli bir aile ortamı"
          },
          {
            "type": "blank",
            "left": 47.0,
            "top": 79.55,
            "width": 34.0,
            "text": "doğuştan eşit haklara sahiptir"
          }
        ]
      }
    ],
    "125": [
      {
        "id": "p125_etk9",
        "title": "9. Etkinlik: İkilemelerle Boşluk Doldurma ve Cümle",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "blank",
            "left": 63.5,
            "top": 39.42,
            "width": 12.0,
            "text": "uzun uzun"
          },
          {
            "type": "blank",
            "left": 75.0,
            "top": 42.82,
            "width": 14.0,
            "text": "zaman zaman"
          },
          {
            "type": "blank",
            "left": 51.0,
            "top": 47.95,
            "width": 12.0,
            "text": "karış karış"
          },
          {
            "type": "blank",
            "left": 67.0,
            "top": 52.75,
            "width": 14.0,
            "text": "eninde sonunda"
          },
          {
            "type": "blank",
            "left": 68.0,
            "top": 57.88,
            "width": 12.0,
            "text": "ileri geri"
          },
          {
            "type": "blank",
            "left": 19.5,
            "top": 63.8,
            "width": 12.0,
            "text": "yavaş yavaş"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 76.2,
            "width": 74.0,
            "text": "Dedemle köydeki eski günlerden uzun uzun bahsettik."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 81.6,
            "width": 74.0,
            "text": "Kayıp kedimizi bulmak için bütün mahalleyi karış karış aradık."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 87.0,
            "width": 74.0,
            "text": "Çalışmalarımızın meyvesini yavaş yavaş almaya başladık."
          }
        ]
      }
    ],
    "126": [
      {
        "id": "p126_etk10",
        "title": "10. Etkinlik: Sınırlama İfadeleri",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "blank",
            "left": 31.0,
            "top": 39.8,
            "width": 14.0,
            "text": "sadece"
          },
          {
            "type": "blank",
            "left": 23.0,
            "top": 44.5,
            "width": 14.0,
            "text": "yalnızca"
          },
          {
            "type": "blank",
            "left": 20.0,
            "top": 49.3,
            "width": 14.0,
            "text": "bundan sonra"
          },
          {
            "type": "blank",
            "left": 41.0,
            "top": 54.0,
            "width": 14.0,
            "text": "mak üzere"
          },
          {
            "type": "blank",
            "left": 37.0,
            "top": 58.8,
            "width": 14.0,
            "text": "a dek"
          },
          {
            "type": "blank",
            "left": 32.0,
            "top": 63.5,
            "width": 14.0,
            "text": "e kadar"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 73.08,
            "width": 74.0,
            "text": "Toplantıya yetişmek üzere erkenden yola çıktı fakat trafik yoğundu."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 78.59,
            "width": 74.0,
            "text": "Akşama dek kütüphanede çalıştı ancak aradığı kitabı bulamadı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 84.04,
            "width": 74.0,
            "text": "Sadece derslerinde değil, sporda da son derece başarılıydı."
          }
        ]
      }
    ],
    "127": [
      {
        "id": "p127_yazma",
        "title": "11. Etkinlik: Konuşan Kumbara Hikâyesi (1. Bölüm)",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 59.42,
            "width": 78.0,
            "text": "Başlık: Konuşan Kumbara ve Kaybolan Işık"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 61.99,
            "width": 78.0,
            "text": "Emre o akşam çalışma masasında otururken garip bir fısıltı işitti."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 64.62,
            "width": 78.0,
            "text": "Masanın köşesindeki sevimli seramik kumbara hafifçe kıpırdıyor, hüzünle bakıyordu."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 67.18,
            "width": 78.0,
            "text": "'Beni dinle Emre!' dedi kumbara, 'İçimdeki parlaklık sadece madeni paralardan ibaret değil.'"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 69.74,
            "width": 78.0,
            "text": "'Sen bugün annene yardım etmedin, derslerini erteledin ve verdiğin sözü unuttun.'"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 72.31,
            "width": 78.0,
            "text": "'Her ihmal ettiğin sorumluluk, bendeki o altın pırıltıyı biraz daha söndürdü.'"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 74.87,
            "width": 78.0,
            "text": "Emre kumbaranın içine baktığında gerçekten de ışığın mat bir griye dönüştüğünü gördü."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 77.44,
            "width": 78.0,
            "text": "Derin bir pişmanlık duyarak hemen ayağa kalktı; önce dağınık odasını toparladı."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 80.06,
            "width": 78.0,
            "text": "Ardından ertesi günün ödevlerini özenle bitirip annesine mutfakta yardım etti."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 82.63,
            "width": 78.0,
            "text": "Kardeşine gülümseyerek sarıldı ve ertelediği tüm görevleri tek tek tamamladı."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 85.19,
            "width": 78.0,
            "text": "Tekrar masasına döndüğünde gözlerine inanamadı; kumbara pırıl pırıl parlıyordu."
          }
        ]
      }
    ],
    "128": [
      {
        "id": "p128_hikaye_devam",
        "title": "11. Etkinlik: Konuşan Kumbara Hikâyesi (Sonuç)",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 7.95,
            "width": 78.0,
            "text": "Kumbara gülümsedi: 'Gördün mü? En büyük hazine, vaktinde yapılan görevlerdir.'"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 10.51,
            "width": 78.0,
            "text": "'İnsan sorumluluklarını yerine getirdikçe hem kendi içi aydınlanır hem de etrafına ışık saçar.'"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 13.08,
            "width": 78.0,
            "text": "Emre o gece sorumluluğun bir yük değil, ruhu zenginleştiren bir erdem olduğunu anladı."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 15.64,
            "width": 78.0,
            "text": "Artık kumbara sadece madeni para değil, sevgi ve gayret biriktiren bir dosttu."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 18.27,
            "width": 78.0,
            "text": "Ertesi sabah erkenden uyanıp güne neşeyle ve sorumluluk bilinciyle başladı."
          }
        ]
      }
    ],
    "131": [
      {
        "id": "p131_etk1",
        "title": "1. Etkinlik: Kelime Kartları ve Anlamları",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 45.0,
            "top": 21.67,
            "width": 42.0,
            "text": "Hızla ve cesaretle öne doğru hamle yapmak."
          },
          {
            "type": "lines",
            "left": 46.0,
            "top": 27.24,
            "width": 41.0,
            "text": "Öne doğru fırlamak, süratle atılmak."
          },
          {
            "type": "lines",
            "left": 51.0,
            "top": 32.82,
            "width": 36.0,
            "text": "Cesaret, atılganlık, hız, hamle."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 40.13,
            "width": 42.0,
            "text": "Canlılara karşı duyulan derin şefkat ve acıma."
          },
          {
            "type": "lines",
            "left": 46.0,
            "top": 45.71,
            "width": 41.0,
            "text": "Zor duruma üzülme, koruma ve şefkat gösterme."
          },
          {
            "type": "lines",
            "left": 51.0,
            "top": 51.28,
            "width": 36.0,
            "text": "Vicdan, sevgi, şefkat, koruma, adalet."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 58.65,
            "width": 42.0,
            "text": "Küçük boylu, sevimli ve dayanıklı bir binek atı."
          },
          {
            "type": "lines",
            "left": 46.0,
            "top": 64.23,
            "width": 41.0,
            "text": "Küçük cins binek atı, bodur at."
          },
          {
            "type": "lines",
            "left": 51.0,
            "top": 69.81,
            "width": 36.0,
            "text": "Binek hayvanı, yele, koşu, tay."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 77.12,
            "width": 42.0,
            "text": "Birdenbire çok sinirlenmek, sakinliğini yitirmek."
          },
          {
            "type": "lines",
            "left": 46.0,
            "top": 82.69,
            "width": 41.0,
            "text": "Hiddetlenmek, aşırı kızgınlık duymak."
          },
          {
            "type": "lines",
            "left": 51.0,
            "top": 88.27,
            "width": 36.0,
            "text": "Kızgınlık, hiddet, sabırsızlık, şiddet."
          }
        ]
      }
    ],
    "132": [
      {
        "id": "p132_etk3",
        "title": "3. Etkinlik: Hikâye Unsurları Haritası",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "box",
            "left": 12.0,
            "top": 48.0,
            "width": 28.0,
            "text": "Zaman: Güneşli bir yaz sabahı ve öğleden sonrası."
          },
          {
            "type": "box",
            "left": 55.0,
            "top": 48.0,
            "width": 33.0,
            "text": "Mekân: Birtwick Malikanesi, orman yolu ve çiftlik avlusu."
          },
          {
            "type": "box",
            "left": 12.0,
            "top": 76.0,
            "width": 28.0,
            "text": "Şahıs/Varlık: Siyah İnci, Bay Gordon, Sawyer, John Manly, Merrylegs."
          },
          {
            "type": "box",
            "left": 55.0,
            "top": 76.0,
            "width": 33.0,
            "text": "Olay: Bay Gordon'un Sawyer'ın midilliye kötü davranmasını önleyip vicdana davet etmesi."
          }
        ]
      }
    ],
    "133": [
      {
        "id": "p133_etk4",
        "title": "4. Etkinlik: Hitap Biçimi ve Sınıf Kararı",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 46.22,
            "width": 78.0,
            "text": "Bay Gordon, Sawyer'a sakin fakat oldukça kararlı ve uyarıcı bir üslupla hitap etmiştir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 48.78,
            "width": 78.0,
            "text": "Kanıt: 'O midillinin bir canı yok mu? Merhametsizce davranmak insanlığa yakışmaz.' sözleri"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 51.35,
            "width": 78.0,
            "text": "Sawyer'ın öfkesine yenildiğini ve hayvana haksızca eziyet ettiğini açıkça gösterir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 53.91,
            "width": 78.0,
            "text": "Bay Gordon ceza vermek yerine onu vicdan muhasebesi yapmaya davet etmiştir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 71.47,
            "width": 78.0,
            "text": "Sınıfça varılan sonuç: Sawyer sabırsızlığına yenik düşmüş ve gücünü kötüye kullanmıştır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 74.04,
            "width": 78.0,
            "text": "Gerekçemiz: Midillinin inatlaşması karşısında sakin kalmak yerine kırbaçla terbiye etmeye"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 76.6,
            "width": 78.0,
            "text": "çalışması, öfke kontrolü eksikliğini ve merhametsiz bir tutum sergilediğini ortaya koymaktadır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 79.17,
            "width": 78.0,
            "text": "Hayvanlara karşı şiddet hiçbir şart altında haklı bir terbiye yöntemi olamaz."
          }
        ]
      }
    ],
    "134": [
      {
        "id": "p134_etk5",
        "title": "5. Etkinlik: Güven, Hak ve Eşitlik Kavramları",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 19.0,
            "top": 51.86,
            "width": 69.0,
            "text": "Kişinin karşısındakine duyduğu sarsılmaz itimat ve emin olma duygusu."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 54.42,
            "width": 78.0,
            "text": "İnsanlar ve hayvanlar arasındaki bağın temelini şefkat ve karşılıklı güven oluşturur."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 56.99,
            "width": 78.0,
            "text": "Güven ortamı sağlandığında canlılar korku yerine sevgiyle karşılık verir."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 63.14,
            "width": 71.0,
            "text": "Hukukun ve ahlakın canlılara tanıdığı dokunulmaz yaşam ve korunma yetkisi."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 65.71,
            "width": 78.0,
            "text": "Her canlı doğuştan gelen yaşama ve iyi muamele görme hakkına sahiptir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 68.27,
            "width": 78.0,
            "text": "Bu hakları çiğnemek hem hukuki hem de ahlaki bir suçtur."
          },
          {
            "type": "lines",
            "left": 19.0,
            "top": 74.42,
            "width": 69.0,
            "text": "Her canlının eşit derecede saygı ve merhamet görme hakkı."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 76.99,
            "width": 78.0,
            "text": "Güçlü olanın zayıf olanı ezmediği, adaletin herkese eşit uygulandığı ilkedir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 79.55,
            "width": 78.0,
            "text": "Toplumda huzur ancak eşitlik ve hakkaniyet temelinde sağlanabilir."
          }
        ]
      }
    ],
    "136": [
      {
        "id": "p136_etk8",
        "title": "8. Etkinlik: Çevre Problemlerine Çözüm Önerileri",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 21.0,
            "top": 41.15,
            "width": 66.0,
            "text": "Okullarda sıfır atık ve geri dönüşüm bilincini zorunlu projelerle yaygınlaştırmak."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 43.65,
            "width": 74.0,
            "text": "Her sınıfa geri dönüşüm kutuları konulmalı ve kompost alanları oluşturulmalıdır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 46.22,
            "width": 74.0,
            "text": "Öğrencilere doğayı koruma alışkanlığı uygulamalı atölyelerle kazandırılmalıdır."
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 53.01,
            "width": 66.0,
            "text": "Şehir içi ulaşımda bisiklet yollarını artırıp karbon salınımını en aza indirmek."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 55.51,
            "width": 74.0,
            "text": "Toplu taşıma araçlarında temiz elektrikli enerjinin kullanımı teşvik edilmelidir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 58.08,
            "width": 74.0,
            "text": "Hava kirliliğini önlemek gelecek nesillere temiz bir nefes bırakmak demektir."
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 64.87,
            "width": 66.0,
            "text": "Su kaynaklarını korumak için yağmur suyu hasadı sistemlerini devreye sokmak."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 67.37,
            "width": 74.0,
            "text": "Tarımda damla sulama yöntemiyle su israfının önüne geçilmelidir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 69.87,
            "width": 74.0,
            "text": "Her damla suyun kıymetini bilmek ekolojik dengenin sürdürülebilirliğini sağlar."
          }
        ]
      }
    ],
    "137": [
      {
        "id": "p137_yazma",
        "title": "9. Etkinlik: Eşitlik ve Adalet Üzerine Yazı",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 40.51,
            "width": 78.0,
            "text": "Başlık: Adaletin Işığında Eşit Bir Dünya"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 43.65,
            "width": 78.0,
            "text": "Toplumsal hayatın en sağlam direği, hiç şüphesiz adalet ve eşitlik duygusudur."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 46.22,
            "width": 78.0,
            "text": "Eşitlik, herkese aynı ayakkabıyı vermek; adalet ise herkese ayağına uygun olanı vermektir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 48.78,
            "width": 78.0,
            "text": "Bir çocuk özel gereksinimliyse ona eşit imkân sunmak, ilave destek sağlamakla mümkündür."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 51.35,
            "width": 78.0,
            "text": "Canlılar dünyasında da adalet merhametle birleştiğinde gerçek anlamını bulur."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 53.91,
            "width": 78.0,
            "text": "Siyah İnci metninde gördüğümüz gibi dilsiz bir hayvana şefkat göstermek vicdani adalettir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 56.54,
            "width": 78.0,
            "text": "Gücümüzü başkalarını ezmek için değil, haklarını korumak için kullanmalıyız."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 59.1,
            "width": 78.0,
            "text": "Adaletsizliğin hüküm sürdüğü bir toplumda güven duygusu kökünden sarsılır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 61.67,
            "width": 78.0,
            "text": "Oysa adaletli ortamlarda bireyler birbirine saygı duyar ve barış filizlenir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 64.23,
            "width": 78.0,
            "text": "Huzurlu ve uygar bir gelecek, ancak adaletin rehberliğinde inşa edilebilir."
          }
        ]
      }
    ],

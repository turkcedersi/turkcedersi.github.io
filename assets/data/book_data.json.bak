        },
        "items": [
          {
            "type": "lines",
            "left": 55.0,
            "top": 59.48,
            "width": 29.0,
            "text": "Konuşan kişinin sözünü kesmeden dinlemeliyiz."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 62.05,
            "width": 29.0,
            "text": "Göz teması kurarak dinlemeye özen göstermeliyiz."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 69.42,
            "width": 29.0,
            "text": "Ön yargılardan uzak durmalı, empati kurmalıyız."
          },
          {
            "type": "lines",

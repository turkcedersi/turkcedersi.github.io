        },
        "items": [
          {
            "type": "lines",
            "left": 35.0,
            "top": 44.5,
            "width": 30.0,
            "height": 2.8,
            "text": "ÖFKEYİ YÖNETMEK"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 47.0,
            "width": 71.0,
            "height": 2.8,
            "text": "İnsan hayatında sevinç kadar öfke de son derece doğal bir duygudur."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 49.5,
            "width": 71.0,
            "height": 2.8,
            "text": "Kızgınlık anında içimizdeki ateş güç verir; 'öfke baldan tatlıdır' denir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 52.0,
            "width": 71.0,
            "height": 2.8,
            "text": "Fakat fevri kararlar insanı telafisi güç büyük pişmanlıklara sürükler."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 54.5,
            "width": 71.0,
            "height": 2.8,
            "text": "Nitekim 'Öfke ile kalkan zararla oturur.' sözü sabrın değerini gösterir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 57.0,
            "width": 71.0,
            "height": 2.8,
            "text": "Akıllı birey öfkelendiğinde derin bir nefes alıp aklını kullanmalıdır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 59.5,
            "width": 71.0,
            "height": 2.8,
            "text": "Böylece hem dostluklar korunur hem de haksız yere kimse incitilmemiş olur."
          }
        ]
      },
      {
        "id": "p135_9_d",

    "44": [
      {
        "id": "p44_etk9",
        "title": "9. Etkinlik: Bağlantı Unsurları",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "blank",
            "left": 42.0,
            "top": 34.87,
            "width": 14.0,
            "text": "rağmen"
          },
          {
            "type": "blank",
            "left": 33.5,
            "top": 40.45,
            "width": 15.0,
            "text": "gelgelelim"
          },
          {
            "type": "blank",
            "left": 34.5,
            "top": 47.76,
            "width": 14.0,
            "text": "karşın"
          },
          {
            "type": "blank",
            "left": 35.5,
            "top": 53.65,
            "width": 14.0,
            "text": "yalnız"
          },
          {
            "type": "blank",
            "left": 36.5,
            "top": 59.94,
            "width": 14.0,
            "text": "meğerse"
          },
          {
            "type": "blank",
            "left": 29.5,
            "top": 65.9,
            "width": 16.0,
            "text": "her ne kadar"
          },
          {
            "type": "blank",
            "left": 15.0,
            "top": 71.47,
            "width": 14.0,
            "text": "Dahası"
          }
        ]
      }
    ],
    "45": [
      {
        "id": "p45_etk10",
        "title": "10. Etkinlik: Bir Ebruzenin Günlüğü",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 19.42,
            "width": 74.0,
            "text": "Sabahın ilk ışıklarıyla atölyemi açtım. Önce kitreli suyumu süzdüm ve tekneme sevgiyle döktüm."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.31,
            "width": 74.0,
            "text": "Toprak boyalarımı öd ile kıvamlaştırdıktan sonra gül dalı fırçamı elime aldım. Suya ilk vuruşumda"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.19,
            "width": 74.0,
            "text": "renkler adeta uykudan uyandı, haleler şeklinde genişledi. Bir biz yardımıyla dalgalandırdığım teknede"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 28.08,
            "width": 74.0,
            "text": "mor bir lale belirdi. Kâğıdı teknenin üzerine sakince bıraktım; o an zaman durdu. Kâğıdı çektiğimde"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 30.96,
            "width": 74.0,
            "text": "çıkan mucize, günün bütün yorgunluğunu silip yerini sonsuz bir huzura bıraktı."
          }
        ]
      }
    ],
    "46": [
      {
        "id": "p46_hazirlik",
        "title": "Hazırlık Vakti: Süleymaniye",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 21.99,
            "width": 74.0,
            "text": "Mimar Sinan'ın 'kalfalık eserim' dediği Süleymaniye Camii; mimari dengesi, akustik mükemmelliği,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 24.87,
            "width": 74.0,
            "text": "aydınlatma sistemi ve hava sirkülasyonu sağlayan kandil isi odalarıyla bir mühendislik harikasıdır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 31.92,
            "width": 74.0,
            "text": "Yahya Kemal, 'Süleymaniye'de Bayram Sabahı' şiirinde bu mabedi Türk milletinin tarihiyle özdeşleştirmiştir."
          }
        ]
      }
    ],
    "47": [
      {
        "id": "p47_etk1",
        "title": "1. Etkinlik: Şiir Söz Varlığı",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 21.99,
            "width": 74.0,
            "text": "Kubbeler: Gökyüzünü kucaklayan geniş, heybetli kemerli tavan yapısı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.19,
            "width": 74.0,
            "text": "Şadırvan: Cami avlularında abdest almak için yapılan kubbeli, havuzlu su yapısı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 28.4,
            "width": 74.0,
            "text": "Tekbir: Allah'ın büyüklüğünü anmak için söylenen 'Allahu ekber' kutsal sözü."
          },
          {
            "type": "badge",
            "left": 18.0,
            "top": 68.0,
            "width": 14.0,
            "text": "Arınma / Su"
          },
          {
            "type": "badge",
            "left": 38.0,
            "top": 68.0,
            "width": 14.0,
            "text": "Huzur"
          },
          {
            "type": "badge",
            "left": 58.0,
            "top": 68.0,
            "width": 14.0,
            "text": "Avlu"
          },
          {
            "type": "badge",
            "left": 78.0,
            "top": 68.0,
            "width": 14.0,
            "text": "Serinlik"
          }
        ]
      }
    ],
    "48": [
      {
        "id": "p48_etk3",
        "title": "3. Etkinlik: Şiir Tahlili",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 23.27,
            "width": 74.0,
            "text": "Şair, caminin kubbesini gökkubbeye ve milletin ortak çatısına benzetmiştir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.47,
            "width": 74.0,
            "text": "Bayram sabahında camiye toplanan kalabalık; Malazgirt'ten Mohaç'a uzanan şanlı tarihimizin bir özetidir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 34.17,
            "width": 74.0,
            "text": "Mimar Sinan, taşı sadece yontmamış; ona inancın, tevazuun ve estetiğin ruhunu üflemiştir."
          }
        ]
      }
    ],
    "49": [
      {
        "id": "p49_etk4_5",
        "title": "4. & 5. Etkinlik: Şiirin Ana Duygusu & Sanatlar",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 20.06,
            "width": 74.0,
            "text": "Ana Duygu: Süleymaniye Camii'nin ihtişamı karşısında duyulan millî gurur, manevi huzur ve tarih bilinci."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 38.01,
            "width": 74.0,
            "text": "Kişileştirme (Teşhis): 'Mermerlerin fısıltısı', 'Kubbelerin göğe yükselen duası'."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 41.22,
            "width": 74.0,
            "text": "Benzetme (Teşbih): 'Cami, dağlar gibi sağlam ve sarsılmaz bir kale gibidir.'"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 44.42,
            "width": 74.0,
            "text": "Karşıtlık (Tezat): Maddenin faniliği ile mabedin ebediliği tezat oluşturur."
          }
        ]
      }
    ],
    "50": [
      {
        "id": "p50_etk6",
        "title": "6. Etkinlik: Millî ve Manevi Değerler",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "badge",
            "left": 78.0,
            "top": 28.0,

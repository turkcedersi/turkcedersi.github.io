    "51": [
      {
        "id": "p51_9_a",
        "title": "9. Etkinlik (a)",
        "button": {
          "left": 5.0,
          "top": 32.0
        },
        "items": [
          {
            "type": "lines",
            "left": 28.0,
            "top": 35.8,
            "width": 58.0,
            "height": 2.4,
            "text": "2, 4, 6 ve 7. Cümleler (İşaret Sıfatları)"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 38.8,
            "width": 72.0,
            "height": 2.4,
            "text": "İsimlerin önüne gelerek onları işaret yoluyla belirten sıfatlardır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 41.8,
            "width": 72.0,
            "height": 2.4,
            "text": "Örnekler: bu davranış, öteki elbisemi, şu vazo, o yemekler."
          },
          {
            "type": "lines",
            "left": 28.0,
            "top": 45.8,
            "width": 58.0,
            "height": 2.4,
            "text": "1, 3 ve 5. Cümleler (Belgisiz Sıfatlar)"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 48.8,
            "width": 72.0,
            "height": 2.4,
            "text": "İsimlerin sayısını ve miktarını kesin olmayacak şekilde belirten sıfatlardır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 51.8,
            "width": 72.0,
            "height": 2.4,
            "text": "Örnekler: bazı geleneksel sanatlar, birkaç arkadaş, her insanın."
          }
        ]
      },
      {
        "id": "p51_10_b",
        "title": "10. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 68.0
        },
        "items": [
          {
            "type": "lines",
            "left": 22.0,
            "top": 76.5,
            "width": 16.0,
            "height": 2.4,
            "text": "Killi topraktan yapılır."
          },
          {
            "type": "lines",
            "left": 22.0,
            "top": 79.2,
            "width": 16.0,
            "height": 2.4,
            "text": "Çarkta el emeğiyle üretilir."
          },
          {
            "type": "lines",
            "left": 22.0,
            "top": 81.9,
            "width": 16.0,
            "height": 2.4,
            "text": "Hava alan doğal yapıdadır."
          },
          {
            "type": "lines",
            "left": 42.5,
            "top": 76.5,
            "width": 16.0,
            "height": 2.4,
            "text": "Mutfakta kap olarak kullanılır."
          },
          {
            "type": "lines",
            "left": 42.5,
            "top": 79.2,
            "width": 16.0,
            "height": 2.4,
            "text": "Yiyecek ve su saklanır."
          },
          {
            "type": "lines",
            "left": 42.5,
            "top": 81.9,
            "width": 16.0,
            "height": 2.4,
            "text": "Farklı boy ve şekildedir."
          },
          {
            "type": "lines",
            "left": 63.0,
            "top": 76.5,
            "width": 16.0,
            "height": 2.4,
            "text": "Plastik, cam ve metaldir."
          },
          {
            "type": "lines",
            "left": 63.0,
            "top": 79.2,
            "width": 16.0,
            "height": 2.4,
            "text": "Fabrikalarda seri üretilir."
          },
          {
            "type": "lines",
            "left": 63.0,
            "top": 81.9,
            "width": 16.0,
            "height": 2.4,
            "text": "Kırılmaya daha dayanıklıdır."
          }
        ]
      }
    ],

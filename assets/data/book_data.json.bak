            "width": 14.0,
            "height": 2.4,
            "text": "Duygu: Huzur"
          },
          {
            "type": "lines",
            "left": 34.0,
            "top": 65.8,
            "width": 50.0,
            "height": 2.6,
            "text": "Taş yolda emin adımlarla yürüyen bir dede vardı."
          },
          {
            "type": "lines",
            "left": 34.0,
            "top": 68.3,
            "width": 50.0,
            "height": 2.6,
            "text": "Ak saçları ve gözlüğü ona bilge bir hava katıyordu."
          },
          {
            "type": "lines",
            "left": 34.0,
            "top": 70.8,
            "width": 50.0,
            "height": 2.6,
            "text": "Mavi gömleği ve pantolonuyla sade ve zarifti."
          },
          {
            "type": "lines",
            "left": 34.0,
            "top": 73.3,
            "width": 50.0,
            "height": 2.6,
            "text": "Gülümsemesi parktaki huzurunu yansıtıyordu."
          }
        ]
      }
    ],

    "149": [
      {
        "id": "p149_etk6_b",
        "title": "6. Etkinlik B: Karşılaştırma Tablosu",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 11.0,
            "top": 20.32,
            "width": 22.0,
            "text": "Arkadaşların birbirinin"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 22.82,
            "width": 22.0,
            "text": "kişisel sınırlarına ve"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 25.32,
            "width": 22.0,
            "text": "duygularına sanal ortamda"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 27.88,
            "width": 22.0,
            "text": "saygı duyması gerektiği"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 30.38,
            "width": 22.0,
            "text": "vurgulanmıştır."
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 20.32,
            "width": 22.0,
            "text": "Kuşaklar arasındaki"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 22.82,
            "width": 22.0,
            "text": "düşünce farklılıklarına"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 25.32,
            "width": 22.0,
            "text": "ve çocukların özgün"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 27.88,
            "width": 22.0,
            "text": "kişiliklerine saygı"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 30.38,
            "width": 22.0,
            "text": "gösterilir."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 36.73,
            "width": 22.0,
            "text": "Sosyal medyada yapılan"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 39.29,
            "width": 22.0,
            "text": "kırıcı yorumlar ve alaycı"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 41.79,
            "width": 22.0,
            "text": "şakalar sanal zorbalık"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 44.29,
            "width": 22.0,
            "text": "olarak değerlendirilmiş"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 46.86,
            "width": 22.0,
            "text": "ve kınanmıştır."
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 36.73,
            "width": 22.0,
            "text": "Aile içinde baskı,"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 39.29,
            "width": 22.0,
            "text": "kıyaslama ve zorbalığa"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 41.79,
            "width": 22.0,
            "text": "asla yer verilmez;"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 44.29,
            "width": 22.0,
            "text": "çocuklar başkalarıyla"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 46.86,
            "width": 22.0,
            "text": "karşılaştırılmaz."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 53.21,
            "width": 22.0,
            "text": "Hayri'nin uyguladığı yöntem"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 55.71,
            "width": 22.0,
            "text": "sayesinde arkadaşları"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 58.27,
            "width": 22.0,
            "text": "kendilerini başkasının"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 60.77,
            "width": 22.0,
            "text": "yerine koyarak empati"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 63.27,
            "width": 22.0,
            "text": "kurmayı öğrenmiştir."
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 53.21,
            "width": 22.0,
            "text": "Aile fertleri birbirini"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 55.71,
            "width": 22.0,
            "text": "anlamaya çalışır,"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 58.27,
            "width": 22.0,
            "text": "sürekli iletişim kurup"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 60.77,
            "width": 22.0,
            "text": "duygularını paylaşarak"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 63.27,
            "width": 22.0,
            "text": "empati geliştirir."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 69.68,
            "width": 22.0,
            "text": "Hatalar öfkeyle değil,"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 72.18,
            "width": 22.0,
            "text": "arkadaşça ve sevgiyle"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 74.68,
            "width": 22.0,
            "text": "dile getirilerek bağlar"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 77.24,
            "width": 22.0,
            "text": "sağlamlaştırılmış ve"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 79.74,
            "width": 22.0,
            "text": "güven tazelenmiştir."
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 69.68,
            "width": 22.0,
            "text": "Koşulsuz sevgi esastır;"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 72.18,
            "width": 22.0,
            "text": "bireyler hiçbir zaman"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 74.68,
            "width": 22.0,
            "text": "sevgilerini esirgemez,"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 77.24,
            "width": 22.0,
            "text": "kızgınlıkları bile"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 79.74,
            "width": 22.0,
            "text": "sevgiyle ifade ederler."
          }
        ]
      }
    ],

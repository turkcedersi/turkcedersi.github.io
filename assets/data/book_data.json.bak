    "154": [
      {
        "id": "p154_etk11_a",
        "title": "11. Etkinlik A: İletişim Aracı Notları",
        "button": {
          "left": 6.0,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 25.06,
            "width": 79.0,
            "text": "Seçtiğim araç: Akıllı telefon. Gençler teknolojiyi sezgisel ve hızlı öğrenirken"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 27.63,
            "width": 79.0,
            "text": "yaşlılar hata yapma ve yanlış tuşa basma korkusuyla daha temkinli yaklaşırlar."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 30.26,
            "width": 79.0,
            "text": "Benzerlik olarak her iki yaş grubu da temel iletişim ve haberleşme ihtiyacını"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 32.82,
            "width": 79.0,
            "text": "karşılamak amacıyla bu dijital cihazları severek kullanmayı istemektedir."
          }
        ]
      },
      {
        "id": "p154_etk11_b",
        "title": "11. Etkinlik B: Karşılaştırmalı Yazı",
        "button": {
          "left": 6.0,
          "top": 36.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 49.17,
            "width": 79.0,
            "text": "Teknolojiyi Öğretirken İletişimin Gücü"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 51.79,
            "width": 79.0,
            "text": "Günümüzde akıllı telefon kullanmak hayatın vazgeçilmez bir parçasıdır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 54.36,
            "width": 79.0,
            "text": "Bu aracı bir akranıma öğretirken teknik terimleri ve kısayolları doğrudan"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 56.92,
            "width": 79.0,
            "text": "aktarabilirim; çünkü gençler dijital arayüzlere hızla uyum sağlarlar."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 59.49,
            "width": 79.0,
            "text": "Oysa bir büyüğüme veya yaşlı bir bireye öğretirken çok daha sabırlı,"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 62.05,
            "width": 79.0,
            "text": "anlayışlı ve teşvik edici bir iletişim dili kurmam gerekir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 64.68,
            "width": 79.0,
            "text": "Örneğin dedeme mesaj yazmayı öğretirken harflerin büyüklüğünü ayarladım"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 67.24,
            "width": 79.0,
            "text": "ve aşama aşama pratik yaptırdım. Yapılan araştırmalara göre yaşlı bireylerin"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 69.81,
            "width": 79.0,
            "text": "%70'i teknoloji öğrenirken sabırlı bir rehbere ve sürekli tekrara ihtiyaç duyar."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 71.99,
            "width": 79.0,
            "text": "Sonuç olarak iletişimde yaşa ve ihtiyaca uygun empati geliştirmek, bilgi aktarımını"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 74.55,
            "width": 79.0,
            "text": "çok daha kolay, verimli ve sevgi dolu bir paylaşıma dönüştürmektedir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 77.12,
            "width": 79.0,
            "text": "Böylelikle nesiller arasındaki bağlar sevgi ve anlayışla güçlenir."
          }
        ]
      }
    ],
    "156": [
      {
        "id": "p156_etk1",
        "title": "1. Etkinlik: Kelime Anlamları ve Tahminler",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.5,
            "top": 28.59,
            "width": 11.5,
            "text": "nasihat"
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 26.79,
            "width": 44.5,
            "text": "Öğüt, doğru yolu gösterme"
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 31.09,
            "width": 40.5,
            "text": "Bir kimseye doğru yolu göstermek için söylenen söz, öğüt."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 38.21,
            "width": 11.5,
            "text": "ârif"
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 36.41,
            "width": 44.5,
            "text": "Anlayışlı, sezgili, bilgili kimse"
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 40.71,
            "width": 40.5,
            "text": "Çok anlayışlı, sezgisi güçlü, kavrayışlı kimse."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 47.76,
            "width": 11.5,
            "text": "kemlik"
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 45.96,
            "width": 44.5,
            "text": "Kötülük, fenalık, zarar"
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 50.26,
            "width": 40.5,
            "text": "Kötülük, fena ve incitici davranış."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 57.37,
            "width": 11.5,
            "text": "zâyi"
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 55.58,
            "width": 44.5,
            "text": "Kayıp, boşa gitme, heba olma"
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 59.87,
            "width": 40.5,
            "text": "Yitmiş, kaybolmuş, elden çıkmış, boşa gitmiş."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 66.99,
            "width": 11.5,
            "text": "fend"
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 65.19,
            "width": 44.5,
            "text": "Hile, tuzak, kurnazlık"
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 69.49,
            "width": 40.5,
            "text": "Tuzak, hile, düzen, kurnazca aldatmaca."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 76.54,
            "width": 11.5,
            "text": "hacil"
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 74.74,
            "width": 44.5,
            "text": "Utanmış, mahcup duruma düşmüş"
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 79.04,
            "width": 40.5,
            "text": "Utanmış, mahcup, sıkılmış, başı öne eğilmiş."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 86.15,
            "width": 11.5,
            "text": "başa kakıcı"
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 84.36,
            "width": 44.5,
            "text": "İyiliği yüzüne vurup inciten"
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 88.65,
            "width": 40.5,
            "text": "Yaptığı iyiliği kusur sayıp yüze vuran kimse."
          }
        ]
      }
    ],
    "157": [
      {
        "id": "p157_etk3_a",
        "title": "3. Etkinlik A: Şiirde Vurgulanan Değerler",
        "button": {

        },
        "items": [
          {
            "type": "lines",
            "left": 18.0,
            "top": 21.28,
            "width": 70.0,
            "text": "Çocuk haklarının doğuşu ve Birleşmiş Milletler Sözleşmesi'nin kabul süreci."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 23.85,
            "width": 77.0,
            "text": "Dünyadaki tüm çocukların eşit haklara sahip olduğu vurgulanmıştır."
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 29.94,
            "width": 68.0,
            "text": "Yaşama, korunma, eğitim ve sağlık haklarının ayrıntılı maddeleri sıralanmıştır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 32.56,
            "width": 77.0,
            "text": "Engelli çocukların sosyal hayata katılımı için gerekli özel düzenlemeler açıklanmıştır."
          },
          {
            "type": "lines",
            "left": 19.0,
            "top": 38.65,
            "width": 69.0,
            "text": "Çocuk haklarının evrensel uygulanmasının dünya barışına katkısı özetlenmiştir."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 41.22,
            "width": 77.0,
            "text": "Gelecek nesillere daha adil ve sevgi dolu bir dünya bırakma çağrısı yapılmıştır."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 65.5,
            "width": 27.0,
            "text": "20 Kasım 1989'dan günümüze"

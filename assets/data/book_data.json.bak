    "68": [
      {
        "id": "p68_q3",
        "title": "3. Soru: Kelime Anlamı (Zemin Hazırlar)",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "mark",
            "left": 12.2,
            "top": 19.7,

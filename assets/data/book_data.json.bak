  "book4_inpage_answers": {
    "14": [
      {
        "id": "p14_1",
        "title": "1. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 16.0,
            "top": 38.6,
            "width": 38.0,
            "height": 3.0,
            "text": "Hoca'nın fıkraları sadece güldürmez,"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 41.5,
            "width": 38.0,
            "height": 3.0,
            "text": "insanları derin derin düşündürür ve"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 44.4,
            "width": 38.0,
            "height": 3.0,
            "text": "onlara hayat dersleri ve öğütler verir."
          },
          {
            "type": "lines",
            "left": 49.0,
            "top": 65.4,
            "width": 38.0,
            "height": 3.0,
            "text": "Bizler de bu fıkraları okuyarak doğruyu,"
          },
          {
            "type": "lines",
            "left": 49.0,
            "top": 68.3,
            "width": 38.0,
            "height": 3.0,
            "text": "yanlışı ve insan ilişkilerindeki incelikleri"
          },
          {
            "type": "lines",
            "left": 49.0,
            "top": 71.2,
            "width": 38.0,
            "height": 3.0,
            "text": "tatlı bir tebessümle öğreniriz."
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 82.6,
            "width": 38.0,
            "height": 3.0,
            "text": "Böylece kültürümüzün en değerli mizah"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 85.5,
            "width": 38.0,
            "height": 3.0,
            "text": "ve bilgelik mirasını geleceğe taşırız."
          }
        ]
      }
    ],
    "15": [
      {
        "id": "p15_3",
        "title": "3. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 35.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 47.4,
            "width": 34.0,
            "height": 2.8,
            "text": "Fıkrayı ilk dinlediklerinde tüm cemaat"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.1,
            "width": 34.0,
            "height": 2.8,
            "text": "büyük bir kahkaha atarak çok güldü."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 52.8,
            "width": 34.0,
            "height": 2.8,
            "text": "Herkes fıkradaki nükteye ve Hoca'nın"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 55.5,
            "width": 34.0,
            "height": 2.8,
            "text": "hazırcevaplığına hayran kalarak neşelendi."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 58.2,
            "width": 34.0,
            "height": 2.8,
            "text": "Ancak bir süre sonra derin bir sessizlik oldu"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 60.8,
            "width": 34.0,
            "height": 2.8,
            "text": "ve herkes verilen dersi düşünmeye başladı."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 47.4,
            "width": 34.0,
            "height": 2.8,
            "text": "İnsanlar gülmeyi bırakıp fıkranın asıl"
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 50.1,
            "width": 34.0,
            "height": 2.8,
            "text": "mesajı üzerine etraflıca kafa yordular."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 52.8,
            "width": 34.0,
            "height": 2.8,
            "text": "Kendi davranışlarını, yaptıkları hataları ve"
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 55.5,
            "width": 34.0,
            "height": 2.8,
            "text": "eksikliklerini samimiyetle gözden geçirdiler."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 58.2,
            "width": 34.0,
            "height": 2.8,
            "text": "Hoca'nın tatlı dille uyardığı gerçeği fark edip"
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 60.8,
            "width": 34.0,
            "height": 2.8,
            "text": "kendi hayatları için önemli dersler çıkardılar."
          }
        ]
      },
      {
        "id": "p15_4",
        "title": "4. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 65.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.0,
            "top": 74.8,
            "width": 73.0,
            "height": 3.0,
            "text": "Nasreddin Hoca'nın yüzyıllar öncesinden günümüze kadar ulaşan bilgeliği ve fıkralarının evrenselliğidir."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 77.8,
            "width": 73.0,
            "height": 3.0,
            "text": "Onun her çağa ve her insana hitap eden derin hayat tecrübesi bu etkiyi sağlamıştır."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 89.2,
            "width": 73.0,
            "height": 3.0,
            "text": "Toplumsal kusurları kırmadan, incitmeden ve mizah yoluyla tatlı tatlı düşündürerek eleştirmesidir."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 92.2,
            "width": 73.0,
            "height": 3.0,
            "text": "İnsanlara tebessüm ettirirken aynı zamanda doğru yolu ve erdemli davranışı göstermesidir."
          }
        ]
      }
    ],
    "16": [
      {
        "id": "p16_5",
        "title": "5. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 28.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 33.1,
            "width": 72.0,
            "height": 2.5,
            "text": "Nasreddin Hoca'nın fıkraları sadece güldürmekle kalmaz, aynı zamanda insanlara derin hayat dersleri sunar."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 35.4,
            "width": 72.0,
            "height": 2.5,
            "text": "Cemaat onun anlattığı nükteli hikâyelere önce kahkahalarla güler, ardından fıkranın ardındaki hikmeti kavrar."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 37.7,
            "width": 72.0,
            "height": 2.5,
            "text": "Hoca, insanların yanlışlarını yüzlerine vurmak yerine tatlı bir tebessüm eşliğinde onların düşünmesini sağlar."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 40.0,
            "width": 72.0,
            "height": 2.5,
            "text": "Böylece toplumdaki eksiklikler ve kusurlar kimse kırılıp incinmeden büyük bir bilgelikle düzeltilir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 42.3,
            "width": 72.0,
            "height": 2.5,
            "text": "Geçmişten günümüze uzanan bu eşsiz miras, kültürümüzün en kıymetli hoşgörü ve mizah hazinesini oluşturur."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 44.6,
            "width": 72.0,
            "height": 2.5,
            "text": "Bizler de onun fıkralarından ilham alarak doğruyu, iyiliği ve insan sevgisini kuşaktan kuşağa taşırız."
          }
        ]
      },

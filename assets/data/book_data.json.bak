    "21": [
      {
        "id": "p21_11_b",
        "title": "11. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 24.0
        },
        "items": [
          {
            "type": "badge",
            "left": 30.0,
            "top": 32.2,
            "width": 40.0,
            "height": 2.5,
            "text": "Kültürümüzün İki Bilgesi"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 34.6,
            "width": 72.0,
            "height": 2.4,
            "text": "Nasreddin Hoca ve Dede Korkut, Türk milletinin ortak hafızasını ve ahlaki değerlerini inşa eden iki eşsiz zirvedir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 36.8,
            "width": 72.0,
            "height": 2.4,
            "text": "Nasreddin Hoca günlük hayatın içinden seçtiği olaylarla insanları güldürürken derin bir şekilde düşündürür."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 39.0,
            "width": 72.0,
            "height": 2.4,
            "text": "Toplumsal aksaklıkları tatlı bir tebessüm ve hoşgörüyle eleştirerek bize doğru yolu gösterir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 41.2,
            "width": 72.0,
            "height": 2.4,
            "text": "Dede Korkut ise milletimizin kahramanlık, fedakârlık, doğruluk ve birlik beraberlik ruhunu destanlaştırır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 43.4,
            "width": 72.0,
            "height": 2.4,
            "text": "Biri nükte ve mizahın inceliğiyle aklımızı aydınlatırken diğeri yiğitlik ve erdemle kalbimizi besler."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 45.6,
            "width": 72.0,
            "height": 2.4,
            "text": "Her iki bilge şahsiyet de Anadolu coğrafyasından tüm insanlığa seslenen evrensel birer sevgi elçisidir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 47.8,
            "width": 72.0,
            "height": 2.4,
            "text": "Bizler onların anlattığı fıkra ve hikâyelerden aldığımız derslerle millî kültürümüzü yaşatırız."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.0,
            "width": 72.0,
            "height": 2.4,
            "text": "Bu iki ulu çınarın mirasını geleceğe taşımak hepimiz için en kıymetli kültürel ödevdir."
          }
        ]
      }
    ],
    "23": [

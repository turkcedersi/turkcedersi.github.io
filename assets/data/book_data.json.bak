    "89": [
      {
        "id": "p89_etk3c",
        "title": "3. Etkinlik (c): Dörtlüğü Düzyazıya Çevirme",
        "button": {
          "left": 18.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 38.5,
            "top": 10.4,
            "width": 52.0,
            "height": 2.2,
            "text": "Ey gönül! Hayatın boyunca insanları sevmekten"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 13.3,
            "width": 52.0,
            "height": 2.2,
            "text": "asla vazgeçme. Her zaman yapıcı, iyiliksever ol;"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 16.3,
            "width": 52.0,
            "height": 2.2,
            "text": "asla yıkıcı olma. Seni seven insanları sakın kırma,"

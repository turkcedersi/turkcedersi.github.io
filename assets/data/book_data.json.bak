    "110": [
      {
        "id": "p110_etk10",
        "title": "10. Etkinlik B: Hikâyemin Haritası",
        "button": {
          "left": 6.5,
          "top": 11.5
        },
        "items": [
          {
            "type": "lines",
            "left": 38.0,
            "top": 17.24,
            "width": 49.0,
            "text": "Okul bahçesindeki Türk bayrağı (anlatıcı), okul müdürü,"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 19.81,
            "width": 49.0,
            "text": "öğretmenler, törendeki öğrenciler ve veliler."
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 27.5,
            "width": 49.0,
            "text": "Yer: Süleyman Paşa Ortaokulu bahçesi ve tören alanı."
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 30.06,
            "width": 49.0,
            "text": "Zaman: 23 Nisan sabahı, pırıl pırıl bir bahar günü."
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 37.76,
            "width": 46.5,
            "text": "Günün ilk ışıklarıyla rüzgârda dalgalanmaya başlamam."
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 40.32,
            "width": 46.5,
            "text": "Öğrencilerin al bayraklarla tören alanını doldurması."
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 44.17,
            "width": 46.5,
            "text": "İstiklâl Marşı eşliğinde göndere gururla çekilmem."
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 46.73,
            "width": 46.5,
            "text": "Kürsüde okunan bağımsızlık ve hürriyet şiirleri."
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 50.58,
            "width": 46.5,
            "text": "Halk oyunları gösterileri ve çocukların coşkusu."
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 53.14,
            "width": 46.5,
            "text": "Göklerden minik yüreklerin sevincine ortak olmam."
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 56.99,
            "width": 46.5,
            "text": "Törenin ardından çocukların neşeyle evlerine dağılması."
          },
          {
            "type": "lines",
            "left": 41.0,
            "top": 59.55,
            "width": 46.5,
            "text": "Geleceğin teminatı olan genç nesillere sonsuz güvenim."
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 64.68,
            "width": 49.0,
            "text": "23 Nisan, Türk milletinin millî egemenlik bayramıdır."
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 67.24,
            "width": 49.0,
            "text": "Atatürk'ün çocuklara emanet ettiği bu kutlu vatan,"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 69.81,
            "width": 49.0,
            "text": "genç nesillerin azmiyle sonsuza dek yaşayacaktır."
          }
        ]
      }
    ],
    "111": [
      {
        "id": "p111_yazma",
        "title": "Üretim Vakti: Millî Mücadele Öyküsü Yazma",
        "button": {
          "left": 6.5,
          "top": 24.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.0,
            "top": 50.9,
            "width": 78.0,
            "text": "Sırtlarındaki cephane sandıkları her adımda daha da ağırlaşıyor, nefesleri buz kesiyordu."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 53.46,
            "width": 78.0,
            "text": "Mehmet ve arkadaşları, cephedeki askerlerin mermisiz kalmaması için durmadan yürüyorlardı."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 56.03,
            "width": 78.0,
            "text": "Ay ışığı, sarp kayalıkların ve dik yamaçların arasından onlara adeta yol gösteriyordu."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 58.59,
            "width": 78.0,
            "text": "Gece yarısına doğru sertleşen rüzgâr, dağ başındaki ayazı iliklerine kadar hissettirdi."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 61.15,
            "width": 78.0,
            "text": "İçlerinden biri yorgunluktan tökezlese, diğeri hemen elinden tutup omuz veriyordu."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 63.72,
            "width": 78.0,
            "text": "'Biraz dinlensek mi?' sorusu hiçbirinin aklından geçmiyor, gayretleri hiç eksilmiyordu."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 66.28,
            "width": 78.0,
            "text": "Çünkü biliyorlardı ki her bir mermi, vatanın istiklali ve Mehmetçiğin canı demekti."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 68.85,
            "width": 78.0,
            "text": "Şafak sökerken sislerin arasından siperlerin karaltısı ve Türk bayrağı belirdi."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 71.41,
            "width": 78.0,
            "text": "Uzaktan bir nöbetçinin 'Kimdir o!' sesi yankılandı kayalıkların yamaçlarında."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 73.97,
            "width": 78.0,
            "text": "'Vatan emanetini getiren köylüleriz!' cevabıyla birlikte nöbetçinin gözleri parladı."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 76.54,
            "width": 78.0,
            "text": "Sandıklar birer birer Mehmetçiğin eline teslim edilirken yüzlerde tarifsiz bir gurur vardı."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 79.1,
            "width": 78.0,
            "text": "Komutan, gençlerin omzunu sıvazlayarak 'Vatan size minnettardır evlatlarım.' dedi."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 81.67,
            "width": 78.0,
            "text": "O an çekilen bütün zahmetler, dökülen terler ve yorgunluklar bir anda silinip gitti."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 84.23,
            "width": 78.0,
            "text": "Türk milletinin bağımsızlık azmi ve fedakârlığı, karanlık geceleri zafere taşıyordu."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 86.79,
            "width": 78.0,
            "text": "Cephe gerisindeki bu kutlu dayanışma, Kurtuluş Savaşı'nın en büyük zafer müjdesiydi."
          }
        ]
      }
    ],
    "115": [
      {
        "id": "p115_soru5",
        "title": "5. Soru: Anahtar Kelimeler ve Kavram Alanı Tablosu",
        "button": {
          "left": 6.5,
          "top": 55.0
        },
        "items": [
          {
            "type": "lines",
            "left": 33.0,
            "top": 63.91,
            "width": 46.0,
            "text": "Çanakkale Boğazı'nı savunan topçu birliği ve mevzileri."
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 68.85,
            "width": 46.0,
            "text": "En küçük topçu birliği; birkaç toptan oluşan askeri birlik."
          },
          {
            "type": "lines",
            "left": 80.5,
            "top": 63.91,
            "width": 8.5,
            "text": "Topçu, mevzi"
          },
          {
            "type": "lines",
            "left": 80.5,
            "top": 68.85,
            "width": 8.5,
            "text": "cephane, siper"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 73.78,
            "width": 46.0,
            "text": "Çanakkale'de destan yazan 57. Alay gibi kahraman birlik."
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 78.78,
            "width": 46.0,
            "text": "Genellikle üç taburdan oluşan büyük askerî birlik."
          },
          {
            "type": "lines",
            "left": 80.5,
            "top": 73.78,
            "width": 8.5,
            "text": "Tabur, tugay"
          },
          {
            "type": "lines",
            "left": 80.5,
            "top": 78.78,
            "width": 8.5,
            "text": "tümen, ordu"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 83.72,
            "width": 46.0,
            "text": "Vatan savunmasında canını ortaya koyan her bir er."
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 88.72,
            "width": 46.0,
            "text": "Er, tek asker; bir topluluğu oluşturan her bir kişi."
          },
          {
            "type": "lines",
            "left": 80.5,
            "top": 83.72,
            "width": 8.5,
            "text": "Mehmetçik"
          },
          {
            "type": "lines",
            "left": 80.5,
            "top": 88.72,
            "width": 8.5,
            "text": "er, asker"
          }
        ]
      }
    ],
    "116": [
      {
        "id": "p116_soru6",
        "title": "6. Soru: Dizelerdeki Söz Sanatları",
        "button": {
          "left": 6.5,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 72.0,
            "top": 15.96,
            "width": 18.0,
            "text": "Kişileştirme (Teşhis)"
          },
          {
            "type": "lines",
            "left": 72.0,
            "top": 25.58,
            "width": 18.0,
            "text": "Benzetme (Teşbih)"
          }
        ]
      },
      {
        "id": "p116_soru8",
        "title": "8. Soru: Kavram Gruplama ve Millî Mücadele Paragrafı",
        "button": {
          "left": 6.5,
          "top": 42.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 56.6,
            "width": 78.0,
            "text": "1. Grup (Manevi Değerler): Fedakârlık, cesaret, direniş, özgürlük, vatan, zafer."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 59.17,
            "width": 78.0,
            "text": "2. Grup (Toplum ve İrade): Kadın, kağnı, meclis, egemenlik, millet, görev."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 61.73,
            "width": 78.0,
            "text": "Millî Mücadele, milletimizin vatan sevgisiyle başlattığı kutlu bir direniştir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 64.29,
            "width": 78.0,
            "text": "İlk olarak cephe gerisinde kahraman kadınlarımız, kağnılarla cephane taşımışlardır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 66.86,
            "width": 78.0,
            "text": "Bununla birlikte açılan meclisimiz, millî egemenliğin sarsılmaz sesi olmuştur."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 69.42,
            "width": 78.0,
            "text": "Kısacası vatan yolunda üstlenilen her görev, birlik ve beraberlikle başarılmıştır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 71.99,
            "width": 78.0,
            "text": "Sonuç olarak bu fedakârlıklar sayesinde milletimiz hürriyetine kavuşmuş,"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 74.55,
            "width": 78.0,
            "text": "şanlı mücadelemiz tarihe altın harflerle geçen büyük bir zaferle taçlanmıştır."
          }
        ]
      }
    ],
    "117": [
      {
        "id": "p117_dinleme",
        "title": "Dinleme/İzleme Becerisi Öz Değerlendirme Formu",

        },
        "items": [
          {
            "type": "lines",
            "left": 21.0,
            "top": 69.94,
            "width": 24.0,
            "text": "Somut İsimler"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 69.94,
            "width": 24.0,
            "text": "Soyut İsimler"
          },
          {
            "type": "lines",
            "left": 22.5,
            "top": 78.97,
            "width": 24.5,
            "text": "bayrak"
          },
          {
            "type": "lines",

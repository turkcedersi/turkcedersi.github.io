      {
        "id": "p136_10_c",
        "title": "10. Etkinlik (c)",
        "button": {
          "left": 5.2,
          "top": 39.5
        },
        "items": [
          {
            "type": "lines",
            "left": 28.0,
            "top": 49.5,
            "width": 45.0,
            "height": 3.0,
            "text": "GÖNLÜMÜZÜN IŞIĞI: SEVGİ"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 52.5,
            "width": 71.0,
            "height": 3.8,
            "text": "Sevgi; bir canlıya, bir insana ya da güzele karşı duyulan derin bağlılık v."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 55.0,
            "width": 71.0,
            "height": 3.8,
            "text": "Ruhumuzu besleyen duygular arasında en güçlüsü sevgidir; çünkü nefret kalb."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 57.5,
            "width": 71.0,
            "height": 3.8,
            "text": "Sevgi, karanlık bir odayı aniden aydınlatan ve ısıtan sıcacık bir kandile."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 60.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Kandil nasıl etrafına ışık saçarsa sevgi dolu bir insan da çevresine neşe."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 62.6,
            "width": 71.0,
            "height": 3.8,
            "text": "Sevginin gücü büyük sözlerde değil, küçük ama samimi davranışlarda gizlidir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 65.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Bir sokak kedisinin başını okşamak, arkadaşımıza içtenlikle gülümsemek sev."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 67.6,
            "width": 71.0,
            "height": 3.8,
            "text": "Ayrıca hasta bir yakınımızı ziyaret edip hâlini sormak da sevginin somut g."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 70.2,
            "width": 71.0,
            "height": 3.8,
            "text": "Kısacası dünyayı daha yaşanılır kılan en değerli hazine, kalbimizde büyütt."
          }
        ]
      }
    ],
    "137": [
      {
        "id": "p137_11",
        "title": "11. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 30.0,
            "top": 42.7,
            "width": 40.0,
            "height": 3.0,
            "text": "KAYIP DEFTERİN GİZEMİ"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 45.2,
            "width": 71.0,
            "height": 3.8,
            "text": "Sabah sırama oturduğumda çantamın açık olduğunu görünce içimi derin bir en."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 47.6,
            "width": 71.0,
            "height": 3.8,
            "text": "Hemen fermuarı açıp baktım; günlerdir üzerinde çalıştığım şiir defterim ye."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.2,
            "width": 71.0,
            "height": 3.8,
            "text": "Önce büyük bir şaşkınlık yaşadım, sınıfın içinde donakalmıştım; defter ner."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 52.6,
            "width": 71.0,
            "height": 3.8,
            "text": "Şaşkınlığım yerini bir anda öfkeye bıraktı, 'Biri benden habersiz eşyamı n."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 55.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Sıra arkadaşım Kerem yüzümdeki telaşı görünce hemen yanıma geldi ve ne old."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 57.7,
            "width": 71.0,
            "height": 3.8,
            "text": "Durumu anlatınca sakin olmamı, defteri birlikte arayabileceğimizi söyleyer."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 60.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Sınıfın her köşesini, kitaplığı ve öğretmen masasını tek tek dikkatle kont."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 62.6,
            "width": 71.0,
            "height": 3.8,
            "text": "Tam umudumu kaybetmek üzereyken Türkçe öğretmenimiz elinde tanıdık mavi de."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 65.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Dün akşam panoya asmak üzere incelemek için defterimi masadan kendisinin a."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 67.6,
            "width": 71.0,
            "height": 3.8,
            "text": "Defterimin emin ellerde olduğunu öğrenince içimdeki öfke ve endişe bir and."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 70.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Öğretmenimizin yazdığım şiirleri çok beğendiğini söylemesi ise beni tarifs."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 72.6,
            "width": 71.0,
            "height": 3.8,
            "text": "O gün bir olay karşısında öfkeyle fevri davranmak yerine sabırlı olmanın d."
          }
        ]
      }
    ],
    "138": [
      {
        "id": "p138_11_devam",
        "title": "11. Etkinlik (Hikâye Devamı ve Değerlendirme)",
        "button": {
          "left": 5.2,

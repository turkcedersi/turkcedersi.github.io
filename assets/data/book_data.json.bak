    "99": [
      {
        "id": "p99_2",
        "title": "2. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 22.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 28.5,
            "width": 71.0,
            "height": 4.5,
            "text": "Sığırtmaç Mustafa sıtma hastalığına yakalanmış, sağlığı bozulmuş ve yoksulluk nedeniyle tedavi olamamıştır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 42.5,
            "width": 71.0,
            "height": 4.5,
            "text": "Atatürk çocuğu hemen yanına almış, İstanbul'a hastaneye sevk ettirerek en iyi doktorlarca tedavi edilmesini sağlamıştır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 56.5,
            "width": 71.0,
            "height": 4.5,
            "text": "Mustafa'nın okuma yazma bilmemesi ve eğitim imkânlarından mahrum kalmış olmasıdır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 70.5,
            "width": 71.0,
            "height": 4.5,
            "text": "Atatürk onu himayesine almış, Kuleli Askerî Lisesine yazdırmış ve başarılı bir Türk subayı olmasını sağlamıştır."
          }
        ]
      }
    ],
    "100": [
      {
        "id": "p100_3",
        "title": "3. Etkinlik (b & c - Kahramanların Karşılaştırılması)",
        "button": {
          "left": 5.2,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.0,
            "top": 20.8,
            "width": 33.0,
            "height": 2.2,
            "text": "Her iki kahraman da vatanını sever."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 23.2,
            "width": 33.0,
            "height": 2.2,
            "text": "Zorluklara karşı cesurdurlar."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 25.6,
            "width": 33.0,
            "height": 2.2,
            "text": "Büyüklerine saygılı ve sorumludur."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 28.0,
            "width": 33.0,
            "height": 2.2,
            "text": "Dürüsttür, hak etmeyeni istemez."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 30.4,
            "width": 33.0,
            "height": 2.2,
            "text": "Vatanı için fedakârlık yapar."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 20.8,
            "width": 33.0,
            "height": 2.2,
            "text": "Mustafa köyde çobandır."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 23.2,
            "width": 33.0,
            "height": 2.2,
            "text": "Diğer kahraman şehirlidir."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 25.6,
            "width": 33.0,
            "height": 2.2,
            "text": "Mustafa okumayı Atatürk'ten öğrendi."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 28.0,
            "width": 33.0,
            "height": 2.2,
            "text": "Biri sığır güder, biri okur."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 30.4,
            "width": 33.0,
            "height": 2.2,
            "text": "Mustafa subay olmuştur."
          }
        ]
      },
      {
        "id": "p100_4_a",
        "title": "4. Etkinlik (a - Metin Unsurları)",
        "button": {
          "left": 5.2,
          "top": 37.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.2,
            "top": 44.0,
            "width": 15.5,
            "height": 2.2,
            "text": "Mustafa Kemal,"
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 46.7,
            "width": 15.5,
            "height": 2.2,
            "text": "Sığırtmaç Mustafa"
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 49.3,
            "width": 15.5,
            "height": 2.2,
            "text": "yaver, hekimler."
          },
          {
            "type": "lines",
            "left": 33.3,
            "top": 44.0,
            "width": 15.5,
            "height": 2.2,
            "text": "Yalova kaplıcası,"
          },
          {
            "type": "lines",
            "left": 33.3,
            "top": 46.7,
            "width": 15.5,
            "height": 2.2,
            "text": "Şişli Hastanesi,"
          },
          {
            "type": "lines",
            "left": 33.3,
            "top": 49.3,
            "width": 15.5,
            "height": 2.2,
            "text": "Kuleli Lisesi."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 44.0,
            "width": 15.5,
            "height": 2.2,
            "text": "Cumhuriyet çağı,"
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 46.7,
            "width": 15.5,
            "height": 2.2,
            "text": "1929 yazı,"
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 49.3,
            "width": 15.5,
            "height": 2.2,
            "text": "öğleden sonra."
          },
          {
            "type": "lines",
            "left": 70.2,
            "top": 44.0,
            "width": 16.0,
            "height": 2.2,
            "text": "Mustafa ile Paşa"
          },
          {
            "type": "lines",
            "left": 70.2,
            "top": 46.7,
            "width": 16.0,
            "height": 2.2,
            "text": "çocuğu okutarak"
          },
          {
            "type": "lines",
            "left": 70.2,
            "top": 49.3,
            "width": 16.0,
            "height": 2.2,
            "text": "subay yapması."
          }
        ]
      },
      {
        "id": "p100_4_b",
        "title": "4. Etkinlik (b - Olay Örgüsü)",
        "button": {
          "left": 5.2,
          "top": 62.5
        },
        "items": [
          {
            "type": "lines",
            "left": 53.0,
            "top": 62.3,
            "width": 21.5,
            "height": 2.2,
            "text": "Mustafa'nın sıtmasını"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 64.8,
            "width": 21.5,
            "height": 2.2,
            "text": "öğrenince tedavi için"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 67.2,
            "width": 21.5,
            "height": 2.2,
            "text": "İstanbul'a sevk eder."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 69.5,
            "width": 21.5,
            "height": 2.2,
            "text": "İstanbul'a göndertir."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 80.3,
            "width": 21.5,
            "height": 2.2,
            "text": "Sığırtmaç Mustafa ile"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 82.8,
            "width": 21.5,
            "height": 2.2,
            "text": "karşılaşır, yolu sorar."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 85.1,
            "width": 21.5,
            "height": 2.2,
            "text": "Çocuğun mertliği ve"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 87.5,
            "width": 21.5,
            "height": 2.2,
            "text": "zekâsı hoşuna gider."
          },
          {
            "type": "lines",
            "left": 40.0,
            "top": 80.3,
            "width": 21.5,
            "height": 2.2,
            "text": "Şişli Hastanesinde"
          },
          {
            "type": "lines",
            "left": 40.0,
            "top": 82.8,
            "width": 21.5,
            "height": 2.2,
            "text": "özel doktorlarca tedavi"
          },
          {
            "type": "lines",
            "left": 40.0,
            "top": 85.1,
            "width": 21.5,
            "height": 2.2,
            "text": "iyileşip sağlığına"
          },
          {
            "type": "lines",
            "left": 40.0,
            "top": 87.5,
            "width": 21.5,
            "height": 2.2,
            "text": "eski gücüne kavuşur."
          },
          {
            "type": "lines",
            "left": 68.5,
            "top": 80.3,
            "width": 21.5,
            "height": 2.2,
            "text": "Atatürk himayesinde"
          },
          {
            "type": "lines",
            "left": 68.5,
            "top": 82.8,
            "width": 21.5,
            "height": 2.2,
            "text": "Kuleli'yi bitirir ve"
          },
          {
            "type": "lines",
            "left": 68.5,
            "top": 85.1,
            "width": 21.5,
            "height": 2.2,
            "text": "subay olarak atanır."
          },
          {
            "type": "lines",
            "left": 68.5,
            "top": 87.5,
            "width": 21.5,
            "height": 2.2,
            "text": "bir Türk subayı olur."
          }
        ]
      }
    ],
    "101": [
      {
        "id": "p101_5_a",
        "title": "5. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 6.8
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 14.8,
            "width": 71.0,
            "height": 2.2,
            "text": "- Paşam, bu vatanı koruyacak bir Türk subayı olarak huzurunuzdayım."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 17.3,
            "width": 71.0,
            "height": 2.2,
            "text": "- Sana emek veren milletimize layık bir subay olduğunu görmek beni sevindirdi."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 19.8,
            "width": 71.0,
            "height": 2.2,
            "text": "- Sayenizde okudum; vatanıma ve sizlere olan borcumu ömrümce ödeyeceğim."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 22.2,
            "width": 71.0,
            "height": 2.2,
            "text": "- Aferin çocuk! Cumhuriyet sizin gibi dürüst gençlerle yükselecektir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 24.7,
            "width": 71.0,
            "height": 2.2,
            "text": "daima yaşayacak ve yükselecektir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 28.5,
            "width": 71.0,
            "height": 2.5,
            "text": "\"Cumhuriyet, bilhassa kimsesizlerin kimsesidir.\" - Mustafa Kemal Atatürk"
          }
        ]
      },
      {
        "id": "p101_6",
        "title": "6. Etkinlik (D/Y)",
        "button": {
          "left": 5.2,
          "top": 36.5
        },
        "items": [
          {
            "type": "mark",
            "left": 12.5,
            "top": 43.2,

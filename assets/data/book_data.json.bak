            "text": "5"
          }
        ]
      }
    ],
    "52": [
      {
        "id": "p52_problem1",
        "title": "Problem - Çözüm: Halk Müziğimiz",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.63,
            "width": 74.0,
            "text": "Problem: Türkülerimizin ve ozanlık geleneğimizin gençler arasında yeterince dinlenmemesi."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 29.68,
            "width": 74.0,
            "text": "1. Çözüm: Türkülerin özgün yapısı bozulmadan modern enstrümanlar ve düzenlemelerle gençlere sunulması."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 74.0,
            "text": "2. Çözüm: Okullarda bağlama ve halk müziği korolarının kurularak konserler verilmesi."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 43.14,
            "width": 74.0,
            "text": "Karar: Okul müzik kulüplerinde türkü atölyeleri kurmak, gençlerin bu köklü kültürü yaşayarak öğrenmesini sağlar."
          }
        ]
      }
    ],
    "53": [
      {
        "id": "p53_problem2",
        "title": "Problem - Çözüm: Tarihî Eserlerin Korunması",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.63,
            "width": 74.0,
            "text": "Problem: Mimar Sinan eserlerinin çevre kirliliği, nem ve çarpık kentleşme nedeniyle zarar görmesi."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 29.68,
            "width": 74.0,
            "text": "1. Çözüm: Eserlerin etrafındaki yapılaşmanın sınırlandırılması ve koruma bantlarının oluşturulması."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 74.0,
            "text": "2. Çözüm: Periyodik restorasyonların alanında uzman mimar ve bilim heyetlerince yürütülmesi."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 43.14,
            "width": 74.0,
            "text": "Karar: Bilimsel koruma kurallarına harfiyen uyulması bu şaheserlerin gelecek nesillere aktarılmasını güvenceye alır."
          }
        ]
      }
    ],
    "54": [
      {
        "id": "p54_problem3",
        "title": "Problem - Çözüm: Sandıktaki Miras",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.63,
            "width": 74.0,
            "text": "Problem: Aile sandıklarında bekleyen el işi dantel, oyalar ve dokumaların güveye ve neme kurban gitmesi."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 29.68,
            "width": 74.0,
            "text": "1. Çözüm: Etnografya müzeleri ve belediyelerce 'Sandıktan Müzeye' bağış kampanyalarının başlatılması."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 74.0,
            "text": "2. Çözüm: Ailelere geleneksel tekstil ürünlerini koruma ve havalandırma yöntemlerinin öğretilmesi."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 43.14,
            "width": 74.0,
            "text": "Karar: Eserlerin dijital envanterinin çıkarılması ve yerel müzelerde sergilenmesi en etkili koruma yöntemidir."
          }
        ]
      }
    ],
    "56": [
      {
        "id": "p56_etk9",
        "title": "9. Etkinlik: Minyatür Sanatı",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 19.42,
            "width": 74.0,
            "text": "Minyatür; ışık ve gölgenin, derinlik (perspektif) kuralının olmadığı, önemli figürlerin daha büyük"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.31,
            "width": 74.0,
            "text": "çizildiği geleneksel Türk resim sanatıdır. Matrakçı Nasuh ve Levni gibi büyük nakkaşlar; seferleri,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.19,
            "width": 74.0,
            "text": "şenlikleri ve saray hayatını ince fırçalarla tarihe görsel birer belge olarak not düşmüşlerdir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 28.08,
            "width": 74.0,
            "text": "Minyatürler, geçmişin şehir dokusunu ve giyim kuşamını tanımamız için en değerli pencerelerdir."
          }
        ]
      }
    ],
    "57": [
      {
        "id": "p57_uretim",
        "title": "Üretim Vakti: Zeybek ve Halk Oyunları",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.63,
            "width": 74.0,
            "text": "Zeybek, Ege Bölgesi'nin yiğitliğini, mertliğini ve haksızlığa karşı dik duruşunu simgeleyen asil oyunudur."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.51,
            "width": 74.0,
            "text": "Kolların kartal kanatları gibi yana açılması özgürlüğü; dizin yere sertçe vurulması toprağa ve vatana bağlılığı anlatır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 74.0,
            "text": "Halk oyunlarımız; birlik, beraberlik, yardımlaşma ve ortak coşkuyu pekiştiren en canlı kültürel bağımızdır."
          }
        ]
      }
    ],
    "59": [
      {
        "id": "p59_deg1",
        "title": "Tema Değerlendirme: Milas Halısı",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 23.91,
            "width": 74.0,
            "text": "Milas halıları; yün ipliklerin kök boyalarla renklendirilmesi ve kendine özgü geometrik desenleriyle tanınır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.79,
            "width": 74.0,
            "text": "Ada Milas ve Karacahisar gibi tipleri olup sıcak sarı, kiremit kırmızısı ve kahverengi tonları hâkimdir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 34.17,
            "width": 74.0,
            "text": "Benzerlik: Her iki el sanatı da Anadolu insanının sabrını, göz nurunu ve estetik zevkini yansıtır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 37.05,
            "width": 74.0,
            "text": "Farklılık: Kilim düz dokuma tekniğiyle üretilirken halıda ilmek (düğüm) tekniği kullanılmaktadır."
          }
        ]
      }
    ],
    "60": [
      {
        "id": "p60_deg2",
        "title": "Tema Değerlendirme: Renk Tasnifi",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 23.27,
            "width": 74.0,
            "text": "Kırmızı: Sevgi, cesaret, canlılık ve mutluluğu ifade eder."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.47,
            "width": 74.0,
            "text": "Sarı: Hasret, ayrılık hüznü ve sabır duygularını simgeler."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 29.68,
            "width": 74.0,
            "text": "Yeşil: Murada ermek, huzur, kutsallık ve bereketi temsil eder."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 74.0,
            "text": "Mavi: Sonsuzluk, umut, gökyüzü ve engin düşünceleri anlatır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 40.58,
            "width": 74.0,
            "text": "Metin Eleştirisi: Yazarın üslubu son derece akıcı, samimi ve millî değerleri yücelten etkileyici bir dildir."
          }
        ]
      }
    ],
    "61": [
      {
        "id": "p61_deg3",
        "title": "Tema Değerlendirme: Âşık Veysel Olay Sıralaması",
        "button": {
          "left": 88.0,
          "top": 15.0
        },

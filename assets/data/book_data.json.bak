          {
            "type": "lines",
            "left": 12.0,
            "top": 48.59,
            "width": 76.0,
            "text": "tutkusunu fuar alanında yazarlarla tanışarak ve yeni eserleri inceleyerek pekiştirmek"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 51.15,
            "width": 76.0,
            "text": "istiyoruz. Gezi sebebiyle derslerimizin aksamasından veya kalabalıkta düzenin"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 53.78,
            "width": 76.0,
            "text": "bozulmasından endişe duyabileceğinizin farkındayız. Ancak geziyi ders programını"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 56.35,
            "width": 76.0,
            "text": "etkilemeyecek uygun bir günde planlayacak ve yanınızdan asla ayrılmayacağız."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 58.91,
            "width": 76.0,
            "text": "Bu kültürel etkinliğin sınıfımızın ufkunu genişleteceğine ve bizlere unutulmaz"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 61.47,
            "width": 76.0,
            "text": "bir deneyim katacağına inanıyoruz. Talebimizi kabul edeceğinizi umut ederiz."
          }
        ]
      }
    ],
    "63": [
      {
        "id": "p63_plan",
        "title": "8. Etkinlik: Yazar Söyleşisi İkna Planı",
        "button": {
          "left": 6.5,
          "top": 30.5
        },
        "items": [
          {
            "type": "lines",
            "left": 37.0,
            "top": 34.94,
            "width": 50.0,
            "text": "Hafta sonu şehir kütüphanesinde düzenlenecek olan"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 37.5,
            "width": 74.0,
            "text": "en sevdiğimiz yazarın gençlik ve yazarlık serüvenini anlattığı söyleşiye"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 40.06,
            "width": 74.0,
            "text": "benimle birlikte katılmanı çok isterim."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 43.65,
            "width": 35.5,
            "text": "Yazarın karşılaştığı zorlukları nasıl aştığını,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 46.22,
            "width": 74.0,
            "text": "yazma tekniklerini ve ilham kaynaklarını bizzat kendisinden dinlemenin"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 48.78,
            "width": 74.0,
            "text": "bizim yazarlık ve hayal gücü gelişimimize paha biçilmez bir katkı sunacağıdır."
          },
          {
            "type": "lines",
            "left": 51.0,
            "top": 52.31,
            "width": 36.0,
            "text": "Ders çalışman gerektiğini biliyorum;"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 54.87,
            "width": 74.0,
            "text": "ancak söyleşi sadece iki saat sürecek, böylece derslerini aksatmadan önce veya"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 57.5,
            "width": 74.0,
            "text": "sonra birlikte ödevlerimizi kütüphanede verimli bir şekilde tamamlayabiliriz."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 61.03,
            "width": 34.5,
            "text": "Bu söyleşi sayesinde hem ufkumuz açılacak"

      {
        "id": "p96_etk4",
        "title": "4. Etkinlik: Video Karşılaştırması",
        "button": {
          "left": 6.5,
          "top": 46.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 69.1,
            "width": 35.0,
            "text": "• İki video da Millî Mücadele'deki"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 70.9,
            "width": 35.0,
            "text": "  bağımsızlık ruhunu odağa alır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 72.69,
            "width": 35.0,
            "text": "• Arka planda etkileyici anlatım"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 74.49,
            "width": 35.0,
            "text": "  ve duygu yüklü ezgiler vardır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 76.28,
            "width": 35.0,
            "text": "• Tarihî fotoğraflarla anlatım"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 78.08,
            "width": 35.0,
            "text": "  daha inandırıcı kılınmıştır."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 69.1,
            "width": 35.0,
            "text": "• 'Sakarya Zaferi' doğrudan cephe"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 70.9,
            "width": 35.0,
            "text": "  savaşını ve taktikleri işler."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 72.69,
            "width": 35.0,
            "text": "• 'Kahraman Çocuklar' ise cephe"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 74.49,
            "width": 35.0,
            "text": "  gerisindeki gençleri anlatır."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 76.28,
            "width": 35.0,
            "text": "• Biri belgesel dili taşırken"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 78.08,
            "width": 35.0,
            "text": "  diğeri bireysel hikâyeler sunar."
          }
        ]
      }
    ],

          {
            "type": "lines",
            "left": 52.0,
            "top": 44.04,
            "width": 36.0,
            "height": 2.2,
            "text": "Her gün sabırla taktik çalışmalıydım."
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 54.1,
            "width": 36.0,
            "height": 2.2,
            "text": "Yılmadan her gün pratik yaptım"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 55.96,
            "width": 36.0,
            "height": 2.2,
            "text": "ve turnuvada ikinci oldum."
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 61.03,
            "width": 36.0,
            "height": 2.2,
            "text": "Disiplinli ve sabırlı çalışmanın"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 63.53,
            "width": 36.0,
            "height": 2.2,
            "text": "mutlaka başarı getireceğini."
          }
        ]
      }
    ],
    "24": [
      {
        "id": "p24_etk11_a",

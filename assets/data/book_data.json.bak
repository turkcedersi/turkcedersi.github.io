            "top": 31.16,
            "width": 3.0,
            "height": 2.5,
            "text": "✓"
          },
          {
            "type": "mark",
            "left": 69.3,
            "top": 35.41,
            "width": 3.0,
            "height": 2.5,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 42.63,
            "width": 72.0,
            "text": "Farklı görsel ve işitsel metinleri birbiriyle daha ayrıntılı karşılaştırma."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 44.81,
            "width": 72.0,
            "text": "İçerikten hareketle yeni ve özgün sorular üretme becerisi."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 46.99,
            "width": 72.0,
            "text": "Dinleme sırasında anahtar kelimeleri daha hızlı ve düzenli not alma."
          }
        ]
      },
      {

      }
    ],
    "92": [
      {
        "id": "p92_etk7",
        "title": "7. Etkinlik: Anlamca Çelişen Sözcükler",
        "button": {
          "left": 6.5,
          "top": 9.0
        },
        "items": [
          {
            "type": "lines",
            "left": 12.0,
            "top": 34.04,
            "width": 76.0,
            "text": "Donanma gemileri üç beş saatte Çanakkale'ye ulaştı."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 43.78,
            "width": 76.0,
            "text": "Tüm şairlerin bu marş konusunda mutlaka bir fikri vardır."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 53.53,
            "width": 76.0,
            "text": "Top mermisinin taşınması gerektiğini gören Seyit Onbaşı yerinden fırlayıverdi."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 63.27,
            "width": 76.0,
            "text": "Bu taburda tam iki yıl çalıştıktan sonra tayini çıkmıştı."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 73.14,
            "width": 76.0,
            "text": "“Çalıkuşu” hiç şüphesiz Millî Mücadele’de kadının rolünü en güzel anlatan romandır."
          }
        ]
      }
    ],
    "93": [
      {
        "id": "p93_etk8",
        "title": "8. Etkinlik: Türk Sinemasında Millî Mücadele",
        "button": {
          "left": 6.5,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 9.5,
            "top": 42.56,
            "width": 80.0,
            "text": "Türk sineması, bağımsızlık mücadelesini ve Kurtuluş Savaşı destanını ilk yıllardan bugüne dek büyük bir"
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 45.13,
            "width": 80.0,
            "text": "özenle beyaz perdeye taşımıştır. Bu filmleri kronolojik olarak 'klasik dönem' ve 'yakın dönem' şeklinde"
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 47.76,
            "width": 80.0,
            "text": "iki temel ana gruba ayırarak incelemek mümkündür."
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 50.32,
            "width": 80.0,
            "text": "Klasik dönemde 'Ateşten Gömlek' ve 'Bir Millet Uyanıyor' gibi filmler, bizzat savaşı yaşamış kuşağın"
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 52.89,
            "width": 80.0,
            "text": "tanıklıklarını yansıtırken cephedeki Mehmetçiğin ve halkın olağanüstü fedakârlığını odağa almıştır."
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 55.45,
            "width": 80.0,
            "text": "Yakın dönemde üretilen 'Dersimiz Atatürk' ve 'Mustafa' gibi yapımlar ise modern sinema teknikleriyle"
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 58.01,
            "width": 80.0,
            "text": "ve animasyonla çocuklara ve gençlere Millî Mücadele ruhunu doğrudan aşılamayı amaçlamaktadır."
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 60.64,
            "width": 80.0,
            "text": "Ayrıca cephe gerisindeki kahraman kadın ve çocukların fedakârlıkları eserlerde çarpıcı biçimde işlenir."
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 63.21,
            "width": 80.0,
            "text": "Sonuç olarak Kurtuluş Savaşı filmleri, milletimizin vatan sevgisini ve bağımsızlık azmini canlı tutarak"
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 65.77,
            "width": 80.0,
            "text": "tarih bilincini ve vatan sevgisini yarınlara aktaran en güçlü kültürel hafıza köprülerindendir."
          }
        ]
      }
    ],
    "95": [
      {
        "id": "p95_etk1_a",
        "title": "1. Etkinlik: İçeriğe Yönelik Tahmin ve Gerekçe",
        "button": {
          "left": 6.5,
          "top": 9.0
        },
        "items": [
          {
            "type": "lines",
            "left": 21.0,
            "top": 28.53,
            "width": 58.0,
            "text": "Tahminim: Bu içerikte Kurtuluş Savaşı ve Millî Mücadele yıllarında"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 31.09,
            "width": 58.0,
            "text": "henüz çocuk yaşta olmalarına rağmen vatan savunmasına gönüllü katılan,"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 33.65,
            "width": 58.0,
            "text": "cephede ve cephe gerisinde tarihi görevler üstlenen kahraman Türk"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 36.22,
            "width": 58.0,
            "text": "çocuklarının cesaretleri ve eşsiz fedakârlıkları anlatılmaktadır."
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 38.85,
            "width": 58.0,
            "text": "Gerekçem: Başlığın 'Millî Mücadele Sergisi Kahraman Çocuklar' olması,"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 41.41,
            "width": 58.0,
            "text": "95. sayfadaki görselde siperde asker üniformasıyla yer alan çocukların"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 43.97,
            "width": 58.0,
            "text": "ve 'Hey Onbeşli' ağıdının henüz bıyığı terlememiş gençlerin cepheye"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 46.54,
            "width": 58.0,
            "text": "gidişini anlatan tarihî hafızamızla örtüşmesidir."
          }
        ]
      }
    ],
    "96": [
      {
        "id": "p96_etk3_a",

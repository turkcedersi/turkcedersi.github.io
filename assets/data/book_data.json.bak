            "width": 34.0,
            "height": 2.5,
            "text": "Ayakkabının tozlanması"
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 24.8,
            "width": 34.0,
            "height": 2.5,
            "text": "Kuşların izlenmesi"
          }
        ]
      },
      {
        "id": "p26_6_b",
        "title": "6. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 30.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 36.2,
            "width": 72.0,
            "height": 2.4,
            "text": "Karakterler bayram sabahına neşeyle uyanıp yeni bayramlıklarını giyerler."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 38.8,
            "width": 72.0,
            "height": 2.4,
            "text": "Büyüklerin ellerini öpüp harçlık alır, komşuları ziyarete çıkarlar."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 41.4,
            "width": 72.0,
            "height": 2.4,
            "text": "Mahalledeki yalnız ve yaşlı insanları ziyaret edip onları sevindirirler."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 44.0,
            "width": 72.0,
            "height": 2.4,
            "text": "Böylece sevgi, saygı, vefa ve paylaşma ruhunu hep birlikte yaşatırlar."
          }
        ]
      },
      {
        "id": "p26_7_b",
        "title": "7. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 76.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 83.3,
            "width": 72.0,
            "height": 2.4,
            "text": "Hayri'nin bayramların eski önemini yitirdiği görüşüne katılmıyorum."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 85.9,
            "width": 72.0,
            "height": 2.4,
            "text": "Çünkü günümüzde de bayramlar insanları sevgiyle buluşturmaktadır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 88.5,
            "width": 72.0,
            "height": 2.4,
            "text": "Teknolojiye rağmen akraba ve komşu ziyaretleri canlılığını korur."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 91.1,
            "width": 72.0,
            "height": 2.4,
            "text": "Çocuklar el öpüp şeker toplamakta, büyükler hayır duası etmektedir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 93.7,
            "width": 72.0,
            "height": 2.4,
            "text": "Geleneklerimiz aile ve toplum dayanışması sayesinde yaşamaya devam eder."
          }
        ]
      }
    ],
    "27": [
      {
        "id": "p27_8_c",
        "title": "8. Etkinlik (c)",
        "button": {
          "left": 5.0,
          "top": 48.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 55.0,
            "width": 72.0,
            "height": 2.4,
            "text": "Çocuk, pijama, yatak, pantolon, askı, ütü masası,"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 57.5,
            "width": 72.0,
            "height": 2.4,
            "text": "çiçek, saksı, örtü, komodin, resim çerçevesi, duvar."
          }
        ]
      },
      {
        "id": "p27_8_ç",
        "title": "8. Etkinlik (ç)",
        "button": {
          "left": 5.0,
          "top": 61.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 66.4,
            "width": 72.0,
            "height": 2.4,
            "text": "Sevimli çocuk, bayram sabahı çizgili pijamasıyla yatağının önünde duruyor."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 69.0,
            "width": 72.0,
            "height": 2.4,
            "text": "Özenle ütülenmiş mavi pantolonunu sağlam askısıyla elinde tutuyor."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 71.6,
            "width": 72.0,
            "height": 2.4,
            "text": "Sağ tarafta renkli puantiyeli örtüsüyle büyük bir ütü masası yer alıyor."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 74.2,
            "width": 72.0,
            "height": 2.4,
            "text": "Arkadaki komodinin üzerinde küçük bir saksı çiçeği ve çerçeve bulunuyor."
          }
        ]
      }
    ],

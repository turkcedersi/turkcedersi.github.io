            "top": 23.5,
            "width": 16.0,
            "text": "dalga dalga"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 50.58,
            "width": 78.0,
            "text": "Başlık: Yeşil Vatan Bizim Geleceğimizdir"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 53.14,
            "width": 78.0,
            "text": "Ormanlar ve temiz su kaynakları, tüm canlıların ortak yaşam alanıdır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 55.71,
            "width": 78.0,
            "text": "Sağlıklı bir çevrede yaşamak en temel insan hakkıdır ancak bu hakkı korumak"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 58.27,
            "width": 78.0,
            "text": "hepimizin yerine getirmesi gereken milli ve vicdani bir sorumluluktur."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 60.83,
            "width": 78.0,
            "text": "Yeşil Vatan Projesi sayesinde dikilen her fidan, yarınlara bırakılan taze bir nefes demektir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 63.46,
            "width": 78.0,
            "text": "Bu nedenle doğayı korumak sadece bugünü değil geleceğimizi de kurtarmaktır."
          }
        ]
      }
    ],

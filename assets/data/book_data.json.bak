          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 70.06,
            "width": 74.0,
            "text": "Âşık Veysel, gözlerini kaybetmiş olmasına rağmen gönül gözüyle dünyayı gören, hoşgörü ve sevgi abidesidir."
          }
        ]
      }
    ],
    "62": [
      {
        "id": "p62_deg4",
        "title": "Tema Değerlendirme: Orta Oyunu ve Bakış Açısı",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.63,
            "width": 74.0,
            "text": "Babanın Bakış Açısı: Evladının acısını hafifletmek ve ona hayata tutunacağı bir umut ışığı sunmak."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.51,
            "width": 74.0,
            "text": "Ona saz alarak içindeki duyguları ezgilere dökmesini sağlamış ve büyük bir ozanın doğmasına vesile olmuştur."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 38.01,
            "width": 74.0,
            "text": "Orta Oyunu Paragrafı: Orta oyunu, dekorun minimum düzeyde tutulduğu, oyuncuların seyirciyle"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 40.9,
            "width": 74.0,
            "text": "doğrudan göz teması kurup anlık nüktelerle oyunu yönlendirdiği gerçek bir halk tiyatrosudur."
          }
        ]
      }
    ],

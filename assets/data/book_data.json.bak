        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 85.0,
            "width": 72.0,
            "height": 2.2,
            "text": "Hava çok soğuktu ama yine de sabah erkenden yürüyüşe çıktık."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 87.4,
            "width": 72.0,
            "height": 2.2,
            "text": "Ödevlerimi vaktinde bitirdim bu yüzden akşam rahatça kitap okuyabildim."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 89.9,
            "width": 72.0,
            "height": 2.2,
            "text": "Kütüphaneden hem macera romanı hem de tarih kitabı ödünç aldım."
          }
        ]
      }
    ],
    "88": [
      {
        "id": "p88_6",
        "title": "6. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 48.0,
            "top": 15.0,
            "width": 38.0,

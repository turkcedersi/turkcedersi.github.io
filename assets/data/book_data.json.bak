    ],
    "71": [
      {
        "id": "p71_etk5c",
        "title": "5. Etkinlik c (Çözüm Önerileri)",
        "button": {
          "left": 5.0,
          "top": 28.0
        },
        "items": [
          {
            "type": "lines",
            "left": 18.0,
            "top": 32.0,
            "width": 70.0,
            "height": 2.2,
            "text": "Utku, ailesine onu dinlemediklerinde üzüldüğünü nazikçe söyleyebilir."
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 34.6,
            "width": 70.0,
            "height": 2.2,
            "text": "Anne ve babasından resmini incelemeleri için uygun bir zaman isteyebilir."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 37.1,
            "width": 73.0,
            "height": 2.2,
            "text": "Anne ve baba, çocukları heyecanla geldiğinde işlerine kısa bir ara vermelidir."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 39.8,
            "width": 73.0,
            "height": 2.2,
            "text": "Göz teması kurarak çocuğu dinlemeli, emeğine değer verdiklerini göstermelidir."
          },
          {
            "type": "lines",
            "left": 20.5,
            "top": 41.9,
            "width": 68.0,
            "height": 2.2,
            "text": "Aile bireyleri her akşam teknolojik cihazlardan uzak sohbet saati yapmalıdır."
          },
          {
            "type": "lines",
            "left": 20.5,
            "top": 44.5,
            "width": 68.0,
            "height": 2.2,
            "text": "Günün nasıl geçtiğini birbirlerine anlatıp aile içi iletişimi güçlendirmelidir."
          }
        ]
      },
      {

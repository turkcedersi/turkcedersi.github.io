    "125": [
      {
        "id": "p125_etk1",
        "title": "1. Etkinlik: Kelime ve Tahmin Tablosu",
        "button": {
          "left": 6.5,
          "top": 6.0
        },
        "items": [
          {
            "type": "lines",
            "left": 12.5,
            "top": 25.06,
            "width": 23.5,
            "text": "Gönlü isli"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 25.06,
            "width": 49.5,
            "text": "İçi hüzün ve kederle kaplı, yaslı kimse."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 30.06,
            "width": 23.5,
            "text": "Mıhlayış"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 30.06,
            "width": 49.5,
            "text": "Çekiçle çivi çakıp sağlamca tutturma işi."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 35.13,
            "width": 23.5,
            "text": "Çiriş"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 35.13,
            "width": 49.5,
            "text": "Ayakkabıcıların kullandığı bitkisel yapıştırıcı."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 40.26,
            "width": 23.5,
            "text": "Kösele"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 40.26,
            "width": 49.5,
            "text": "Ayakkabı tabanında kullanılan sert ve kalın deri."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 45.32,
            "width": 23.5,
            "text": "İskemle"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 45.32,
            "width": 49.5,
            "text": "Arkalıksız ya da alçak arkalıklı küçük oturak."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 50.45,
            "width": 23.5,
            "text": "Peltek"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 50.45,
            "width": 49.5,
            "text": "Bazı sesleri tam çıkaramayan konuşma kusuru."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 55.51,
            "width": 23.5,
            "text": "Perçem"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 55.51,
            "width": 49.5,
            "text": "Alına veya şakaklara doğru dökülen saç tutamı."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 60.58,
            "width": 23.5,
            "text": "Entari"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 60.58,
            "width": 49.5,
            "text": "Tek parçadan oluşan, boydan uzunca ve bol giysi."
          }
        ]
      }
    ],
    "126": [
      {
        "id": "p126_etk3",
        "title": "3. Etkinlik A: Hasan'ın Duyguları ve İletişime Etkisi",
        "button": {
          "left": 6.5,
          "top": 6.0
        },
        "items": [
          {
            "type": "lines",
            "left": 52.0,
            "top": 23.4,
            "width": 39.0,
            "text": "Vapur yolculuğunun eğlenceli geçmesi,"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 25.51,
            "width": 58.0,
            "text": "güvertedeki vincin ve insanların ilgisini çekmesi."
          },
          {
            "type": "lines",
            "left": 42.0,
            "top": 30.32,
            "width": 49.0,
            "text": "Merak, heyecan, çocuksu bir neşe ve"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 32.44,
            "width": 58.0,
            "text": "yeni yerleri görmenin getirdiği sevinç."
          },
          {
            "type": "lines",
            "left": 56.5,
            "top": 37.18,
            "width": 34.5,
            "text": "Şirin peltekliğiyle çevresine"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 39.36,
            "width": 58.0,
            "text": "sorular sormuş, yolcularla neşeyle kaynaşmıştır."
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 45.19,
            "width": 39.0,
            "text": "Kimsenin Türkçe konuşmaması ve"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 47.37,
            "width": 58.0,
            "text": "yabancı bir ortamda yapayalnız kalması."
          },
          {
            "type": "lines",
            "left": 42.0,
            "top": 52.12,
            "width": 49.0,
            "text": "Korku, çaresizlik, derin bir yalnızlık"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 54.23,
            "width": 58.0,
            "text": "ve dinmeyen bir memleket hasreti."
          },
          {
            "type": "lines",
            "left": 56.5,
            "top": 58.97,
            "width": 34.5,
            "text": "Hırçınlaşıp içine kapanmış,"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 61.15,
            "width": 58.0,
            "text": "haftalarca hiç kimseyle tek bir kelime konuşmamıştır."
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 66.99,
            "width": 39.0,
            "text": "Eskicinin Türkçe konuştuğunu duyması,"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 69.17,
            "width": 58.0,
            "text": "kendisi gibi bir memleketlisiyle karşılaşması."
          },
          {
            "type": "lines",
            "left": 42.0,
            "top": 73.91,
            "width": 49.0,
            "text": "Büyük bir sevinç, heyecan, umut ve"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 76.09,
            "width": 58.0,
            "text": "ana dilini duymanın coşkulu mutluluğu."
          },
          {
            "type": "lines",
            "left": 56.5,
            "top": 80.83,
            "width": 34.5,
            "text": "Aylardır süren suskunluğu bitmiş,"
          },
          {
            "type": "lines",
            "left": 33.0,
            "top": 82.95,
            "width": 58.0,
            "text": "durmadan konuşmuş, ayrılırken hıçkırarak ağlamıştır."
          }
        ]
      }
    ],
    "127": [
      {
        "id": "p127_etk4",
        "title": "4. Etkinlik: Dil Kavramına Bakış",
        "button": {
          "left": 6.5,
          "top": 6.0
        },
        "items": [
          {
            "type": "lines",
            "left": 33.5,
            "top": 25.58,
            "width": 56.5,
            "text": "Duygu, düşünce ve hayalleri aktarmayı sağlayan,"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 28.14,
            "width": 79.5,
            "text": "insanları birleştiren ve ortak bir kültür oluşturan en temel"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 30.71,
            "width": 79.5,
            "text": "iletişim aracıdır; dünyayı anlama kapımızdır."
          },
          {
            "type": "lines",
            "left": 36.0,
            "top": 38.27,
            "width": 54.0,
            "text": "Kendini güvende hissetmenin ve sevdiklerini yanında"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 40.83,
            "width": 79.5,
            "text": "bulmanın tek yoludur. Yabancı ellerde sustuğu yalnızlığa son veren,"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 43.4,
            "width": 79.5,
            "text": "ruhundaki kilitleri açıp onu hayata bağlayan sestir."
          }
        ]
      },
      {
        "id": "p127_etk5",
        "title": "5. Etkinlik A: Metnin Serim, Düğüm ve Çözüm Bölümleri",
        "button": {
          "left": 6.5,
          "top": 50.0
        },
        "items": [
          {
            "type": "lines",
            "left": 19.0,
            "top": 64.1,
            "width": 71.0,
            "text": "«Vapur rıhtımdan kalkıp, ta Marmara'ya doğru uzaklaşmaya başlayınca"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 66.47,
            "width": 79.5,
            "text": "yolcuyu geçirmeye gelenler ferahladılar...» Hasan'ın yolculuğu anlatılır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 69.04,
            "width": 79.5,
            "text": "Öksüz çocuğun gurbete gidişi ve yabancı dilde suskunlaşması serimdir."
          },
          {
            "type": "lines",
            "left": 22.0,
            "top": 74.94,
            "width": 68.0,
            "text": "«Bir gün halası sokaktan bağırarak geçen bir satıcıyı çağırdı.»"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 77.5,
            "width": 79.5,
            "text": "cümlesiyle başlar. Hasan'ın eskicinin Türk olduğunu fark etmesiyle"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 80.06,
            "width": 79.5,
            "text": "aylardır süren suskunluğun bozulması ve yaşanan coşku düğümdür."
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 83.53,
            "width": 70.0,
            "text": "«Fakat nihayet bütün ayakkabılar tamir edilmiş, iş bitmişti.»"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 85.9,
            "width": 79.5,
            "text": "cümlesiyle başlar. Eskicinin toparlanması, ayrılık hüznü ve iki memleketlinin"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 88.46,
            "width": 79.5,
            "text": "birbirine sarılıp gözyaşlarına boğulmasıyla metin sonuca ulaşır."
          }
        ]
      }
    ],
    "128": [
      {
        "id": "p128_etk6",
        "title": "6. Etkinlik: Eskici Metni Özeti",
        "button": {
          "left": 6.5,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 26.28,
            "width": 79.5,
            "text": "Küçük Hasan, hem öksüz hem de yetim kalınca akrabaları tarafından Filistin'deki"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 28.85,
            "width": 79.5,
            "text": "halasının yanına gönderilmek üzere İstanbul'dan bir vapura bindirilir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 31.47,
            "width": 79.5,
            "text": "İlk başlarda vapur yolculuğu Hasan için eğlenceli ve hareketli geçer."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 34.04,
            "width": 79.5,
            "text": "Ancak gemi Arap topraklarına ulaştığında hiç bilmediği bir dil konuşulduğunu"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 36.6,
            "width": 79.5,
            "text": "gören Hasan, kendini yapayalnız hisseder ve derin bir suskunluğa gömülür."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 39.17,
            "width": 79.5,
            "text": "Halasının evinde de aylarca hiç kimseyle tek bir kelime bile konuşmaz."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 41.73,
            "width": 79.5,
            "text": "Bir gün avluya ayakkabı tamiri için gelen yaşlı bir eskicinin Türkçe konuştuğunu"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 44.36,
            "width": 79.5,
            "text": "duyunca dünyalar Hasan'ın olur; aralarındaki buzlar anında erir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 46.92,
            "width": 79.5,
            "text": "Hasan, memleketine ve sevdiklerine dair her şeyi durmaksızın eskiciye anlatır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 49.49,
            "width": 79.5,
            "text": "Eskici işini bitirip gitmek üzere toparlandığında Hasan hıçkırıklarla ağlar."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 52.05,
            "width": 79.5,
            "text": "Bu içten ağlayışa dayanamayan gurbetçi eskici de gözyaşlarına boğulur."
          }
        ]
      }
    ],
    "129": [
      {
        "id": "p129_etk7",
        "title": "7. Etkinlik: Düş Fırçası Bakış Açısı Değişimi",
        "button": {
          "left": 6.5,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 25.13,
            "width": 79.5,
            "text": "Yolculuk öncesinde Ayşe, çevresindeki güzelliklerin tam farkında olmayan,"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 27.69,
            "width": 79.5,
            "text": "olaylara sıradan ve dar bir pencereden bakan sabırsız bir çocuktu."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 30.26,
            "width": 79.5,
            "text": "Dedesiyle çıktığı yolculuktan sonra hayata daha dikkatli, sevgi dolu ve"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 32.82,
            "width": 79.5,
            "text": "hayal gücünü kullanan geniş bir bakış açısıyla bakmayı öğrenmiştir."
          }
        ]
      },
      {
        "id": "p129_etk8",
        "title": "8. Etkinlik B: Hikâye Unsurları",
        "button": {
          "left": 6.5,
          "top": 45.0
        },
        "items": [
          {
            "type": "lines",
            "left": 9.5,
            "top": 57.5,
            "width": 30.0,
            "text": "Güneşli ve aydınlık bir gün;"
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 60.0,
            "width": 30.0,
            "text": "tatil süreci ve yolculuk boyunca."
          },
          {
            "type": "lines",
            "left": 60.5,
            "top": 57.5,
            "width": 30.0,
            "text": "Dedesinin köy evi, kasaba sokakları"
          },
          {
            "type": "lines",
            "left": 60.5,
            "top": 60.0,
            "width": 30.0,
            "text": "ve doğada yolculuk yapılan alanlar."
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 74.0,
            "width": 30.0,
            "text": "Ayşe, dedesi, çevrelerindeki insanlar"
          },
          {
            "type": "lines",
            "left": 9.5,
            "top": 76.5,
            "width": 30.0,
            "text": "ve hayal güçlerini yansıtan varlıklar."
          },
          {
            "type": "lines",
            "left": 60.5,
            "top": 74.0,
            "width": 30.0,
            "text": "Ayşe'nin dedesiyle yaptığı yolculukta"
          },
          {
            "type": "lines",
            "left": 60.5,
            "top": 76.5,
            "width": 30.0,
            "text": "dünyaya daha zengin ve sevgiyle bakmayı öğrenmesi."
          }
        ]
      }
    ],
    "131": [
      {
        "id": "p131_etk11",
        "title": "11. Etkinlik: Kuşaklar Arası İletişim Yazısı",
        "button": {
          "left": 6.5,
          "top": 10.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 55.58,
            "width": 79.5,
            "text": "Farklı kuşaklar arasındaki iletişim kopukluğunun temel sebebi, hızla değişen"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 58.14,
            "width": 79.5,
            "text": "teknoloji ve yaşam tarzlarının getirdiği anlayış farklılıklarıdır. Gençler"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 60.77,
            "width": 79.5,
            "text": "daha hızlı, dijital ve kısa ifadelerle kendilerini ifade ederken büyüklerimiz"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 63.33,
            "width": 79.5,
            "text": "yüz yüze sohbeti, nezaketi ve sabırlı dinlemeyi önemsemektedir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 65.9,
            "width": 79.5,
            "text": "Bu engelleri aşmak için ortak etkinlikler planlanmalı; gençler büyüklerine"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 68.46,
            "width": 79.5,
            "text": "dijital dünyayı anlatırken büyükler de hayat deneyimlerini paylaşmalıdır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 71.03,
            "width": 79.5,
            "text": "Karşılıklı önyargılardan arınmış, sevgi ve empati temelli bir diyalog kurulursa"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 73.65,
            "width": 79.5,
            "text": "her iki nesil de birbirini daha iyi anlar ve köprüler sağlamlaşır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 76.22,
            "width": 79.5,
            "text": "Böylece hem aile içi huzur pekişir hem de kültürel değerlerimiz korunur."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 78.78,
            "width": 79.5,
            "text": "Unutulmamalıdır ki iletişim, aynı dili değil, aynı duyguyu paylaşmaktır."
          }
        ]
      }
    ],
    "132": [
      {
        "id": "p132_etk11_devam",
        "title": "11. Etkinlik Devamı: Düşüncelerimi Geliştiriyorum",
        "button": {
          "left": 6.5,
          "top": 4.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 9.17,
            "width": 79.5,
            "text": "Kuşaklar arasındaki iletişimi güçlendirmenin en etkili yollarından biri de"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 11.73,
            "width": 79.5,
            "text": "birlikte geçirilen kaliteli zamanı artırmaktır. Ortak bir masa etrafında toplanmak,"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 14.29,
            "width": 79.5,
            "text": "eski anıları dinlemek ve geleceğe dair fikirleri paylaşmak aradaki mesafeleri eritir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 16.92,
            "width": 79.5,
            "text": "Gençlerin teknolojiye olan yatkınlığı ile büyüklerin hayat tecrübesi birleştiğinde"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 19.49,
            "width": 79.5,
            "text": "toplumsal dayanışma çok daha güçlü bir zemine oturacaktır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 22.05,
            "width": 79.5,
            "text": "Eleştirmek yerine anlamaya çalışmak, yargılamak yerine şefkatle dinlemek her iki"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 24.62,
            "width": 79.5,
            "text": "tarafın da kendini değerli ve güvende hissetmesini sağlar."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 27.18,
            "width": 79.5,
            "text": "Sonuç olarak kuşaklar arasındaki iletişim bir çatışma değil, bir zenginleşme vesilesidir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 29.81,
            "width": 79.5,
            "text": "Sevgiyle atılan her adım ve tatlı dille söylenen her söz, kalpler arasındaki"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 32.37,
            "width": 79.5,
            "text": "en sağlam köprüyü inşa edecektir."
          }
        ]
      }
    ],
    "135": [
      {
        "id": "p135_etk1_c",
        "title": "1. Etkinlik C: Eş, Zıt ve Eş Sesli Kelimeler",
        "button": {
          "left": 6.5,
          "top": 47.0
        },
        "items": [
          {
            "type": "lines",
            "left": 11.0,
            "top": 58.65,
            "width": 21.0,
            "text": "kelam"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 61.54,
            "width": 21.0,
            "text": "yeğlemek"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 64.42,
            "width": 21.0,
            "text": "yâd etmek"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 67.31,
            "width": 21.0,
            "text": "akıbet"
          },
          {
            "type": "lines",
            "left": 36.0,
            "top": 58.65,
            "width": 21.0,
            "text": "hayır"
          },
          {
            "type": "lines",
            "left": 36.0,
            "top": 61.54,
            "width": 21.0,
            "text": "hayrını görmek"
          },
          {
            "type": "lines",
            "left": 36.0,
            "top": 64.42,
            "width": 21.0,
            "text": "ağzını hayra açmak"
          },
          {
            "type": "lines",
            "left": 36.0,
            "top": 67.31,
            "width": 21.0,
            "text": "hayra yormak"
          },
          {
            "type": "lines",
            "left": 61.0,
            "top": 58.65,
            "width": 21.0,
            "text": "hayır"
          },
          {
            "type": "lines",
            "left": 61.0,
            "top": 61.54,
            "width": 21.0,
            "text": "açmak"
          },
          {
            "type": "lines",
            "left": 61.0,
            "top": 64.42,
            "width": 21.0,
            "text": "yormak"
          },
          {
            "type": "lines",
            "left": 61.0,
            "top": 67.31,
            "width": 21.0,
            "text": "söz"
          }
        ]
      },
      {
        "id": "p135_etk1_c_tablo",
        "title": "1. Etkinlik Ç: Eş ve Zıt Anlamlar Tablosu",
        "button": {
          "left": 6.5,
          "top": 78.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.0,
            "top": 83.53,
            "width": 33.0,
            "text": "kelam = söz"
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 85.45,
            "width": 33.0,
            "text": "yeğlemek = tercih etmek"
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 87.37,
            "width": 33.0,
            "text": "yâd etmek = anmak, hatırlamak"
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 89.29,
            "width": 33.0,
            "text": "akıbet = son, netice"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 83.53,
            "width": 33.0,
            "text": "hayır (iyilik) ↔ şer (kötülük)"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 85.45,
            "width": 33.0,
            "text": "hayrını görmek ↔ zararını görmek"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 87.37,
            "width": 33.0,
            "text": "ağzı hayra açmak ↔ ağzı şerre açmak"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 89.29,
            "width": 33.0,
            "text": "hayra yormak ↔ şerre yormak"
          }
        ]
      }
    ],
    "136": [
      {
        "id": "p136_etk3",
        "title": "3. Etkinlik A: Düşünceyi Geliştirme Yolları",
        "button": {
          "left": 6.5,
          "top": 24.0
        },
        "items": [
          {
            "type": "lines",
            "left": 22.5,
            "top": 53.53,
            "width": 67.5,
            "text": "«Çünkü hayırın anlamı iyiliktir, karşılık beklemeden yapılan"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 56.09,
            "width": 79.5,
            "text": "yardımdır.» cümlesinde hayır kelimesinin tanımı yapılmıştır."
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 60.0,
            "width": 63.5,
            "text": "«Mevlana insanları 'Hayır söyleyin ki hayır bulasınız.' diye uyarır.»"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 62.56,
            "width": 79.5,
            "text": "cümlesiyle düşünce tanınmış bir kişinin sözüyle desteklenmiştir."
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 66.47,
            "width": 63.5,
            "text": "«'Hayırlı olsun', 'hayırlı geceler', 'hayırlı işler', 'hayırlı evlat' hep"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 69.04,
            "width": 79.5,
            "text": "dilekler, olumlu deyimlerdi.» ifadesiyle örnekler sıralanmıştır."
          },
          {
            "type": "lines",
            "left": 24.5,
            "top": 72.95,
            "width": 65.5,
            "text": "«Beğenmiyoruz kendimizinkileri, başkalarının selamını kelamını"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 75.58,
            "width": 79.5,
            "text": "yeğliyoruz.» sözüyle eski ve yeni selamlaşmalar kıyaslanmıştır."
          },
          {
            "type": "lines",
            "left": 22.5,
            "top": 79.49,
            "width": 67.5,
            "text": "«Her kelime, hazinemin bir altınıdır sanki...» ve «erozyona uğrayan"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 82.05,
            "width": 79.5,
            "text": "topraklar gibi» sözleriyle kelimeler altına ve toprağa benzetilmiştir."
          },
          {
            "type": "lines",
            "left": 39.0,
            "top": 85.96,
            "width": 51.0,
            "text": "(Metinde yok) «Toplumumuzda insanların %70'i"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 88.53,
            "width": 79.5,
            "text": "selamlaşırken geleneksel nezaket ifadelerini tercih etmektedir.»"
          }
        ]
      }
    ],
    "137": [
      {
        "id": "p137_etk3_b",
        "title": "3. Etkinlik B: Düşünceyi Geliştirme Yollarının Anlatıma Katkısı",
        "button": {
          "left": 6.5,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 12.0,
            "top": 14.87,
            "width": 76.0,
            "text": "Düşünceyi geliştirme yolları kullanılmasaydı metin kuru, sıradan ve etkisiz"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 17.44,
            "width": 76.0,
            "text": "bir anlatıma sahip olurdu. Yazarın ileri sürdüğü fikirler soyut kalır,"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 20.0,
            "width": 76.0,
            "text": "okuyucunun zihninde somut bir karşılık bulamaz ve inandırıcılığı azalırdı."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 22.56,
            "width": 76.0,
            "text": "Mevlana'nın tanıklığı, benzetmeler ve zengin örnekler anlatımı canlandırmış,"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 25.19,
            "width": 76.0,
            "text": "okuyucuyu konunun önemine ikna etmede büyük bir güç sağlamıştır."
          }
        ]
      },
      {
        "id": "p137_etk4",
        "title": "4. Etkinlik: İfadeleri Sınıflandırma (Öznellik-Nesnellik)",
        "button": {
          "left": 6.5,
          "top": 38.0
        },
        "items": [
          {
            "type": "lines",
            "left": 40.5,
            "top": 51.67,
            "width": 50.0,
            "text": "«Öznellik - Nesnellik» ölçütünü seçiyorum."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 68.97,
            "width": 36.0,
            "text": "Öznel İfadeler"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 71.41,
            "width": 36.0,
            "text": "• «Her kelime hazinemin bir altınıdır.»"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 73.78,
            "width": 36.0,
            "text": "• «Sevdiğim kelimeler beni sevindirir.»"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 76.22,
            "width": 36.0,
            "text": "• «Güzel anlamlı ifadeli uyumlu.»"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 78.59,
            "width": 36.0,
            "text": "• «Ben mirasyedi değilim.»"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 81.03,
            "width": 36.0,
            "text": "• «İyi de demiş bizden evvelkiler.»"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 68.97,
            "width": 36.0,
            "text": "Nesnel İfadeler"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 71.41,
            "width": 36.0,
            "text": "• «Mevlana: Hayır söyleyin ki... der.»"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 73.78,
            "width": 36.0,
            "text": "• «Hayırın anlamı iyiliktir.»"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 76.22,
            "width": 36.0,
            "text": "• «Günaydın, iyi günler selam sözleridir.»"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 78.59,
            "width": 36.0,
            "text": "• «Hayırlı geceler olumlu bir ifadedir.»"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 81.03,
            "width": 36.0,
            "text": "• «Hayra alamet iyiye işarettir.»"
          }
        ]
      }
    ],
    "138": [
      {
        "id": "p138_etk5",
        "title": "5. Etkinlik: Sadaka Taşı Bilgileri",
        "button": {
          "left": 6.5,
          "top": 16.0
        },
        "items": [
          {
            "type": "lines",
            "left": 55.0,
            "top": 26.22,
            "width": 33.5,
            "text": "Silindir veya dikdörtgen taş blok,"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 29.62,
            "width": 33.5,
            "text": "üst kısmında oyuk bir para haznesi,"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 32.95,
            "width": 33.5,
            "text": "insan boyuna yakın taş sütun."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 38.01,
            "width": 33.5,
            "text": "Cami avluları ve ibadethaneler,"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 41.35,
            "width": 33.5,
            "text": "mahalle ve sokak kesişimleri,"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 44.74,
            "width": 33.5,
            "text": "tenha ve sakin köşe başları."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 49.62,
            "width": 33.5,
            "text": "Yoksulları incitmeden korumak,"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 52.95,
            "width": 33.5,
            "text": "alan ile vereni gizli tutmak,"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 56.28,
            "width": 33.5,
            "text": "toplumsal dayanışmayı artırmak."
          }
        ]
      },
      {

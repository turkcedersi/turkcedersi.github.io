      {
        "id": "p25_etk11_c",
        "title": "11. Etkinlik C: Noktalı Virgül Örnek Cümleleri",
        "button": {
          "left": 6.5,
          "top": 44.5
        },
        "items": [
          {
            "type": "lines",
            "left": 35.7,
            "top": 51.22,
            "width": 53.5,
            "height": 2.2,
            "text": "Pazardan elma, armut, muz; marul, ıspanak aldım."
          },
          {
            "type": "lines",
            "left": 35.7,
            "top": 59.94,
            "width": 53.5,
            "height": 2.2,
            "text": "Sevinçten havalara uçtu, güldü; içi içine sığmıyordu."

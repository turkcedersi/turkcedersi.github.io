            "top": 59.5,
            "width": 32.0,
            "height": 2.2,
            "text": "Büyük ve heybetli ev dizileri"
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 62.0,
            "width": 32.0,
            "height": 2.2,
            "text": "Uzun yemek masalı soğuk sofralar"
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 64.5,
            "width": 32.0,

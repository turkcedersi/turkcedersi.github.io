    ],
    "155": [
      {
        "id": "p155_10",
        "title": "10. Etkinlik (Söz Sanatları)",
        "button": {
          "left": 5.2,
          "top": 6.5
        },
        "items": [
          {
            "type": "lines",
            "left": 27.5,
            "top": 17.5,
            "width": 58.0,
            "height": 3.0,
            "text": "Anadolu, nehirlerin hüzünlü türküsünü asırlardır dinler."
          },
          {
            "type": "lines",
            "left": 27.5,
            "top": 24.5,
            "width": 58.0,
            "height": 3.0,
            "text": "Bozkırdaki ulu dağ, 'Ben bu vatanın kalesiyim!' diye seslendi."
          },
          {
            "type": "lines",
            "left": 27.5,
            "top": 32.0,
            "width": 58.0,
            "height": 3.0,
            "text": "Anadolu, bin yıllık zengin tarihiyle renkli bir kilimdir."
          }
        ]
      },
      {
        "id": "p155_11",
        "title": "11. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 40.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 53.9,
            "width": 71.0,
            "height": 3.8,
            "text": "Gövdem koca bir tarih, köklerim ise bu aziz vatanın bağrında bir sevdadır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 56.5,
            "width": 71.0,
            "height": 3.8,
            "text": "Asırlar boyunca serin gölgemde nice yiğitler, nice bilgeler dinlendi."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 59.0,
            "width": 71.0,
            "height": 3.8,
            "text": "Osmanlı'nın kuruluşundaki kutlu rüyalara ve zafer sevinçlerine tanık oldum."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 61.5,
            "width": 71.0,
            "height": 3.8,
            "text": "Kimi zaman dondurucu fırtınalarda dallarım kırıldı, yapraklarım döküldü."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 64.0,
            "width": 71.0,
            "height": 3.8,
            "text": "Fakat Millî Mücadele günlerinde milletimin azmini görünce gurur duydum."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 66.5,
            "width": 71.0,
            "height": 3.8,
            "text": "Ben sadece bir ağaç değil; köklü bir vefanın, birliğin ve sabrın simgesiyim."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 69.0,
            "width": 71.0,
            "height": 3.8,
            "text": "Şimdi taze yapraklarımla geleceğe selam duruyor, çocuklarımızı kucaklıyorum."
          }
        ]
      }
    ],
    "156": [
      {
        "id": "p156_12_a",
        "title": "12. Etkinlik (a)",
        "button": {
          "left": 5.2,
          "top": 35.0
        },
        "items": [
          {
            "type": "lines",
            "left": 46.0,
            "top": 35.4,
            "width": 38.0,
            "height": 2.2,
            "text": "Alper Gezeravcı"
          },
          {
            "type": "lines",
            "left": 48.0,
            "top": 38.9,
            "width": 36.0,
            "height": 2.2,
            "text": "Mersin / Silifke"
          },
          {
            "type": "lines",
            "left": 49.5,
            "top": 42.4,
            "width": 34.5,
            "height": 2.2,
            "text": "1979"
          },
          {
            "type": "lines",
            "left": 49.0,
            "top": 45.9,
            "width": 35.0,
            "height": 2.2,
            "text": "Hava Harp Okulu, ABD Hava Kuv. Tek. Ens."
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 49.4,
            "width": 40.0,
            "height": 2.2,
            "text": "Askerî Pilot ve Astronot"
          },
          {
            "type": "lines",
            "left": 50.0,
            "top": 52.7,
            "width": 34.0,
            "height": 2.2,
            "text": "Mersin, İstanbul, ABD, Uzay İstasyonu"
          }
        ]
      },
      {
        "id": "p156_12_b",
        "title": "12. Etkinlik (b)",
        "button": {
          "left": 5.2,
          "top": 59.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 63.4,
            "width": 71.0,
            "height": 3.8,
            "text": "Her ikisi de vatanına, milletine ve bayrağına derin bir sevgi besler."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 65.9,
            "width": 71.0,
            "height": 3.8,
            "text": "Biri sanatıyla diğeri bilim ve cesaretiyle Türk milletini temsil etti."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 68.4,
            "width": 71.0,
            "height": 3.8,
            "text": "Her ikisi de azimli, hedeflerine odaklanan, çalışkan öncü kişiliklerdir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 70.9,
            "width": 71.0,
            "height": 3.8,
            "text": "Genç nesillere umut aşılayarak millî bir gurur kaynağı olmuşlardır."
          }
        ]
      }
    ],
    "160": [
      {
        "id": "p160_1_a",
        "title": "1. Etkinlik (a)",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 15.0,
            "width": 71.0,
            "height": 2.8,
            "text": "Tahmin: Metinde çocukların katıldığı çekişmeli bir bisiklet yarışı ve"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 17.5,
            "width": 71.0,
            "height": 2.8,
            "text": "yaşanan kazanma hırsının arkadaşlık ilişkilerine yansıması anlatılmaktadır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 20.0,
            "width": 71.0,
            "height": 2.8,
            "text": "Gerekçe: 'Altı Üstü Bir Yarış' başlığı yarışın abartılmamasını ima ederken"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 22.5,
            "width": 71.0,
            "height": 2.8,
            "text": "sayfa arka planındaki bisikletler spor mücadelesine işaret etmektedir."
          }
        ]
      },
      {
        "id": "p160_1_b",
        "title": "1. Etkinlik (b)",
        "button": {
          "left": 5.2,
          "top": 24.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 29.5,
            "width": 71.0,
            "height": 2.8,
            "text": "Evet, tahminim doğru çıktı. Yiğit'in girdiği bisiklet yarışında aşırı"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 32.0,
            "width": 71.0,
            "height": 2.8,
            "text": "hırslanarak öfkesine yenilmesi ve sonunda ailesinin öğütleriyle bir oyunun"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 34.5,
            "width": 71.0,
            "height": 2.8,
            "text": "dostluktan daha mühim olmadığını anlaması tahminimle tam örtüşmüştür."
          }
        ]
      },
      {
        "id": "p160_3",
        "title": "3. Etkinlik (Gerekçelendirme)",
        "button": {
          "left": 5.2,
          "top": 69.5
        },
        "items": [
          {
            "type": "lines",
            "left": 34.5,
            "top": 77.8,
            "width": 38.0,
            "height": 2.6,
            "text": "yarışı ne olursa olsun kazanma hırsından"
          },
          {
            "type": "lines",
            "left": 56.5,
            "top": 81.0,
            "width": 22.0,
            "height": 2.6,
            "text": "gelip teselli etmesinden"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 84.0,
            "width": 25.0,
            "height": 2.6,
            "text": "tatlı dille tesellisinden"
          },
          {
            "type": "lines",
            "left": 46.0,
            "top": 87.0,
            "width": 32.0,
            "height": 2.6,
            "text": "dostluğun değerini anlamasından"
          }
        ]
      }
    ],
    "161": [
      {
        "id": "p161_4",
        "title": "4. Etkinlik (Başlık Analizi)",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 16.0,
            "width": 71.0,
            "height": 3.0,
            "text": "Yarışın bir eğlence olduğunu ve dostluktan üstün olmadığını vurgulamak için."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 18.5,
            "width": 71.0,
            "height": 3.0,
            "text": "Farklı Başlık Önerilerim: 'Dostluk Yarışı', 'Öfkeyi Yenen Pedal',"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 21.0,
            "width": 71.0,
            "height": 3.0,
            "text": "'Kazanmaktan Daha Değerli', 'İki Teker Üstünde Hayat Dersi'."
          }
        ]
      }
    ],
    "162": [
      {
        "id": "p162_6",
        "title": "6. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.5,
            "top": 18.5,
            "width": 73.0,
            "height": 2.8,
            "text": "Öfkesine yenilip bisikletini fırlatmış; zincirinin atmasına yol açmıştır."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 21.2,
            "width": 73.0,
            "height": 2.8,
            "text": "Ayrıca yarışan arkadaşlarının kalbini kırmış ve pişmanlık duymuştur."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 30.0,
            "width": 73.0,
            "height": 2.8,
            "text": "Kendini yarışın tek galibi görmesi, aşırı hırsı ve kabullenememesidir."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 53.0,
            "width": 28.0,
            "height": 2.5,
            "text": "Hatasını ailesine itiraf etti."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 55.5,
            "width": 28.0,
            "height": 2.5,
            "text": "Arkadaşları teselli etti."
          },
          {
            "type": "lines",
            "left": 57.5,
            "top": 53.0,
            "width": 28.0,
            "height": 2.5,
            "text": "Öfke insana zarar verir."
          },
          {
            "type": "lines",
            "left": 57.5,
            "top": 55.5,
            "width": 28.0,
            "height": 2.5,
            "text": "Aşırı hırs neşeyi yok eder."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 71.5,
            "width": 73.0,
            "height": 2.6,
            "text": "Hayır; çünkü bisikletinin bozulması ve ailesinin nasihatleri ders olmuştur."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 81.0,
            "width": 73.0,
            "height": 2.8,
            "text": "Kaybettiğinde öfkelenip bisikleti fırlatmasını doğru bulmadım."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 83.5,
            "width": 73.0,
            "height": 2.8,
            "text": "Ben olsaydım rakibimi tebrik eder, bunun bir oyun olduğunu unutmazdım."
          }
        ]
      }
    ],
    "163": [
      {
        "id": "p163_8",
        "title": "8. Etkinlik (Serim - Düğüm - Çözüm)",
        "button": {
          "left": 5.2,
          "top": 44.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.5,
            "top": 51.4,
            "width": 73.0,
            "height": 2.2,
            "text": "Yiğit'in mahalledeki arkadaşlarıyla iddialı bir bisiklet yarışı"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 54.0,
            "width": 73.0,
            "height": 2.2,
            "text": "planlaması ve büyük bir heyecanla yarışa başlaması."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 66.6,
            "width": 73.0,
            "height": 2.2,
            "text": "Yarışı kaybedince öfkesine yenilip bisikletini fırlatması,"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 69.4,
            "width": 73.0,
            "height": 2.2,
            "text": "zincirini bozması ve sonrasında duyduğu derin pişmanlık."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 83.8,
            "width": 73.0,
            "height": 2.2,
            "text": "Durumu ailesine anlatıp hatasını kabul etmesi, dostluğun"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 86.3,
            "width": 73.0,
            "height": 2.2,
            "text": "yarıştan çok daha kıymetli olduğunu öğrenmesi."
          }
        ]
      }
    ],
    "164": [
      {
        "id": "p164_9",
        "title": "9. Etkinlik (Noktalama Kuralları ve Örnekler)",
        "button": {
          "left": 5.2,
          "top": 58.0
        },
        "items": [
          {
            "type": "lines",
            "left": 28.5,
            "top": 65.9,
            "width": 27.0,
            "height": 2.2,
            "text": "Konuşma cümlesini bildirmek"
          },
          {
            "type": "lines",
            "left": 61.5,
            "top": 65.9,
            "width": 26.0,
            "height": 2.2,
            "text": "Açıklama yapılacak yere."
          },
          {
            "type": "lines",
            "left": 28.5,
            "top": 70.9,
            "width": 27.0,
            "height": 2.2,
            "text": "Karşılıklı konuşmayı belirtir"
          },
          {
            "type": "lines",
            "left": 61.5,
            "top": 70.9,
            "width": 26.0,
            "height": 2.2,
            "text": "Konuşmaların başına konur."
          },
          {
            "type": "lines",
            "left": 28.5,
            "top": 75.4,
            "width": 27.0,
            "height": 2.2,
            "text": "Bitmemiş yargıyı belirtmek"
          },
          {
            "type": "lines",
            "left": 61.5,
            "top": 75.4,
            "width": 26.0,
            "height": 2.2,
            "text": "Bitmemiş cümle sonuna."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 85.2,
            "width": 72.0,
            "height": 2.2,
            "text": "Öğretmenimiz sınıfa seslendi: 'Yarın kütüphaneye gidiyoruz.'"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 87.6,
            "width": 72.0,
            "height": 2.2,
            "text": "— Bu güzel sergiye sen de gelecek misin?"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 90.2,
            "width": 72.0,
            "height": 2.2,
            "text": "Kuş sesleri, hafif bir meltem, dalgaların şırıltısı..."
          }
        ]
      }
    ],
    "168": [
      {
        "id": "p168_10",
        "title": "10. Etkinlik (Üç Kardeş Masal Analizi)",
        "button": {
          "left": 5.2,
          "top": 63.5
        },
        "items": [
          {
            "type": "lines",
            "left": 17.5,
            "top": 65.4,
            "width": 68.0,
            "height": 2.2,
            "text": "İhtiyar zengin baba ve üç kızı (büyük kız, ortanca kız, küçük kız)."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 71.4,
            "width": 32.0,
            "height": 2.2,
            "text": "Konağın bahçesi ve çorak tarla."
          },
          {
            "type": "lines",
            "left": 54.5,
            "top": 71.4,
            "width": 32.0,
            "height": 2.2,
            "text": "Geçmiş zaman, masal vakti."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 79.9,
            "width": 68.0,
            "height": 2.2,
            "text": "Babanın kızlarına sevgilerini sorması, büyük kızların süslü sözlerine kanması,"
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 82.4,
            "width": 68.0,
            "height": 2.2,
            "text": "küçük kızın sevgisini tuza benzetmesi ve babası tarafından saraydan uzaklaştırılması,"
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 84.9,
            "width": 68.0,
            "height": 2.2,

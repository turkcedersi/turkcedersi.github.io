    "60": [
      {
        "id": "p60_1",
        "title": "1. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 66.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.5,
            "top": 71.7,
            "width": 73.0,
            "height": 2.4,
            "text": "Anadolu kadını ve genç kızı; hislerini, hayallerini, zekâsını, el ve göz zevkini"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 74.3,
            "width": 73.0,
            "height": 2.4,
            "text": "ilmek ilmek işleyerek oyalar aracılığıyla sessizce ve estetik bir dille ifade etmiştir."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 81.6,
            "width": 73.0,
            "height": 2.4,
            "text": "Oyalar; yapıldıkları yörenin doğasını, iklimini, inançlarını ve sosyal hayatını"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 84.2,
            "width": 73.0,
            "height": 2.4,
            "text": "geçmişten günümüze taşıyarak kültürel belleğin ve geleneklerin yaşatılmasını sağlar."
          }
        ]
      }
    ],
    "61": [
      {
        "id": "p61_2",
        "title": "2. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.5,
            "top": 11.8,
            "width": 73.0,
            "height": 2.4,
            "text": "Geleneksel Türk el sanatlarından oyaların özellikleri, çeşitleri ve kültürel anlamı."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 18.1,
            "width": 73.0,
            "height": 2.4,
            "text": "Oyalar sadece bir süs eşyası olmayıp Anadolu insanının duygularını ve yörenin tabiatını yansıtır."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 20.7,
            "width": 73.0,
            "height": 2.4,
            "text": "Kültürel bir kimlik ve sessiz bir iletişim aracı olan bu zengin mirasımızı"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 23.4,
            "width": 73.0,
            "height": 2.4,
            "text": "koruyup değerini bilerek gelecek kuşaklara gururla aktarmalıyız."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 26.0,
            "width": 73.0,
            "height": 2.4,
            "text": "Her motif ve ilmek, geçmişimizle geleceğimiz arasında kurulan köklü bir gönül bağıdır."
          }
        ]
      },
      {
        "id": "p61_3",
        "title": "3. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 32.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.2,
            "top": 44.0,
            "width": 34.0,
            "height": 2.2,
            "text": "• El emeği ve göz nuruyla üretilir."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 46.5,
            "width": 34.0,
            "height": 2.2,
            "text": "• Anadolu insanının hissini yansıtır."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 49.0,
            "width": 34.0,
            "height": 2.2,
            "text": "• Kültürümüzün köklü bir el sanatıdır."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 51.5,
            "width": 34.0,
            "height": 2.2,
            "text": "• Tabiat ve çiçeklerden ilham alır."
          },
          {
            "type": "lines",
            "left": 51.8,
            "top": 44.0,
            "width": 34.0,
            "height": 2.2,
            "text": "• Farklı tekniklerle (iğne, tığ) örülür."
          },
          {
            "type": "lines",
            "left": 51.8,
            "top": 46.5,
            "width": 34.0,
            "height": 2.2,
            "text": "• Malzemeleri (koza, boncuk) değişir."
          },
          {
            "type": "lines",
            "left": 51.8,
            "top": 49.0,
            "width": 34.0,
            "height": 2.2,
            "text": "• Yörelere göre adları ve motifleri değişir."
          },
          {
            "type": "lines",
            "left": 51.8,
            "top": 51.5,
            "width": 34.0,
            "height": 2.2,
            "text": "• Bir yerde sırma, diğerinde kemiktir."
          }
        ]
      },
      {
        "id": "p61_4",
        "title": "4. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 71.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.5,
            "top": 74.0,
            "width": 73.0,
            "height": 2.4,
            "text": "Oya, el emeği, gelenek, motif, Anadolu kadını, kültürel miras."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 79.1,
            "width": 73.0,
            "height": 2.4,
            "text": "Bu kavramlar, metinde anlatılan oya sanatının tarihî ve estetik önemini,"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 81.7,
            "width": 73.0,
            "height": 2.4,
            "text": "Anadolu kadınının duygularını yansıtış biçimini ve kültürümüzün kuşaktan kuşağa"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 84.2,
            "width": 73.0,
            "height": 2.4,
            "text": "aktarılan en zarif el sanatı değerlerini doğrudan özetlemektedir."
          }
        ]
      }
    ],
    "62": [
      {
        "id": "p62_6",
        "title": "6. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 35.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.2,
            "top": 44.0,
            "width": 34.2,
            "height": 2.2,
            "text": "• Karagöz ile Hacivat başkarakterdir."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 46.5,
            "width": 34.2,
            "height": 2.2,
            "text": "• Tasvirler deve derisinden yapılır."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 49.0,
            "width": 34.2,
            "height": 2.2,
            "text": "• Oyunu seslendirene Hayalî denir."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 51.5,
            "width": 34.2,
            "height": 2.2,
            "text": "• Oyunlar toplum hayatının aynasıdır."
          },
          {
            "type": "lines",
            "left": 51.2,
            "top": 44.0,
            "width": 34.2,
            "height": 2.2,
            "text": "• Perdede açılan süsleme figürleri."
          },
          {
            "type": "lines",
            "left": 51.2,
            "top": 46.5,
            "width": 34.2,
            "height": 2.2,
            "text": "• Çırağın getirdiği küçük eşyalar."
          },
          {
            "type": "lines",
            "left": 51.2,
            "top": 49.0,
            "width": 34.2,
            "height": 2.2,
            "text": "• Işık kaynağının teknik detayları."
          },
          {
            "type": "lines",
            "left": 51.2,
            "top": 51.5,
            "width": 34.2,
            "height": 2.2,
            "text": "• Sahnedeki anlık küçük tekerlemeler."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 62.6,
            "width": 71.0,
            "height": 2.3,
            "text": "Karagöz ve Hacivat, Türk tiyatromuzun en önemli gölge oyunu mirasıdır."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 65.3,
            "width": 71.0,
            "height": 2.3,
            "text": "Oyun, perdenin arkasından ışık verilip tasvirlerin oynatılmasıyla sunulur."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 68.0,
            "width": 71.0,
            "height": 2.3,
            "text": "Tasvirler deve derisinden özenle kesilerek kök boyalarla renklendirilir."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 70.7,
            "width": 71.0,
            "height": 2.3,
            "text": "Tüm figürleri perde arkasında ustalıkla seslendiren ustaya Hayalî denir."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 73.4,
            "width": 71.0,
            "height": 2.3,
            "text": "Hayalî; taklit gücü yüksek, nükteden anlayan çok yönlü bir sanatçıdır."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 76.1,
            "width": 71.0,
            "height": 2.3,
            "text": "Güldürü unsuru, okumamış Karagöz ile aydın Hacivat'ın sözlerine dayanır."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 78.8,
            "width": 71.0,
            "height": 2.3,
            "text": "Karagöz, Hacivat'ın süslü ve yabancı kelimelerini sürekli yanlış anlar."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 81.5,
            "width": 71.0,
            "height": 2.3,
            "text": "Bu tatlı yanlış anlamalar izleyicileri hem güldürür hem de düşündürür."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 84.2,
            "width": 71.0,
            "height": 2.3,
            "text": "Hayal perdesi, eğlendirirken toplumdaki aksaklıkları da ustaca hicveder."
          },
          {
            "type": "lines",
            "left": 14.2,
            "top": 86.8,
            "width": 71.0,
            "height": 2.3,
            "text": "Böylece Karagöz sanatı, asırlık ortak kültürümüzü günümüze taşımaktadır."
          }
        ]
      }
    ],
    "63": [
      {
        "id": "p63_7",
        "title": "7. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 33.5,
            "top": 16.0,
            "width": 28.5,
            "height": 2.2,
            "text": "Okumamış bir halk adamıdır."
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 16.0,
            "width": 28.5,
            "height": 2.2,
            "text": "Medrese görmüş aydın kişidir."
          },
          {
            "type": "lines",
            "left": 33.5,
            "top": 20.5,
            "width": 28.5,
            "height": 2.2,
            "text": "Doğal, samimi ve içi dışı birdir."
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 20.5,
            "width": 28.5,
            "height": 2.2,
            "text": "Kibar, görgülü ve temkinlidir."
          },
          {
            "type": "lines",
            "left": 33.5,
            "top": 25.4,
            "width": 28.5,
            "height": 2.2,
            "text": "Halk nükteciliği ve saflık."
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 25.4,
            "width": 28.5,
            "height": 2.2,
            "text": "Söz oyunları ve süslü dil."
          },
          {
            "type": "lines",
            "left": 33.5,
            "top": 29.8,
            "width": 28.5,
            "height": 2.2,
            "text": "Çabuk öfkelenir ve fevridir."
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 29.8,
            "width": 28.5,
            "height": 2.2,
            "text": "Sakin kalır ve alttan alır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 45.0,
            "width": 17.5,
            "height": 2.1,
            "text": "• Okumamıştır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 47.8,
            "width": 17.5,
            "height": 2.1,
            "text": "• İçi dışı birdir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.6,
            "width": 17.5,
            "height": 2.1,
            "text": "• Ters anlar."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 53.4,
            "width": 17.5,
            "height": 2.1,
            "text": "• Çabuk parlar."
          },
          {
            "type": "lines",
            "left": 37.0,
            "top": 44.0,
            "width": 26.0,
            "height": 2.1,
            "text": "• Gölge oyununun iki ana tipidir."
          },
          {
            "type": "lines",
            "left": 37.0,
            "top": 46.8,
            "width": 26.0,
            "height": 2.1,
            "text": "• Birbirinin kadim dostudurlar."
          },
          {
            "type": "lines",
            "left": 37.0,
            "top": 49.6,
            "width": 26.0,
            "height": 2.1,
            "text": "• Güldürürken düşündürürler."
          },
          {
            "type": "lines",
            "left": 37.0,
            "top": 52.4,
            "width": 26.0,
            "height": 2.1,
            "text": "• Ortak kültürel mirasımızdır."
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 45.0,
            "width": 18.0,
            "height": 2.1,
            "text": "• Medrese görmüştür."
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 47.8,
            "width": 18.0,
            "height": 2.1,
            "text": "• Kibar ve kurnazdır."
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 50.6,
            "width": 18.0,
            "height": 2.1,
            "text": "• Ağdalı konuşur."
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 53.4,
            "width": 18.0,
            "height": 2.1,
            "text": "• Sakin ve temkinlidir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 69.4,
            "width": 70.0,
            "height": 2.4,
            "text": "Karagöz ve Hacivat, gölge oyunumuzun birbirini tamamlayan iki zıt kutbudur."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 71.8,
            "width": 70.0,
            "height": 2.4,
            "text": "Karagöz saf ve samimi halkı temsil ederken, Hacivat okumuş ve aydın kesimi simgeler."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 74.3,
            "width": 70.0,
            "height": 2.4,
            "text": "Aralarındaki tezatlık ve diyaloglar izleyiciyi güldürürken derin derin düşündürür."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 76.7,
            "width": 70.0,
            "height": 2.4,
            "text": "Her ikisi de yüzyıllardır birlik içinde kültürümüzün en renkli zenginliğini oluşturur."
          }
        ]
      }
    ],

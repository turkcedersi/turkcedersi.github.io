            "text": "başarıyla tamamlamıştır."
          },
          {
            "type": "lines",
            "left": 58.0,
            "top": 17.6,
            "width": 28.0,
            "height": 3.0,
            "text": "zaferle taçlandırmıştır."
          },
          {
            "type": "lines",
            "left": 40.0,
            "top": 20.0,
            "width": 46.0,
            "height": 3.0,
            "text": "bağımsızlık meşalesidir."
          },
          {
            "type": "lines",
            "left": 64.0,
            "top": 22.4,
            "width": 22.0,
            "height": 3.0,
            "text": "en yüce simgesidir."
          },
          {
            "type": "lines",
            "left": 51.0,
            "top": 24.8,
            "width": 35.0,
            "height": 3.0,
            "text": "layıkıyla ödemeliyiz."
          }
        ]
      },
      {
        "id": "p88_7",
        "title": "7. Etkinlik (Şerife Bacı)",
        "button": {
          "left": 5.2,
          "top": 48.5
        },
        "items": [
          {
            "type": "mark",
            "left": 27.5,
            "top": 72.0,
            "width": 3.2,
            "height": 2.2,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 81.0,
            "width": 71.0,
            "height": 3.0,
            "text": "Şerife Bacı, İnebolu'dan cepheye kağnısıyla karlı ve dondurucu şartta"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 83.5,
            "width": 71.0,
            "height": 3.0,
            "text": "mermi taşırken şehit olan kahraman kadındır. Görseldeki karlı dağlarda"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 86.0,
            "width": 71.0,
            "height": 3.0,
            "text": "kağnılarla mermi taşıyan fedakâr kadınlarımız doğrudan metinle örtüşür."
          }
        ]
      }
    ],
    "91": [
      {
        "id": "p91_8",
        "title": "Biz Uyguluyoruz (Plan ve Taslak Metin)",
        "button": {
          "left": 5.2,
          "top": 67.0
        },
        "items": [
          {
            "type": "lines",
            "left": 24.5,
            "top": 71.4,
            "width": 61.0,
            "height": 2.2,
            "text": "Elif Bacı, köyün yaşlıları ve cephane taşıyan kadınlar."
          },
          {
            "type": "lines",
            "left": 22.5,
            "top": 73.9,
            "width": 63.0,
            "height": 2.2,
            "text": "Kastamonu ile İnebolu arasındaki sarp ve karlı dağ yolları."
          },
          {
            "type": "lines",
            "left": 25.5,
            "top": 76.4,
            "width": 60.0,
            "height": 2.2,
            "text": "Kurtuluş Savaşı yılları, dondurucu bir kış mevsimi."
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 78.6,
            "width": 59.0,
            "height": 2.2,
            "text": "Cephanelerin kağnıya yüklenmesi, zorlu kış yolculuğuna çıkış,"
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 80.9,
            "width": 68.0,
            "height": 2.2,
            "text": "yorganın mermilere örtülmesi ve mermilerin cepheye ulaştırılması."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 85.4,
            "width": 68.0,
            "height": 2.2,
            "text": "Elif Bacı, dondurucu ayaza aldırmadan kağnısını karlı dağ yollarında kararlılıkla sürüyordu."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 87.9,
            "width": 68.0,
            "height": 2.2,
            "text": "Bebeğinin yorganını mermiler ıslanmasın diye cephanenin üstüne örtecek kadar fedakârdı."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 90.4,
            "width": 68.0,
            "height": 2.2,
            "text": "Çektiği her zahmet, vatanın kurtuluşu ve Mehmetçiğin zafere ulaşması içindi."
          }
        ]
      }
    ],
    "92": [
      {
        "id": "p92_8",
        "title": "Yine Uyguluyoruz (Plan ve Taslak Metin)",
        "button": {
          "left": 5.2,
          "top": 42.0
        },
        "items": [
          {
            "type": "lines",
            "left": 24.5,
            "top": 46.9,
            "width": 61.0,
            "height": 2.2,
            "text": "Ahmet (5. sınıf öğrencisi) ve Türkçe öğretmeni."
          },
          {
            "type": "lines",
            "left": 22.5,
            "top": 49.4,
            "width": 63.0,
            "height": 2.2,
            "text": "Okul kütüphanesi ve evdeki çalışma masası."
          },
          {
            "type": "lines",
            "left": 25.5,
            "top": 51.9,
            "width": 60.0,
            "height": 2.2,
            "text": "18 Mart Çanakkale Zaferi anma töreninden bir hafta önce."
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 54.2,
            "width": 59.0,
            "height": 2.2,
            "text": "Törende şiir okuma görevi alma, kütüphanede şiir araştırma,"
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 56.4,
            "width": 68.0,
            "height": 2.2,
            "text": "Mehmet Âkif'in 'Çanakkale Şehitlerine' şiirini seçip prova yapma."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 60.8,
            "width": 68.0,
            "height": 2.2,
            "text": "Ahmet, 18 Mart töreninde okuyacağı en anlamlı şiiri seçmek için günlerdir kütüphanedeydi."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 63.3,
            "width": 68.0,
            "height": 2.2,
            "text": "Mehmet Âkif'in 'Çanakkale Şehitlerine' şiirini okurken gözleri doluyor, göğsü gururla kabarıyordu."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 65.8,
            "width": 68.0,
            "height": 2.2,
            "text": "Şehitlerimizin aziz hatırasına layık bir ses tonuyla şiirini defalarca yürekten prova etti."
          }
        ]
      }
    ],
    "93": [
      {
        "id": "p93_9",
        "title": "9. Etkinlik (Hikâye Serim Bölümü)",
        "button": {
          "left": 5.2,
          "top": 55.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.5,
            "top": 55.4,
            "width": 72.0,
            "height": 2.2,
            "text": "Güneş, Anadolu bozkırının üzerinde kavurucu sıcaklığıyla yükseliyordu."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 57.4,
            "width": 72.0,
            "height": 2.2,
            "text": "On bir yaşındaki Eren, sabahın ilk ışıklarıyla bahçeye çıktığında köyün meydanından"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 59.4,
            "width": 72.0,
            "height": 2.2,
            "text": "toz bulutları kaldırarak geçen Türk süvarilerini gördü. Askerlerin yorgun ama vakur"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 61.4,
            "width": 72.0,
            "height": 2.2,
            "text": "duruşları Eren'in yüreğinde büyük bir heyecan ve vatan sevgisi uyandırdı."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 63.4,
            "width": 72.0,
            "height": 2.2,
            "text": "Köy çeşmesinin başında toplanan kadınlar, askerlerimizin kavurucu güneş altında"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 65.4,
            "width": 72.0,
            "height": 2.2,
            "text": "susuz savaştıklarını konuşuyorlardı. Eren derhal arkadaşı Ferhat'ın yanına koştu:"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 67.4,
            "width": 72.0,
            "height": 2.2,
            "text": "'Ferhat, askerlerimiz susuzken biz burada bekleyemeyiz! Çeşmeden testilerimizi doldurup"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 69.4,
            "width": 72.0,
            "height": 2.2,
            "text": "cepheye su taşımalıyız!' dedi. İki can yoldaşı testilerini buz gibi suyla doldurup yola koyuldular."
          }
        ]
      }
    ],
    "94": [

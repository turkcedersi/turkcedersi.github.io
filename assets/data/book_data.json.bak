          },
          {
            "type": "lines",
            "left": 40.5,
            "top": 67.7,
            "width": 47.0,
            "height": 2.4,
            "text": "\"Bir fincan kahvenin kırk yıl hatırı vardır\""
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 69.9,
            "width": 70.0,
            "height": 2.4,
            "text": "atasözüyle başlanarak dinleyicinin dikkati doğrudan çekilmiştir."
          },
          {

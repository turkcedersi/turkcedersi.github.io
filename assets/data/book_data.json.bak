    ],
    "105": [
      {
        "id": "p105_etk8",
        "title": "8. Etkinlik B & C: Noktalama İşaretleri Gruplaması",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "box",
            "left": 44.0,
            "top": 41.5,
            "width": 14.5,
            "text": "Cümle 1 ve Cümle 6\n(Doğrudan aktarılan alıntı cümleler tırnak içine alınmıştır.)"
          },
          {
            "type": "box",
            "left": 62.0,
            "top": 41.5,
            "width": 14.5,
            "text": "Cümle 4, 5 ve 8\n(Özel olarak vurgulanan sözler ve eser adları tırnak içine alınmıştır.)"
          },
          {
            "type": "box",
            "left": 44.0,
            "top": 53.5,
            "width": 14.5,
            "text": "Cümle 2 ve Cümle 7\n(Cümledeki ek açıklama ve durumlar yay ayraç ile belirtilmiştir.)"
          },
          {
            "type": "box",
            "left": 62.0,
            "top": 53.5,
            "width": 14.5,
            "text": "Cümle 3\n(Yay ayraç içindeki ilave açıklama için köşeli ayraç kullanılmıştır.)"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 70.06,
            "width": 78.0,
            "text": "1. Başka bir kimseden olduğu gibi aktarılan sözler tırnak işareti (\" \") içine alınır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 72.63,
            "width": 78.0,
            "text": "2. Cümle içinde özel olarak belirtilmek istenen kavramlar ve eser adları tırnak içine alınır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 75.19,
            "width": 78.0,
            "text": "3. Cümlenin yapısıyla doğrudan ilgili olmayan açıklayıcı bilgiler yay ayraç ( ) içine yazılır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 77.76,
            "width": 78.0,
            "text": "4. Ayraç içinde ayraç kullanılması gereken durumlarda yay ayraçtan önce köşeli ayraç [ ] kullanılır."
          }
        ]
      }
    ],
    "106": [
      {
        "id": "p106_etk9",
        "title": "9. Etkinlik: Hikâye Değerlendirme Yazısı",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 47.63,
            "width": 76.0,
            "text": "Başlık: Küçük Prens ile Büyülü Bir Yolculuk"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 50.19,
            "width": 76.0,
            "text": "Antoine de Saint-Exupéry'nin ölümsüz eseri 'Küçük Prens', çocuklara masalsı bir dünya sunarken"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 52.76,
            "width": 76.0,
            "text": "büyüklere de unuttukları saflığı, sevgiyi ve dostluğun hatırını hatırlatan derin bir başyapıttır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 55.32,
            "width": 76.0,
            "text": "Kitapta küçük bir çocuğun gözünden anlatılan gezegenler arası macera, modern insanın hırslarını"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 57.88,
            "width": 76.0,
            "text": "ve yapay telaşlarını zekice hicveder. Tilkinin 'Gerçeğin mayası gözle görülmez, insan ancak yüreğiyle"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 60.45,
            "width": 76.0,
            "text": "baktığı zaman doğruyu görebilir.' sözü, eserin ana fikrini kusursuz şekilde özetlemektedir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 63.01,
            "width": 76.0,
            "text": "Dili son derece sade, şiirsel ve akıcıdır; her yaştan okurun hayatında derin izler bırakacak değerdedir."
          }
        ]
      }
    ],
    "107": [
      {
        "id": "p107_uretim",
        "title": "Üretim Vakti: Kitap İnceleme Özeti",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "badge",
            "left": 15.0,
            "top": 49.5,
            "width": 32.0,
            "text": "Şahıslar: Küçük Prens, Pilot, Tilki, Gül"
          },
          {
            "type": "badge",
            "left": 53.0,
            "top": 49.5,
            "width": 32.0,
            "text": "Olay: Çöle düşen pilotun Prens ile tanışması"
          },
          {
            "type": "badge",
            "left": 15.0,
            "top": 55.5,
            "width": 32.0,
            "text": "Zaman: Belirsiz bir geçmiş / günümüz"
          },
          {
            "type": "badge",
            "left": 53.0,
            "top": 55.5,
            "width": 32.0,
            "text": "Mekân: Sahra Çölü ve B-612 Gezegeni"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 46.67,
            "width": 78.0,
            "text": "Sahra Çölü'ne uçağı düşen bir pilot, başka bir gezegenden gelen Küçük Prens ile karşılaşır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 49.55,
            "width": 78.0,
            "text": "Küçük Prens, kendi küçük asteroidindeki çiçeğine duyduğu sevgiyle çıktığı yolculukta pek çok büyüyle karşılaşmış;"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 52.44,
            "width": 78.0,
            "text": "dünyada bir tilkiyle dost olarak gerçek bağın sorumluluk ve emekle kurulduğunu öğrenmiştir."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 55.32,
            "width": 78.0,
            "text": "Eser, insanın hayattaki en kıymetli hazinesinin sevgi, samimiyet ve sadakat olduğunu etkileyici bir dille anlatır."
          }
        ]
      }
    ],
    "110": [
      {
        "id": "p110_deg1",
        "title": "Tema Değerlendirme: Ölçütler ve Problem",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.0,
            "top": 9.49,
            "width": 73.0,
            "text": "Bilgilendirici bir metin, anlatılanları daha iyi kavratabilmek için somut örnekler ve görseller ile desteklemelidir."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 13.65,
            "width": 73.0,
            "text": "Benim yaş grubuma uygun bir metnin dili açık, sade, akıcı ve anlaşılır olmalıdır."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 16.54,
            "width": 73.0,
            "text": "Organizasyonu iyi olan bir metinde giriş, gelişme ve sonuç bölümleri yer almalıdır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 33.53,
            "width": 78.0,
            "text": "Tespit Edilen Problem: Medya içeriklerinin ticari kaygılarla yanlış ve yanıltıcı bilgi yayması."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 38.33,
            "width": 78.0,
            "text": "Problemin Özeti: Bireylerin sosyal medya ve internetteki her haberi doğrulamadan doğru kabul etmesi."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 43.14,
            "width": 78.0,
            "text": "Çözüm Önerileri: Okullarda medya okuryazarlığı eğitimi yaygınlaştırılmalı, güvenilir kaynak taraması öğretilmeli."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 48.27,
            "width": 78.0,
            "text": "En Uygun Çözüm: Dijital içerikleri sorgulayan, teyit mekanizmasını alışkanlık edinen bilinçli nesiller yetiştirmek."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 53.72,
            "width": 78.0,
            "text": "Değerlendirme: Bilinçli okuryazarlık sayesinde bilgi kirliliği engellenir, toplum doğru yönlendirilir."
          }
        ]
      }
    ],

    "32": [
      {
        "id": "p32_3",
        "title": "3. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "badge",
            "left": 41.5,
            "top": 19.8,
            "width": 3.6,
            "height": 2.5,
            "text": "b"
          },
          {
            "type": "badge",
            "left": 41.5,
            "top": 24.0,
            "width": 3.6,
            "height": 2.5,
            "text": "a"
          },
          {
            "type": "badge",
            "left": 41.5,
            "top": 27.7,
            "width": 3.6,
            "height": 2.5,
            "text": "c"
          },
          {
            "type": "lines",
            "left": 47.0,
            "top": 27.9,
            "width": 40.0,
            "height": 2.4,
            "text": "Bir yerde konuk olarak gecelemek veya bir süre kalmak."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 42.6,
            "width": 72.0,
            "height": 2.4,
            "text": "Köyden gelen akrabalarımızı evimizde en güzel şekilde ağırladık."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 45.3,
            "width": 72.0,
            "height": 2.4,
            "text": "Kendi evinde yabancı gibi öyle misafir gibi oturmaktan vazgeç."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 47.7,
            "width": 72.0,
            "height": 2.4,
            "text": "Hafta sonu dedemlerin yayladaki evinde iki gün misafir kaldık."
          }
        ]
      },
      {
        "id": "p32_4",
        "title": "4. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 54.0
        },
        "items": [
          {
            "type": "lines",
            "left": 41.5,
            "top": 62.9,
            "width": 46.0,
            "height": 2.4,
            "text": "Aile büyüklerine saygı ve hatıralara vefa duyulduğunu gösterir."
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 65.5,
            "width": 46.0,
            "height": 2.4,
            "text": "Geçmiş ile gelecek kuşaklar arasında sevgi bağı kurulduğunu anlatır."
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 73.6,
            "width": 46.0,
            "height": 2.4,
            "text": "Geniş aile kültürünü, birlik ve beraberlik bağlarını yansıtır."
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 76.3,
            "width": 46.0,
            "height": 2.4,
            "text": "Kuşaklar arası dayanışma ve sıcak akrabalık sevgisini ifade eder."
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 84.3,
            "width": 46.0,
            "height": 2.4,
            "text": "Türk milletinin cömertlik ve misafirperverlik erdemini gösterir."
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 87.0,
            "width": 46.0,
            "height": 2.4,
            "text": "Gelen konuğa hürmet etmenin ve paylaşmanın önemini vurgular."
          }
        ]
      }
    ],
    "33": [
      {
        "id": "p33_5",
        "title": "5. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 10.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 17.8,
            "width": 32.0,
            "height": 2.4,
            "text": "Kişileştirme"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 17.8,
            "width": 36.0,
            "height": 2.4,
            "text": "Bendim evin gözbebeği, canım sıkılmazdı hiç."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 20.4,
            "width": 32.0,
            "height": 2.4,
            "text": "Konuşturma"
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 20.4,
            "width": 36.0,
            "height": 2.4,
            "text": "Misafir odası kendi duygularını anlatmıştır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 30.7,
            "width": 72.0,
            "height": 2.4,
            "text": "Küçük serçe, sabah güneşine neşeyle günaydın dedi."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 33.4,
            "width": 72.0,
            "height": 2.4,
            "text": "Bahçedeki sarı papatya rüzgârla tatlı tatlı fısıldaşıyordu."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 36.1,
            "width": 72.0,
            "height": 2.4,
            "text": "Eski çalar saat yorulmadan her sabah bizi neşeyle uyandırdı."
          }
        ]
      },
      {

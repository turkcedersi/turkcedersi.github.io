      {
        "id": "p145_etk4",
        "title": "4. Etkinlik: Hayri'nin Yolu ve Değerlendirme",
        "button": {
          "left": 6.0,
          "top": 66.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 77.44,
            "width": 79.0,
            "text": "Hayri, arkadaşlarının şakalarının kırıcı bir sanal zorbalık olduğunu göstermek için"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 80.0,
            "width": 79.0,
            "text": "öfkeyle yaklaşmak yerine empati kurmalarını sağlayan zekice bir yöntem seçmiştir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 82.56,
            "width": 79.0,
            "text": "Bu yaklaşım doğru bir yöntemdir; çünkü insanlar empati kurduklarında hatalarını"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 85.13,
            "width": 79.0,
            "text": "savunmak yerine içtenlikle kabul eder ve davranışlarını kalıcı olarak düzeltirler."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 87.76,
            "width": 79.0,
            "text": "Böylece kırıcı olmadan yapıcı bir iletişim kurulmuş ve arkadaşlık bağı korunmuştur."
          }
        ]
      }
    ],
    "146": [
      {
        "id": "p146_etk5_a",
        "title": "5. Etkinlik A: İçeriğin Vermek İstediği Mesaj",
        "button": {
          "left": 6.0,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 21.0,
            "top": 22.88,
            "width": 58.0,
            "text": "İçeriğin vermek istediği temel mesaj, mizah ile"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 25.45,
            "width": 58.0,
            "text": "sanal zorbalık arasındaki hassas çizgiyi korumaktır."
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 28.08,
            "width": 58.0,
            "text": "Bir davranışı komik bulmak başkalarını incitecek"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 30.64,
            "width": 58.0,
            "text": "düzeye ulaştığında bu durum eğlence olmaktan çıkar."
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 33.21,
            "width": 58.0,
            "text": "Hale, Kâmil ve Sevim başlangıçta yaptıklarını masum"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 35.77,
            "width": 58.0,
            "text": "bir şaka sanırken Hayri'nin empati sağlayan uyarısıyla"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 38.33,
            "width": 58.0,
            "text": "kırıcı olduklarını anlayıp düşüncelerini değiştirmişlerdir."
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 40.9,
            "width": 58.0,
            "text": "İletişimde her zaman nezaket ve saygı esas alınmalıdır."
          }
        ]
      },
      {
        "id": "p146_etk5_b",
        "title": "5. Etkinlik B: Serim Bölümü İncelemesi",

    "142": [
      {
        "id": "p142_etk10",
        "title": "10. Etkinlik: Arkadaşıma Mektup (Empati ve Kurallar)",
        "button": {
          "left": 6.5,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 53.59,
            "width": 79.5,
            "text": "Sevgili Caner,"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 56.15,
            "width": 79.5,
            "text": "Kütüphanede fısıltıyla konuşurken görevli tarafından haksız yere uyarıldığını"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 58.72,
            "width": 79.5,
            "text": "düşündüğün o anı anlattığın yazını dikkatle okudum. Kendini kötü hissetmeni"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 61.28,
            "width": 79.5,
            "text": "ve kırılmanı çok iyi anlıyorum; çünkü niyetin asla huzuru bozmak değildi."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 63.85,
            "width": 79.5,
            "text": "Ancak görevlinin penceresinden baktığımızda, oradaki yüzlerce insanın tam bir"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 66.41,
            "width": 79.5,
            "text": "sessizliğe ihtiyaç duyduğunu ve en küçük fısıltının dahi dikkat dağıtabileceğini"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 69.04,
            "width": 79.5,
            "text": "görmemiz gerekir. Görevlinin tavrı sana özel bir tepki değil, ortak çalışma"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 71.6,
            "width": 79.5,
            "text": "alanını koruma çabasıydı. Bu yüzden haksızlığa uğradığını düşünüp üzülmemelisin."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 74.17,
            "width": 79.5,
            "text": "Önemli olan, toplum içinde kuralların hepimizin huzuru için olduğunu kavramaktır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 76.73,
            "width": 79.5,
            "text": "Gönlünü ferah tut, arkadaşım; her deneyim bize empatiyi ve olgunlaşmayı öğretir."
          }
        ]
      }
    ],
    "144": [
      {
        "id": "p144_etk1",
        "title": "1. Etkinlik B: Kelime Anlamı ve Çağrışımlar",
        "button": {
          "left": 6.0,
          "top": 42.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.5,
            "top": 47.05,
            "width": 12.5,
            "text": "yorum"
          },
          {
            "type": "lines",
            "left": 43.8,
            "top": 48.27,
            "width": 43.5,
            "text": "Düşünce, fikir beyanı, eleştiri, sosyal medya tepkisi"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 57.76,
            "width": 12.5,
            "text": "canını sıkmak"
          },
          {
            "type": "lines",
            "left": 43.8,
            "top": 58.65,
            "width": 43.5,
            "text": "Üzmek, moral bozmak, kalbini kırmak, can sıkıntısı"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 67.82,
            "width": 12.5,
            "text": "iddia etmek"
          },
          {
            "type": "lines",
            "left": 43.8,
            "top": 69.04,
            "width": 43.5,
            "text": "Bir görüşü savunmak, öne sürmek, tezinde ısrar etmek"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 77.76,
            "width": 12.5,
            "text": "sanal zorbalık"
          },
          {
            "type": "lines",
            "left": 43.8,
            "top": 79.17,
            "width": 43.5,
            "text": "Kötü niyetli yorumlar, siber saldırı, dijital taciz"
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 87.95,
            "width": 12.5,
            "text": "mizah"
          },
          {
            "type": "lines",
            "left": 43.8,
            "top": 89.29,
            "width": 43.5,
            "text": "Gülmece, espri, nükte, eğlence, tebessüm"
          }
        ]
      }
    ],

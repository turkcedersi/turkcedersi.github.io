      {
        "id": "p48_etk9_b",
        "title": "9. Etkinlik B: Noktalı Virgül Örnek Cümleleri",
        "button": {
          "left": 6.5,
          "top": 57.5
        },
        "items": [
          {
            "type": "mark",
            "left": 11.5,
            "top": 63.3,
            "width": 4.0,
            "height": 3.5,
            "text": "1"
          },
          {
            "type": "lines",
            "left": 20.5,
            "top": 62.88,
            "width": 67.5,
            "text": "Pazardan elma, armut, portakal; ıspanak, pırasa, havuç aldım."
          },
          {
            "type": "mark",
            "left": 11.5,
            "top": 69.1,
            "width": 4.0,
            "height": 3.5,
            "text": "2"
          },
          {
            "type": "lines",
            "left": 20.5,
            "top": 68.65,
            "width": 67.5,
            "text": "At ölür, meydan kalır; yiğit ölür, şan kalır."
          },
          {
            "type": "mark",
            "left": 11.5,
            "top": 74.8,
            "width": 4.0,
            "height": 3.5,
            "text": "3"
          },
          {
            "type": "lines",
            "left": 20.5,
            "top": 74.36,
            "width": 67.5,
            "text": "Ahmet; Murat, Can ve Selim gibi başarılı bir öğrencidir."
          }
        ]
      }
    ],
    "49": [
      {
        "id": "p49_etk10",
        "title": "10. Etkinlik: Arkadaşımızın Gelecekteki Mesleğine Dair Yazı",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 8.5,
            "top": 51.54,
            "width": 83.0,
            "text": "GELECEĞİN BÜYÜK MİMARI: CAN",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 54.1,
            "width": 83.0,
            "text": "Sınıf arkadaşım Can; uzun boylu, güler yüzlü, son derece dikkatli ve ince ruhlu biridir."
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 56.73,
            "width": 83.0,
            "text": "Etrafındaki her yapıyı, çizgiyi ve mekânı büyük bir merakla inceler; detaylara hayran kalır."
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 59.29,
            "width": 83.0,
            "text": "Sahip olduğu bu eşsiz görsel zekâ ve estetik bakış açısı dolayısıyla onun gelecekte çok başarılı"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 61.86,
            "width": 83.0,
            "text": "ve üretken bir mimar olacağına yürekten inanıyorum."
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 64.42,
            "width": 83.0,
            "text": "Can, boş zamanlarında sürekli yeni binalar çizer, geometrik şekillerden hayalî şehirler tasarlar."
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 66.99,
            "width": 83.0,
            "text": "Görsel sanatlar derslerinde yaptığı maketlerde gösterdiği olağanüstü sabır ve titizlik, herkesin"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 69.62,
            "width": 83.0,
            "text": "takdirini kazanmaktadır. Karşılaştığı karmaşık problemleri soğukkanlılıkla çözebildiği için grup"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 72.18,
            "width": 83.0,
            "text": "çalışmalarında her zaman yol gösterici olur. Hayal gücünü matematiksel zekâsıyla ustaca birleştiren"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 74.74,
            "width": 83.0,
            "text": "arkadaşım, hem estetik hem de sağlam yapılar tasarlamak için gerekli tüm meziyetlere sahiptir."
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 77.31,
            "width": 83.0,
            "text": "Çevresindeki sorunlara duyarlı yaklaştığından ötürü doğayla uyumlu projeler üretmeyi hedefler."
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 79.87,
            "width": 83.0,
            "text": "Bu nedenle geleceğin modern kentlerini tasarlarken çevre dostu çözümler geliştirecektir."
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 82.44,
            "width": 83.0,
            "text": "Onun bu kararlı tutumu, azimli çalışma gayreti ve yenilikçi vizyonu sayesinde mimarlık dünyasında"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 85.06,
            "width": 83.0,
            "text": "ülkemizi gururla temsil edeceğinden hiç şüphem yoktur."
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 87.63,
            "width": 83.0,
            "text": "Sonuç olarak Can; üstün yetenekleri, tükenmeyen merakı ve yılmayan çabasıyla hem mimarlık mesleğine"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 90.26,
            "width": 83.0,
            "text": "yeni bir soluk getirecek hem de hayallerini gerçeğe dönüştürerek büyük başarılara imza atacaktır."
          }
        ]
      }
    ],
    "53": [
      {
        "id": "p53_etk2_a",
        "title": "2. Etkinlik A: Kaoru İkeya'nın Dikkat Çeken Söz ve Davranışları",
        "button": {
          "left": 6.5,
          "top": 39.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 48.33,
            "width": 79.0,
            "text": "Kaoru İkeya'nın en dikkat çeken davranışı, gündüzleri fabrikada yorulmasına rağmen"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 51.15,
            "width": 79.0,
            "text": "geceleri uykusundan fedakârlık ederek sabaha kadar gökyüzünü gözlemlemesidir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 53.78,
            "width": 79.0,
            "text": "Maddi imkânsızlıklar nedeniyle hazır teleskop alamayınca kendi teleskobunu yapabilmek için"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 56.35,
            "width": 79.0,
            "text": "aylarca büyük bir sabırla cam ve ayna taşlamış, el emeğiyle aynasını pürüzsüzleştirmiştir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 58.91,
            "width": 79.0,
            "text": "Ayrıca Minoru Honda'nın öğütlerini rehber edinip ona saygı ve hürmetle mektup yazmış,"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 61.47,
            "width": 79.0,
            "text": "\"Gökyüzü sabredenleri er ya da geç ödüllendirir.\" inancıyla hedefine sımsıkı sarılmıştır."
          }
        ]
      },
      {
        "id": "p53_etk2_b",
        "title": "2. Etkinlik B: Kaoru İkeya'nın Kişilik Özellikleri ve Gerekçeleri",
        "button": {
          "left": 6.5,
          "top": 68.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 75.26,
            "width": 79.0,
            "text": "Kaoru İkeya; son derece azimli, sabırlı, çalışkan, meraklı ve sorumluluk sahibi biridir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 78.08,
            "width": 79.0,
            "text": "Ailesi ekonomik sıkıntı yaşayınca fabrikada çalışarak sorumluluk bilincini göstermiştir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 80.64,
            "width": 79.0,
            "text": "Gündüz yorulmasına karşın geceleri teleskop yapıp göğü incelemesi azmini ve tutkusunu kanıtlar."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 83.21,
            "width": 79.0,
            "text": "Kendi imkânlarıyla aylarca ayna yontup teleskop üretmesi üretken ve sabırlı yapısını yansıtır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 85.83,
            "width": 79.0,
            "text": "Usta bir gök bilimciden tavsiye isteyip pes etmeden göğü taraması ise öğrenme hevesini ve"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 88.4,
            "width": 79.0,
            "text": "hayallerine olan sarsılmaz inancını açıkça ortaya koymaktadır."
          }
        ]
      }
    ],
    "54": [
      {
        "id": "p54_etk3_a",
        "title": "3. Etkinlik A: Karakterlerin Karşılaştırmalı Tablosu",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 12.0,
            "top": 25.4,
            "width": 28.5,
            "text": "Genç yaşta ağır bir trafik kazası"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 27.6,
            "width": 28.5,
            "text": "geçirerek omurilik felci olmuş,"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 29.8,
            "width": 28.5,
            "text": "tekerlekli sandalyeye mahkûm kalmıştır."
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 25.4,
            "width": 28.5,
            "text": "Babasının işi iflas etmiş, maddi"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 27.6,
            "width": 28.5,
            "text": "yokluktan hazır teleskop alamamış,"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 29.8,
            "width": 28.5,
            "text": "fabrikada ağır işlerde çalışmıştır."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 34.8,
            "width": 28.5,
            "text": "Asla hayata küsmemiş, azimle"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 37.0,
            "width": 28.5,
            "text": "okçuluğa başlamış ve dünya"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 39.2,
            "width": 28.5,
            "text": "şampiyonluğunu hedeflemiştir."
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 34.8,
            "width": 28.5,
            "text": "İmkânsızlıklara boyun eğmeyip"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 37.0,
            "width": 28.5,
            "text": "kendi teleskobunu el emeğiyle"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 39.2,
            "width": 28.5,
            "text": "aylarca taşlayarak üretmiştir."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 44.2,
            "width": 28.5,
            "text": "Paralimpik okçulukta dünya"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 46.4,
            "width": 28.5,
            "text": "rekoru kırarak dünya ve Avrupa"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 48.6,
            "width": 28.5,
            "text": "şampiyonu olmayı başarmıştır."
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 44.2,
            "width": 28.5,
            "text": "Kendi ürettiği teleskopla yeni"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 46.4,
            "width": 28.5,
            "text": "kuyruklu yıldızlar keşfetmiş ve"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 48.6,
            "width": 28.5,
            "text": "adını gök bilimine yazdırmıştır."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 53.6,
            "width": 28.5,
            "text": "Yenilmez bir irade, hedef odaklılık,"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 55.8,
            "width": 28.5,
            "text": "düzenli disiplin ve engelleri"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 58.0,
            "width": 28.5,
            "text": "fırsata dönüştürme kararlılığı."
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 53.6,
            "width": 28.5,
            "text": "Tükenmeyen bilim tutkusu, sabır,"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 55.8,
            "width": 28.5,
            "text": "merak, el becerisi ve uykusundan"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 58.0,
            "width": 28.5,
            "text": "fedakârlık etme gayreti."
          }
        ]
      },
      {
        "id": "p54_etk3_b",
        "title": "3. Etkinlik B: Benzerlikler ve Farklılıklar",
        "button": {
          "left": 6.5,
          "top": 64.0
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 76.8,
            "width": 37.0,
            "text": "• İkisi de zorluklara teslim olmadı."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 79.8,
            "width": 37.0,
            "text": "• Hedefleri için fedakârlık yaptılar."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 82.8,
            "width": 37.0,
            "text": "• Karşılaştıkları engelleri aştılar."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 85.8,
            "width": 37.0,
            "text": "• Alanlarında büyük başarı kazandılar."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 88.8,
            "width": 37.0,
            "text": "• Gençlere ilham veren birer örnektir."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 76.8,
            "width": 37.0,
            "text": "• Yiğit bedensel engeli aşıp spora yöneldi."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 79.8,
            "width": 37.0,
            "text": "• Kaoru maddi yokluğu aşıp bilime yöneldi."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 82.8,
            "width": 37.0,
            "text": "• Yiğit rehabilitasyon için okçuluğu seçti."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 85.8,
            "width": 37.0,
            "text": "• Kaoru çocukluk tutkusu olan göğü seçti."
          },
          {
            "type": "lines",
            "left": 53.5,
            "top": 88.8,
            "width": 37.0,
            "text": "• Kaoru teleskobunu kendi eliyle yaptı."
          }
        ]
      }
    ],
    "55": [
      {
        "id": "p55_etk4",
        "title": "4. Etkinlik A: Öyküleyici Metin Bölüm Ölçütleri",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 9.0,
            "top": 29.49,
            "width": 39.0,
            "text": "1. Olayın yeri ve zamanı belirtilmeli,"
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 32.82,
            "width": 39.0,
            "text": "   mekân duygusu hissettirilmelidir."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 36.09,
            "width": 39.0,
            "text": "2. Karakterler belirgin yönleriyle"
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 39.29,
            "width": 39.0,
            "text": "   okuyucuya tanıtılmalıdır."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 42.56,
            "width": 39.0,
            "text": "3. Merak uyandıracak temel olayla"
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 45.83,
            "width": 39.0,
            "text": "   kurgu ve anlatım başlatılmalıdır."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 49.1,
            "width": 39.0,
            "text": "4. Anlatım sade ve akıcı olmalıdır."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 29.49,
            "width": 39.0,
            "text": "1. Olaylar merak unsuru etrafında"
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 32.82,
            "width": 39.0,
            "text": "   gelişmeli ve yoğunlaşmalıdır."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 36.09,
            "width": 39.0,
            "text": "2. Kahramanların engelleri ve"
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 39.29,
            "width": 39.0,
            "text": "   mücadeleleri anlatılmalıdır."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 42.56,
            "width": 39.0,
            "text": "3. Merak düzeyi en üst seviyeye"
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 45.83,
            "width": 39.0,
            "text": "   (doruk noktasına) ulaşmalıdır."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 49.1,
            "width": 39.0,
            "text": "4. Mantık hataları bulunmamalıdır."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 68.53,
            "width": 39.0,
            "text": "1. Çatışmalar ve merak unsurları"
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 71.79,
            "width": 39.0,
            "text": "   mantıklı sonuca bağlanmalıdır."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 75.0,
            "width": 39.0,
            "text": "2. Kahramanların akıbeti netleşmeli,"
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 78.27,
            "width": 39.0,
            "text": "   soru işareti kalmamalıdır."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 81.54,
            "width": 39.0,
            "text": "3. Metnin ana fikri veya mesajı"
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 84.81,
            "width": 39.0,
            "text": "   etkili dille hissettirilmelidir."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 88.01,
            "width": 39.0,
            "text": "4. Kapanış etkileyici olmalıdır."
          }
        ]
      }
    ],
    "56": [
      {
        "id": "p56_etk5",
        "title": "5. Etkinlik: Ali Kuşçu Dinleme Metni Boşluk Doldurma",

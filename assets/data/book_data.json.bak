    "30": [
      {
        "id": "p30_3_a",
        "title": "3. Etkinlik (a)",
        "button": {
          "left": 5.2,
          "top": 12.8
        },
        "items": [
          {
            "type": "badge",
            "left": 16.0,
            "top": 16.8,
            "width": 25.6,
            "height": 2.8,
            "text": "Çözüm Odaklı ve Azimli"
          },
          {
            "type": "lines",
            "left": 16.2,
            "top": 19.8,
            "width": 71.2,
            "height": 5.2,
            "text": "Top patladığında pes etmek yerine \"Bir sorun varsa bir çözüm de vardır.\" diyerek oyunu sürdürecek bir çare aramıştır."
          },
          {
            "type": "badge",
            "left": 16.0,
            "top": 24.5,
            "width": 25.6,
            "height": 2.8,
            "text": "Yaratıcı ve Üretken"
          },
          {
            "type": "lines",
            "left": 16.2,
            "top": 27.5,
            "width": 71.2,
            "height": 5.2,
            "text": "Top olmadan da basketbol oynanabileceği fikrini bulup çantasından hayalî bir top çıkararak oyunu başlatmıştır."
          },
          {
            "type": "badge",
            "left": 16.0,
            "top": 31.9,
            "width": 25.6,
            "height": 2.8,
            "text": "Lider Ruhlu ve Birleştirici"
          },
          {
            "type": "lines",
            "left": 16.2,
            "top": 34.9,
            "width": 71.2,
            "height": 5.2,
            "text": "Sahanın ortasına geçip şaşkınlık yaşayan arkadaşlarını yönlendirmiş; Mete numara yaptığında oyunu canlı tutmuştur."
          }
        ]
      },
      {
        "id": "p30_3_b",
        "title": "3. Etkinlik (b)",
        "button": {
          "left": 5.2,
          "top": 43.4
        },
        "items": [
          {
            "type": "box",
            "left": 15.8,
            "top": 50.1,
            "width": 71.2,
            "height": 13.2,
            "text": "Bir sorunla karşılaştığımızda hemen pes etmemeli ve paniğe kapılmamalıyız. Moni gibi sorunları bir engel değil, yeni bir öğrenme ve deneme fırsatı olarak görmeliyiz. Şikâyet etmek yerine \"Ne yapabilirim?\" diyerek aklımızı ve hayal gücümüzü kullanmalı, kararlılıkla alternatif bir çözüm yolu üretmeliyiz."
          }
        ]
      }
    ],
    "31": [
      {
        "id": "p31_4_b",
        "title": "4. Etkinlik (b & c)",
        "button": {
          "left": 5.2,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.0,
            "top": 21.8,
            "width": 32.0,
            "height": 4.5,
            "text": "Topun patlaması üzerine oyunun birden durması."
          },
          {
            "type": "lines",
            "left": 14.0,
            "top": 29.2,
            "width": 32.0,
            "height": 4.5,
            "text": "Moni'nin arkadaşlarına moral verip çözüm araması."
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 21.8,
            "width": 32.0,
            "height": 4.5,
            "text": "Moni'nin çantasından hayalî bir basketbol topu çıkarması."
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 29.2,
            "width": 32.0,
            "height": 4.5,
            "text": "Mete'nin hayalî topu göbeğinde sektirerek sayı atması."
          },
          {
            "type": "mark",
            "left": 36.5,
            "top": 39.0,
            "width": 3.2,
            "height": 2.2,
            "text": "✓"
          }
        ]
      },
      {
        "id": "p31_5_a",
        "title": "5. Etkinlik (a)",
        "button": {
          "left": 5.2,
          "top": 54.2
        },
        "items": [
          {
            "type": "lines",
            "left": 7.5,
            "top": 59.5,
            "width": 28.5,
            "height": 5.2,
            "text": "Bilgisayar oyununun birden durması ve ekranın kilitlenmesi."
          },
          {
            "type": "lines",
            "left": 62.0,
            "top": 59.5,
            "width": 26.5,
            "height": 5.2,
            "text": "Basketbol topunun patlaması ve maçın yarıda kalması."
          },
          {
            "type": "lines",
            "left": 7.5,
            "top": 68.2,
            "width": 28.5,
            "height": 5.2,
            "text": "Şaşırmış, öfkelenmiş ve oyunun yarıda kalmasına üzülmüştür."
          },
          {
            "type": "lines",
            "left": 62.0,
            "top": 68.2,
            "width": 26.5,
            "height": 5.2,
            "text": "Pes etmeyip gülümsemiş, arkadaşlarına moral vermiştir."
          },
          {
            "type": "lines",
            "left": 7.5,
            "top": 76.5,
            "width": 28.5,
            "height": 6.5,
            "text": "Ahtapot'un mektubundaki görevi yapıp sahilde deniz kabuğu toplayarak çözdü."
          },
          {
            "type": "lines",
            "left": 62.0,
            "top": 76.5,
            "width": 26.5,
            "height": 6.5,
            "text": "Moni tarafından hayalî bir topla yeni oyun başlatılarak çözüldü."
          }
        ]
      }
    ],

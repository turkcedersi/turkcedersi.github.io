            "type": "lines",
            "left": 11.0,
            "top": 58.08,
            "width": 77.0,
            "text": "Engelli çocuklara yönelik içerikte özel bakım ve erişilebilirlik ihtiyacı öne çıkmaktadır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 62.95,
            "width": 77.0,
            "text": "Farklılıklarımıza rağmen hepimizin aynı saygı ve sevgiye layık olduğu vurgulanmaktadır."
          }
        ]
      }
    ],
    "146": [
      {
        "id": "p146_yazma",
        "title": "12. Etkinlik: Çocuk Hakları Bilgilendirici Metin",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 38.85,
            "width": 78.0,
            "text": "Başlık: Yarının Umudu Çocuklar ve Hakları"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 41.41,
            "width": 78.0,
            "text": "Dünya, çocukların saf tebessümleri ve neşeli sesleriyle güzelleşen ortak bir yuvadır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 43.97,
            "width": 78.0,
            "text": "Bir toplumun medeniyet seviyesi, çocuklarına sağladığı haklar ve güvenle ölçülür."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 46.54,
            "width": 78.0,
            "text": "Her çocuğun temiz bir çevrede yaşama, kaliteli eğitim alma ve oyun oynama hakkı kutsaldır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 49.17,
            "width": 78.0,
            "text": "Savaşlardan, şiddetten ve yoksulluktan çocukları korumak tüm insanlığın ortak vazifesidir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 51.73,
            "width": 78.0,
            "text": "Eğitimden mahrum kalan tek bir çocuk bile yarının kararan bir yıldızı demektir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 54.29,
            "width": 78.0,
            "text": "Bu nedenle Çocuk Hakları Sözleşmesi'nin ilkeleri hayata eksiksiz geçirilmelidir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 56.86,
            "width": 78.0,
            "text": "Sonuç olarak çocuklarına değer veren milletler aydınlık ve huzurlu bir geleceğe yürür."
          }
        ]
      }
    ],
    "150": [
      {
        "id": "p150_etk1",
        "title": "1. Etkinlik: Anahtar Kelimeler ve Anlamı",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "badge",
            "left": 23.0,
            "top": 45.0,
            "width": 10.0,
            "text": "kral"
          },
          {
            "type": "badge",
            "left": 36.0,
            "top": 45.0,
            "width": 10.0,
            "text": "keşiş"
          },
          {
            "type": "badge",
            "left": 49.0,
            "top": 45.0,
            "width": 10.0,
            "text": "kürek"
          },
          {
            "type": "badge",
            "left": 62.0,
            "top": 45.0,
            "width": 10.0,
            "text": "toprak"
          },
          {
            "type": "badge",
            "left": 75.0,
            "top": 45.0,
            "width": 10.0,
            "text": "zaman"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 52.95,
            "width": 77.0,
            "text": "Seçilen anahtar kelimeler, metnin olay örgüsünü ve ana fikrini doğrudan yansıtır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 55.51,
            "width": 77.0,
            "text": "Kralın arayışı, keşişin bilgeliği ve toprağı belleyerek yaşayarak öğrenme süreci"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 58.08,
            "width": 77.0,
            "text": "en doğru zamanın 'şu an', en önemli kişinin 'yanımızdaki' olduğunu kavramasını sağlamıştır."
          }
        ]
      }
    ],
    "151": [
      {
        "id": "p151_etk3",
        "title": "3. Etkinlik: Önemli Bilgiler ve Sebep-Sonuç İlişkileri",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 48.33,
            "width": 78.0,
            "text": "• Temiz bir çevre sağlıklı bir yaşamın vazgeçilmez şartıdır; doğayı korumak ortak görevdir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 50.9,
            "width": 78.0,
            "text": "• Yaşlılara ve çocuklara hürmet gösterilmeli, zayıfların hakkı korunmalıdır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 53.46,
            "width": 78.0,
            "text": "• Haklarımız kadar sorumluluklarımızın da bilincinde olmak toplumsal huzuru temin eder."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 75.06,
            "width": 78.0,
            "text": "Sebep: Bireylerin çevre kurallarına ve canlılara saygı duyması,"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 79.74,
            "width": 78.0,
            "text": "Sonuç: Toplumda barış, güven ve huzur ortamının kökleşmesini sağlar."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 82.31,
            "width": 78.0,
            "text": "Sebep: Trafik ve ortak yaşam kurallarına titizlikle uyulması,"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 84.94,
            "width": 78.0,
            "text": "Sonuç: Olası kazaları ve kargaşayı önleyerek güvenli bir yaşam ortamı oluşturur."
          }
        ]
      }
    ],
    "152": [
      {
        "id": "p152_etk4",
        "title": "4. Etkinlik: Kamu Denetçiliği Afiş İncelemesi",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 69.29,
            "width": 78.0,
            "text": "Evet, afişteki görseller kurumun çocuklara yönelik hak arama desteğini net biçimde yansıtır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 71.86,
            "width": 78.0,
            "text": "Resimler ve karikatürler çocukların kuruma güvenle başvurabileceğini hissettirmektedir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 80.58,
            "width": 78.0,
            "text": "Görseller ve metinler tam bir uyum içindedir; sade ve anlaşılır bir dil kullanılmıştır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 83.14,
            "width": 78.0,
            "text": "Afiş hak bilincini güçlendirici ve yol gösterici bir rehber niteliğindedir."
          }
        ]
      }
    ],
    "153": [
      {
        "id": "p153_etk5",
        "title": "5. Etkinlik: Temel Sorun ve Çözüm Önerileri",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 23.72,
            "width": 78.0,
            "text": "Kralın her işte en doğru zamanı, en önemli kişiyi ve en doğru eylemi bilememesi."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 40.32,
            "width": 78.0,
            "text": "Kral, hatasız bir hükümdarlık için üç temel soruya yanıt aramış fakat bilgeler"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 42.88,
            "width": 78.0,
            "text": "birbirinden farklı cevaplar vererek kralın kafasını daha da karıştırmıştır."
          },
          {
            "type": "mark",
            "left": 14.5,
            "top": 64.2,
            "width": 2.2,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 64.23,
            "width": 70.0,
            "text": "Soruların cevabını teorik bilgelikte değil, yaşayarak ve bizzat tecrübe ederek aramak."
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 66.79,
            "width": 70.0,
            "text": "Keşişin yanında toprağı belleyip yaralı adama yardım ederek en doğru çözüme ulaşmıştır."
          }
        ]
      }
    ],

          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 76.8,
            "width": 30.0,
            "height": 2.4,
            "text": "Sevgi ve saygı esastır."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 79.4,
            "width": 30.0,
            "height": 2.4,
            "text": "Bayram sevinci paylaşılır."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 82.0,
            "width": 30.0,
            "height": 2.4,
            "text": "Güzel dileklerde bulunulur."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 84.6,
            "width": 30.0,
            "height": 2.4,
            "text": "Güler yüzle ve tatlı dille konuşulur."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 87.2,
            "width": 30.0,
            "height": 2.4,
            "text": "İçten ve samimi davranılır."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 89.8,
            "width": 30.0,
            "height": 2.4,
            "text": "Birlik ve beraberlik yaşatılır."
          },
          {
            "type": "lines",
            "left": 58.0,
            "top": 76.8,
            "width": 30.0,
            "height": 2.4,
            "text": "Büyüklere daha saygılı konuşulur."
          },
          {
            "type": "lines",
            "left": 58.0,
            "top": 79.4,
            "width": 30.0,
            "height": 2.4,
            "text": "Akranlarla serbestçe şakalar yapılır."
          },
          {
            "type": "lines",
            "left": 58.0,
            "top": 82.0,
            "width": 30.0,
            "height": 2.4,
            "text": "Büyüklerin eli öpülüp hayır duası alınır."
          },
          {
            "type": "lines",
            "left": 58.0,
            "top": 84.6,
            "width": 30.0,
            "height": 2.4,
            "text": "Akranlarla oyun ve eğlence konuşulur."
          },
          {
            "type": "lines",
            "left": 58.0,
            "top": 87.2,
            "width": 30.0,
            "height": 2.4,
            "text": "Büyüklere 'amca, teyze' diye hitap edilir."
          },
          {
            "type": "lines",
            "left": 58.0,
            "top": 89.8,
            "width": 30.0,
            "height": 2.4,
            "text": "Büyüklerin anlattığı öğütler dinlenir."
          }
        ]
      }
    ],

            "type": "lines",
            "left": 16.5,
            "top": 50.8,
            "width": 68.0,
            "height": 2.2,
            "text": "Tahminimiz doğru çıktı; bezirgân ile bülbül arasında bir bağ"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 53.0,
            "width": 68.0,
            "height": 2.2,
            "text": "kuruldu ancak bezirgân kuşa zarar vermek için değil,"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 55.2,
            "width": 68.0,
            "height": 2.2,
            "text": "yaralı kanadını tedavi edip iyileştirmek için kuşu"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 57.4,
            "width": 68.0,
            "height": 2.2,
            "text": "yanına almış ve ona büyük bir şefkat göstermişti."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 64.0,
            "width": 68.0,
            "height": 2.2,
            "text": "Anne bülbülün telaşlanıp yavrusunun peşine düşeceği"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 66.2,
            "width": 68.0,
            "height": 2.2,
            "text": "tahminim metindeki olaylarla tam olarak doğrulandı."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 68.4,
            "width": 68.0,
            "height": 2.2,
            "text": "Bir annenin yavrusunu tehlikede bırakamayacağı gerekçem"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 70.6,
            "width": 68.0,
            "height": 2.2,
            "text": "hikâyenin olay örgüsüyle bütünüyle uyumlu çıktı."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 77.2,
            "width": 68.0,
            "height": 2.2,
            "text": "Bezirgânın iyi niyetli çıkması ve bülbülü iyileştirmesi"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 79.5,
            "width": 68.0,
            "height": 2.2,
            "text": "güzel bir sürpriz oldu; masal mutlu sonla bitti"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 81.8,
            "width": 68.0,
            "height": 2.2,
            "text": "ve 'aç kapıyı bezirgânbaşı' oyunu bu samimi dostluktan"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 84.1,
            "width": 68.0,
            "height": 2.2,
            "text": "doğarak günümüze kadar ulaştı."
          }
        ]
      }
    ],
    "23": [
      {
        "id": "p23_kanguru_tahmin",
        "title": "Tahminlerimiz ve Gerekçelerimiz",
        "button": {
          "left": 5.2,
          "top": 33.0
        },
        "items": [
          {
            "type": "lines",
            "left": 16.5,
            "top": 34.2,
            "width": 68.0,
            "height": 2.3,
            "text": "Tahmin: Metinde görme engelli ya da farklı bir özelliği"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 36.6,
            "width": 68.0,
            "height": 2.3,
            "text": "olan bir kangurunun hikâyesi anlatılacaktır."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 39.0,
            "width": 68.0,
            "height": 2.3,
            "text": "Gerekçe: 'Parmak Uçlarındaki Dünya' başlığı dokunarak dünyayı"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 41.4,
            "width": 68.0,
            "height": 2.3,
            "text": "algılamayı ve hissetmeyi çağrıştırmaktadır."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 59.0,
            "width": 68.0,
            "height": 2.3,
            "text": "Tahmin: Kangurunun arkadaşlarıyla oynarken görme engelinden"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 61.4,
            "width": 68.0,
            "height": 2.3,
            "text": "dolayı bazı oyunlarda zorlanacağını tahmin ediyorum."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 63.8,
            "width": 68.0,
            "height": 2.3,
            "text": "Gerekçe: Çünkü görme engeli hareketli ve hızlı oyunlarda"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 66.2,
            "width": 68.0,
            "height": 2.3,
            "text": "ekstra dikkat ve farklı duyular gerektirir."
          }
        ]
      }
    ],
    "24": [
      {
        "id": "p24_kanguru_tahmin2",
        "title": "2 Numaralı Yerdeki Tahminlerim",
        "button": {
          "left": 43.5,
          "top": 52.0
        },
        "items": [
          {
            "type": "lines",
            "left": 48.5,
            "top": 54.0,
            "width": 38.5,
            "height": 2.2,
            "text": "Tahmin: Dokunmaya dayalı bu yarışmayı"
          },
          {
            "type": "lines",
            "left": 48.5,
            "top": 56.5,
            "width": 38.5,
            "height": 2.2,
            "text": "minik kanguru başarıyla kazanacaktır."
          },
          {
            "type": "lines",
            "left": 48.5,
            "top": 65.5,
            "width": 38.5,
            "height": 2.2,
            "text": "Gerekçe: Dünyayı dokunarak tanıdığı için"
          },
          {
            "type": "lines",
            "left": 48.5,
            "top": 68.0,
            "width": 38.5,
            "height": 2.2,
            "text": "nesneleri ayırt etmede çok ustadır."
          }
        ]
      }
    ],
    "25": [
      {
        "id": "p25_kanguru_degerlendirme",
        "title": "Tahminlerimi Değerlendiriyorum",
        "button": {
          "left": 5.2,
          "top": 19.5
        },
        "items": [
          {
            "type": "lines",
            "left": 16.5,
            "top": 23.5,
            "width": 68.0,
            "height": 5.2,
            "text": "Tahminim doğru çıktı; minik kangurunun görme engelli olduğu ve dünyayı dokunarak tanıdığı anlatıldı."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 36.5,
            "width": 68.0,
            "height": 5.2,
            "text": "Kangurunun seksek oyununda zorlandığı ancak arkadaşlarının onu dışlamayıp birlikte oyun kurdukları görüldü."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 47.2,
            "width": 68.0,
            "height": 5.2,
            "text": "'Bil Bakalım Bu Ne?' yarışmasında kanguru nesneleri dokunarak tanımış ve yarışmayı birinci bitirmiştir."
          }
        ]
      }
    ],

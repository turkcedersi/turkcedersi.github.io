    "165": [
      {
        "id": "p165_kitap_vakti",
        "title": "Kitap Vakti: Kitap İnceleme Formu",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 18.0,
            "top": 15.6,
            "width": 45.0,
            "text": "Siyah İnci"
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 18.2,
            "width": 40.0,
            "text": "Anna Sewell"
          },
          {
            "type": "lines",
            "left": 70.0,
            "top": 18.2,
            "width": 15.0,
            "text": "184"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 20.8,
            "width": 70.0,
            "text": "Bir atın gözünden hayvan sevgisi, adalet ve insanların hayvanlara muamelesi."
          },
          {
            "type": "lines",
            "left": 23.0,
            "top": 23.5,
            "width": 65.0,
            "text": "Siyah İnci, Ginger, Merrylegs, Bay Gordon, John Manly."
          },
          {
            "type": "lines",
            "left": 23.0,
            "top": 26.2,
            "width": 65.0,
            "text": "Siyah İnci sabırlı, asil ve sadık bir attır; insanlara daima güvenmek ister."
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 29.0,
            "width": 30.0,
            "text": "İngiltere kırsalı ve çiftlikler"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 29.0,
            "width": 30.0,
            "text": "19. yüzyıl"
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 31.7,
            "width": 30.0,
            "text": "1. tekil kişi (Siyah İnci)"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 37.0,
            "width": 76.0,
            "text": "Olayların bir hayvanın iç dünyasından samimiyetle ve ders verici şekilde anlatılması."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 42.0,
            "width": 76.0,
            "text": "Sawyer gibi kötü niyetli karakterlerin daha çabuk adalet önüne çıkarılmasını isterdim."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 49.0,
            "width": 76.0,
            "text": "Siyah İnci, güzel bir çiftlikte sevgiyle büyütülür ancak sahipleri değiştikçe"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 52.5,
            "width": 76.0,
            "text": "zorlu işlerde çalıştırılır ve çeşitli haksızlıklara maruz kalır."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 56.0,
            "width": 76.0,
            "text": "Sonunda tekrar merhametli ellere kavuşarak huzurlu bir yaşama adım atar."
          }
        ]
      }
    ],
    "166": [
      {
        "id": "p166_film_vakti",
        "title": "Film Vakti: Film İnceleme Formu",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 17.0,
            "top": 15.6,
            "width": 45.0,
            "text": "Küçük Prens"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 18.2,
            "width": 30.0,
            "text": "Animasyon / Macera"
          },
          {
            "type": "lines",
            "left": 75.0,
            "top": 18.2,
            "width": 12.0,
            "text": "108 dk"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 20.8,
            "width": 70.0,
            "text": "Bir çocuğun büyüme baskısına karşı hayal gücünü ve dostluğu keşfetmesi."
          },
          {
            "type": "lines",
            "left": 23.0,
            "top": 23.5,
            "width": 65.0,
            "text": "Küçük Prens, Küçük Kız, Havacı Dede, Tilki, Gül."
          },
          {
            "type": "lines",
            "left": 23.0,
            "top": 26.2,
            "width": 65.0,
            "text": "Küçük Kız meraklı ve çalışkan; Havacı sevecen ve hayalperest biridir."
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 29.0,
            "width": 30.0,
            "text": "Şehir ve masalsı gezegenler"
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 29.0,
            "width": 30.0,
            "text": "Günümüz"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 35.0,
            "width": 76.0,
            "text": "Dostluğun ve çocukluk masumiyetinin görsel bir şölenle aktarılmasını çok beğendim."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 40.0,
            "width": 76.0,
            "text": "Yetişkinlerin tekdüze dünyasının çocuklara dayatılmasının eleştirisi son derece etkilidir."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 47.0,
            "width": 76.0,
            "text": "Annesi tarafından katı bir plana göre yetiştirilen Küçük Kız, yaşlı komşusu"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 50.5,
            "width": 76.0,
            "text": "Havacı ile tanışır ve Küçük Prens'in masalsı evrenini keşfederek özgürleşir."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 54.0,
            "width": 76.0,
            "text": "Gerçek değerlerin sadece gözle değil, kalple görülebileceğini öğrenir."
          }
        ]
      }
    ]
  }
}
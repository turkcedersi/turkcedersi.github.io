          },
          {
            "type": "mark",
            "left": 38.5,
            "top": 52.56,
            "width": 3.0,
            "text": "✓"
          },
          {
            "type": "mark",
            "left": 35.0,
            "top": 63.46,
            "width": 3.0,
            "text": "✓"
          }
        ]
      },
      {
        "id": "p157_etk3_b",
        "title": "3. Etkinlik B: Değerlerin Şiirdeki Dizeleri",
        "button": {
          "left": 6.0,
          "top": 71.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 75.51,
            "width": 79.0,
            "text": "İyilik değeri: \"Elinden geldikçe iyilik eyle / Sen iyilik eyle, o zâyi olmaz\""
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 78.14,
            "width": 79.0,
            "text": "Alçak gönüllülük: \"Alçaklarda otur, gözet kendini / Katı yükseklerden uçucu olma\""
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 80.71,
            "width": 79.0,
            "text": "Vefa ve edep: \"El âriftir yoklar senin bendini / Seni bir mecliste hacil düşürür\""
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 83.27,
            "width": 79.0,
            "text": "Kötülerden uzak durma: \"Kötülerle konup göçücü olma / Hatırdan, gönülden geçici olma\""
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 85.9,
            "width": 79.0,
            "text": "Tatlı dil ve ölçülü konuşma: \"El iki söylerse sen birin söyle / Mecliste ârif ol\""
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 88.46,
            "width": 79.0,
            "text": "Şair, insanın erdemli ve saygın kalmasını en yüce ahlaki ilke olarak öğütlemiştir."
          }
        ]
      }
    ],

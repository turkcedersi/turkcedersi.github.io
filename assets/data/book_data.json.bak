          "left": 5.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 24.5,
            "top": 24.3,
            "width": 33.5,
            "height": 2.8,
            "text": "Mizah, hazırcevaplık ve nükte yoluyla düşündürmek"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 24.3,
            "width": 33.5,
            "height": 2.8,
            "text": "Kahramanlık, yiğitlik, cesaret ve töre bilinci"
          },
          {
            "type": "lines",
            "left": 24.5,
            "top": 30.0,
            "width": 33.5,
            "height": 2.8,
            "text": "Halktan sıradan insanlar, komşular, kadı, köylüler"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 30.0,
            "width": 33.5,
            "height": 2.8,
            "text": "Beyler, yiğitler, hanlar, hatunlar ve alp erenler"
          },
          {
            "type": "lines",
            "left": 24.5,
            "top": 35.6,
            "width": 33.5,
            "height": 2.8,
            "text": "Günlük yaşam, komşuluk ilişkileri, insan zaafları"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 35.6,
            "width": 33.5,
            "height": 2.8,
            "text": "Birlik beraberlik, yurt savunması, fedakârlık ve erdem"
          },
          {
            "type": "lines",
            "left": 24.5,
            "top": 41.4,
            "width": 33.5,
            "height": 2.8,
            "text": "Kısa fıkra, mensur (düzyazı) ve nükteli anlatım"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 41.4,
            "width": 33.5,
            "height": 2.8,
            "text": "Nazım ve nesir karışık destansı hikâye anlatımı"
          },
          {
            "type": "lines",
            "left": 24.5,
            "top": 47.1,
            "width": 33.5,
            "height": 2.8,
            "text": "Akşehir, Konya ve Anadolu coğrafyası"
          },
          {
            "type": "lines",
            "left": 59.5,
            "top": 47.1,
            "width": 33.5,
            "height": 2.8,
            "text": "Oğuz boylarının yaşadığı Orta Asya ve Kafkaslar"
          }
        ]
      }
    ],

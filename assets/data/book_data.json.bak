      },
      {
        "id": "p78_etk3_b",
        "title": "3. Etkinlik B: Metinde Verilmek İstenen Mesaj",
        "button": {
          "left": 6.5,
          "top": 69.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 75.9,
            "width": 78.0,
            "text": "Vatan ve bağımsızlık sevgisi, bir insan için her türlü maddi varlıktan ve can güvenliğinden"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 78.46,
            "width": 78.0,
            "text": "daha üstündür. Hatice Nine'nin beş defa evi yanmasına ve büyük acılar çekmesine rağmen tek"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 81.03,
            "width": 78.0,
            "text": "gayesi Türk bayrağının dalgalandığı topraklarda özgürce yaşamak ve ölünce bu topraklara"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 83.59,
            "width": 78.0,
            "text": "gömülmektir. Kendi bayrağımızın gölgesinde olmak, insana en zor koşullarda bile tükenmeyen bir"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 86.15,
            "width": 78.0,
            "text": "yaşama sevinci, huzur ve milli onur kazandırır."
          }
        ]
      }
    ],
    "79": [
      {
        "id": "p79_etk4",
        "title": "4. Etkinlik: Metni Özetleme",
        "button": {
          "left": 6.5,
          "top": 10.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 21.54,
            "width": 78.0,
            "text": "Yazar, Salihli'nin işgalden kurtulduğu zafer günlerinde halkın büyük sevincini anlatır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 24.1,
            "width": 78.0,
            "text": "Yangından çıkan Hatice Nine, yüzünde derin bir huzurla yazarın boynuna sarılır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 26.67,
            "width": 78.0,
            "text": "Üsküp'ten beri beş defa evi yanan nine, yabancı bayraklardan Türk bayrağına kaçmıştır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 29.23,
            "width": 78.0,
            "text": "Oğluyla her zorluğa göğüs gererek Salihli'ye, kahraman Türk ordusunun yanına ulaşmıştır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 31.79,
            "width": 78.0,
            "text": "Hayattaki tek gayesi, son nefesini bağımsız ve hür Türk bayrağının gölgesinde vermektir."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 34.36,
            "width": 78.0,
            "text": "Öldüğünde naaşının düşman çizmesi altında değil, kutsal vatan toprağında kalmasını ister."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 36.92,
            "width": 78.0,
            "text": "Metin; vatan, bayrak ve bağımsızlık aşkının her zorluğu yenecek güçte olduğunu özetler."
          }
        ]
      },
      {
        "id": "p79_etk5_a",
        "title": "5. Etkinlik A: Sakarya Zaferi Düşünceyi Geliştirme Yolları",

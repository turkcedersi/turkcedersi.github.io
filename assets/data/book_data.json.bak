    "101": [
      {
        "id": "p101_etk1",
        "title": "1. Etkinlik: Şiirdeki Kelimeler ve Cümleler",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 50.0,
            "top": 23.59,
            "width": 30.0,
            "text": "Gelişmek, büyümek, boy atmak."
          },
          {
            "type": "lines",
            "left": 50.0,
            "top": 28.4,
            "width": 30.0,
            "text": "Büyüyüp gelişmek, serpilip güçlenmek."
          },
          {
            "type": "lines",
            "left": 50.0,
            "top": 33.53,
            "width": 30.0,
            "text": "Kor ateşi, sıcak kül."
          },
          {
            "type": "lines",
            "left": 50.0,
            "top": 38.33,
            "width": 30.0,
            "text": "Yanarak kor hâline gelmiş odun parçası."
          },
          {
            "type": "lines",
            "left": 50.0,
            "top": 43.46,
            "width": 30.0,
            "text": "Çok ısınmak, yanıp tutuşmak."
          },
          {
            "type": "lines",
            "left": 50.0,
            "top": 48.27,
            "width": 30.0,
            "text": "Ateşte rengi dönene kadar yanmak; mecazen acı çekmek."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 62.37,
            "width": 76.0,
            "text": "1. Dedemin sandığından çıkan eski cüzleri büyük bir merakla inceledik."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 64.94,
            "width": 76.0,
            "text": "2. Bahçedeki fidanlar bahar yağmurlarıyla birlikte günbegün serpildi."
          }
        ]
      }
    ],

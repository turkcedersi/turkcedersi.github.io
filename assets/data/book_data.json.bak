    "76": [
      {
        "id": "p76_1_a",
        "title": "1. Etkinlik (a)",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 16.8,
            "width": 71.0,
            "height": 3.0,
            "text": "Tahmin: Tiyatronun Millî Mücadele yıllarını, Atatürk'ün Ankara'ya gelişini ve"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 19.4,
            "width": 71.0,
            "height": 3.0,
            "text": "halkımızın bağımsızlık azmiyle Cumhuriyete giden yolu anlatır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 24.5,
            "width": 71.0,
            "height": 3.0,
            "text": "Gerekçe: Çünkü tiyatronun adı 'Dersimiz Cumhuriyete Doğru'dur ve afişte Atatürk"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 27.1,
            "width": 71.0,
            "height": 3.0,
            "text": "ile cepheye koşan, vatanı savunan fedakâr Türk milleti tasvir edilmiştir."
          }
        ]
      },
      {
        "id": "p76_1_b",
        "title": "1. Etkinlik (b)",
        "button": {
          "left": 5.2,
          "top": 37.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 44.8,
            "width": 71.0,
            "height": 3.0,
            "text": "Evet, tahminim bütünüyle doğru çıktı. Oyunda meclisin açılışı,"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 47.4,
            "width": 71.0,
            "height": 3.0,
            "text": "Seymenlerin Atatürk'ü karşılaması ve fedakârlıklar sergilendi."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.0,
            "width": 71.0,
            "height": 3.0,
            "text": "Cumhuriyetin ilanı başarıyla sahnelenmiş ve doğrulanmıştır."
          }
        ]
      }
    ],
    "77": [
      {
        "id": "p77_3",
        "title": "3. Etkinlik (a)",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 18.5,
            "top": 17.5,
            "width": 17.5,
            "height": 3.0,
            "text": "Mustafa Kemal Paşa,"
          },
          {
            "type": "lines",
            "left": 18.5,
            "top": 20.0,
            "width": 17.5,
            "height": 3.0,
            "text": "Halide Edip, vekil"
          },
          {
            "type": "lines",
            "left": 18.5,
            "top": 22.5,
            "width": 17.5,
            "height": 3.0,
            "text": "Seymenler ve halk."
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 17.5,
            "width": 17.5,
            "height": 3.0,
            "text": "Kurtuluş Savaşı"
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 20.0,
            "width": 17.5,
            "height": 3.0,
            "text": "1919-1923 dönemi"
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 22.5,
            "width": 17.5,
            "height": 3.0,
            "text": "Meclisin açılışı"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 17.5,
            "width": 17.5,
            "height": 3.0,
            "text": "Ankara şehri,"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 20.0,
            "width": 17.5,
            "height": 3.0,
            "text": "TBMM binası ve"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 22.5,
            "width": 17.5,
            "height": 3.0,
            "text": "şehir meydanı."
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 27.5,
            "width": 64.0,
            "height": 3.0,
            "text": "Mustafa Kemal'in Ankara'ya gelişi ve halkın coşkulu karşılaması,"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 29.8,
            "width": 64.0,
            "height": 3.0,
            "text": "meclisin açılışı, Halide Edip'in konuşması ve orduya katılımlar,"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 32.0,
            "width": 64.0,
            "height": 3.0,
            "text": "milletin tek yürek olarak kazandığı zaferle Cumhuriyetin ilanı."
          }
        ]
      },
      {
        "id": "p77_4_b",
        "title": "4. Etkinlik (b)",
        "button": {
          "left": 5.2,
          "top": 68.5
        },
        "items": [
          {
            "type": "lines",
            "left": 18.0,
            "top": 74.2,
            "width": 64.0,
            "height": 3.2,
            "text": "Türk milleti bağımsızlığına canı pahasına sahip çıkmış;"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 76.5,
            "width": 64.0,
            "height": 3.2,
            "text": "birlik ve beraberlikle zorlukları aşıp Cumhuriyeti kurmuştur."
          }
        ]
      }
    ],
    "78": [
      {
        "id": "p78_7",
        "title": "7. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 58.5
        },
        "items": [
          {
            "type": "lines",
            "left": 17.5,
            "top": 68.8,
            "width": 69.5,
            "height": 2.2,
            "text": "Yer adlarındaki boğaz, nehir, göl, dağ gibi ikinci adlar büyük harfle başlar."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 78.5,
            "width": 69.5,
            "height": 2.2,
            "text": "Kurum, kuruluş ve kurul adlarının her kelimesi büyük harfle başlar."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 88.1,
            "width": 69.5,
            "height": 2.2,
            "text": "Saray, köşk, han, kale, köprü vb. tarihî yapı adları büyük harfle başlar."
          }
        ]
      }
    ],
    "79": [
      {
        "id": "p79_nokta",

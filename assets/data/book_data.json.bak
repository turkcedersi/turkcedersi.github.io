    "83": [
      {
        "id": "p83_etk4",
        "title": "4. Etkinlik: Giriş, Gelişme, Sonuç",
        "button": {
          "left": 88.0,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 17.5,
            "top": 21.73,
            "width": 68.0,
            "text": "Kitabın kendi ağzından insanlığın sözlü kültürden yazılı kültüre geçişini anlatması."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 24.29,
            "width": 76.5,
            "text": "İlk çağlarda bilginin taşınmasındaki zorluklar ve hafızanın rolü vurgulanmıştır."
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 30.38,
            "width": 65.5,
            "text": "Sümer kil tabletleri, Mısır papirüsleri, parşömen ve matbaanın icadıyla gelen dönüşüm."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 33.01,
            "width": 76.5,
            "text": "Günümüzde basılı kitap ile e-kitap arasındaki tatlı rekabet ve üstünlük savları."
          },
          {
            "type": "lines",
            "left": 18.5,
            "top": 39.1,
            "width": 67.0,
            "text": "Her iki biçimin de insanlığa hizmet ettiği ve basılı kitabın kokusunun hep süreceği."
          }
        ]
      },
      {
        "id": "p83_etk5",
        "title": "5. Etkinlik: Metin Özeti",
        "button": {
          "left": 88.0,
          "top": 58.0
        },
        "items": [
          {
            "type": "lines",
            "left": 9.0,
            "top": 69.1,
            "width": 76.5,
            "text": "Metinde kitabın sözlü gelenekten başlayıp kil tablet, papirüs ve matbaayla gelişimi anlatılmıştır."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 72.31,
            "width": 76.5,
            "text": "Önemli olan bilgiye erişmektir; basılı veya dijital fark etmeksizin kitap yaşamın özüdür."
          },
          {
            "type": "lines",
            "left": 9.0,
            "top": 74.87,
            "width": 76.5,
            "text": "Ancak basılı sayfalara dokunmak ve kokusunu hissetmek her zaman eşsiz bir duygudur."
          }
        ]
      }
    ],

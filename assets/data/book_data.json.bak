            "left": 35.7,
            "top": 68.59,
            "width": 53.5,
            "height": 2.2,
            "text": "Ali; dürüst, çalışkan ve saygılı bir öğrencidir."
          }
        ]
      }
    ],
    "27": [
      {
        "id": "p27_etk12_b",
        "title": "12. Etkinlik B: E-posta Yanıtı",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 17.0,
            "top": 31.09,
            "width": 70.0,
            "height": 2.2,
            "text": "deniz.yildiz@posta.com"
          },
          {
            "type": "lines",
            "left": 17.6,
            "top": 33.59,
            "width": 69.4,
            "height": 2.2,
            "text": "Yanıt: Parklardaki Doğal Yaşam Alanlarının Korunması"
          },
          {
            "type": "box",
            "left": 12.5,
            "top": 37.5,
            "width": 75.0,
            "height": 40.0,
            "text": "Sevgili Deniz Merhaba,\n\nMahallemizdeki parkta gerçekleştirdiğimiz ağaç budama çalışmaları sırasında kuş yuvalarının zarar gördüğünü fark ederek bize ulaştığın için sana çok teşekkür ederim. Çevreye ve doğaya karşı gösterdiğin bu örnek duyarlılık hepimizi gururlandırdı.\n\nBelediye olarak temel amacımız sadece şehirlerimizi güzelleştirmek değil; doğayı, yeşili ve parklarımızda barınan tüm canlıları korumaktır. Park ve Bahçeler Müdürlüğü ekiplerimize derhal talimat verilmiş olup budama çalışmalarında kuş yuvalarının bulunduğu dalların kesinlikle korunması ve çalışmaların uzman biyologlar gözetiminde yürütülmesi kararlaştırılmıştır. Ayrıca parkımıza kuşların güvenle barınabileceği ahşap yapay kuş yuvaları da yerleştirilecektir.\n\nDoğal çevremize sahip çıkan senin gibi bilinçli gençlerin varlığı geleceğe olan umudumuzu artırıyor. Gözlemlerini ve önerilerini bizimle paylaşmaya lütfen devam et.\n\nDerslerinde başarılar, sağlıklı ve mutlu günler dilerim.\n\nAli Yılmaz\nBüyükşehir Belediye Başkanı"
          }
        ]
      }
    ],
    "31": [
      {
        "id": "p31_etk1",
        "title": "1. Etkinlik: Kelime ve Sözlük Anlamı",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 12.5,
            "top": 27.82,
            "width": 11.5,
            "text": "ebedî",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.2,
            "top": 26.47,
            "width": 49.0,
            "text": "Sonsuz, ölümsüz"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 29.17,
            "width": 44.4,
            "text": "Sonu olmayan, ebediyen süren, bengi."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 34.36,
            "width": 11.5,
            "text": "ihtimam",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.2,
            "top": 33.01,
            "width": 49.0,
            "text": "Özen göstermek, titizlik"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 35.71,
            "width": 44.4,
            "text": "Özen, itina, dikkat ve titizlik."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 40.83,
            "width": 11.5,
            "text": "dağarcık",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.2,
            "top": 39.55,
            "width": 49.0,
            "text": "Bilgi birikimi, bellek"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 42.24,
            "width": 44.4,
            "text": "Bellek, birikim, tecrübeler bütünü."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 47.37,
            "width": 11.5,
            "text": "hüsran",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.2,
            "top": 46.09,
            "width": 49.0,
            "text": "Büyük hayal kırıklığı"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 48.78,
            "width": 44.4,
            "text": "Bir umudun boşa çıkmasıyla duyulan acı."
          }
        ]
      },
      {
        "id": "p31_etk2_a",
        "title": "2. Etkinlik: Düşünceyi Geliştirme Yolları",
        "button": {
          "left": 6.5,
          "top": 54.5
        },
        "items": [
          {
            "type": "lines",
            "left": 26.2,
            "top": 64.62,
            "width": 62.8,
            "text": "Heraklit: \"Bir nehirde iki defa yıkanmanın"
          },
          {
            "type": "lines",
            "left": 10.8,
            "top": 66.92,
            "width": 78.2,
            "text": "mümkün olmadığını söylerken bunu ne güzel anlatmıştır.\""
          },
          {
            "type": "lines",
            "left": 20.8,
            "top": 70.45,
            "width": 68.2,
            "text": "\"Çünkü hayat, tıpkı bir nehrin suyu gibi"
          },
          {
            "type": "lines",
            "left": 10.8,
            "top": 72.76,
            "width": 78.2,
            "text": "zaman içinde akıp gitmektedir.\""
          },
          {
            "type": "lines",
            "left": 25.3,
            "top": 76.28,
            "width": 63.7,
            "text": "\"Çiçeklerini açmış bir şeftali ağacı ne kadar"
          },
          {
            "type": "lines",
            "left": 10.8,
            "top": 78.59,
            "width": 78.2,
            "text": "güzelse aynı ağaç dallarında olgun meyvelerle de güzeldir.\""
          },
          {
            "type": "lines",
            "left": 23.5,
            "top": 82.24,
            "width": 65.5,
            "text": "\"Gençlikte pek çokmuş gibi görünen vakit,"
          },
          {
            "type": "lines",
            "left": 10.8,
            "top": 84.49,
            "width": 78.2,
            "text": "yaş ilerledikçe azalacaktır.\""
          }
        ]
      }
    ],

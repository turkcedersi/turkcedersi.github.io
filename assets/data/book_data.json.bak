    "80": [
      {
        "id": "p80_etk6_a",
        "title": "6. Etkinlik A: Sıralı Kronolojik Metin Yapısı",
        "button": {
          "left": 6.5,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 12.0,
            "top": 21.5,
            "width": 20.5,
            "text": "Yunan taarruzu üzerine"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 23.8,
            "width": 20.5,
            "text": "ordumuz Sakarya'nın"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 26.1,
            "width": 20.5,
            "text": "doğusuna çekildi."
          },
          {
            "type": "lines",
            "left": 30.0,
            "top": 48.0,
            "width": 20.5,
            "text": "22 gün 22 gece süren"
          },
          {
            "type": "lines",
            "left": 30.0,
            "top": 50.3,
            "width": 20.5,
            "text": "büyük Sakarya Meydan"
          },
          {
            "type": "lines",
            "left": 30.0,
            "top": 52.6,
            "width": 20.5,
            "text": "Muharebesi başladı."
          },
          {
            "type": "lines",
            "left": 48.5,
            "top": 25.0,
            "width": 20.5,
            "text": "Topyekûn taarruza"
          },
          {
            "type": "lines",
            "left": 48.5,
            "top": 27.3,
            "width": 20.5,
            "text": "geçilerek düşman"
          },
          {
            "type": "lines",
            "left": 48.5,
            "top": 29.6,
            "width": 20.5,
            "text": "hattı yarıldı."
          },
          {
            "type": "lines",
            "left": 66.8,
            "top": 53.0,
            "width": 20.5,
            "text": "Düşman batıya atıldı,"
          },
          {
            "type": "lines",
            "left": 66.8,
            "top": 55.3,
            "width": 20.5,
            "text": "büyük zafer kazanılıp"
          },
          {
            "type": "lines",
            "left": 66.8,
            "top": 57.6,
            "width": 20.5,
            "text": "vatan kurtarıldı."
          }
        ]
      },
      {
        "id": "p80_etk6_b",
        "title": "6. Etkinlik B: Bilgilerin Birbiriyle İlişkisi",
        "button": {
          "left": 6.5,
          "top": 64.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 67.88,
            "width": 78.0,
            "text": "İçerikte verilen bilgiler, olayların tarihsel sırasına göre neden-sonuç bağıyla birbirine"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 70.45,
            "width": 78.0,
            "text": "bağlandığı sıralı kronolojik bir metin yapısı oluşturmaktadır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 73.01,
            "width": 78.0,
            "text": "Yunan ordusunun işgal girişimleri ve Ankara'ya doğru ilerleyişi, ordumuzun Sakarya Nehri'nin"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 75.58,
            "width": 78.0,
            "text": "doğusuna stratejik bir geri çekilme yapmasına zemin hazırlamıştır (sebep)."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 78.21,
            "width": 78.0,
            "text": "23 Ağustos'ta başlayan Yunan taarruzu, 22 gün boyunca süren amansız bir mücadeleye ve"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 80.77,
            "width": 78.0,
            "text": "Mustafa Kemal Paşa'nın topyekûn savunma stratejisini uygulamasına yol açmıştır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 83.33,
            "width": 78.0,
            "text": "12 Eylül'de Türk ordusunun karşı taarruza geçmesi ise Yunan ordusunun savunma hattının"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 85.9,
            "width": 78.0,
            "text": "çökmesi ve düşmanın nehrin batısına püskürtülmesi sonucunu doğurmuştur."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 88.46,
            "width": 78.0,
            "text": "Nihayetinde her bir tarihsel aşama, bir önceki olayın doğal bir sonucu olarak gelişmiş"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 91.03,
            "width": 78.0,
            "text": "ve Sakarya Zaferi'nin mutlak bir başarıyla tamamlanmasını sağlamıştır."
          }
        ]
      }
    ],
    "82": [
      {
        "id": "p82_etk8_a",
        "title": "8. Etkinlik A: Atatürk'ün Hayatı ve Dönemleri",
        "button": {
          "left": 6.5,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 30.5,
            "width": 24.5,
            "text": "Şemsi Efendi Mektebi,"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 32.5,
            "width": 24.5,
            "text": "Selanik Askerî Rüştiyesi,"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 34.5,
            "width": 24.5,
            "text": "Manastır Askerî İdadisi,"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 36.5,
            "width": 24.5,
            "text": "Harp Akademisi'ni bitirdi."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 42.0,
            "width": 24.5,
            "text": "İleri görüşlü, modern ve"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 44.0,
            "width": 24.5,
            "text": "üstün askerî dehası olan"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 46.0,
            "width": 24.5,
            "text": "bir kurmay subay oldu."
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 30.5,
            "width": 24.5,
            "text": "Trablusgarp, Çanakkale,"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 32.5,
            "width": 24.5,
            "text": "Kafkas ve Suriye cephelerinde"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 34.5,
            "width": 24.5,
            "text": "savaştı; Millî Mücadele'yi"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 36.5,
            "width": 24.5,
            "text": "yönetip zafere ulaştırdı."
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 42.0,
            "width": 24.5,
            "text": "Vatan işgalden kurtarıldı,"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 44.0,
            "width": 24.5,
            "text": "bağımsız Türk devleti kuruldu,"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 46.0,
            "width": 24.5,
            "text": "Gazi ve Mareşal unvanı aldı."
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 30.5,
            "width": 24.5,
            "text": "TBMM'yi açtı, Cumhuriyeti ilan"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 32.5,
            "width": 24.5,
            "text": "etti; hukuk, eğitim ve kültür"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 34.5,
            "width": 24.5,
            "text": "alanında çağdaş inkılaplar"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 36.5,
            "width": 24.5,
            "text": "gerçekleştirdi."
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 42.0,
            "width": 24.5,
            "text": "Modern, laik, demokratik"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 44.0,
            "width": 24.5,
            "text": "Türkiye Cumhuriyeti doğdu;"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 46.0,
            "width": 24.5,
            "text": "millet egemenliği sağlandı."
          }
        ]
      },
      {
        "id": "p82_etk8_b",
        "title": "8. Etkinlik B: Sebep-Sonuç Şeması",
        "button": {
          "left": 6.5,
          "top": 51.5
        },
        "items": [
          {
            "type": "lines",
            "left": 43.5,
            "top": 62.8,
            "width": 45.0,
            "text": "Atatürk'ün askerlik yaşamı ve Millî Mücadele"
          },
          {
            "type": "lines",
            "left": 22.5,
            "top": 68.9,
            "width": 66.0,
            "text": "Yurdun dört bir yandan haksızca işgal edilip halkın esarete zorlanması"
          },
          {
            "type": "lines",
            "left": 22.5,
            "top": 75.1,
            "width": 66.0,
            "text": "Mustafa Kemal'in bağımsızlığa inanarak milleti tek amaçta birleştirmesi"
          },
          {
            "type": "lines",
            "left": 22.5,
            "top": 81.3,
            "width": 66.0,
            "text": "Türk milletinin topyekûn bir inanç, fedakârlık ve azimle kenetlenmesi"
          },
          {
            "type": "lines",
            "left": 43.0,
            "top": 87.6,
            "width": 45.0,
            "text": "Kurtuluş Savaşı kazanıldı, cumhuriyet kuruldu."
          }
        ]
      }
    ],
    "83": [
      {
        "id": "p83_etk8_yazma",
        "title": "8. Etkinlik B: Sebep-Sonuç Taslak Metni",
        "button": {
          "left": 6.5,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 14.74,
            "width": 78.0,
            "text": "Mustafa Kemal Atatürk'ün askerlik yaşamı, vatanın bağımsızlığına adanmış destansı"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 17.31,
            "width": 78.0,
            "text": "ve eşsiz bir mücadele dönemidir. I. Dünya Savaşı'nın ardından Osmanlı Devleti mağlup"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 19.94,
            "width": 78.0,
            "text": "sayılmış; bunun sonucunda yurdumuz İtilaf Devletleri tarafından haksızca işgal"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 22.5,
            "width": 78.0,
            "text": "edilmiştir. Bu haksız işgaller karşısında milletimiz çaresiz bırakılmak istenmiş,"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 25.06,
            "width": 78.0,
            "text": "oysa Türk milleti tarih boyunca esarete asla boyun eğmemiştir."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 27.63,
            "width": 78.0,
            "text": "Bu nedenle Mustafa Kemal, 19 Mayıs 1919'da Samsun'a çıkarak Millî Mücadele meşalesini"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 30.19,
            "width": 78.0,
            "text": "yakmıştır. İlk olarak halkı kongrelerle tek gaye etrafında birleştirmiş,"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 32.76,
            "width": 78.0,
            "text": "ardından da Ankara'da TBMM'yi açarak millet iradesini hâkim kılmıştır. Özellikle"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 35.38,
            "width": 78.0,
            "text": "milletin gösterdiği topyekûn fedakârlık ve ordu-millet dayanışması, cephelerde"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 37.95,
            "width": 78.0,
            "text": "büyük kahramanlık destanlarının yazılmasını sağlamıştır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 40.51,
            "width": 78.0,
            "text": "Sonuç olarak; Atatürk'ün askerî dehası ve milletine olan sonsuz güveni"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 43.08,
            "width": 78.0,
            "text": "sayesinde Sakarya'da ve Büyük Taarruz'da düşman kesin yenilgiye uğratılmıştır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 45.64,
            "width": 78.0,
            "text": "Kısacası bu zorlu mücadeleler, tam bağımsız Türkiye Cumhuriyeti Devleti'nin temellerini"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 48.21,
            "width": 78.0,
            "text": "atmış ve Türk milletine ebedî özgürlüğünü kazandırmıştır."
          }
        ]
      }
    ],
    "87": [
      {
        "id": "p87_etk1_a",
        "title": "1. Etkinlik A: Metnin Anahtar Kelimeleri",
        "button": {
          "left": 6.5,
          "top": 9.0
        },
        "items": [
          {
            "type": "lines",
            "left": 17.5,
            "top": 18.91,
            "width": 13.0,
            "text": "Millî Mücadele"
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 18.91,
            "width": 13.0,
            "text": "bağımsızlık"
          },
          {
            "type": "lines",
            "left": 71.0,
            "top": 18.91,
            "width": 13.0,
            "text": "millî egemenlik"
          }
        ]
      },
      {
        "id": "p87_etk3",
        "title": "3. Etkinlik: Görsel Yorumlama",
        "button": {
          "left": 6.5,
          "top": 60.0
        },
        "items": [
          {
            "type": "lines",
            "left": 37.5,
            "top": 75.32,
            "width": 51.5,
            "text": "Görsel, metindeki 'Millî Mesai Başlıyor' bölümüyle"
          },
          {
            "type": "lines",
            "left": 37.5,
            "top": 77.88,
            "width": 51.5,
            "text": "doğrudan ilişkilidir. Mustafa Kemal Samsun'a geçip"
          },
          {
            "type": "lines",
            "left": 37.5,
            "top": 80.45,
            "width": 51.5,
            "text": "çetelerin yıktığı köyleri ziyaret etmiş, köylülerin"
          },
          {
            "type": "lines",
            "left": 37.5,
            "top": 83.01,
            "width": 51.5,
            "text": "dertlerini dinlemiştir. Yıkılmış evler ve halkın hüznü"
          },
          {
            "type": "lines",
            "left": 37.5,
            "top": 85.58,
            "width": 51.5,
            "text": "metinde anlatılan o zorlu günleri yansıtmaktadır."
          }
        ]
      }
    ],
    "89": [
      {
        "id": "p89_etk4_b",
        "title": "4. Etkinlik B: İkna Tekniklerinin İşlevi",
        "button": {
          "left": 6.5,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 20.71,
            "width": 34.0,
            "text": "İnsanlara yapılan bir iyilik veya"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 23.97,
            "width": 34.0,
            "text": "fedakârlık, onlarda minnet ve"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 27.24,
            "width": 34.0,
            "text": "sorumluluk duygusu uyandırır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 30.51,
            "width": 34.0,
            "text": "Böylece kişi karşılık verme ve"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 33.72,
            "width": 34.0,
            "text": "isteğe uyma ihtiyacı hisseder."
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 20.71,
            "width": 34.0,
            "text": "Sevdiğimiz ve değer verdiğimiz"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 23.97,
            "width": 34.0,
            "text": "insanların ricaları ve önerileri"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 27.24,
            "width": 34.0,
            "text": "bize daha samimi ve güvenilir gelir."
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 30.51,
            "width": 34.0,
            "text": "Bu sevgi bağı sayesinde fikirleri"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 33.72,
            "width": 34.0,
            "text": "kolayca kabul eder, benimseriz."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 56.41,
            "width": 34.0,
            "text": "Sözleri ile davranışları birbiriyle"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 59.68,
            "width": 34.0,
            "text": "uyumlu olan bireyler güven verir."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 62.95,
            "width": 34.0,
            "text": "Verilen sözlerin arkasında durulması,"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 66.22,
            "width": 34.0,
            "text": "toplum nezdindeki inandırıcılığı"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 69.42,
            "width": 34.0,
            "text": "ve ikna gücünü en üst düzeye çıkarır."
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 56.41,
            "width": 34.0,
            "text": "Kendi alanında uzman, bilgili ve"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 59.68,
            "width": 34.0,
            "text": "tecrübeli kişilerin görüşleri"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 62.95,
            "width": 34.0,
            "text": "sağlam kanıtlar sunduğu için"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 66.22,
            "width": 34.0,
            "text": "hızla kabul görür; insanları"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 69.42,
            "width": 34.0,
            "text": "doğru hedeflere hızla ikna eder."
          }
        ]
      }
    ],
    "90": [
      {
        "id": "p90_etk5_a",
        "title": "5. Etkinlik A: Millî ve Manevi Değerler",
        "button": {
          "left": 6.5,
          "top": 9.0
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 50.77,
            "width": 78.0,
            "text": "bayrak, vatan, şehitlik, bağımsızlık, Mehmetçik, toprak, istiklal,"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 53.33,
            "width": 78.0,
            "text": "Çanakkale Destanı, fedakârlık, gazilik, millet ve birlik."
          }
        ]
      },
      {
        "id": "p90_etk5_b",
        "title": "5. Etkinlik B: Somut ve Soyut İsimler",
        "button": {
          "left": 6.5,

            "type": "lines",
            "left": 45.0,
            "top": 25.96,
            "width": 35.0,
            "text": "İnsanı büyüleyen, derinden etkileyen gizemli güç."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 30.83,
            "width": 35.0,
            "text": "Büyü, sihir, tılsım veya büyüleyici güzellik."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 35.64,
            "width": 35.0,
            "text": "Ucu bucağı görünmeyen sonsuz bilgi dünyası."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 40.51,
            "width": 35.0,
            "text": "Ucu bucağı görünmeyecek kadar geniş, açık deniz."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 45.32,
            "width": 35.0,
            "text": "İnsanlığın altında toplandığı evrensel kubbe."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 50.19,
            "width": 35.0,
            "text": "Gökyüzü, sema kubbesi, mavi gök kubbe."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 55.0,
            "width": 35.0,
            "text": "Kitaplarla nesilden nesle aktarılan köklü bilgi."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 59.87,
            "width": 35.0,
            "text": "Bilim, düzenli ve yöntemli bilgi bütünü."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 64.68,
            "width": 35.0,
            "text": "Tarihin derinliklerinden süzülen çok eski miras."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 69.55,
            "width": 35.0,
            "text": "Başlangıcı geçmişin derinliklerinde olan, çok eski."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 74.36,
            "width": 35.0,
            "text": "Kütüphanede korunan el yazması eser örneği."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 79.23,
            "width": 35.0,
            "text": "Birbirinin tıpkısı olan yazılı şeylerin her biri."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 84.04,
            "width": 35.0,
            "text": "İlk yazıların üzerine kazındığı pişmiş kil levha."
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 88.91,
            "width": 35.0,
            "text": "Eski çağlarda yazı yazmak için kullanılan düz levha."
          }
        ]
      }
    ],
    "91": [
      {
        "id": "p91_etk3",

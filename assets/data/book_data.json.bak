            "top": 47.8,
            "width": 3.0,
            "height": 2.0,
            "text": "Y"
          },
          {
            "type": "mark",
            "left": 12.5,
            "top": 52.2,
            "width": 3.0,
            "height": 2.0,
            "text": "D"
          },
          {
            "type": "mark",
            "left": 12.5,
            "top": 56.8,
            "width": 3.0,
            "height": 2.0,
            "text": "D"
          }
        ]
      },
      {
        "id": "p101_7",
        "title": "7. Etkinlik (Ünlem)",
        "button": {
          "left": 5.2,
          "top": 64.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 72.5,
            "width": 71.0,
            "height": 2.2,
            "text": "Sevinç, kıvanç, acı, korku, şaşma anlatan cümlelerin sonuna konur."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 78.5,
            "width": 71.0,
            "height": 2.2,
            "text": "Seslenme, hitap ve uyarı sözlerinden sonra konur."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 84.5,
            "width": 71.0,
            "height": 2.2,
            "text": "Alay, kinaye veya küçümseme anlamı için yay ayraç içinde (!) kullanılır."
          }
        ]
      }
    ],
    "102": [
      {
        "id": "p102_8_a",
        "title": "8. Etkinlik (a - Geçiş ve Bağlantı İfadeleri)",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "blank",
            "left": 74.0,
            "top": 22.3,
            "width": 8.8,
            "height": 2.0,
            "text": "fakat"
          },
          {
            "type": "blank",
            "left": 79.2,
            "top": 24.0,
            "width": 7.0,
            "height": 2.0,
            "text": "rağmen"
          },
          {
            "type": "blank",
            "left": 70.8,
            "top": 25.8,
            "width": 9.0,
            "height": 2.0,
            "text": "Öte yandan"
          },
          {
            "type": "blank",
            "left": 13.0,
            "top": 32.7,
            "width": 13.5,
            "height": 2.0,
            "text": "Bununla birlikte"
          },
          {
            "type": "blank",
            "left": 78.5,
            "top": 34.4,
            "width": 7.5,
            "height": 2.0,
            "text": "ancak"
          }
        ]
      },
      {
        "id": "p102_8_b",
        "title": "8. Etkinlik (b - Cümle Yazımı)",
        "button": {
          "left": 5.2,
          "top": 41.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 44.5,
            "width": 71.0,
            "height": 2.2,
            "text": "Derslerime çok çalıştım ancak sınav sabahı biraz heyecanlandım."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 47.3,
            "width": 71.0,
            "height": 2.2,
            "text": "Dışarıda fırtına vardı fakat söz verdiğim için kütüphaneye gittim."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.0,
            "width": 71.0,
            "height": 2.2,
            "text": "Havanın çok soğuk olmasına rağmen sabah erkenden yürüyüşe çıktık."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 52.8,
            "width": 71.0,
            "height": 2.2,
            "text": "Ödevlerimi bitirdim, bununla birlikte yarınki sunuma da hazırlandım."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 55.5,
            "width": 71.0,
            "height": 2.2,
            "text": "Bir yandan resim yaparken öte yandan sevdiğim şarkıları dinledim."
          }
        ]
      },
      {
        "id": "p102_8_c",
        "title": "8. Etkinlik (c - Anlatıma Katkısı)",
        "button": {
          "left": 5.2,
          "top": 61.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 62.0,
            "width": 71.0,
            "height": 2.2,
            "text": "Geçiş ve bağlantı ifadeleri cümleler arasındaki düşünce bağını pekiştirir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 64.8,
            "width": 71.0,
            "height": 2.2,
            "text": "Düşüncenin yönünün değiştiğini veya farklı bir duruma geçildiğini bildirir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 67.8,
            "width": 71.0,
            "height": 2.2,
            "text": "Anlatımı tekdüzelikten kurtarıp metne akıcılık ve mantıksal bütünlük katar."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 70.5,
            "width": 71.0,
            "height": 2.2,
            "text": "Okuyucunun anlatılan ana fikri daha rahat ve doğru kavramasını sağlar."
          }
        ]
      }
    ],
    "108": [
      {
        "id": "p108_tablo",
        "title": "Öğrenim Hayatı Tablosu",
        "button": {
          "left": 5.2,
          "top": 49.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 53.0,
            "width": 71.0,
            "height": 2.2,
            "text": "Atatürk'ün Öğrenim Hayatı"
          },
          {
            "type": "box",
            "left": 14.5,
            "top": 62.5,
            "width": 71.0,
            "height": 11.0,
            "text": "• Atatürk'ün Selanik'te doğduğunu ve ilkokul öğrenimine Mahalle Mektebinde başladığını biliyordum.\n• Daha sonra modern eğitim veren Şemsi Efendi Mektebine geçtiğini ve asker olmak istediğini biliyordum."
          },
          {
            "type": "box",
            "left": 14.5,
            "top": 82.5,
            "width": 71.0,
            "height": 11.0,
            "text": "• Manastır Askerî İdadisinde okurken tatillerde Selanik'te özel Fransızca dersleri aldığını öğrendim.\n• Harp Okulunu teğmen, Harp Akademisini kurmay yüzbaşı rütbesiyle dereceyle bitirdiğini öğrendim."
          }
        ]
      }
    ],
    "112": [
      {
        "id": "p112_2",
        "title": "2. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 38.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 44.5,
            "width": 71.0,

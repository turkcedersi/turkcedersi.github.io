          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 42.0,
            "width": 20.0,
            "height": 2.4,
            "text": "Karagöz ve Hacivat"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 45.0,
            "width": 20.0,
            "height": 2.4,
            "text": "Meddahlık sanatı"
          },
          {
            "type": "lines",
            "left": 68.0,
            "top": 48.0,
            "width": 20.0,
            "height": 2.4,
            "text": "Âşıklık geleneği"
          },
          {
            "type": "badge",
            "left": 24.0,
            "top": 52.5,
            "width": 24.0,
            "height": 3.0,
            "text": "Sözlü Anlatımlar"
          },
          {
            "type": "lines",
            "left": 25.0,
            "top": 56.5,
            "width": 20.0,
            "height": 2.4,
            "text": "Dede Korkut Boyları"
          },
          {
            "type": "lines",
            "left": 25.0,
            "top": 59.5,
            "width": 20.0,
            "height": 2.4,
            "text": "Nasreddin Hoca"
          },
          {
            "type": "lines",
            "left": 25.0,
            "top": 62.5,
            "width": 20.0,
            "height": 2.4,
            "text": "Masallar ve efsaneler"
          },
          {
            "type": "badge",
            "left": 52.0,
            "top": 52.5,
            "width": 24.0,
            "height": 3.0,
            "text": "Mutfak Kültürü"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 56.5,
            "width": 20.0,
            "height": 2.4,
            "text": "Türk kahvesi"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 59.5,
            "width": 20.0,
            "height": 2.4,
            "text": "Mesir macunu"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 62.5,
            "width": 20.0,
            "height": 2.4,
            "text": "Yufka ve lavaş ekmeği"
          }
        ]
      },
      {
        "id": "p52_12_a",
        "title": "12. Etkinlik (a)",
        "button": {
          "left": 5.0,
          "top": 74.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 78.5,
            "width": 71.0,
            "height": 2.4,
            "text": "Somut olmayan kültürel miras, gelenek, görenek, kuşaktan kuşağa aktarım,"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 81.4,
            "width": 71.0,
            "height": 2.4,
            "text": "el sanatları, sözlü gelenekler, toplumsal dayanışma, ortak hafıza,"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 84.3,
            "width": 71.0,
            "height": 2.4,
            "text": "yaşayan miras, ustalık, çıraklık ilişkisi, millî kimlik ve birlik beraberliktir."
          }
        ]
      }
    ],
    "54": [
      {
        "id": "p54_tanitma_paragrafi",
        "title": "Tanıtma Paragrafı: Yöresel Kıyafet",
        "button": {
          "left": 5.0,
          "top": 42.0
        },
        "items": [
          {
            "type": "lines",
            "left": 17.0,
            "top": 50.4,
            "width": 26.0,
            "height": 2.4,
            "text": "Bindallı, kına gecelerinde gelinlerin"
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 55.6,
            "width": 26.0,
            "height": 2.4,
            "text": "giydiği geleneksel bir giysidir."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 63.4,
            "width": 26.0,
            "height": 2.4,
            "text": "Kadife kumaşa sırma ve lale işlenir."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 66.0,
            "width": 26.0,
            "height": 2.4,
            "text": "Gümüş kemer ve süslü fesle takılır."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 70.9,
            "width": 26.0,
            "height": 2.4,
            "text": "Zarafeti ve el emeğini simgeleyen"
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 73.5,
            "width": 26.0,
            "height": 2.4,
            "text": "en kıymetli kültür mirasımızdır."
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 50.4,
            "width": 38.0,
            "height": 2.4,
            "text": "Bindallı, düğün ve merasimlerde giyilen"
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 53.0,
            "width": 38.0,
            "height": 2.4,
            "text": "özel ve geleneksel bir kadın giysisidir."
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 55.6,
            "width": 38.0,
            "height": 2.4,
            "text": "Çoğunlukla bordo kadife kumaş üzerine"
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 58.4,
            "width": 38.0,
            "height": 2.4,
            "text": "altın rengi sırma ipliklerle motifler işlenir."
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 61.0,
            "width": 38.0,
            "height": 2.4,
            "text": "Uzun kollu ve boyu yere kadar uzanan bu elbise,"
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 63.6,
            "width": 38.0,
            "height": 2.4,
            "text": "gümüş bir kemer ve süslü fesle tamamlanır."
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 66.4,
            "width": 38.0,
            "height": 2.4,
            "text": "Asırlardır kına gecelerini süsleyen bindallı,"
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 69.0,
            "width": 38.0,
            "height": 2.4,
            "text": "el emeğimizin ve köklü zarafetimizin simgesidir."
          }
        ]
      }
    ],
    "55": [
      {
        "id": "p55_tanitma_paragrafi",
        "title": "Tanıtma Paragrafı: Millî Bayram",
        "button": {
          "left": 5.0,
          "top": 36.0
        },
        "items": [
          {
            "type": "lines",
            "left": 17.0,
            "top": 47.9,
            "width": 26.0,
            "height": 2.4,
            "text": "Millî bayramlar, bağımsızlığımızı"
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 50.5,
            "width": 26.0,
            "height": 2.4,
            "text": "kutladığımız ortak günlerimizdir."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 58.4,
            "width": 26.0,
            "height": 2.4,
            "text": "29 Ekim ve 23 Nisan coşkuyla kutlanır."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 61.0,
            "width": 26.0,
            "height": 2.4,
            "text": "19 Mayıs'ta gençlik meşalesi parlar."
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 68.4,
            "width": 26.0,
            "height": 2.4,
            "text": "Milletçe kenetlendiğimiz en büyük"
          },
          {
            "type": "lines",
            "left": 17.0,
            "top": 71.0,
            "width": 26.0,
            "height": 2.4,
            "text": "birlik ve beraberlik gücümüzdür."
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 47.9,
            "width": 38.0,
            "height": 2.4,
            "text": "Millî bayramlar, bir ulusun tarihi zaferlerini"
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 50.5,
            "width": 38.0,
            "height": 2.4,
            "text": "ve bağımsızlığını coşkuyla andığı günlerdir."
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 53.2,
            "width": 38.0,
            "height": 2.4,
            "text": "Vatanı uğruna kenetlenen milletimiz,"
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 55.8,
            "width": 38.0,
            "height": 2.4,
            "text": "bu günlerde bayram sevincini hep birlikte tazeler."
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 58.4,
            "width": 38.0,
            "height": 2.4,
            "text": "29 Ekim'de cumhuriyet, 23 Nisan'da neşe kutlanır,"
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 61.0,
            "width": 38.0,
            "height": 2.4,
            "text": "Okunan şiirler ve marşlar kalpleri birleştirir."
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 63.8,
            "width": 38.0,
            "height": 2.4,
            "text": "Sonuç olarak bayramlarımız, geleceğe uzanan"
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 66.5,
            "width": 38.0,
            "height": 2.4,
            "text": "birlik ve beraberliğimizin en güçlü teminatıdır."
          }
        ]
      }
    ],

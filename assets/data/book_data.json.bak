            "text": "Kelimeleri hecelerine ayırmak için kullanılır."
          }
        ]
      }
    ],
    "36": [
      {
        "id": "p36_10",
        "title": "10. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 20.3,
            "width": 72.0,
            "height": 2.4,
            "text": "Metnin konusu, geleneksel Türk aile yapısında misafire verilen değerdir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 23.0,
            "width": 72.0,
            "height": 2.4,
            "text": "Ev sahibinin misafir odasını büyük bir özen ve saygıyla hazırlaması,"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 25.6,
            "width": 72.0,
            "height": 2.4,
            "text": "komşuluk ve akrabalık ilişkilerindeki sıcak samimiyet dikkatimi çekti."
          },
          {
            "type": "lines",
            "left": 36.5,
            "top": 39.8,
            "width": 52.0,
            "height": 2.4,
            "text": "Komşular, zor zamanlarda bir araya gelmenin kıymetini anlar."
          },
          {
            "type": "lines",
            "left": 36.5,
            "top": 42.4,
            "width": 52.0,
            "height": 2.4,
            "text": "Kendilerine ikramda bulunulmasından ve hatır sorulmasından"
          },
          {
            "type": "lines",
            "left": 36.5,
            "top": 45.0,
            "width": 52.0,
            "height": 2.4,
            "text": "büyük bir mutluluk ve derin bir mahalle güveni duyarlar."
          },
          {
            "type": "lines",
            "left": 36.5,
            "top": 47.7,
            "width": 52.0,
            "height": 2.4,
            "text": "Yazar, geçmişten gelen misafirperverlik geleneğini çok kıymetli görür."
          },
          {
            "type": "lines",
            "left": 36.5,
            "top": 50.3,
            "width": 52.0,
            "height": 2.4,
            "text": "Bu güzel anıların ve dayanışma kültürünün asla unutulmaması"
          },
          {
            "type": "lines",
            "left": 36.5,
            "top": 52.9,
            "width": 52.0,
            "height": 2.4,
            "text": "ve gelecek kuşaklara aktarılması gerektiğini savunur."
          }
        ]
      },
      {
        "id": "p36_11_a",
        "title": "11. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 60.0
        },
        "items": [
          {
            "type": "lines",
            "left": 26.5,
            "top": 67.2,
            "width": 60.0,
            "height": 2.3,
            "text": "Olayın geçtiği yerin, zamanın ve misafir odasının tanıtılması,"
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 69.6,
            "width": 60.0,
            "height": 2.3,
            "text": "evdeki hazırlıkların ve heyecanlı bekleyişin anlatılması."
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 73.8,
            "width": 60.0,
            "height": 2.3,
            "text": "Misafirlerin gelmesi, yapılan samimi sohbetler, ikramlar ve"
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 76.2,
            "width": 60.0,
            "height": 2.3,
            "text": "komşuluk ilişkilerinde yaşanan sıcak olayların gelişmesi."
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 81.5,
            "width": 60.0,
            "height": 2.3,
            "text": "Misafirlerin dualarla uğurlanması ve bu güzel günün ardından"
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 83.9,
            "width": 60.0,
            "height": 2.3,
            "text": "kalan sevgi, huzur ve hoş anıların değerlendirilmesi."
          }
        ]
      }
    ],
    "37": [
      {
        "id": "p37_12_b",
        "title": "12. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 36.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 44.4,
            "width": 72.0,
            "height": 2.3,
            "text": "Bizim mahallenin en eski sakinleri Davut amca ve Selma teyzedir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 46.8,
            "width": 72.0,
            "height": 2.3,
            "text": "Kapılarını çalan herkesi güler yüz ve tatlı dille karşılarlar."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 49.2,
            "width": 72.0,
            "height": 2.3,
            "text": "Selma teyze fırından yeni çıkmış sıcak börekler ikram eder."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 51.6,
            "width": 72.0,
            "height": 2.3,
            "text": "Davut amca eski fotoğraflar eşliğinde güzel hatıralar anlatır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 54.0,
            "width": 72.0,
            "height": 2.3,
            "text": "Onların evinde insan kendini gerçek bir aile sıcaklığında hisseder."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 56.4,
            "width": 72.0,
            "height": 2.3,
            "text": "Paylaşılan her lokmada sevgi, saygı ve samimiyet vardır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 58.8,
            "width": 72.0,
            "height": 2.3,
            "text": "Ayrılırken Davut amca elimizi tutup hayır dualar eder."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 61.2,
            "width": 72.0,
            "height": 2.3,
            "text": "Selma teyze cebimize bayram şekeri koymadan bizi bırakmaz."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 63.6,
            "width": 72.0,
            "height": 2.3,
            "text": "Onların gösterdiği bu vefa ve misafirperverlik çok kıymetlidir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 66.0,
            "width": 72.0,
            "height": 2.3,
            "text": "Geleneksel komşuluk ve dayanışma kültürümüzü yaşatırlar."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 68.4,
            "width": 72.0,
            "height": 2.3,
            "text": "Bizler de büyüklerimizin bu mirasını sevgiyle geleceğe taşırız."
          }
        ]
      }
    ],
    "39": [
      {
        "id": "p39_metin_analizi",
        "title": "Halı Dokumacılığı Çalışma Kâğıdı",
        "button": {
          "left": 5.0,
          "top": 60.0
        },
        "items": [
          {
            "type": "lines",
            "left": 22.0,
            "top": 65.2,
            "width": 64.0,
            "height": 2.4,
            "text": "Geleneksel Türk halı dokumacılığı sanatı ve aşamaları"
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 68.0,
            "width": 43.0,
            "height": 2.4,
            "text": "Anadolu'da halı dokuma geleneğinin"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 70.8,
            "width": 70.5,
            "height": 2.4,
            "text": "tarihî önemi, sabır ve büyük bir emekle yapıldığı anlatılmıştır."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 73.5,
            "width": 70.5,
            "height": 2.4,
            "text": "Yünlerin kırkılmasından tezgâhta motiflerin dokunmasına kadar"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 76.2,
            "width": 70.5,
            "height": 2.4,
            "text": "bütün aşamalar sırasıyla ayrıntılı olarak açıklanmıştır."
          },
          {
            "type": "mark",
            "left": 21.6,
            "top": 81.8,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 83.9,
            "width": 49.0,
            "height": 2.4,
            "text": "\"Kültürel zenginliği ve zanaatkârlığı"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 86.5,
            "width": 70.5,
            "height": 2.4,
            "text": "bir araya getiren önemli bir el sanatıdır.\" cümlesiyle başlanmıştır."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 89.1,
            "width": 55.0,
            "height": 2.4,
            "text": "Bu ifade okuyucunun konuya ilgisini doğrudan çeker."
          }
        ]
      }
    ],
    "40": [
      {
        "id": "p40_metin_analizi",
        "title": "Halı Dokumacılığı Çalışma Kâğıdı",
        "button": {
          "left": 5.0,
          "top": 10.0
        },
        "items": [
          {
            "type": "lines",
            "left": 16.5,
            "top": 13.0,
            "width": 70.5,
            "height": 2.4,
            "text": "Öncelikle, haziran ve eylül aylarında,"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 15.6,
            "width": 70.5,
            "height": 2.4,
            "text": "ardından, bu aşamada, boyama aşamasına geçildiğinde önce,"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 18.2,
            "width": 70.5,
            "height": 2.4,
            "text": "bu süreçte, boyama tamamlandıktan sonra, son aşamasında,"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 20.8,
            "width": 70.5,
            "height": 2.4,
            "text": "bütün bu aşamaların ardından."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 29.8,
            "width": 14.5,
            "height": 2.1,
            "text": "Koyunlar kırkılır."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 31.9,
            "width": 14.5,
            "height": 2.1,
            "text": "Yünler yıkanır."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 34.1,
            "width": 14.5,
            "height": 2.1,
            "text": "İplik eğrilir."
          },
          {
            "type": "lines",
            "left": 34.0,
            "top": 29.8,
            "width": 14.5,
            "height": 2.1,
            "text": "Boyama alanı kurulur."
          },
          {
            "type": "lines",
            "left": 34.0,
            "top": 31.9,
            "width": 14.5,
            "height": 2.1,
            "text": "Kök boya hazırlanır."
          },
          {
            "type": "lines",
            "left": 34.0,
            "top": 34.1,
            "width": 14.5,
            "height": 2.1,
            "text": "İplikler boyanır."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 29.8,
            "width": 14.5,
            "height": 2.1,
            "text": "Halı tezgâhı kurulur."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 31.9,
            "width": 14.5,
            "height": 2.1,
            "text": "Model belirlenir."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 34.1,
            "width": 14.5,
            "height": 2.1,
            "text": "İlmekler atılır."
          },
          {
            "type": "lines",
            "left": 69.0,
            "top": 29.8,
            "width": 14.5,
            "height": 2.1,
            "text": "Düğümler tamamlanır."
          },
          {
            "type": "lines",
            "left": 69.0,
            "top": 31.9,
            "width": 14.5,
            "height": 2.1,
            "text": "Halı tezgâhtan iner."
          },
          {
            "type": "lines",
            "left": 69.0,
            "top": 34.1,
            "width": 14.5,
            "height": 2.1,
            "text": "Sanat eseri oluşur."
          },
          {
            "type": "mark",
            "left": 21.6,
            "top": 40.0,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 42.9,
            "width": 49.0,
            "height": 2.4,
            "text": "\"Halı dokuma geleneği korunması,"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 45.6,
            "width": 70.5,
            "height": 2.4,
            "text": "yaşatılması ve gelecek kuşaklara aktarılması gereken önemli bir değerdir.\""
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 48.2,
            "width": 70.5,
            "height": 2.4,
            "text": "Girişteki kültürel miras vurgusu sonuçtaki koruma çağrısıyla örtüşmektedir."
          }
        ]
      }
    ],
    "41": [
      {
        "id": "p41_metin_analizi",
        "title": "Keçe Ustası Çalışma Kâğıdı",
        "button": {
          "left": 5.0,
          "top": 54.0
        },
        "items": [
          {
            "type": "lines",
            "left": 20.0,
            "top": 57.2,
            "width": 68.0,
            "height": 2.4,
            "text": "Keçe ustası Ahmet Yaşar Kocataş'ın hayatı ve ustalığı"
          },
          {
            "type": "lines",
            "left": 43.0,
            "top": 59.8,
            "width": 44.0,
            "height": 2.4,
            "text": "Geleneksel Türk el sanatları arasında"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 62.4,
            "width": 72.0,
            "height": 2.4,
            "text": "keçeciliğin önemli yeri ve Ahmet Usta'nın mesleğe adanmışlığı vurgulanmıştır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 65.0,
            "width": 72.0,
            "height": 2.4,
            "text": "UNESCO tarafından 'Yaşayan İnsan Hazineleri' listesine seçildiği belirtilmiştir."
          },
          {
            "type": "mark",
            "left": 21.6,
            "top": 70.8,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 37.0,
            "top": 74.3,
            "width": 50.0,
            "height": 2.4,
            "text": "\"Geleneksel Türk el sanatları arasında"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 76.9,
            "width": 72.0,
            "height": 2.4,
            "text": "önemli bir yere sahiptir ve tarih boyunca çeşitli kültürlerde kullanılmıştır.\""
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 79.5,
            "width": 72.0,
            "height": 2.4,
            "text": "Sanatın köklü geçmişi ve ustamızın değeri belirtilerek ilgi çekilmiştir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 85.6,
            "width": 72.0,
            "height": 2.4,
            "text": "1950 yılında, henüz altı yaşında, 1961'de ilkokulu tamamladıktan sonra,"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 88.3,
            "width": 72.0,
            "height": 2.4,
            "text": "çocukluk yılları boyunca, 1970-1972 yılları arasında, ardından, 1996'da, 2015 yılında."
          }
        ]
      }
    ],

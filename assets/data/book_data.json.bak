            "height": 2.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 87.5,
            "width": 71.0,
            "height": 2.2,
            "text": "İnanç, azim ve bilimle en çorak topraklar bile bereketli yurda dönüşür."
          }
        ]
      }
    ],
    "113": [
      {
        "id": "p113_3",
        "title": "3. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 4.8
        },
        "items": [
          {
            "type": "box",
            "left": 14.5,
            "top": 13.5,
            "width": 71.0,
            "height": 10.0,
            "text": "Atatürk; yeni başkent Ankara'nın çorak görüntüsünü yeşillendirmek, halka ferah dinlenme alanları kazandırmak ve en önemlisi Türk köylüsüne modern tarım ve hayvancılık tekniklerini bizzat örnek olarak göstermek için çiftlik kurmak istemiştir. Uzmanların 'burada hiçbir şey yetişmez' demesine rağmen azimle bataklığı kurutup çiftliği inşa ettirmiştir."
          },
          {
            "type": "box",
            "left": 14.5,
            "top": 31.0,
            "width": 71.0,
            "height": 10.0,
            "text": "Atatürk çiftliğin kuruluşunda bir lider gibi sadece emir vermemiş; bizzat traktörün direksiyonuna geçmiş, ağaç dikmiş ve uzmanları yüreklendirmiştir. İmkânsızlıklar karşısındaki kararlılığı çiftliğin başarılmasında en büyük etken olmuştur."
          },
          {
            "type": "box",
            "left": 14.5,
            "top": 66.5,
            "width": 71.0,
            "height": 22.0,
            "text": "Uzmanlar bu toprakların verimsiz ve çorak olduğunu, burada ot dahi bitmeyeceğini söylediler. Fakat ben milletimin azmine ve bilimin aydınlığına yürekten inanıyordum. Kolları sıvadık; bataklıkları kuruttuk, fideleri toprakla buluşturduk. En modern makineleri getirip tarlaları sürdük. Bugün o bozkır yemyeşil bir ormana dönüştü; Türk köylüsü de modern üretimin bereketini gözleriyle gördü."
          }
        ]
      }
    ],
    "114": [
      {
        "id": "p114_4",
        "title": "4. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 4.8
        },
        "items": [
          {
            "type": "badge",
            "left": 8.0,
            "top": 25.0,
            "width": 18.0,
            "height": 2.5,
            "text": "çiftlik"
          },
          {
            "type": "lines",
            "left": 31.0,
            "top": 23.5,
            "width": 54.5,
            "height": 4.0,
            "text": "Modern tarımı öğretmek için kurulan örnek üretim alanıdır."
          },
          {
            "type": "badge",
            "left": 8.0,
            "top": 35.0,
            "width": 18.0,
            "height": 2.5,
            "text": "yeşillendirmek"
          },
          {
            "type": "lines",
            "left": 31.0,
            "top": 33.5,
            "width": 54.5,
            "height": 4.0,
            "text": "Başkente ağaçlar dikerek doğayı koruma arzusunu temsil eder."
          },
          {
            "type": "badge",
            "left": 8.0,
            "top": 45.0,
            "width": 18.0,
            "height": 2.5,
            "text": "modernleşme"
          },
          {
            "type": "lines",
            "left": 31.0,
            "top": 43.5,
            "width": 54.5,
            "height": 4.0,
            "text": "Makineleri ve bilimi öne çıkararak üretimi artırma çabasıdır."
          },
          {
            "type": "badge",
            "left": 8.0,
            "top": 55.0,
            "width": 18.0,
            "height": 2.5,
            "text": "azim"
          },
          {
            "type": "lines",
            "left": 31.0,
            "top": 53.5,
            "width": 54.5,
            "height": 4.0,
            "text": "Uzman raporlarına rağmen vazgeçmeyip başarma iradesidir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 72.0,
            "width": 71.0,
            "height": 2.2,
            "text": "Cumhuriyetimizin ilk yıllarında tarım alanında büyük bir atılım başlatıldı."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 76.5,
            "width": 71.0,
            "height": 2.2,
            "text": "Kurulan bu örnek çiftlik, Türk çiftçisine yeni yöntemleri göstermiştir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 81.0,
            "width": 71.0,
            "height": 2.2,
            "text": "Bütün okul el ele verip bahçemizi yeşillendirmek için fidanlar diktik."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 85.5,
            "width": 71.0,
            "height": 2.2,
            "text": "Ülkemiz eğitimde ve sanayide daima modernleşme yolunda hızla ilerlemektedir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 90.0,
            "width": 71.0,
            "height": 2.2,
            "text": "Mustafa Kemal'in içindeki vatan sevgisi ve azim her engeli aşmaya yetti."
          }
        ]
      }
    ],

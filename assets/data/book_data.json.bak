    "86": [
      {
        "id": "p86_etk8",
        "title": "8. Etkinlik: Kitap Tanıtım Maddeleri",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 45.5,
            "top": 29.36,
            "width": 31.0,
            "text": "Kitabın adı, yazarı, sayfa sayısı ve ait olduğu edebî tür."
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 35.45,
            "width": 31.0,
            "text": "Kitabın konusu, geçtiği zaman ve mekân gibi temel unsurlar."
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 41.54,
            "width": 31.0,
            "text": "Ana karakterlerin kişilik özellikleri ve yaşadıkları temel çatışma."
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 47.63,
            "width": 31.0,
            "text": "Yazarın dili, üslubu ve anlatımında kullandığı söz sanatları."
          },
          {
            "type": "lines",
            "left": 45.5,
            "top": 53.72,
            "width": 31.0,
            "text": "Kitabın okuyucuya ilettiği ana fikir ve hayata dair çıkarımlar."
          }
        ]
      }
    ],

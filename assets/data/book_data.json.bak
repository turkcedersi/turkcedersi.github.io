            "text": "FİİL (EYLEM)"
          },
          {
            "type": "lines",
            "left": 18.5,
            "top": 67.0,
            "width": 28.0,
            "height": 2.2,
            "text": "Atatürk, Meclis, sandalye,"
          },
          {
            "type": "lines",
            "left": 18.5,
            "top": 69.5,
            "width": 28.0,
            "height": 2.2,
            "text": "duvar, boya, masa,"
          },
          {
            "type": "lines",
            "left": 18.5,
            "top": 72.0,
            "width": 28.0,
            "height": 2.2,
            "text": "harita, kapı, perde,"
          },
          {
            "type": "lines",
            "left": 18.5,
            "top": 74.5,
            "width": 28.0,
            "height": 2.2,
            "text": "asker, sehpa, oda, halı"
          },
          {
            "type": "lines",
            "left": 56.5,
            "top": 67.0,
            "width": 28.0,
            "height": 2.2,
            "text": "onarıldı, dinliyor,"
          },
          {
            "type": "lines",
            "left": 56.5,
            "top": 69.5,
            "width": 28.0,
            "height": 2.2,
            "text": "solmuş, konulmuş,"
          },
          {
            "type": "lines",
            "left": 56.5,
            "top": 72.0,
            "width": 28.0,
            "height": 2.2,
            "text": "değişmiş, açıldı,"
          },
          {
            "type": "lines",
            "left": 56.5,
            "top": 74.5,
            "width": 28.0,
            "height": 2.2,
            "text": "girdi, toplanmış, duruyor"
          }
        ]
      }
    ],
    "80": [
      {
        "id": "p80_9_c",
        "title": "9. Etkinlik (Müze Betimleme Planı)",
        "button": {
          "left": 5.2,
          "top": 68.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 71.2,
            "width": 71.0,
            "height": 2.4,
            "text": "Görseldeki müze salonu, Millî Mücadele'nin kaderini belirleyen tarihî bir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 73.7,
            "width": 71.0,
            "height": 2.4,
            "text": "Odanın tam ortasında kırmızı çuha örtülü geniş bir masa ve etrafında topla."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 76.2,
            "width": 71.0,
            "height": 2.4,
            "text": "Komutanlar masanın üzerindeki harp haritasını dikkatle inceleyerek taarruz."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 78.8,
            "width": 71.0,
            "height": 2.4,
            "text": "İki yanda gururla dalgalanan Türk bayrakları salona resmî, vakur ve millî."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 81.5,
            "width": 71.0,
            "height": 2.4,
            "text": "Tavandan sarkan klasik avize odayı aydınlatırken balmumu heykellerin yüzün."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 84.1,
            "width": 71.0,
            "height": 2.4,
            "text": "Türk ordusunun vatan sevgisini ve bağımsızlık inancını derinden hissettirir."
          }
        ]
      }
    ],
    "81": [
      {
        "id": "p81_9_devam",
        "title": "9. Etkinlik (Taslak ve Gözden Geçirilmiş Metin)",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 16.3,
            "width": 71.0,
            "height": 2.8,
            "text": "Müze salonuna girdiğimde kendimi bir anda Kurtuluş Savaşı karargâhında bul."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 18.8,
            "width": 71.0,
            "height": 2.8,
            "text": "Ortada büyük kırmızı bir masa, üzerinde harita ve etrafında Atatürk ile ko."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 21.4,
            "width": 71.0,
            "height": 2.8,
            "text": "Bayraklar dimdik duruyor, balmumu heykeller sanki her an konuşacakmış gibi."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 23.9,
            "width": 71.0,
            "height": 2.8,
            "text": "Bu tarihî atmosfer beni hem çok duygulandırdı hem de göğsümü millî bir gur."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 42.2,
            "width": 71.0,
            "height": 2.8,
            "text": "Müzenin loş koridorundan geçip toplantı salonuna adım attığımda tarih gözl."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 44.7,
            "width": 71.0,
            "height": 2.8,
            "text": "Odanın merkezinde kırmızı örtülü bir masa, strateji haritası ve subaylar v."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 47.2,
            "width": 71.0,
            "height": 2.8,
            "text": "Görkemli Türk bayrakları ve balmumu heykellerdeki sarsılmaz inanç beni büy."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 49.7,
            "width": 71.0,
            "height": 2.8,
            "text": "Burada olmak, atalarımızın bağımsızlık uğruna verdiği destansı mücadeleyi."
          }
        ]
      }
    ],
    "85": [
      {
        "id": "p85_1_a",
        "title": "1. Etkinlik (a - Tahmin ve Gerekçe)",
        "button": {
          "left": 5.2,
          "top": 10.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 15.1,
            "width": 72.0,
            "height": 2.2,
            "text": "Metnin başlığından ve görselinden hareketle, Basmane İstasyonu'nda ailesiyle vedalaşıp"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 17.7,
            "width": 72.0,
            "height": 2.2,
            "text": "cepheye giden Hüseyin'in annesine yazdığı duygu dolu mektupların anlatıldığını tahmin ediyorum."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 20.2,
            "width": 72.0,
            "height": 2.2,
            "text": "Çünkü başlık 'Oğlu Hüseyin'den Emine Ana'ya Mektuplar'dır ve resimde istasyonda hüzünle"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 22.7,
            "width": 72.0,
            "height": 2.2,
            "text": "vedalaşan fedakâr bir anne, koltuk değnekli bir ağabey ile cephe yolcusu bir asker görülmektedir."
          }
        ]
      },
      {
        "id": "p85_1_b",
        "title": "1. Etkinlik (b - Tahminlerin Değerlendirilmesi)",
        "button": {
          "left": 5.2,
          "top": 27.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 33.0,
            "width": 72.0,
            "height": 2.2,
            "text": "Evet, metnin içeriğiyle ilgili yaptığım tahminler bütünüyle doğru çıktı."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 35.5,
            "width": 72.0,
            "height": 2.2,
            "text": "Hüseyin'in annesine yazdığı mektuplarda cephe hayatı, kardeşlerine olan sevgisi ve vatan inancı anlatılıyor."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 38.0,
            "width": 72.0,
            "height": 2.2,
            "text": "Metnin başlığı konuyu doğrudan belirttiği ve görsel de ayrılık anını çok net yansıttığı için"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 40.5,
            "width": 72.0,
            "height": 2.2,
            "text": "tahminlerimin doğru çıkmasında görsel ve başlıktan kurduğum gerekçeler çok etkili oldu."
          }
        ]
      }
    ],

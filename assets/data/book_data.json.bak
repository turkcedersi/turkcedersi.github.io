            "text": "✓"
          }
        ]
      },
      {
        "id": "p68_q4_c",
        "title": "4. Soru C: Motivasyon Defteri Ana Mesajı",
        "button": {
          "left": 6.5,
          "top": 52.0
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 58.14,
            "width": 78.0,
            "text": "İzlediğim içerikte verilmek istenen temel mesaj; insanın hayatta başarıya ulaşabilmesi için"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 60.71,
            "width": 78.0,
            "text": "zamanını planlı ve verimli yönetmesinin en belirleyici etken olduğudur."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 63.27,
            "width": 78.0,
            "text": "Beyhan Budak, erteleme alışkanlığının ve programsız yaşamanın hedeflere ulaşmayı"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 65.83,
            "width": 78.0,
            "text": "engellediğini, motivasyonun sadece beklemekle değil düzenli adımlar atmakla artacağını belirtir."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 68.4,
            "width": 78.0,
            "text": "Günlük ve haftalık küçük hedefler koymak, öncelikleri doğru belirlemek ve dikkat dağıtıcı"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 70.96,
            "width": 78.0,
            "text": "unsurlardan uzak durmak bireyin hedeflerine adım adım yaklaşmasını sağlar."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 73.53,
            "width": 78.0,
            "text": "Özetle; planlı çalışmak ve sabırla gayret göstermek, hayallerimizi gerçeğe dönüştürmenin"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 76.15,
            "width": 78.0,
            "text": "ve yaşam kalitemizi artırmanın vazgeçilmez anahtarıdır."
          }
        ]
      }
    ],
    "69": [
      {
        "id": "p69_q6",
        "title": "6. Soru: Zamanı Verimli Kullanma Paragrafı",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 14.94,
            "width": 78.0,
            "text": "\"Vakit nakittir.\" ve \"Bugünün işini yarına bırakma.\" sözleri zamanın geri getirilemez"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 17.5,
            "width": 78.0,
            "text": "değerini en veciz şekilde ifade eder. Zamanı verimli kullanan bireyler görevlerini"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 20.13,
            "width": 78.0,
            "text": "vaktinde bitirdikleri için hem stresten uzak kalır hem de hedeflerine hızla ulaşırlar."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 22.69,
            "width": 78.0,
            "text": "Buna karşılık zamanını planlamayan kişiler sürekli işlerini ertelediklerinden ötürü"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 25.26,
            "width": 78.0,
            "text": "başarısızlık ve pişmanlık duygusu yaşarlar. Bu sebeple zamanı doğru yönetmek,"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 27.82,
            "width": 78.0,
            "text": "başarı ve huzur dolu bir geleceğin en temel hazırlayıcısıdır."
          }
        ]
      },
      {
        "id": "p69_q7_a",
        "title": "7. Etkinlik A: Noktalı Virgül Görevleri",
        "button": {
          "left": 6.5,
          "top": 36.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 46.15,
            "width": 76.5,
            "text": "Cümle içinde virgüllerle ayrılmış tür veya takımları"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 48.85,
            "width": 76.5,
            "text": "birbirinden ayırmak için kullanılmıştır (afiş grubu ve sunum grubu)."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 62.95,
            "width": 76.5,
            "text": "Ögeleri arasında virgül bulunan sıralı cümleleri"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 65.64,
            "width": 76.5,
            "text": "birbirinden ayırmak için kullanılmıştır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 79.74,
            "width": 76.5,
            "text": "İkiden fazla eş değer ögeler arasında virgül bulunan cümlelerde"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 82.44,
            "width": 76.5,
            "text": "özneden sonra kullanılmıştır (özne: \"Gerçek başarı\")."
          }
        ]
      }
    ],
    "70": [
      {
        "id": "p70_q7_b",
        "title": "7. Etkinlik B: Noktalı Virgül Örnek Cümleleri",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 15.0,
            "top": 13.4,
            "width": 72.0,
            "text": "Pazardan elma, armut, muz; ıspanak, pırasa, havuç aldım."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 22.12,
            "width": 72.0,
            "text": "At ölür, meydan kalır; yiğit ölür, şan kalır."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 30.77,
            "width": 72.0,
            "text": "Ahmet; çalışkan, dürüst ve saygılı bir öğrencidir."
          }
        ]
      },
      {
        "id": "p70_q8",
        "title": "8. Soru: Çatlak Testi Hikâyesi Tamamlama (Düğüm ve Çözüm)",
        "button": {
          "left": 6.5,
          "top": 40.0
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 56.54,
            "width": 78.0,
            "text": "Kusursuz olan diğer testi, her seferinde suyunu tam taşıdığı için gururlanıyor; çatlak"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 59.1,
            "width": 78.0,
            "text": "testi ise suyunu sızdırdığı için kendini yetersiz ve suçlu hissediyordu. Bir gün nehir"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 61.67,
            "width": 78.0,
            "text": "kenarında üzüntüyle sucuya: \"Kusurum yüzünden emeklerini ziyan ediyorum.\" dedi."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 64.23,
            "width": 78.0,
            "text": "Sucu şefkatle gülümseyerek: \"Yol boyunca senin yürüdüğün taraftaki çiçekleri gördün mü?"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 66.79,
            "width": 78.0,
            "text": "Ben senin çatlak olduğunu bildiğim için yolun senin tarafına rengârenk çiçek tohumları ektim."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 69.42,
            "width": 78.0,
            "text": "Sen her gün o güzel çiçekleri suladın ve sayende evimize, kasabamıza güzellik kattık.\" dedi."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 71.99,
            "width": 78.0,
            "text": "Bu sözleri duyan testi, kusur sandığı özelliğinin büyük bir fayda sağladığını anlayıp"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 74.55,
            "width": 78.0,
            "text": "içini kaplayan hüzünden kurtuldu ve hayatına huzur dolu bir sevinçle devam etti."
          }
        ]
      }
    ],

          {
            "type": "lines",
            "left": 13.0,
            "top": 32.76,
            "width": 74.0,
            "text": "birlikte kültürel bir etkinlik yapmanın gururuyla sınıf içi kaynaşmamız güçlenecektir."
          }
        ]
      },
      {
        "id": "p62_taslak",
        "title": "Küçük Grupla Uyguluyorsunuz: Kitap Fuarı İkna Taslağı",
        "button": {
          "left": 6.5,
          "top": 38.0
        },
        "items": [
          {
            "type": "lines",
            "left": 12.0,
            "top": 40.9,
            "width": 76.0,
            "text": "Değerli Öğretmenimiz,"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 43.46,
            "width": 76.0,
            "text": "Bu hafta şehrimizde açılan kitap fuarına sınıfça katılmayı ve birlikte kitapların"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 46.03,
            "width": 76.0,
            "text": "büyülü dünyasını keşfetmeyi çok arzu ediyoruz. Derslerde bizlere aşıladığınız okuma"

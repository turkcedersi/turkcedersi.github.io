    "29": [
      {
        "id": "p29_10",
        "title": "10. Etkinlik",
        "button": {
          "left": 5.0,
          "top": 22.0
        },
        "items": [
          {
            "type": "badge",
            "left": 19.5,
            "top": 30.2,
            "width": 13.0,
            "height": 2.5,
            "text": "Kâmil"
          },
          {
            "type": "badge",
            "left": 38.0,
            "top": 30.2,
            "width": 13.0,
            "height": 2.5,
            "text": "Mert"
          },
          {
            "type": "badge",
            "left": 56.5,
            "top": 30.2,
            "width": 13.0,
            "height": 2.5,
            "text": "Hayri"
          },
          {
            "type": "badge",
            "left": 75.0,
            "top": 30.2,
            "width": 13.0,
            "height": 2.5,
            "text": "Akın"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 39.8,
            "width": 18.0,
            "height": 2.4,
            "text": "Sakin, ağırbaşlı"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 39.8,
            "width": 18.0,
            "height": 2.4,
            "text": "Lider ruhlu, cesur"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 39.8,
            "width": 18.0,
            "height": 2.4,
            "text": "Neşeli, esprili, obur"
          },
          {
            "type": "lines",
            "left": 73.0,
            "top": 39.8,
            "width": 18.0,
            "height": 2.4,
            "text": "Meraklı, zeki"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 42.7,
            "width": 18.0,
            "height": 2.4,
            "text": "Mantıklı düşünen"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 42.7,
            "width": 18.0,
            "height": 2.4,
            "text": "Arkadaş canlısı"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 42.7,
            "width": 18.0,
            "height": 2.4,
            "text": "Şakacı, sempatik"
          },
          {
            "type": "lines",
            "left": 73.0,
            "top": 42.7,
            "width": 18.0,
            "height": 2.4,
            "text": "Teknolojiye düşkün"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 45.6,
            "width": 18.0,
            "height": 2.4,
            "text": "Sorumluluk sahibi"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 45.6,
            "width": 18.0,
            "height": 2.4,
            "text": "Çözüm odaklı"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 45.6,
            "width": 18.0,
            "height": 2.4,
            "text": "İçten, samimi"
          },
          {
            "type": "lines",
            "left": 73.0,
            "top": 45.6,
            "width": 18.0,
            "height": 2.4,
            "text": "Araştırmacı ruhlu"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 48.5,
            "width": 18.0,
            "height": 2.4,
            "text": "Güvenilir dost"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 48.5,
            "width": 18.0,
            "height": 2.4,
            "text": "Yardımsever"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 48.5,
            "width": 18.0,
            "height": 2.4,
            "text": "Keyifli, enerjik"
          },
          {
            "type": "lines",
            "left": 73.0,
            "top": 48.5,
            "width": 18.0,
            "height": 2.4,
            "text": "Pratik zekâlı"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 56.2,
            "width": 18.0,
            "height": 2.4,
            "text": "Uzun boylu, zayıf"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 56.2,
            "width": 18.0,
            "height": 2.4,
            "text": "Orta boylu, atletik"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 56.2,
            "width": 18.0,
            "height": 2.4,
            "text": "Toplu, tombul yanaklı"
          },
          {
            "type": "lines",
            "left": 73.0,
            "top": 56.2,
            "width": 18.0,
            "height": 2.4,
            "text": "Kısa boylu, sevimli"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 59.1,
            "width": 18.0,
            "height": 2.4,
            "text": "Gözlüklü, kumral"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 59.1,
            "width": 18.0,
            "height": 2.4,
            "text": "Siyah dalgalı saçlı"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 59.1,
            "width": 18.0,
            "height": 2.4,
            "text": "Gür kıvırcık saçlı"
          },
          {
            "type": "lines",
            "left": 73.0,
            "top": 59.1,
            "width": 18.0,
            "height": 2.4,
            "text": "Sarı saçlı, gözlüklü"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 62.0,
            "width": 18.0,
            "height": 2.4,
            "text": "Mavi çizgili tişört"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 62.0,
            "width": 18.0,
            "height": 2.4,
            "text": "Kırmızı polo tişört"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 62.0,
            "width": 18.0,
            "height": 2.4,
            "text": "Yeşil bol tişört"
          },
          {
            "type": "lines",
            "left": 73.0,
            "top": 62.0,
            "width": 18.0,
            "height": 2.4,
            "text": "Turuncu tişört, kot"
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 64.9,
            "width": 18.0,
            "height": 2.4,
            "text": "Ciddi bir duruş"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 64.9,
            "width": 18.0,
            "height": 2.4,
            "text": "Güleryüzlü ve dinamik"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 64.9,
            "width": 18.0,
            "height": 2.4,
            "text": "Geniş gülümsemeli"
          },
          {
            "type": "lines",
            "left": 73.0,
            "top": 64.9,
            "width": 18.0,
            "height": 2.4,
            "text": "Gözleri parlayan"
          }
        ]
      }
    ],

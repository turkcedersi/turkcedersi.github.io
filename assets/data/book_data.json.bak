      {
        "id": "p56_14",
        "title": "14. Etkinlik (Türk Kahvesi)",
        "button": {
          "left": 5.0,
          "top": 48.0
        },
        "items": [
          {
            "type": "lines",
            "left": 22.0,
            "top": 55.8,
            "width": 66.0,
            "height": 2.4,
            "text": "Türk kahvesi kültürü, geleneği ve toplumsal önemi"
          },
          {
            "type": "lines",
            "left": 46.5,
            "top": 58.5,
            "width": 41.5,
            "height": 2.4,
            "text": "Türk kahvesinin pişirilme usulü, köpüğü"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 61.1,
            "width": 70.0,
            "height": 2.4,
            "text": "ve ikram adabıyla dostluk ve muhabbet vesilesi olduğu anlatılmıştır."
          },
          {
            "type": "mark",
            "left": 23.1,
            "top": 63.3,

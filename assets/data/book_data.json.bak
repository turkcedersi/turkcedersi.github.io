        },
        "items": [
          {
            "type": "box",
            "left": 60.5,
            "top": 24.5,
            "width": 15.0,
            "text": "Uygundur. Çünkü ana başlık ve alt başlıklar metnin tarihi seyrini eksiksiz yansıtmaktadır."

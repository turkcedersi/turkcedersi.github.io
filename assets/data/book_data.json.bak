  "book6_inpage_answers": {
    "11": [
      {
        "id": "p11_hazirlik",
        "title": "Hazırlık Vakti",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 20.71,
            "width": 74.0,
            "text": "Halı ve kilimler; Türk milletinin sevinçlerini, hüzünlerini, özlemlerini ve doğayla kurduğu bağı"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 23.27,
            "width": 74.0,
            "text": "ilmek ilmek dokuduğu, zengin kültürel mirasımızı kuşaktan kuşağa aktaran en önemli sanat eserlerindendir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 31.6,
            "width": 74.0,
            "text": "Göz, akrep, eli belinde, koçboynuzu, hayat ağacı ve bereket gibi motifler; dokuyanın duygularını,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 34.17,
            "width": 74.0,
            "text": "inançlarını ve dileklerini yansıtan evrensel bir sembolik dil oluşturur."
          }
        ]
      }
    ],
    "14": [
      {
        "id": "p14_etk1a",
        "title": "1. Etkinlik: Kelime Eşleştirme",
        "button": {
          "left": 88.0,
          "top": 16.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.95,
            "width": 74.0,
            "text": "Kirkit: Dokunan halı veya kilimin ilmeklerini sıkıştırmak için kullanılan demir ya da tahta tarak."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.79,
            "width": 74.0,
            "text": "Istar: Halı, kilim ve bez dokunan tezgâhın yöresel adı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 30.64,
            "width": 74.0,
            "text": "Çözgü: Dokuma tezgâhında boyuna gerilen dayanıklı iplerin bütünü."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 34.49,
            "width": 74.0,
            "text": "Kök Boya: Doğal bitki köklerinden, kabuklarından ve yapraklarından elde edilen dayanıklı boya."
          }
        ]
      },
      {
        "id": "p14_etk1b",
        "title": "1. Etkinlik B: Kilim Çağrışımları",
        "button": {
          "left": 88.0,
          "top": 62.0
        },
        "items": [
          {
            "type": "badge",
            "left": 20.0,
            "top": 68.0,
            "width": 16.0,
            "text": "Kültür / Tarih"
          },
          {
            "type": "badge",
            "left": 42.0,
            "top": 68.0,
            "width": 16.0,
            "text": "Göz Nuru / Emek"
          },
          {
            "type": "badge",
            "left": 64.0,
            "top": 68.0,
            "width": 16.0,
            "text": "Anadolu Ruhu"
          },
          {
            "type": "badge",
            "left": 31.0,
            "top": 78.0,
            "width": 16.0,
            "text": "İlmek İlmek Sevgi"
          },
          {
            "type": "badge",
            "left": 53.0,
            "top": 78.0,
            "width": 16.0,
            "text": "Geleneksel Motif"
          }
        ]
      }
    ],
    "15": [
      {
        "id": "p15_etk2",
        "title": "2. Etkinlik: Metin Soruları",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 19.36,
            "width": 74.0,
            "text": "Kilim; Anadolu insanının iç dünyasını, konuşamadığı sırlarını, sevdasını, umudunu ve kederini"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 21.99,
            "width": 74.0,
            "text": "renkler ve motifler vasıtasıyla dışa vurduğu sessiz bir anlatım ve haberleşme aracıdır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 24.55,
            "width": 74.0,
            "text": "Bu yönüyle kilim, konuşan bir dil ve taşa, toprağa kazınan canlı bir tarihtir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.37,
            "width": 74.0,
            "text": "Kilimlerde kullanılan kırmızı renk cana yakınlığı ve sevgiyi; mavi umudu ve enginliği; sarı hüznü"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 34.94,
            "width": 74.0,
            "text": "ve hasreti; yeşil ise muradı, bereketi ve doğanın canlılığını simgelemektedir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 37.5,
            "width": 74.0,
            "text": "Her renk, dokuyanın o anki duygu durumunun açık bir tercümesidir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 45.38,
            "width": 74.0,
            "text": "Eli belinde motifi analığı, bereketi ve dişiliği; koçboynuzu kahramanlığı ve gücü simgeler."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 47.95,
            "width": 74.0,
            "text": "Akrep motifi kötülüklerden korunmayı, göz motifi ise nazardan sakınmayı temsil etmektedir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 50.51,
            "width": 74.0,
            "text": "Bu motifler sayesinde kilimler âdeta birer koruyucu ve dilek belgesi hâline gelir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 58.78,
            "width": 74.0,
            "text": "Geleneksel el dokuma kilimlerimizin fabrikasyon üretim karşısında unutulması,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 61.35,
            "width": 74.0,
            "text": "kültürel hafızamızın ve köklü sanat mirasımızın kaybolma tehlikesidir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 63.97,
            "width": 74.0,
            "text": "Bu eşsiz mirası yaşatmak ve tanıtmak kendi öz kimliğimizi korumaktır."
          }
        ]
      }
    ],
    "16": [
      {
        "id": "p16_etk4",
        "title": "4. Etkinlik: Problem ve Çözüm Önerileri",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 16.86,
            "width": 74.0,
            "text": "Geleneksel Anadolu el dokuma kilimlerinin fabrikasyon ürünler karşısında değer kaybetmesi ve yok olması."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 19.42,
            "width": 74.0,
            "text": "Yeni neslin kilim dokuma sanatına ilgi göstermemesi ve usta dokuyucuların yetişmemesi."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 28.4,
            "width": 74.0,
            "text": "Halk eğitim merkezlerinde ve meslek liselerinde dokumacılık atölyeleri açılarak gençlere burs verilmeli."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 30.96,
            "width": 74.0,
            "text": "Geleneksel dokuma ustalarının bilgi ve tecrübeleri dijital ortamlarda kayıt altına alınarak arşivlenmeli."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 37.37,
            "width": 74.0,
            "text": "El dokuması ürünlerin tescili ve coğrafi işaret koruması sağlanarak uluslararası pazarlarda tanıtımı yapılmalı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 39.94,
            "width": 74.0,
            "text": "Modern tasarımcılar ile geleneksel dokuyucular bir araya getirilerek çağa uygun yenilikçi eserler üretilmeli."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 48.91,
            "width": 74.0,
            "text": "Dokuma atölyelerinin yaygınlaştırılması ve gençlerin teşvik edilmesi en kalıcı ve sürdürülebilir çözümdür."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 51.47,
            "width": 74.0,
            "text": "Çünkü bir sanatı yaşatmanın tek yolu, onu uygulayacak istekli eller ve nesiller yetiştirmektir."
          }
        ]
      }
    ],
    "17": [
      {
        "id": "p17_etk5",
        "title": "5. Etkinlik: Öznel ve Nesnel Yargılar",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "badge",
            "left": 75.0,
            "top": 21.8,
            "width": 10.0,
            "text": "Öznel"
          },
          {
            "type": "badge",
            "left": 75.0,
            "top": 27.5,
            "width": 10.0,
            "text": "Nesnel"
          },
          {
            "type": "badge",
            "left": 75.0,
            "top": 33.2,
            "width": 10.0,
            "text": "Öznel"
          },
          {
            "type": "badge",
            "left": 75.0,
            "top": 39.0,
            "width": 10.0,
            "text": "Nesnel"
          },
          {
            "type": "badge",
            "left": 75.0,
            "top": 44.8,
            "width": 10.0,
            "text": "Öznel"
          }
        ]
      },
      {
        "id": "p17_etk6",
        "title": "6. Etkinlik: İkna Edici Konuşma Notları",
        "button": {
          "left": 88.0,
          "top": 55.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 59.81,
            "width": 74.0,
            "text": "Sevgili arkadaşlar; evlerimize aldığımız fabrikasyon halılar sadece soğuğu kesen birer eşyadır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 62.37,
            "width": 74.0,
            "text": "Oysa bir el dokuma kilim aldığınızda, evinize bir annenin sevgisini, bin yıllık bir milletin"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 64.94,
            "width": 74.0,
            "text": "tarihini ve sanatkârın göz nurunu konuk edersiniz. Kültürümüzü yaşatmak kendi özümüze sahip çıkmaktır."
          }
        ]
      }
    ],
    "18": [
      {
        "id": "p18_etk7",
        "title": "7. Etkinlik: Metin Karşılaştırma Tablosu",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 23.27,
            "width": 35.0,
            "text": "Konu: Anadolu kilimlerinin anlamı, dili ve kültürel değeri."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.47,
            "width": 35.0,
            "text": "Tür: Deneme / İnceleme yazısı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 29.68,
            "width": 35.0,
            "text": "Anlatım: Samimi, duygusal ve betimleyici bir dil."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 35.0,
            "text": "Amaç: Okuyucuda kültürel farkındalık ve sevgi oluşturmak."
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 23.27,
            "width": 35.0,
            "text": "Konu: Halı ve kilim dokumacılığının teknik aşamaları."
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 26.47,
            "width": 35.0,
            "text": "Tür: Bilgilendirici metin / Makale."
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 29.68,
            "width": 35.0,
            "text": "Anlatım: Nesnel, bilimsel ve öğretici anlatım."
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 32.88,
            "width": 35.0,
            "text": "Amaç: Okuyucuya dokuma teknikleri hakkında bilgi vermek."
          }
        ]
      }
    ],
    "19": [
      {
        "id": "p19_etk8",
        "title": "8. Etkinlik: Çini Sanatı Kartları",
        "button": {
          "left": 88.0,
          "top": 14.0
        },
        "items": [
          {
            "type": "box",
            "left": 12.0,
            "top": 24.5,
            "width": 23.0,
            "text": "Hamur Hazırlığı: Kaolin, kil ve kuvars suyla karıştırılıp dinlendirilir."
          },
          {
            "type": "box",
            "left": 38.5,
            "top": 24.5,
            "width": 23.0,
            "text": "Şekillendirme: Çarkta veya kalıplarda tabak, vazo ve karo formuna getirilir."
          },
          {
            "type": "box",
            "left": 65.0,
            "top": 24.5,
            "width": 23.0,
            "text": "İlk Pişirim (Bisküvi): Kuruyan parçalar fırında yaklaşık 900°C'de pişirilir."
          },
          {
            "type": "box",
            "left": 12.0,
            "top": 58.5,
            "width": 23.0,
            "text": "Desen Çizimi (Tahrir): Kömür tozuyla desen aktarılır ve siyah boyayla kontur çekilir."
          },
          {
            "type": "box",
            "left": 38.5,
            "top": 58.5,
            "width": 23.0,
            "text": "Boyama & Sırlama: Doğal minerallerle renklendirilip üzeri sırça tabakayla kaplanır."
          },
          {
            "type": "box",
            "left": 65.0,
            "top": 58.5,
            "width": 23.0,
            "text": "Sır Pişirimi: Parçalar ikinci kez fırınlanarak o parlak ve dayanıklı hâline kavuşur."
          }
        ]
      }
    ],
    "20": [
      {
        "id": "p20_etk9_10",
        "title": "9. & 10. Etkinlik: Çini Desen Analizi",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.19,
            "width": 74.0,
            "text": "Klasik İznik çinilerinde lale, karanfil, gül, servi ve saz yaprakları gibi doğa motifleri hâkimdir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 27.76,
            "width": 74.0,
            "text": "Lale tasavvufta Allah'ın birliğini simgelerken, karanfil samimiyeti ve bağlılığı temsil eder."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 38.01,
            "width": 74.0,
            "text": "Bitkisel Motifler: Lale, sümbül, karanfil, bahar dalı, nar çiçeği, asma yaprağı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 40.58,
            "width": 74.0,
            "text": "Geometrik Motifler: Sekizgen yıldızlar, sonsuzluk geçmeleri, zencerek örgüleri."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 43.14,
            "width": 74.0,
            "text": "Figüratif Motifler: Çift başlı kartal, tavus kuşu, ceylan ve balık sembolleri."
          }
        ]
      }
    ],
    "21": [
      {
        "id": "p21_etk11",
        "title": "11. Etkinlik: Sanatın Gücü Yazısı",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 19.42,
            "width": 74.0,
            "text": "Başlık: Toprağa ve İpliğe Can Veren Eller"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 23.27,
            "width": 74.0,
            "text": "Sanat, insanın ruhundaki güzellikleri maddeyle buluşturma mucizesidir. Anadolu'nun bin yıllık"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.15,
            "width": 74.0,
            "text": "köylerinde bir kadın kilim dokurken sadece iplikleri değil, yüreğindeki sevdayı ve özlemi dokur."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 29.04,
            "width": 74.0,
            "text": "Bir çini ustası ise çamurun soğukluğunu fırının ateşiyle ve sırın parlaklığıyla ebedî bir zarafete dönüştürür."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 31.92,
            "width": 74.0,
            "text": "Bu eserler sadece görsel bir şölen değil, geçmişimizin hafızası ve kimliğimizin tapu senetleridir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 34.81,
            "width": 74.0,
            "text": "Bizler bu mirasa sahip çıktıkça köklerimiz sağlam kalacak, geleceğe güvenle bakabileceğiz."
          }
        ]
      }
    ],
    "22": [
      {
        "id": "p22_gelecek",
        "title": "Gelecek Derse Hazırlık",
        "button": {
          "left": 88.0,
          "top": 45.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 46.99,
            "width": 74.0,
            "text": "Karagöz ve Hacivat oyunlarının kökeni, tipleri (Çelebi, Tuzsuz Deli Bekir, Zenne, Beberuhi) ve"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 49.87,
            "width": 74.0,
            "text": "Geleneksel Türk Tiyatrosu türleri (Orta Oyunu, Meddah, Köy Seyirlik Oyunları) araştırılmıştır."
          }
        ]
      }
    ],
    "23": [
      {
        "id": "p23_hazirlik",
        "title": "Hazırlık Vakti: Geleneksel Tiyatro",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 21.99,
            "width": 74.0,
            "text": "Geleneksel tiyatromuz; yazılı bir metne dayanmayan (doğaçlama/tuluat), güldürürken düşündüren,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 24.87,
            "width": 74.0,
            "text": "taklit ve şive taklitlerine dayanan, seyirciyle iç içe samimi bir halk eğlencesidir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.24,
            "width": 74.0,
            "text": "Karagöz halkın sağduyusunu ve açık sözlülüğünü; Hacivat ise yarı aydın, kuralcı ve çıkarcı kesimi temsil eder."
          }
        ]
      }
    ],
    "25": [
      {
        "id": "p25_etk1",
        "title": "1. Etkinlik: Tiyatro Terimleri",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.63,
            "width": 74.0,
            "text": "Tuluat: Yazılı bir metne bağlı kalmadan, sahnede akla geliveren sözlerle oynanan doğaçlama oyun."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.15,
            "width": 74.0,
            "text": "Hayalî (Hayalbaz): Karagöz oyununda tasvirleri perde arkasında oynatan ve seslendiren usta sanatçı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 29.68,
            "width": 74.0,
            "text": "Tasvir: Karagöz gölge oyununda manda veya deve derisinden kesilip boyanmış figürler."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 33.21,
            "width": 74.0,
            "text": "Küşteri Meydanı: Karagöz perdesine, bu sanatın piri kabul edilen Şeyh Küşteri'nin anısına verilen ad."
          },
          {
            "type": "badge",
            "left": 15.0,
            "top": 72.0,
            "width": 16.0,
            "text": "Doğaçlama"
          },
          {
            "type": "badge",
            "left": 35.0,
            "top": 72.0,
            "width": 16.0,
            "text": "Mizah / Nükte"
          },
          {
            "type": "badge",
            "left": 55.0,
            "top": 72.0,
            "width": 16.0,
            "text": "Gölge Oyunu"
          },
          {
            "type": "badge",
            "left": 75.0,
            "top": 72.0,
            "width": 16.0,
            "text": "Halk Kültürü"
          }
        ]
      }
    ],
    "26": [
      {
        "id": "p26_etk3",
        "title": "3. Etkinlik: Tiyatro Türleri Tablosu",
        "button": {
          "left": 88.0,
          "top": 45.0
        },
        "items": [
          {
            "type": "box",
            "left": 71.0,
            "top": 53.0,
            "width": 18.0,
            "text": "Canlı oyuncular (Kavuklu, Pişekâr vb.) oynar."
          },
          {
            "type": "box",
            "left": 31.0,
            "top": 62.5,
            "width": 18.0,
            "text": "Halkı güldürürken ahlaki dersler vermek."
          },
          {
            "type": "box",
            "left": 51.0,
            "top": 62.5,
            "width": 18.0,
            "text": "Eğlendirirken aksaklıkları hicvetmek."
          },
          {
            "type": "box",
            "left": 71.0,
            "top": 62.5,
            "width": 18.0,
            "text": "Seyirciyi güldürerek düşündürmek."
          },
          {
            "type": "box",
            "left": 31.0,
            "top": 69.0,
            "width": 18.0,
            "text": "Halk hikâyeleri, destanlar ve komik olaylar."
          },
          {
            "type": "box",
            "left": 51.0,
            "top": 69.0,
            "width": 18.0,
            "text": "Toplumsal tipler ve yanlış anlamalar."
          },
          {
            "type": "box",
            "left": 71.0,
            "top": 69.0,
            "width": 18.0,
            "text": "Sosyal zümrelerin nükteli çatışması."
          },
          {
            "type": "box",
            "left": 31.0,
            "top": 75.4,
            "width": 18.0,
            "text": "Yazılı metin yoktur, doğaçlamaya dayanır."
          },
          {
            "type": "box",
            "left": 51.0,
            "top": 75.4,
            "width": 18.0,
            "text": "Belirli taslak olsa da oyun doğaçlamadır."
          },
          {
            "type": "box",
            "left": 71.0,
            "top": 75.4,
            "width": 18.0,
            "text": "Yazılı metin yoktur, tuluatla oynanır."
          },
          {
            "type": "box",
            "left": 31.0,
            "top": 81.8,
            "width": 18.0,
            "text": "Eski ozan-baksı anlatı geleneğine uzanır."
          },
          {
            "type": "box",
            "left": 51.0,
            "top": 81.8,
            "width": 18.0,
            "text": "16. yüzyıldan beri sevilerek oynanır."
          },
          {
            "type": "box",
            "left": 71.0,
            "top": 81.8,
            "width": 18.0,
            "text": "19. yüzyılda meydanlarda gelişmiştir."
          }
        ]
      }
    ],
    "27": [
      {
        "id": "p27_etk5",
        "title": "5. Etkinlik: Afiş Çözümleme A",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 74.0,
            "text": "Afişte geleneksel motiflerle bezenmiş bir Karagöz perdesi ve renkli figürler dikkat çekmektedir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 35.77,
            "width": 74.0,
            "text": "Kullanılan canlı renkler tiyatronun neşeli ve dinamik yapısını, sıcak halk atmosferini yansıtmaktadır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 38.65,
            "width": 74.0,
            "text": "Yazı fontu ve kompozisyon, etkinliğin hem çocuklara hem de yetişkinlere hitap ettiğini açıkça vurgular."
          }
        ]
      }
    ],
    "28": [
      {
        "id": "p28_etk5b_6",
        "title": "5. Etkinlik B & 6. Etkinlik Dinleme",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 19.42,
            "width": 74.0,
            "text": "Hedef kitle: Geleneksel sanatlarımıza ve tiyatroya ilgi duyan tüm öğrenciler ve aileler."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.31,
            "width": 74.0,
            "text": "Afişin amacı: Kültürel mirası tanıtmak ve tiyatro sevgisini yaygınlaştırmaktır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 39.94,
            "width": 74.0,
            "text": "Prof. Dr. A. Süheyl Ünver; tıp doktoru, kültür adamı, tezhip, minyatür ve hat sanatı ustasıdır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 42.82,
            "width": 74.0,
            "text": "Ömrünü Türk-İslam sanat eserlerini defterlerine çizerek belgelemeye ve kaybolmaktan kurtarmaya adamıştır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 45.71,
            "width": 74.0,
            "text": "'Herkesin bir mesleği olmalı, bir de meşgalesi. O meşgale de Türk sanatları olmalı.' sözüyle bilinir."
          }
        ]
      }
    ],
    "29": [
      {
        "id": "p29_etk6b_7a",
        "title": "6. Etkinlik B & 7. Etkinlik A",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 21.35,
            "width": 74.0,
            "text": "Süheyl Ünver'in kişisel özellikleri: Son derece çalışkan, titiz, arşivci, sanatsever ve vatanseverdir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 24.23,
            "width": 74.0,
            "text": "Onun bu tutkusu sayesinde birçok tarihî çeşme, cami motifi ve yazma eser günümüze çizimlerle ulaşmıştır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 42.5,
            "width": 74.0,
            "text": "çiz-miş-ti-r : Öğrenilen geçmiş zamanın rivayeti / bildirme."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 45.38,
            "width": 74.0,
            "text": "araştır-ıyor : Şimdiki zaman kipi (3. tekil şahıs)."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 48.27,
            "width": 74.0,
            "text": "koru-malı-y-ız : Gereklilik kipi (1. çoğul şahıs)."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 51.15,
            "width": 74.0,
            "text": "unut-ma-ya-cağ-ız : Gelecek zaman kipi (olumsuz, 1. çoğul şahıs)."
          }
        ]
      }
    ],
    "30": [
      {
        "id": "p30_etk7b",
        "title": "7. Etkinlik B: Eser ve Katkıları Tablosu",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 24.55,
            "width": 74.0,
            "text": "Tıp Tarihi Alanındaki Hizmetleri: Gevrekzade Hasan Efendi ve Selçuklu tıp tarihi araştırmaları."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 28.08,
            "width": 74.0,
            "text": "Sanat Alanındaki Katkıları: Binlerce minyatür ve tezhip çalışması, sanat defterleri ve nakış atölyesi."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 31.6,
            "width": 74.0,
            "text": "Geleceğe Mirası: Kurduğu arşiv ve yetiştirdiği yüzlerce kıymetli talebe ile kültür köprüsü olmuştur."
          }
        ]
      }
    ],
    "32": [
      {
        "id": "p32_plan",
        "title": "Yazı Planı Tablosu",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 21.99,
            "width": 74.0,
            "text": "Konu: Geleneksel Türk tiyatrosunun günümüzdeki yeri ve yaşatılmasının önemi."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.51,
            "width": 74.0,
            "text": "Ana Fikir: Kültürel kimliğimizi korumak için geleneksel tiyatro mirasımıza sahip çıkmalıyız."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 30.64,
            "width": 74.0,
            "text": "Giriş: Tiyatronun insan hayatındaki yeri ve çocukluk hatıralarımızdaki Karagöz oyunu."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 35.13,
            "width": 74.0,
            "text": "Gelişme: Orta Oyunu ve Karagöz'ün güldürürken öğreten özellikleri; modern sahnelere uyarlanması."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 39.62,
            "width": 74.0,
            "text": "Sonuç: Genç nesillere bu zenginliği sevdirmek için atılması gereken somut adımlar."
          }
        ]
      }
    ],
    "33": [
      {
        "id": "p33_taslak",
        "title": "Taslak Metin",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 19.42,
            "width": 74.0,
            "text": "Başlık: Perdenin Ardındaki Hayat"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.63,
            "width": 74.0,
            "text": "Ramazan akşamlarında kahvehanelerin köşesine kurulan beyaz bir bez parçası, üzerine vuran mum ışığıyla"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.51,
            "width": 74.0,
            "text": "bambaşka bir dünyaya kapı aralardı. Karagöz ile Hacivat'ın tatlı atışmaları sadece bir komedi değil,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 28.4,
            "width": 74.0,
            "text": "toplumun aynasıydı. Halkın saflığını ve mertliğini simgeleyen Karagöz, kitabi konuşmalarla burnu havada gezen"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 31.28,
            "width": 74.0,
            "text": "Hacivat'ı her defasında sağduyusuyla alt ederdi. Benzer şekilde meydanlarda icra edilen Orta Oyunu da"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 34.17,
            "width": 74.0,
            "text": "Kavuklu ile Pişekâr'ın doğaçlama ustalığı sayesinde seyirciyi kahkahaya boğarken derin hayat dersleri sunardı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 37.05,
            "width": 74.0,
            "text": "Bugün teknolojinin hızla ilerlediği, dijital ekranların hayatımızı kuşattığı bir çağda yaşıyoruz."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 39.94,
            "width": 74.0,
            "text": "Ancak hiçbir yapay içerik, bir meddahın samimi mendil sallayışındaki sıcaklığı veremez."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 42.82,
            "width": 74.0,
            "text": "Geleneksel sahnelerimizi okullara taşımalı, çocuklarımızı bu köklü kahkahalarla tanıştırmalıyız."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 45.71,
            "width": 74.0,
            "text": "Çünkü geçmişini unutan bir toplum, geleceğini başkalarının yazdığı senaryolarda kaybetmeye mahkûmdur."
          }
        ]
      }
    ],
    "34": [
      {
        "id": "p34_plan_taslak",
        "title": "Yapay Zekâ ve Sanat Metni",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 21.99,
            "width": 74.0,
            "text": "Giriş: Yapay zekânın resim, müzik ve edebiyat alanında eserler üretmeye başlaması."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 24.87,
            "width": 74.0,
            "text": "Gelişme: Sanatın yalnızca teknik bir çıktı değil, yaşanmışlık ve insan ruhunun yansıması olması."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 27.76,
            "width": 74.0,
            "text": "Sonuç: Yapay zekâ bir araç olabilir ancak kalbi ve vicdanı olan insanın yerini asla alamaz."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 37.37,
            "width": 74.0,
            "text": "Bugün algoritmalar saniyeler içinde binlerce görsel üretebiliyor veya kusursuz kafiyeler yazabiliyor."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 40.26,
            "width": 74.0,
            "text": "Fakat hiçbir kod satırı bir annenin evladına duyduğu hasreti hissedemez, bir kilimin ilmeğindeki gözyaşını"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 43.14,
            "width": 74.0,
            "text": "yaşayamaz. Sanat, insanın acıları, umutları ve hayalleriyle var olur; bu yüzden insan ruhu daima eşsiz kalacaktır."
          }
        ]
      }
    ],
    "35": [
      {
        "id": "p35_etk9",
        "title": "9. Etkinlik: Yazma Planı",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 21.35,
            "width": 74.0,
            "text": "Hedef Kitle: Okul arkadaşları, öğretmenler ve sanatseverler."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 24.87,
            "width": 74.0,
            "text": "Yazı Türü: Bilgilendirici ve ikna edici makale / deneme."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 74.0,
            "text": "Bir milletin sanatı onun ruh haritasıdır. Sanatını kaybeden bir millet, köklerinden kopmuş bir ağaç gibidir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 35.77,
            "width": 74.0,
            "text": "Geleneksel sanatlarımız bize kim olduğumuzu, nereden gelip nereye gittiğimizi hatırlatan pusulalardır."
          }
        ]
      }
    ],
    "36": [
      {
        "id": "p36_metin",
        "title": "9. Etkinlik: Düzenlenmiş Metin",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 19.42,
            "width": 74.0,
            "text": "Başlık: Ruhun Renklerle Dansı"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.95,
            "width": 74.0,
            "text": "Geleneksel sanatlarımız; yalnızca estetik bir zevk değil, geçmişimizden süzülüp gelen bir ahlak felsefesidir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.83,
            "width": 74.0,
            "text": "Bir ebru teknesindeki suyun teslimiyeti, bir hat levhasındaki sabrın zarafeti bize insan olmayı öğretir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 28.72,
            "width": 74.0,
            "text": "Bizler bu mirası sadece müzelerde sergilenen birer hatıra olarak değil, günlük hayatımızın bir parçası"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 31.6,
            "width": 74.0,
            "text": "hâline getirmeliyiz. Sanatla güzelleşen bir toplumda şiddet, kabalık ve sevgisizlik kendine asla yer bulamaz."
          }
        ]
      }
    ],
    "37": [
      {
        "id": "p37_hazirlik",
        "title": "Hazırlık Vakti: Ebru Sanatı",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.63,
            "width": 74.0,
            "text": "Ebru, yoğunlaştırılmış su üzerine toprak boyalarla desen yapılıp bu desenin kâğıda aktarılması sanatıdır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 25.51,
            "width": 74.0,
            "text": "Görsel ve ruhsal dinginlik veren, her yapılan eserin tek ve tekrarlanamaz olduğu eşsiz bir Türk sanatıdır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 74.0,
            "text": "Ebru yapımında kullanılan malzemeler: Kitre (veya deniz kadayıfı), öd, toprak boyalar, at kılı ve gül dalından fırçalar."
          }
        ]
      }
    ],
    "38": [
      {
        "id": "p38_etk1b",
        "title": "1. Etkinlik B: Ebru Malzemeleri",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 23.27,
            "width": 74.0,
            "text": "Kitre: Geven otunun özsuyundan elde edilen, tekne suyunu kıvamlaştırmaya yarayan doğal zamk."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.79,
            "width": 74.0,
            "text": "Öd: Sığır safrakesesi sıvısı olup boyaların su üzerinde batmadan yayılmasını ve birbirine karışmamasını sağlar."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 30.32,
            "width": 74.0,
            "text": "Biz: Boyalara su yüzeyinde şekil vermek, dalgalandırmak ve çiçek figürleri oluşturmak için kullanılan ince uçlu metal alet."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 33.85,
            "width": 74.0,
            "text": "Gül Dalı Fırça: At kılından yapılan ve elastikiyeti sayesinde boyayı suya eşit damlatan geleneksel fırça."
          }
        ]
      }
    ],
    "39": [
      {
        "id": "p39_etk3",
        "title": "3. Etkinlik: Ebru Bilgilerini Sınıflandırma",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 29.74,
            "width": 38.0,
            "text": "Grup 1: Öznel / Duygusal Nitelikler"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 29.74,
            "width": 38.0,
            "text": "Grup 2: Nesnel / Teknik Nitelikler"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 32.37,
            "width": 38.0,
            "text": "• Renkler insanın ruhunu dinlendirir."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 32.37,
            "width": 38.0,
            "text": "• Tekne suyunu kitre yoğunlaştırır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 34.94,
            "width": 38.0,
            "text": "• Ebru insanı farklı alemlere taşır."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 34.94,
            "width": 38.0,
            "text": "• Boyalar gül dalı fırçayla serpilir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 37.5,
            "width": 38.0,
            "text": "• Her desen sanatçının teslimiyetidir."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 37.5,
            "width": 38.0,
            "text": "• Boyanın açılması için öd kullanılır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 40.06,
            "width": 38.0,
            "text": "• Bu sanat insana sabrı öğretir."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 40.06,
            "width": 38.0,
            "text": "• Desenler biz ile şekillendirilir."
          }
        ]
      }
    ],
    "41": [
      {
        "id": "p41_etk5_6",
        "title": "5. Etkinlik C & 6. Etkinlik",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "mark",
            "left": 17.5,
            "top": 30.5,
            "width": 3.0,
            "text": "✓"
          },
          {
            "type": "mark",
            "left": 17.5,
            "top": 36.5,
            "width": 3.0,
            "text": "✓"
          },
          {
            "type": "mark",
            "left": 17.5,
            "top": 48.5,
            "width": 3.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 57.24,
            "width": 74.0,
            "text": "Ebru sanatçısı suyun ve boyanın doğasına saygı duyar. Tıpkı hayat gibi burada da her şey tam kontrol edilemez;"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 60.13,
            "width": 74.0,
            "text": "sanatçı teslimiyeti, sabrı ve ortaya çıkan güzelliği minnetle kabullenmeyi öğrenir."
          }
        ]
      }
    ],
    "43": [
      {
        "id": "p43_etk8",

    "157": [
      {
        "id": "p157_plan",
        "title": "Yazma Taslağı: Çocuk Hakları ve Sorumluluk",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 12.5,
            "width": 78.0,
            "text": "Konu: Çocuk haklarının toplumsal hayattaki yeri ve karşılıklı sorumluluk bilinci."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 15.06,
            "width": 78.0,
            "text": "Amaç: Çocukların korunması ve haklarını bilerek büyümesinin önemini aktarmak."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 29.87,
            "width": 78.0,
            "text": "1. Çocukların eğitim, sağlık ve güvenli bir çevrede büyüme haklarının dokunulmazlığı."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 41.15,
            "width": 78.0,
            "text": "2. Hakların korunması için bireylerin, ailelerin ve devletin yerine getireceği görevler."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 52.44,
            "width": 78.0,
            "text": "3. Hak ve sorumluluk dengesinin sağlanmasıyla toplumda adalet ve huzurun kökleşmesi."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 63.72,
            "width": 78.0,
            "text": "Sonuç: Çocuklarına değer veren milletlerin aydınlık ve mamur bir geleceğe ulaşacağı."
          }
        ]
      }
    ],
    "158": [
      {
        "id": "p158_uretim",
        "title": "Üretim Vakti: Çocuk Hakları Yazısı",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 36.6,
            "width": 78.0,
            "text": "Başlık: Haklarıyla Büyüyen Özgür Çocuklar"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 39.17,
            "width": 78.0,
            "text": "Her çocuk dünyaya temiz bir fidan gibi gelir; sevgiyle, adaletle ve şefkatle sulanmalıdır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 41.73,
            "width": 78.0,
            "text": "Oyun oynama, eğitim alma ve düşüncelerini özgürce ifade etme hakları asla kısıtlanamaz."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 44.36,
            "width": 78.0,
            "text": "Haklarımızın farkında olurken başkalarının haklarına da saygı göstermek en yüce erdemdir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 46.92,
            "width": 78.0,
            "text": "Bugün hakları güvenceye alınan her çocuk, yarının barış dolu dünyasının mimarı olacaktır."
          }
        ]
      }
    ],
    "161": [
      {
        "id": "p161_sorular_1_4",
        "title": "Ölçme ve Değerlendirme Soruları 1 - 4",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 11.5,
            "width": 78.0,
            "text": "1. Yeşil Vatan Projesi'nin temel amacı; doğayı korumak ve gelecek nesillere temiz bir çevre bırakmaktır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 21.0,
            "width": 78.0,
            "text": "2. Görseldeki yemyeşil ağaçlar ve el ele tutuşan insanlar, çevreye karşı ortak sorumluluğu simgeler."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 33.0,
            "width": 78.0,
            "text": "3. Çevre bilincini artırmak için fidan dikme kampanyaları ve afiş sergileri düzenlenebilir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 43.08,
            "width": 78.0,
            "text": "Ana fikir: Her çocuğun sevgi, güven ve şefkat dolu bir ortamda büyüme hakkı vardır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 48.85,
            "width": 78.0,
            "text": "Konu: Çocukların masumiyeti ve temel yaşam gereksinimleri."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 61.86,
            "width": 78.0,
            "text": "Ana fikir: Çocuk hakları evrenseldir ve tüm toplumlar bu hakları korumakla yükümlüdür."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 67.95,
            "width": 78.0,
            "text": "Konu: Çocuk Hakları Sözleşmesi ve çocukların hukuki güvenceleri."
          }
        ]
      }
    ],
    "162": [
      {
        "id": "p162_sorular_5_6",
        "title": "Ölçme Soruları 5 - 6: İkilemeler ve Yeşil Vatan",
        "button": {

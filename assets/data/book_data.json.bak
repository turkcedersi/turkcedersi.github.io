    "92": [
      {
        "id": "p92_etk4",
        "title": "4. Etkinlik: Kütüphanelerin Tarihsel Gelişimi",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 15.0,
            "top": 24.55,
            "width": 70.0,
            "text": "Kil tabletler: Ağır ve kırılgan çamur levhalara çivi yazısıyla kazınarak kaydedilirdi."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 29.04,
            "width": 70.0,
            "text": "Papirüs ve Parşömen: Rulo hâlinde sarılan, hafif ve taşınması daha kolay malzemeler oldu."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 34.17,
            "width": 70.0,
            "text": "El Yazması Kodeksler: Sayfaların üst üste dikilip ciltlenmesiyle günümüz kitap formu doğdu."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 39.29,
            "width": 70.0,
            "text": "Matbaa Devrimi: Kitapların seri ve ucuz basılması bilginin tüm topluma yayılmasını sağladı."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 44.42,
            "width": 70.0,
            "text": "Dijital Dönüşüm: Bilgi internet ve veri tabanlarıyla anında erişilebilir hâle geldi."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 49.55,
            "width": 70.0,
            "text": "Geleceğin Kütüphaneleri: Fiziksel mekân ile sanal etkileşimi birleştiren yaşam alanları."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 70.5,
            "width": 32.0,
            "text": "• Her iki dönemde de bilgi toplanıp korunur."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 73.5,
            "width": 32.0,
            "text": "• İnsanlığın öğrenme ve araştırma ihtiyacına hizmet eder."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 77.5,
            "width": 32.0,
            "text": "• Bilgi aktarımında düzen ve sınıflandırma esastır."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 70.5,
            "width": 32.0,
            "text": "• Eskiden sadece seçkinler yararlanırken bugün halka açıktır."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 74.5,
            "width": 32.0,
            "text": "• Fiziksel mekan sınırlılığı dijital kataloglarla kalkmıştır."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 78.5,
            "width": 32.0,
            "text": "• Günümüzde kütüphaneler sosyal yaşam merkezine dönüşmüştür."
          }
        ]
      }
    ],

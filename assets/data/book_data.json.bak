      {
        "id": "p23_1_b",
        "title": "1. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 44.0
        },
        "items": [
          {
            "type": "lines",
            "left": 18.0,
            "top": 48.2,
            "width": 25.0,
            "height": 2.5,
            "text": "Gelenek"
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 48.2,
            "width": 43.0,
            "height": 2.5,
            "text": "Kuşaktan kuşağa aktarılan köklü alışkanlıklar ve değerler"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 51.0,
            "width": 25.0,
            "height": 2.5,
            "text": "Ziyaret"
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 51.0,
            "width": 43.0,
            "height": 2.5,
            "text": "Büyüklerin hatırını sorma, sılayırahim, el öpme"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 53.8,
            "width": 25.0,
            "height": 2.5,
            "text": "İkram"
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 53.8,
            "width": 43.0,
            "height": 2.5,
            "text": "Baklava, bayram şekeri, lokum ve Türk kahvesi sunumu"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 56.6,
            "width": 25.0,
            "height": 2.5,
            "text": "Miras"
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 56.6,
            "width": 43.0,
            "height": 2.5,
            "text": "Geçmişten kalan kültürel zenginlik, bayram sevinci"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 59.4,
            "width": 25.0,
            "height": 2.5,
            "text": "Paylaşma"
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 59.4,
            "width": 43.0,
            "height": 2.5,
            "text": "Kardeşlik, yoksulları gözetme, hediyeleşme"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 62.2,
            "width": 25.0,
            "height": 2.5,
            "text": "Kucaklaşma"
          },
          {
            "type": "lines",
            "left": 45.0,
            "top": 62.2,
            "width": 43.0,
            "height": 2.5,
            "text": "Küslerin barışması, sevgiyle sarılma, dostluk bağı"
          }
        ]
      }
    ],
    "24": [
      {
        "id": "p24_3_a",
        "title": "3. Etkinlik (a)",
        "button": {
          "left": 5.0,
          "top": 12.0
        },
        "items": [
          {
            "type": "badge",
            "left": 10.0,
            "top": 20.8,
            "width": 21.0,
            "height": 2.6,
            "text": "Hoş geldiniz."
          },
          {
            "type": "badge",
            "left": 10.0,
            "top": 26.9,
            "width": 21.0,
            "height": 2.6,
            "text": "Güle güle gidin."
          },
          {
            "type": "badge",
            "left": 10.0,
            "top": 33.0,
            "width": 21.0,
            "height": 2.6,
            "text": "Elinize sağlık."
          },
          {
            "type": "badge",
            "left": 9.5,
            "top": 39.0,
            "width": 22.0,
            "height": 2.6,
            "text": "Bayramınız kutlu olsun."
          },
          {
            "type": "badge",
            "left": 10.0,
            "top": 45.1,
            "width": 21.0,
            "height": 2.6,
            "text": "Gözünüz aydın."
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 21.5,
            "width": 52.0,
            "height": 2.3,
            "text": "Gelen misafirleri kapıda karşılarken ve"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 24.1,
            "width": 52.0,
            "height": 2.3,
            "text": "onları samimiyetle içeri buyur ederken söylenir."
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 27.5,
            "width": 52.0,
            "height": 2.3,
            "text": "Ayrılan veya yola çıkan kişilere hayırlı yolculuklar"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 30.1,
            "width": 52.0,
            "height": 2.3,
            "text": "ve esenlik dilemek amacıyla söylenir."
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 33.6,
            "width": 52.0,
            "height": 2.3,
            "text": "İkram edilen lezzetli yemekleri hazırlayan kişiye"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 36.2,
            "width": 52.0,
            "height": 2.3,
            "text": "teşekkür ve şükran bildirmek için söylenir."
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 39.6,
            "width": 52.0,
            "height": 2.3,
            "text": "Bayram günlerinde karşılaşılan akraba ve dostların"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 42.2,
            "width": 52.0,
            "height": 2.3,
            "text": "bayramını tebrik edip kutlamak için söylenir."
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 45.6,
            "width": 52.0,
            "height": 2.3,
            "text": "Sevindirici bir habere kavuşan kişilerin mutluluğunu"
          },
          {
            "type": "lines",
            "left": 35.0,
            "top": 48.2,
            "width": 52.0,
            "height": 2.3,
            "text": "paylaşmak ve onları tebrik etmek için söylenir."
          }
        ]
      },
      {
        "id": "p24_3_b",
        "title": "3. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 53.0
        },
        "items": [
          {
            "type": "lines",
            "left": 20.0,
            "top": 67.5,
            "width": 43.0,
            "height": 2.5,
            "text": "Geçmiş olsun, umarım en kısa zamanda iyileşirsin."
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 73.6,
            "width": 43.0,
            "height": 2.5,
            "text": "Su gibi aziz ol evladım, ömrün bereketli olsun."
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 79.8,
            "width": 43.0,
            "height": 2.5,
            "text": "Eline sağlık teyzeciğim, yemekler harika olmuş."
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 86.0,
            "width": 43.0,
            "height": 2.5,
            "text": "Güle güle oturun komşum, hayırlı uğurlu olsun."
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 89.3,
            "width": 43.0,
            "height": 2.5,
            "text": "Sınav sonuçları açıklandı, tıp fakültesini kazandım!"
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 91.3,
            "width": 43.0,
            "height": 2.5,
            "text": "Gözünüz aydın Cem, başarın daim olsun!"
          }
        ]
      }
    ],

            "left": 10.5,
            "top": 87.69,
            "width": 79.0,
            "text": "sonuç bölümünde ise İstanbul'daki kalıcı eserleri ve mirasıyla taçlandırılmıştır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 90.26,
            "width": 79.0,
            "text": "Olaylar arasındaki neden-sonuç bağları anlatımı son derece akıcı ve tutarlı kılmıştır."
          }
        ]
      }
    ],
    "60": [
      {
        "id": "p60_plan",
        "title": "Büyük Grupla Uyguluyorsunuz: Bilgisayar İkna Paragrafı Planı",
        "button": {
          "left": 6.5,
          "top": 64.0
        },
        "items": [
          {
            "type": "lines",
            "left": 37.0,
            "top": 68.14,
            "width": 50.0,
            "text": "Okul derslerim ve proje ödevlerimde kullanmak üzere"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 70.71,
            "width": 74.0,
            "text": "güncel ve hızlı yeni bir dizüstü bilgisayar alınmasını rica ediyorum."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 74.29,
            "width": 35.5,
            "text": "Mevcut bilgisayarımızın çok eskimesi,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 76.86,
            "width": 74.0,
            "text": "yeni eğitim programlarını açmaması ve derslerimde aksamalara yol açmasıdır."
          },
          {
            "type": "lines",
            "left": 51.0,
            "top": 80.38,
            "width": 36.0,
            "text": "Ekran süresi sınırına kesinlikle uyacak,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 82.95,
            "width": 74.0,
            "text": "bilgisayarı oyun amacıyla değil sadece okul ve ders çalışmaları için kullanacağım."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 86.54,
            "width": 34.5,
            "text": "Ödevlerimi eksiksiz ve vaktinde bitirecek,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 89.1,
            "width": 74.0,
            "text": "araştırma becerilerimi ve okul başarı düzeyimi en üst seviyeye çıkaracağım."
          }
        ]
      }
    ],
    "61": [
      {
        "id": "p61_taslak",
        "title": "Büyük Grupla Uyguluyorsunuz: Bilgisayar İkna Paragrafı Taslağı",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 12.0,
            "top": 10.45,
            "width": 76.0,
            "text": "EĞİTİMİM İÇİN YENİ BİR ADIM: BİLGİSAYAR"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 13.01,
            "width": 76.0,
            "text": "Sevgili Anneciğim ve Babacığım,"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 15.58,
            "width": 76.0,
            "text": "7. sınıfa geçmemle beraber derslerimin kapsamı ve araştırma projelerim oldukça arttı."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 18.14,
            "width": 76.0,
            "text": "Öğretmenlerimizin verdiği dijital ödevleri eksiksiz yapabilmek ve derslerimi düzenli"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 20.71,
            "width": 76.0,
            "text": "takip edebilmek amacıyla yeni bir dizüstü bilgisayar alınmasını sizlerden rica ediyorum."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 23.33,
            "width": 76.0,
            "text": "Elimizdeki bilgisayarın hâlâ çalıştığını düşünebilirsiniz; ancak mevcut cihazımız çok eski"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 25.9,
            "width": 76.0,
            "text": "olduğu için yeni eğitim yazılımlarını ve kaynak siteleri açarken sürekli donmaktadır."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 28.46,
            "width": 76.0,
            "text": "Bu durum ödevlerimi vaktinde teslim etmemi zorlaştırmakta ve zaman kaybına yol açmaktadır."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 31.03,
            "width": 76.0,
            "text": "Bilgisayar başında çok vakit geçireceğimden veya oyun oynayacağımdan endişe duyabilirsiniz."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 33.59,
            "width": 76.0,
            "text": "Bu konuda içinizin rahat olmasını isterim; belirleyeceğimiz günlük kullanım kurallarına"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 36.15,
            "width": 76.0,
            "text": "harfiyen uyacak, cihazı sadece eğitim ve araştırma amacıyla kullanacağıma söz veriyorum."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 38.78,
            "width": 76.0,
            "text": "Yeni bir bilgisayara sahip olmam, okul ödevlerimi çok daha verimli tamamlamamı sağlayacak,"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 41.35,
            "width": 76.0,
            "text": "dijital becerilerimi geliştirecek ve derslerime olan motivasyonumu büyük ölçüde artıracaktır."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 43.91,
            "width": 76.0,
            "text": "Bana duyduğunuz sevgi ve güven için çok teşekkür eder, desteğinizi beklerim."
          }
        ]
      }
    ],
    "62": [
      {
        "id": "p62_plan",
        "title": "Küçük Grupla Uyguluyorsunuz: Kitap Fuarı İkna Planı",
        "button": {

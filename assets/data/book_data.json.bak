    "100": [
      {
        "id": "p100_etk8",
        "title": "8. Etkinlik: Mesajlaşma Yanıtı",
        "button": {
          "left": 6.5,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 55.5,
            "top": 49.55,
            "width": 21.0,
            "text": "Selam Elif! Harika bir"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 51.35,
            "width": 21.0,
            "text": "konu seçmişsin. Bence"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 53.14,
            "width": 21.0,
            "text": "bu büyük zaferin sırrı,"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 54.94,
            "width": 21.0,
            "text": "Atatürk'ün sarsılmaz"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 56.73,
            "width": 21.0,
            "text": "liderliği ve milletimizin"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 58.53,
            "width": 21.0,
            "text": "topyekûn fedakârlığıdır."
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 60.32,
            "width": 21.0,
            "text": "Yokluk içinde bile olsa"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 62.12,
            "width": 21.0,
            "text": "halkımız bağımsızlık"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 63.91,
            "width": 21.0,
            "text": "inancını kaybetmedi."
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 65.71,
            "width": 21.0,
            "text": "Kadını, çocuğu, yaşlısı"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 67.5,
            "width": 21.0,
            "text": "tek yürek oldu. Yazında"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 69.29,
            "width": 21.0,
            "text": "bu millî birlik ruhunu"
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 71.09,
            "width": 21.0,
            "text": "ve inancı vurgulamalısın."
          },
          {
            "type": "lines",
            "left": 55.5,
            "top": 72.88,
            "width": 21.0,
            "text": "Başarılar dilerim! 17:42"
          }
        ]
      }
    ],
    "103": [
      {
        "id": "p103_etk1",
        "title": "1. Etkinlik: Kelime ve Anlam Tablosu",
        "button": {
          "left": 6.5,
          "top": 9.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.5,
            "top": 27.37,
            "width": 9.5,
            "text": "kağnı"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 25.51,
            "width": 49.0,
            "text": "Öküz veya mandayla çekilen iki tekerlekli araba."
          },
          {
            "type": "lines",
            "left": 42.0,
            "top": 29.23,
            "width": 45.5,
            "text": "İki veya dört tekerlekli, dingili tekerlekle dönen öküz arabası."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 35.96,
            "width": 9.5,
            "text": "Kocabaş"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 34.1,
            "width": 49.0,
            "text": "Şiirde kağnıyı çeken yaşlı ve sadık öküz."
          },
          {
            "type": "lines",
            "left": 42.0,
            "top": 37.82,
            "width": 45.5,
            "text": "Büyük ve iri başlı; mecazen iri cüsseli hayvan, öküz."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 44.55,
            "width": 9.5,
            "text": "mahzun"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 42.69,
            "width": 49.0,
            "text": "Üzgün, boynu bükük, kederli."
          },
          {
            "type": "lines",
            "left": 42.0,
            "top": 46.41,
            "width": 45.5,
            "text": "Üzgün, kederli, boynu bükük, gamlı."
          },
          {
            "type": "lines",
            "left": 13.5,
            "top": 53.14,
            "width": 9.5,
            "text": "alını yeşilini"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 51.28,
            "width": 49.0,
            "text": "Gençliğini, süsünü, neşeli günlerini."
          },
          {
            "type": "lines",
            "left": 42.0,
            "top": 55.0,
            "width": 45.5,
            "text": "Al ve yeşil renkli giysileri, gelinlik süsünü."
          }
        ]
      },
      {
        "id": "p103_etk2",
        "title": "2. Etkinlik: Kelime Tercihleri ve Değişimleri",
        "button": {
          "left": 6.5,
          "top": 60.5
        },
        "items": [
          {
            "type": "lines",
            "left": 19.5,
            "top": 73.33,
            "width": 23.0,
            "text": "Kocabaş"
          },
          {
            "type": "lines",
            "left": 58.0,
            "top": 73.33,
            "width": 23.0,
            "text": "kınalı ellerinden"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 84.87,
            "width": 20.0,
            "text": "sankim"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 84.87,
            "width": 23.0,
            "text": "niceden"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 89.17,
            "width": 20.0,
            "text": "sanki"
          },
          {
            "type": "lines",
            "left": 64.5,
            "top": 89.17,
            "width": 23.0,
            "text": "nice zamandır"
          }
        ]
      }
    ],
    "104": [
      {
        "id": "p104_etk4",
        "title": "4. Etkinlik: Elif'in Duygu Dünyası ve Metin Kanıtları",
        "button": {
          "left": 6.5,
          "top": 36.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 51.41,
            "width": 74.0,
            "text": "Kocabaş'ın ölümü sonrasında Elif, derin bir acı ve sarsılmaz bir kararlılık hissetmiştir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 53.97,
            "width": 74.0,
            "text": "Şiirdeki 'Örtüldü gözleri örtüldü hep' dizesi, sadık emek ortağını yitirmenin kederini;"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 56.6,
            "width": 74.0,
            "text": "'Kalır mı Mustafa Kemal'in kağnısı' sözü ise asla umutsuzluğa kapılmadığını kanıtlar."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 59.17,
            "width": 74.0,
            "text": "Mermilerin cepheye yetişmesi gerektiğini ve vatanın her şeyden üstün olduğunu bilir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 61.73,
            "width": 74.0,
            "text": "'Kocabaşın yerine koştu kendini Elifçik / Yürüdü düşman üstüne' dizelerinde görüldüğü gibi"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 64.29,
            "width": 74.0,
            "text": "acısını kutsal vatan mücadelesi için sarsılmaz bir gayret ve azme dönüştürmüştür."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 66.86,
            "width": 74.0,
            "text": "Elif, kendi bedenini kağnıya koşarak Türk kadınının eşsiz fedakârlığını ve vatan sevgisini"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 69.49,
            "width": 74.0,
            "text": "tüm dünyaya bir kez daha en somut ve asil biçimde göstermiştir."
          }
        ]
      }
    ],
    "105": [
      {
        "id": "p105_etk5_a",
        "title": "5. Etkinlik: Mehmet Âkif Ersoy Kronolojisi",
        "button": {
          "left": 6.5,
          "top": 5.0
        },
        "items": [
          {
            "type": "lines",
            "left": 11.5,
            "top": 66.15,
            "width": 77.0,
            "text": "• 1873: İstanbul Fatih'te doğdu; küçük yaşlardan itibaren dillere ve eğitime büyük ilgi duydu."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 68.72,
            "width": 77.0,
            "text": "• 1888-1889: Babasını kaybetti, Mülkiye Baytar Mektebine girerek okulu birincilikle bitirdi."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 71.28,
            "width": 77.0,
            "text": "• 1911: Türk milletinin ortak değeri olan Safahat adlı eserinin şiirlerini yayımlamaya başladı."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 73.91,
            "width": 77.0,
            "text": "• 1920: Millî Mücadele'ye fiilen katılmak üzere Burdur mebusu olarak Birinci TBMM'ye seçildi."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 76.47,
            "width": 77.0,
            "text": "• 1921: İstiklâl Marşı'nı yazdı, yarışma ödülü olan 500 lirayı Darülmesai Vakfına bağışladı."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 79.04,
            "width": 77.0,
            "text": "• 1936: 27 Aralık'ta vefat etti ve Edirnekapı Şehitliği'nde ebedî istirahatgâhına defnedildi."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 81.6,
            "width": 77.0,
            "text": "• Eserlerinde ahlaklı, vatansever ve çalışkan 'Âsım'ın nesli' idealini gençliğe miras bıraktı."
          }
        ]
      }
    ],
    "106": [
      {
        "id": "p106_etk6",

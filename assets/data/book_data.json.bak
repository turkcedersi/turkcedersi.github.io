        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 48.4,
            "width": 72.0,
            "height": 2.2,
            "text": "Şimdi babamızın yerinde o, içim rahat geldim bu yüzden savaşa... (Sebep - Sonuç)"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.8,
            "width": 72.0,
            "height": 2.2,
            "text": "Ama Salih ağabeyim, o birkaç günlük yolculukta koca bir adam oldu... (Zıtlık)"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 53.2,
            "width": 72.0,
            "height": 2.2,
            "text": "Evvela selam eder, senin ve Salih ağabeyimin ellerinden öperim. (Ekleme)"
          }
        ]
      },
      {

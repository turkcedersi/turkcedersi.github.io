    "75": [
      {
        "id": "p75_plan_taslak",
        "title": "Eleştirel Yazma: Okuma Kulüpleri",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "box",
            "left": 58.0,
            "top": 35.5,
            "width": 17.5,
            "text": "Okuma kulüplerinin bireysel okuma zevkini geliştirmedeki etkisi."
          },
          {
            "type": "box",
            "left": 58.0,
            "top": 41.5,
            "width": 17.5,
            "text": "Okuma özgürlüğü, farklı türleri tanıma ve tartışma ortamı."
          },
          {
            "type": "box",
            "left": 58.0,
            "top": 47.0,
            "width": 17.5,
            "text": "Olumlu: Sosyalleşmeyi ve eleştirel düşünceyi güçlendirir."
          },
          {
            "type": "box",
            "left": 58.0,
            "top": 52.5,
            "width": 17.5,
            "text": "Kitap seçiminde öğrencilerin ortak kararı esas alınmalıdır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 57.44,
            "width": 78.0,
            "text": "Okuma kulüpleri, öğrencilere yalnız bir okuma deneyiminden öte zengin bir alan sunar."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 60.0,
            "width": 78.0,
            "text": "Aynı kitabı okuyan farklı zihinlerin buluşması olaylara çok yönlü bakmayı sağlar."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 62.63,
            "width": 78.0,
            "text": "Ancak bazen tek tip kitapların dayatılması okur motivasyonunu düşürebilir."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 65.19,
            "width": 78.0,
            "text": "Bu sebeple kulüp üyelerine seçim hakkı tanınmalı ve esnek bir ortam kurulmalıdır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 67.76,
            "width": 78.0,
            "text": "Böylece okuma alışkanlığı sürdürülebilir kılınır ve eleştirel düşünce becerisi gelişir."
          }
        ]
      }
    ],
    "76": [
      {
        "id": "p76_plan_taslak2",
        "title": "Eleştirel Yazma: Kitap Öneri Listeleri",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "box",
            "left": 58.0,
            "top": 27.5,
            "width": 17.5,
            "text": "Kitap listelerinin okur beğenisini tek tipleştirme riski."
          },
          {
            "type": "box",
            "left": 58.0,
            "top": 33.0,
            "width": 17.5,
            "text": "Bireysel ilgi alanları, yaş düzeyine uygunluk ve çeşitlilik."
          },
          {
            "type": "box",
            "left": 58.0,
            "top": 38.5,
            "width": 17.5,
            "text": "Kısmen Olumsuz: Standart listeler özgün keşifleri kısıtlayabilir."
          },
          {
            "type": "box",
            "left": 58.0,
            "top": 44.0,
            "width": 17.5,
            "text": "Listeler zorunluluk değil, yol gösterici tavsiyeler olmalıdır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 48.21,
            "width": 78.0,
            "text": "Hazır kitap listeleri, ne okuyacağını bilemeyen genç okurlar için faydalı bir pusuladır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 50.77,
            "width": 78.0,
            "text": "Fakat bu listeler mutlak bir kural gibi dayatıldığında çocukların merakını köreltebilir."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 53.33,
            "width": 78.0,
            "text": "Her okurun ilgi alanı, duygusal olgunluğu ve edebi zevki birbirinden tamamen farklıdır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 55.96,
            "width": 78.0,
            "text": "En sağlıklı yaklaşım, geniş bir yelpaze sunarak öğrencinin kendi rotasını çizmesini sağlamaktır."
          }
        ]
      }
    ],
    "77": [
      {
        "id": "p77_etk9",
        "title": "9. Etkinlik: Dijital ve Basılı Kitap Eleştirisi",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "box",
            "left": 58.0,
            "top": 33.0,
            "width": 17.5,
            "text": "E-kitap ve sesli kitapların öğrenme süreçlerine etkisi."
          },
          {
            "type": "box",
            "left": 58.0,
            "top": 39.0,
            "width": 17.5,
            "text": "Erişilebilirlik, dikkat dağınıklığı ve derinleşme oranı."
          },
          {
            "type": "box",
            "left": 58.0,
            "top": 45.0,
            "width": 17.5,
            "text": "Dengeli: Pratik olmakla birlikte derin odaklanmayı azaltabilir."
          },
          {
            "type": "box",
            "left": 58.0,
            "top": 50.5,
            "width": 17.5,
            "text": "Basılı ve dijital kaynaklar birbirini tamamlayacak biçimde kullanılmalı."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 50.51,
            "width": 78.0,
            "text": "Teknolojinin sunduğu e-kitap ve sesli kitaplar, binlerce eseri cebimize sığdırmaktadır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 53.08,
            "width": 78.0,
            "text": "Seyahatte veya kütüphaneye uzak yerlerde bilgiye anında ulaşmak büyük bir kazanımdır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 55.64,
            "width": 78.0,
            "text": "Ancak ekran ışığı ve gelen bildirimler derinlemesine düşünmeyi zorlaştırabilir."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 58.21,
            "width": 78.0,
            "text": "Bu nedenle dijital araçlar basılı kitabın yerini almak yerine onu desteklemelidir."
          }
        ]
      }
    ],
    "81": [
      {
        "id": "p81_etk1",
        "title": "1. Etkinlik: Metin Tahmini ve Gerekçesi",
        "button": {
          "left": 88.0,

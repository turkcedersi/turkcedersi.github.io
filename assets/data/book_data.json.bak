        },
        "items": [
          {
            "type": "lines",
            "left": 17.5,
            "top": 16.5,
            "width": 71.0,
            "height": 2.2,
            "text": "Söylediği kırıcı sözlerle en yakın arkadaşının gönlünü kırdı."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 26.6,
            "width": 71.0,
            "height": 2.2,
            "text": "Çok istediği o kırmızı bisikleti alamamak içinde, gönlünde kaldı."
          },
          {
            "type": "lines",
            "left": 17.5,
            "top": 36.8,
            "width": 71.0,
            "height": 2.2,
            "text": "Bu yaz tatilinde dedesinin köyüne gidip ata binmeyi gönlünden geçirdi."

    "144": [
      {
        "id": "p144_6_a",
        "title": "6. Etkinlik (a)",
        "button": {
          "left": 5.2,
          "top": 11.0
        },
        "items": [
          {
            "type": "lines",
            "left": 33.0,
            "top": 15.4,
            "width": 53.0,
            "height": 2.2,
            "text": "Ayşenur'un kasnakta nakış işlerken dedesiyle"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 18.2,
            "width": 71.0,
            "height": 2.2,
            "text": "yaptığı anlamlı sohbet ve paylaşımlar."
          },
          {
            "type": "lines",
            "left": 37.0,
            "top": 22.4,
            "width": 49.0,
            "height": 2.2,
            "text": "Ayşenur ve bilge dedesi."
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 28.4,
            "width": 48.0,
            "height": 2.2,
            "text": "Geçmişte, huzurlu bir günün ikindi / dinlenme vaktinde."
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 34.4,
            "width": 48.0,
            "height": 2.2,
            "text": "Evin oturma odasında, sedirin üzerinde."
          }
        ]
      },
      {
        "id": "p144_6_b",
        "title": "6. Etkinlik (b)",
        "button": {
          "left": 5.2,
          "top": 43.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 48.4,
            "width": 71.0,
            "height": 3.8,
            "text": "Evet, kesinlikle güçlendirmiştir. Çünkü dede ile torun arasındaki sevgi do."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 51.2,
            "width": 71.0,
            "height": 3.8,
            "text": "öğütlerin kuru bir nasihat gibi değil, içten bir hayat tecrübesi olarak al."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 54.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Nakış motifiyle sabır ve incelik somutlaştırılarak okuyucunun zihninde kal."
          }
        ]
      }
    ],
    "145": [
      {
        "id": "p145_7",
        "title": "7. Etkinlik",
        "button": {
          "left": 5.2,
          "top": 5.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 19.0,
            "width": 71.0,
            "height": 4.0,
            "text": "Ayşenur odasında sessizce oturmuş, renkli ipliklerle kasnağına özenle nakı."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 22.0,
            "width": 71.0,
            "height": 4.0,
            "text": "Bu sırada odaya dedesi girer ve torununun el emeğini hayranlıkla izlemeye."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 37.8,
            "width": 71.0,
            "height": 4.0,
            "text": "Dedesi nakıştan hareketle asıl güzelliğin kalbe işlenen edep ve güzel ahla."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 40.8,
            "width": 71.0,
            "height": 4.0,
            "text": "Hayatın zorluklarına karşı sabrın, insan sevgisinin ve vefanın önemini der."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 54.5,
            "width": 71.0,
            "height": 4.0,
            "text": "Ayşenur dedesinin sözlerinden çok etkilenir ve bu öğütleri hayatı boyunca."
          }
        ]
      }
    ],
    "146": [
      {
        "id": "p146_8",
        "title": "8. Etkinlik (b)",
        "button": {
          "left": 5.2,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 30.0,
            "top": 34.0,
            "width": 40.0,
            "height": 3.0,
            "text": "KIŞ ORTASINDA AÇAN ÇİÇEK"
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 36.5,
            "width": 71.0,
            "height": 3.8,
            "text": "Zemheri ayazının sokakları buz pistine çevirdiği dondurucu bir kış günüydü."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 38.8,
            "width": 71.0,
            "height": 3.8,
            "text": "Kerem kalın atkısına sarınmış okuldan dönerken kenardan bir inleme duydu."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 41.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Kutunun arkasında soğuktan tir tir titreyen minicik bir kedi yavrusu vardı."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 43.5,
            "width": 71.0,
            "height": 3.8,
            "text": "Kerem merhametli bir çocuktu; o masum canlıyı sokakta öylece bırakamazdı."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 46.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Hiç düşünmeden montunun önünü açtı, yavruyu şefkatle kucağına alıp ısıttı."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 48.7,
            "width": 71.0,
            "height": 3.8,
            "text": "Evin yolunu tuttuğunda kalbi minik kediyi kurtarmanın sevinciyle doluydu."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 51.1,
            "width": 71.0,
            "height": 3.8,
            "text": "Eve varınca annesiyle yavruyu kurulayıp sobanın yanına ılık bir süt koydular."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 53.7,
            "width": 71.0,
            "height": 3.8,
            "text": "Kedi karnını doyurup mırıldandığında Kerem merhametin huzurunu kalbinde duydu."
          }
        ]
      }
    ],

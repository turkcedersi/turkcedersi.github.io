      {
        "id": "p152_etk9_b",
        "title": "9. Etkinlik B: Zamanları Örnekleyen Cümleler",
        "button": {
          "left": 6.0,
          "top": 69.5
        },
        "items": [
          {
            "type": "lines",
            "left": 16.5,
            "top": 75.13,
            "width": 71.0,
            "text": "Geçmiş zaman: Dün akşam arkadaşımla kütüphanede buluşup ders çalıştık."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 80.06,
            "width": 71.0,
            "text": "Şimdiki zaman: Şu anda Türkçe ödevimi büyük bir dikkatle tamamlıyorum."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 85.0,
            "width": 71.0,
            "text": "Gelecek zaman: Hafta sonu ailemle birlikte bilim merkezini ziyaret edeceğiz."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 89.87,
            "width": 71.0,
            "text": "Geniş zaman: Her gün düzenli olarak yarım saat kitap okumaya özen gösteririm."
          }
        ]
      }
    ],
    "153": [
      {
        "id": "p153_etk10_a",
        "title": "10. Etkinlik A: Ünlemin Görevi",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 40.5,
            "top": 36.54,
            "width": 49.0,
            "text": "Cümleye alay, kinaye veya küçümseme anlamı kazandırmak için"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 39.17,
            "width": 78.0,
            "text": "kullanılan sözden hemen sonra yay ayraç içinde ünlem işareti ( ! ) kullanılır."
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 41.73,
            "width": 78.0,
            "text": "Bu kullanım, cümlenin gerçekte söylenenin tam tersi anlama geldiğini belirtir."
          }
        ]

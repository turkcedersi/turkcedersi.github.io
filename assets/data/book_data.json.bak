        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 10.8,
            "width": 71.0,
            "height": 3.8,
            "text": "Duyguların insanı nasıl hızla sarıp sarmalayabildiğini, endişeden mutluluğ."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 13.4,
            "width": 71.0,
            "height": 3.8,
            "text": "Arkadaşım Kerem'in zor anımda yanımda olup destek vermesi ise aramızdaki d."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 15.9,
            "width": 71.0,
            "height": 3.8,
            "text": "Artık her duygumu anlamaya ve onları acele etmeden, aklımla yönetmeye gayr."
          }
        ]
      }
    ],
    "143": [
      {
        "id": "p143_sonuc",

    "141": [
      {
        "id": "p141_etk4_5",
        "title": "4. & 5. Etkinlik: Önemli Bilgiler, Özet ve Çağrışımlar",
        "button": {
          "left": 88.0,
          "top": 14.5
        },
        "items": [
          {
            "type": "lines",
            "left": 39.0,
            "top": 21.99,
            "width": 49.0,
            "text": "18 yaşına kadar her birey çocuktur ve dokunulmaz haklara sahiptir."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 24.55,
            "width": 77.0,
            "text": "• Yaşama, korunma, eğitim ve sağlık hakları devlet güvencesi altındadır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 27.18,
            "width": 77.0,
            "text": "• Her çocuk din, dil, ırk ayrımı gözetilmeksizin eşit muamele görme hakkına sahiptir."
          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 35.19,
            "width": 72.0,
            "text": "Çocuk Hakları Sözleşmesi, dünya üzerindeki tüm çocukların güvenli, sağlıklı"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 37.76,
            "width": 77.0,
            "text": "ve onurlu bir yaşam sürmelerini teminat altına alan evrensel bir mutabakattır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 40.32,
            "width": 77.0,
            "text": "Toplumlar çocukların üstün yararını korumak ve eğitim imkânlarını sağlamakla yükümlüdür."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 42.88,
            "width": 77.0,
            "text": "Çocukların görüşlerini özgürce ifade etmeleri ve kararlara katılımları esastır."
          },
          {
            "type": "badge",
            "left": 12.0,
            "top": 79.5,
            "width": 15.0,
            "text": "Eşitlik"
          },
          {
            "type": "badge",

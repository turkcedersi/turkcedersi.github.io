    "103": [
      {
        "id": "p103_etk5_6",
        "title": "5. & 6. Etkinlik: Karşılaştırma ve İstek Kipi",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 35.0,
            "width": 34.0,
            "text": "• Her iki içerik de kitap sevgisini ve okuma tutkusunu aşılar."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 38.0,
            "width": 34.0,
            "text": "• Kitapların insan zihnindeki dönüştürücü gücünü vurgular."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 35.0,
            "width": 34.0,
            "text": "• Biri çocuk hakları ve kütüphane restorasyonuna odaklanır."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 38.0,
            "width": 34.0,
            "text": "• Diğeri 23 Nisan Dünya Kitap Günü evrensel kutlamalarını işler."
          },
          {
            "type": "underline",
            "left": 64.5,
            "top": 59.3,
            "width": 3.5,
            "text": "yapsak"
          },
          {
            "type": "underline",
            "left": 63.0,
            "top": 63.8,
            "width": 3.0,
            "text": "gelsene"
          },
          {
            "type": "underline",
            "left": 62.5,
            "top": 68.3,
            "width": 3.0,
            "text": "dayayım"
          },
          {
            "type": "underline",
            "left": 60.0,
            "top": 72.4,
            "width": 4.5,
            "text": "misin?"
          },
          {
            "type": "underline",
            "left": 44.8,
            "top": 76.5,
            "width": 3.2,
            "text": "Ne olur"
          },
          {

    "73": [
      {
        "id": "p73_etk10c",
        "title": "10. Etkinlik c (Yazı Planım)",
        "button": {
          "left": 5.0,
          "top": 66.0
        },
        "items": [
          {
            "type": "lines",
            "left": 25.5,
            "top": 71.2,
            "width": 62.5,
            "height": 2.2,
            "text": "Sorun: Arkadaşının doğum günü için pahalı hediye baskısı hissetmesi."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 74.0,
            "width": 76.0,
            "height": 2.2,
            "text": "Amaç: Gerçek dostluğun maddiyattan çok daha değerli olduğunu göstermek."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 76.6,
            "width": 76.0,
            "height": 2.2,
            "text": "Hedef Kitle: Gamze ve akranları (5. sınıf öğrencileri) / Tür: Mektup."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 79.3,
            "width": 76.0,
            "height": 2.2,
            "text": "Giriş: Arkadaşlığın sevgi, güven ve paylaşımla anlam kazandığını belirtmek."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 82.0,
            "width": 76.0,
            "height": 2.2,
            "text": "Gelişme: Popüler eşyaların dostluk ölçütü olamayacağını açıklamak."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 84.7,
            "width": 76.0,
            "height": 2.2,
            "text": "Çözüm: Kendi emeğiyle el yapımı anı defteri veya hediye hazırlamak."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 87.4,
            "width": 76.0,
            "height": 2.2,
            "text": "Alternatif: Bütçeyi sarsmayacak manevi değeri yüksek bir armağan seçmek."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 90.1,
            "width": 76.0,
            "height": 2.2,
            "text": "Sonuç: Samimi sevginin en değerli doğum günü hediyesi olduğunu vurgulamak."
          }
        ]
      }
    ],
    "74": [
      {
        "id": "p74_etk10c_taslak",
        "title": "10. Etkinlik ç (Metin Taslağım)",
        "button": {
          "left": 5.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 12.0,
            "top": 15.8,
            "width": 76.0,
            "height": 2.2,
            "text": "Sevgili Arkadaşım Gamze,"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 18.4,
            "width": 76.0,
            "height": 2.2,
            "text": "Zeynep'in doğum günü için duyduğun heyecanı ve ona güzel görünme isteğini anlıyorum."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 21.0,
            "width": 76.0,
            "height": 2.2,
            "text": "Ancak çok pahalı bir tişört almak için aileni zor durumda bırakman doğru değil."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 23.7,
            "width": 76.0,
            "height": 2.2,
            "text": "Çünkü arkadaşlıklar giydiğimiz kıyafetlerin markasıyla ya da fiyatıyla ölçülmez."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 26.3,
            "width": 76.0,
            "height": 2.2,
            "text": "Zeynep seni üzerindeki pahalı tişört için değil, samimiyetin ve sevgin için seviyor."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 29.0,
            "width": 76.0,
            "height": 2.2,
            "text": "Arkadaşına verebileceğin en güzel hediye, kendi emeğinle hazırladığın bir anı defteri,"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 31.7,
            "width": 76.0,
            "height": 2.2,
            "text": "birlikte çekildiğiniz fotoğraflardan oluşan bir albüm veya içten bir mektuptur."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 34.4,
            "width": 76.0,
            "height": 2.2,
            "text": "Hem aileni ekonomik olarak zora sokmamış hem de Zeynep'e unutulmaz bir hatıra"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 37.0,
            "width": 76.0,
            "height": 2.2,
            "text": "bırakmış olursun. Doğum gününe temiz, sade ve kendini rahat hissettiğin bir kıyafetle"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 39.7,
            "width": 76.0,
            "height": 2.2,
            "text": "katılman fazlasıyla yeterlidir. Önemli olan orada bulunup arkadaşının mutluluğunu"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 42.3,
            "width": 76.0,
            "height": 2.2,
            "text": "yürekten paylaşmandır. Unutma ki gerçek dostluklar maddiyatla değil, sevgiyle büyür."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 45.0,
            "width": 76.0,
            "height": 2.2,
            "text": "Umarım tavsiyelerimi değerlendirir ve doğum gününde çok güzel vakit geçirirsin."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 47.7,
            "width": 76.0,
            "height": 2.2,
            "text": "Sevgi ve dostlukla kalmayı unutma."
          }
        ]
      },
      {
        "id": "p74_etk11c",
        "title": "11. Etkinlik ç (Cümle Tamamlama)",
        "button": {
          "left": 5.0,
          "top": 84.0
        },
        "items": [
          {
            "type": "lines",
            "left": 38.5,
            "top": 90.0,
            "width": 51.0,
            "height": 2.2,
            "text": "başkalarının duygularını anlamayı amaçlamaktadır."
          }
        ]
      }
    ],

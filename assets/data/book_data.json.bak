      {
        "id": "p106_etk7",
        "title": "7. Etkinlik: Çanakkale Benzetmeleri",
        "button": {
          "left": 6.5,
          "top": 44.5
        },
        "items": [
          {
            "type": "lines",
            "left": 16.5,
            "top": 78.27,
            "width": 72.0,
            "text": "Çanakkale geçilmez bir kaleye ve aşılmaz bir vatan kalkanına benzetilmiştir."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 82.12,
            "width": 72.0,
            "text": "Çanakkale bir milletin yeniden dirilişini müjdeleyen kutlu bir destana benzetilmiştir."
          }
        ]
      }
    ],
    "107": [
      {
        "id": "p107_etk8",
        "title": "8. Etkinlik: Kelime Havuzu Çağrışımları ve Konuşma Planı",
        "button": {
          "left": 6.5,
          "top": 24.5
        },
        "items": [
          {
            "type": "lines",
            "left": 12.0,
            "top": 47.44,
            "width": 76.0,
            "text": "Seçtiğim Kavramlar: Millî Mücadele, Vatanseverlik, Azim ve Kararlılık"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 49.94,
            "width": 76.0,
            "text": "1. Millî Mücadele Çağrışımları: İstiklal ateşi, topyekûn seferberlik, Türk kadınının fedakârlığı."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 52.5,
            "width": 76.0,
            "text": "2. Vatanseverlik Çağrışımları: Bayrak sevgisi, bağımsız yaşama tutkusu, canını hiçe sayma."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 55.06,
            "width": 76.0,
            "text": "3. Azim ve Kararlılık Çağrışımları: İnançla engelleri aşmak, Elif'in kağnısı, asla pes etmemek."
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 57.63,
            "width": 76.0,
            "text": "Konuşma Planım (Giriş-Gelişme-Sonuç): Türk milletinin bağımsızlığına olan sarsılmaz inancını"
          },
          {
            "type": "lines",
            "left": 12.0,
            "top": 60.19,
            "width": 76.0,
            "text": "ve cephe gerisinde kadın-erkek omuz omuza sergilenen eşsiz kahramanlık destanını vurgulayacağım."
          }
        ]
      }
    ],
    "108": [
      {
        "id": "p108_etk9",
        "title": "9. Etkinlik: Cümlelerdeki İsim ve Fiil Çekim Ekleri",

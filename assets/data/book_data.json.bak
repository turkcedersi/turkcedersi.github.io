          {
            "type": "lines",
            "left": 13.0,
            "top": 66.15,
            "width": 74.0,
            "text": "birlikte harika ve unutulmaz bir hafta sonu anısı biriktirmiş olacağız."
          }
        ]
      }
    ],
    "64": [
      {
        "id": "p64_uretim_plan",

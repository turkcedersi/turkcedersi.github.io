    "69": [
      {
        "id": "p69_etk1",
        "title": "1. Etkinlik: Kelime Kartları",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 23.59,
            "width": 35.0,
            "text": "Uluslararası ilişkileri yürütme ve barışçıl müzakere sanatı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 32.88,
            "width": 35.0,
            "text": "Harp okulu; subay yetiştiren askerî yükseköğretim kurumu."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 42.18,
            "width": 35.0,
            "text": "Topluluğu oluşturan geniş halk yığını, insan kalabalığı."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 51.47,
            "width": 35.0,
            "text": "Doğru yolu gösteren rehber, manevi kılavuz ve önder."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 23.59,
            "width": 35.0,
            "text": "Devletini dış ülkelerde temsil eden yetkili temsilci, elçi."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 32.88,
            "width": 35.0,
            "text": "Kitap ve gazete okunup sohbet edilen geleneksel mekân."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 42.18,
            "width": 35.0,
            "text": "Öğretim programı; derslerde okutulacak konuların bütünü."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 51.47,
            "width": 35.0,
            "text": "Kireç taşı üzerine yağlı mürekkeple yapılan baskı yöntemi."
          }
        ]
      }
    ],
    "70": [
      {
        "id": "p70_etk3",
        "title": "3. Etkinlik: Düşünceyi Geliştirme Yolları",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 23.08,
            "width": 78.0,
            "text": "Karşılaştırma (18. ve 19. yüzyıl matbaaları kıyaslanmıştır.)"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 45.32,
            "width": 78.0,
            "text": "Örneklendirme (Reşat Nuri Güntekin yazar olarak örnek gösterilmiştir.)"
          }
        ]
      },
      {
        "id": "p70_etk4",
        "title": "4. Etkinlik: Metin Bölümleri ve Önemli Bilgiler",
        "button": {
          "left": 88.0,
          "top": 48.0
        },
        "items": [
          {
            "type": "lines",
            "left": 8.5,
            "top": 64.29,
            "width": 39.5,
            "text": "Mustafa Kemal'in yabancı dillere olan merakı ve ilgisi,"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 67.56,
            "width": 39.5,
            "text": "Fransızcasını geliştirmek için Selanik'te kursa gitmesi,"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 70.83,
            "width": 39.5,
            "text": "Tarih, felsefe ve edebiyat kitaplarını tutkuyla okuması,"
          },
          {
            "type": "lines",
            "left": 8.5,
            "top": 74.04,
            "width": 39.5,
            "text": "Kitap sayfalarına kendi el yazısıyla notlar alması."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 64.29,
            "width": 39.5,
            "text": "19. yüzyılda taş baskı matbaanın yaygınlaşması,"
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 67.56,
            "width": 39.5,
            "text": "Kitapların ve ders metinlerinin ucuzlayıp çoğalması,"
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 70.83,
            "width": 39.5,
            "text": "Kıraathanelerin gazete ve kültür merkezine dönüşmesi,"
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 74.04,
            "width": 39.5,
            "text": "Okul kütüphanelerinin halka ve velilere açılması."
          }
        ]
      }
    ],

        },
        "items": [
          {
            "type": "lines",
            "left": 37.0,
            "top": 11.79,
            "width": 50.0,
            "text": "Şehrimizde açılan TÜYAP Kitap Fuarı'na tüm sınıfça"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 14.36,
            "width": 74.0,
            "text": "öğretmenimiz eşliğinde eğitici ve kültürel bir gezi düzenlenmesini öneriyoruz."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 17.95,
            "width": 35.5,
            "text": "Farklı türde binlerce kitabı incelemek,"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 20.51,
            "width": 74.0,
            "text": "yazarlarla yüz yüze tanışıp söyleşilere katılmak ve okuma sevgimizi pekiştirmektir."
          },
          {
            "type": "lines",
            "left": 51.0,
            "top": 24.04,
            "width": 36.0,
            "text": "Derslerimizin aksamaması için geziyi"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 26.67,
            "width": 74.0,
            "text": "uygun bir ders saatinde yapacak ve fuar alanında disiplin kurallarına tam uyacağız."
          },
          {
            "type": "lines",
            "left": 52.5,
            "top": 30.19,
            "width": 34.5,
            "text": "Sınıfımızın kitap okuma kültürü gelişecek,"

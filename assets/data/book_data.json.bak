      {
        "id": "p34_etk6_c",
        "title": "6. Etkinlik C: Üç Noktaya Örnek Cümleler",
        "button": {
          "left": 6.5,
          "top": 80.5
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 86.15,
            "width": 74.5,
            "text": "— Yarınki Türkçe dersine çalıştın mı? — Şey... Biraz baktım ama tam bitiremedim."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 89.68,
            "width": 74.5,
            "text": "Koca Ali... Koca Ali, be!.. Çekicin sesini duymuyor musun, baksana buraya!"
          }
        ]
      }
    ],
    "35": [
      {
        "id": "p35_etk8_a",
        "title": "8. Etkinlik A: Geleceğe Hazırlık Ölçüt Listesi",
        "button": {
          "left": 6.5,
          "top": 56.5
        },
        "items": [
          {
            "type": "lines",
            "left": 15.82,
            "top": 72.12,
            "width": 65.1,
            "text": "Zamanını planlı kullanarak ders çalışma ve dinlenme dengesini kurmalıdır."
          },
          {
            "type": "lines",
            "left": 15.82,
            "top": 75.06,
            "width": 65.1,
            "text": "Yabancı dil ve temel dijital becerilerini erken yaşta geliştirmelidir."
          },
          {
            "type": "lines",
            "left": 15.82,
            "top": 77.95,
            "width": 65.1,
            "text": "Bir spor veya sanat dalıyla ilgilenerek beden ve ruh sağlığını güçlendirmelidir."
          },
          {
            "type": "lines",
            "left": 15.82,
            "top": 80.83,
            "width": 65.1,
            "text": "Sorumluluk alarak karşılaştığı sorunlar karşısında azimle çözüm üretmelidir."
          }
        ]
      }
    ],
    "36": [
      {
        "id": "p36_etk8_b",
        "title": "8. Etkinlik B: Kendini Değerlendirme Yazısı",
        "button": {
          "left": 6.5,
          "top": 9.5
        },
        "items": [
          {
            "type": "lines",
            "left": 10.85,
            "top": 23.78,
            "width": 77.76,
            "text": "    Ortaokul yılları, geleceğimizin temellerini attığımız en kıymetli dönemdir. Son"
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 26.41,
            "width": 77.76,
            "text": "iki yıldaki yaşantımı gözden geçirdiğimde, ilk olarak okuma alışkanlığımın"
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 28.97,
            "width": 77.76,
            "text": "bana büyük bir düşünce zenginliği ve kelime hazinesi kazandırdığını görüyorum."
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 31.54,
            "width": 77.76,
            "text": "Kitaplar sayesinde dünyayı ve insanları daha iyi anlama becerisi edindim."
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 34.1,
            "width": 77.76,
            "text": "    Bununla birlikte, zaman yönetimi konusunda geçtiğimiz yıl bazı eksikliklerim"
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 36.67,
            "width": 77.76,
            "text": "vardı. Günlük ders çalışma ve dinlenme saatlerimi planlamakta zorlanıyordum."
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 39.29,
            "width": 77.76,
            "text": "Ancak bu yıl hazırladığım haftalık çalışma programına kararlılıkla uyarak"
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 41.86,
            "width": 77.76,
            "text": "vaktimi çok daha verimli kullanmaya başladım ve başarı grafikimi artırdım."
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 44.42,
            "width": 77.76,
            "text": "    Öte yandan, dijital teknolojileri sadece eğlence için değil, araştırma ve dil"
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 46.99,
            "width": 77.76,
            "text": "öğrenme amacıyla kullanma alışkanlığı edindim. Ayrıca düzenli olarak spor"
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 49.55,
            "width": 77.76,
            "text": "yaparak hem beden sağlığımı koruyor hem de takım ruhunu öğreniyorum."
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 52.12,
            "width": 77.76,
            "text": "    Sonuç olarak, karşılaştığım zorluklarda pes etmeyip azimle çalışarak eksiklerimi"
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 54.74,
            "width": 77.76,
            "text": "kapatmaya gayret ediyorum. Kendimi tanıyıp sürekli geliştirmek beni geleceğe"
          },
          {
            "type": "lines",
            "left": 10.85,
            "top": 57.31,
            "width": 77.76,
            "text": "daha güçlü ve öz güvenli bir şekilde hazırlamaktadır."
          }
        ]
      }
    ],
    "39": [
      {
        "id": "p39_etk_sebep_zinciri",
        "title": "Küçük Grupla Uyguluyorsunuz: Sebep-Sonuç Zinciri",
        "button": {
          "left": 6.5,
          "top": 46.5
        },
        "items": [
          {
            "type": "lines",
            "left": 20.5,
            "top": 48.85,
            "width": 68.5,
            "text": "İyiliksever kişilerin karşılık beklemeden yardım etmesi ve güven vermesi."
          },
          {
            "type": "lines",
            "left": 41.5,
            "top": 55.38,
            "width": 47.8,
            "text": "İnsanlar arasında güçlü bir toplumsal güven bağı kurulması."
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 61.92,
            "width": 69.1,
            "text": "Yardımlaşma cesaretinin artması ve dayanışma kültürünün güçlenmesi."
          }
        ]
      }
    ],
    "40": [
      {
        "id": "p40_etk_cok_sebep",
        "title": "Sıra Sizde: Çok Sebep Bir Sonuç Şeması",
        "button": {
          "left": 6.5,
          "top": 52.5
        },
        "items": [
          {
            "type": "lines",
            "left": 19.9,
            "top": 54.94,
            "width": 69.5,
            "text": "Çocukluk döneminde okulda ve evde sorumluluk alıp disiplin kazanılması."
          },
          {
            "type": "lines",
            "left": 19.9,
            "top": 61.09,
            "width": 69.5,
            "text": "Gençlik döneminde engeller karşısında yılmayıp azimle mücadele edilmesi."
          },
          {
            "type": "lines",
            "left": 19.9,
            "top": 67.24,
            "width": 69.5,
            "text": "Yetişkinlikte meslek hayatında titiz ve dürüst çalışmalar yürütülmesi."
          },
          {
            "type": "lines",
            "left": 19.5,
            "top": 73.4,
            "width": 69.6,
            "text": "Bireyin toplumda saygı, sevgi ve takdir gören biri hâline gelmesi."
          }
        ]
      }
    ],
    "42": [
      {
        "id": "p42_etk1",
        "title": "1. Etkinlik: Kelime ve Sözlük Anlamı",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 12.5,
            "top": 31.22,
            "width": 11.5,
            "text": "paralimpik",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 28.78,
            "width": 49.0,
            "text": "Engelli sporcuların yarıştığı olimpiyat"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 33.33,
            "width": 44.5,
            "text": "Engelliler için uluslararası spor oyunları."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 42.18,
            "width": 11.5,
            "text": "motivasyon",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 39.87,
            "width": 49.0,
            "text": "İsteklendirme, hedefe yönelme gücü"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 44.36,
            "width": 44.5,
            "text": "Bir amaca ulaşmak için duyulan istek, güdü."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 53.08,
            "width": 11.5,
            "text": "rekor",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 50.9,
            "width": 49.0,
            "text": "Bir sporda ulaşılan en üst derece"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 55.45,
            "width": 44.5,
            "text": "Bir alanda elde edilen en üstün başarı."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 64.1,
            "width": 11.5,
            "text": "omurilik",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 61.86,
            "width": 49.0,
            "text": "Sırtta sinirlerin geçtiği kemik içi kanal"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 66.41,
            "width": 44.5,
            "text": "Omurga içindeki ana sinir kordonu dokusu."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 75.06,
            "width": 11.5,
            "text": "rehabilitasyon",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 72.88,
            "width": 49.0,
            "text": "Tedavi ve iyileşme süreci"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 77.37,
            "width": 44.5,
            "text": "Hastanın yaşama gücünü yeniden kazandırma."
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 86.03,
            "width": 11.5,
            "text": "makaralı yay",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 38.5,
            "top": 83.85,
            "width": 49.0,
            "text": "Okçulukta kullanılan makaralı mekanik yay"
          },
          {
            "type": "lines",
            "left": 42.8,
            "top": 88.4,
            "width": 44.5,
            "text": "Okçulukta makara sistemli mekanik yay."
          }
        ]
      }
    ],
    "43": [
      {
        "id": "p43_etk3",
        "title": "3. Etkinlik A: Duygular ve Çıkarımları Destekleyen Kanıtlar",
        "button": {
          "left": 6.5,
          "top": 40.0
        },
        "items": [
          {
            "type": "lines",
            "left": 21.0,
            "top": 57.56,
            "width": 68.0,
            "text": "Büyük bir gurur, umut, azim, mücadele hırsı ve tarif edilemez bir mutluluk"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 60.13,
            "width": 78.0,
            "text": "hissettiği açıkça görülmektedir. Yaşadığı ağır kazaya ve zorlu sürece rağmen asla"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 62.76,
            "width": 78.0,
            "text": "vazgeçmemiş olmanın verdiği iç huzuru, kendine güveni ve dünya şampiyonluğuyla"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 65.32,
            "width": 78.0,
            "text": "ülkesine yaşattığı zaferin coşkusunu derin bir heyecan ve minnet duygusuyla"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 67.88,
            "width": 78.0,
            "text": "tekrar yaşamış ve izleyiciye tüm samimiyetiyle hissettirmiştir."
          },
          {
            "type": "lines",
            "left": 42.5,
            "top": 76.09,
            "width": 46.5,
            "text": "Şampiyonluk anını ve bayrağımızı göndere çektirdiği"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 78.72,
            "width": 78.0,
            "text": "anı anlatırken gözlerinin parlaması, ses tonundaki heyecan ve yüzündeki tebessüm"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 81.28,
            "width": 78.0,
            "text": "en büyük kanıttır. Ayrıca hastane odasında başlayan zorlu antrenman sürecinden ve"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 83.85,
            "width": 78.0,
            "text": "pes etmeyip sabrettiğinden bahsederken sesinin son derece kararlı ve kendinden emin"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 86.41,
            "width": 78.0,
            "text": "çıkması, beden dilinin inançla dolu olması bu duyguları açıkça kanıtlamaktadır."
          }
        ]
      }
    ],
    "44": [
      {
        "id": "p44_etk3_b",
        "title": "3. Etkinlik B ve Ç: Davranışlar ve Kişilik Özellikleri",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 57.5,
            "top": 16.67,
            "width": 31.5,
            "text": "\"Asla pes etme, hedefine odaklan\""
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 19.23,
            "width": 78.0,
            "text": "diyerek engeller karşısında yılmamış, daima pozitif ve çözüm odaklı"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 21.79,
            "width": 78.0,
            "text": "düşünmüştür. Günde saatlerce yorulmadan antrenman yaparak büyük bir özveri"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 24.36,
            "width": 78.0,
            "text": "göstermiş, azmiyle dünya şampiyonu olabileceğini herkese kanıtlamıştır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 40.71,
            "width": 78.0,
            "text": "Azimli, kararlı, çalışkan, sabırlı, yüksek öz güvene sahip, zorluklar karşısında yılmayan,"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 43.27,
            "width": 78.0,
            "text": "hedefine ve ülkesine tutkuyla bağlı, disiplinli, güçlü iradeli, pes etmeyen ve çevresine her zaman"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 45.83,
            "width": 78.0,
            "text": "umut aşılayan ilham verici, mücadeleci bir sporcu ve örnek bir kişiliktir."
          }
        ]
      },
      {
        "id": "p44_etk4",
        "title": "4. Etkinlik: Görsel ve İşitsel Anlam Unsurları",
        "button": {
          "left": 6.5,
          "top": 53.5
        },
        "items": [
          {
            "type": "mark",
            "left": 11.27,
            "top": 75.3,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          },
          {
            "type": "mark",
            "left": 11.27,
            "top": 82.9,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          }
        ]
      }
    ],
    "45": [
      {
        "id": "p45_etk5",
        "title": "5. Etkinlik: Benzerlikler ve Farklılıklar",
        "button": {
          "left": 6.5,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 12.5,
            "top": 25.2,
            "width": 34.0,
            "text": "• Spor sevgisi ve okçuluk tutkusu"
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 28.4,
            "width": 34.0,
            "text": "• Pes etmeyen azimli ve kararlı yapısı"
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 31.6,
            "width": 34.0,
            "text": "• Her zaman daha iyisini hedeflemesi"
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 34.8,
            "width": 34.0,
            "text": "• Düzenli ve disiplinli çalışma isteği"
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 38.0,
            "width": 34.0,
            "text": "• Başaracağına olan sarsılmaz inancı"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 25.2,
            "width": 42.0,
            "text": "• Önceleri amatör, sonradan profesyoneldi."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 28.4,
            "width": 42.0,
            "text": "• Hedefi iyileşmekten şampiyonluğa evrildi."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 31.6,
            "width": 42.0,
            "text": "• Bireysel çalışırken millî takıma yükseldi."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 34.8,
            "width": 42.0,
            "text": "• Antrenmanları çok daha yoğun ve planlı oldu."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 38.0,
            "width": 42.0,
            "text": "• Dünya rekoru kırarak tarihe geçti."
          }
        ]
      },
      {
        "id": "p45_etk6",
        "title": "6. Etkinlik: Metni Özetleme",
        "button": {
          "left": 6.5,
          "top": 43.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.0,
            "top": 59.23,
            "width": 78.0,
            "text": "Yiğit Caner Aydın, geçirdiği ağır kaza sonucu omurilik felci olmuş ve hayatına"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 61.79,
            "width": 78.0,
            "text": "tekerlekli sandalyeyle devam etmek zorunda kalmıştır. Ancak karşılaştığı bu engele"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 64.42,
            "width": 78.0,
            "text": "asla teslim olmamış, rehabilitasyon sürecinde tanıştığı okçuluk sporuna tutkuyla sarılmıştır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 66.99,
            "width": 78.0,
            "text": "Fiziksel zorluklara aldırmadan her gün saatlerce büyük bir disiplin ve inançla çalışmıştır."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 69.55,
            "width": 78.0,
            "text": "Göstermiş olduğu bu üstün azim sayesinde kısa sürede Türk millî takımına seçilmiştir."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 72.12,
            "width": 78.0,
            "text": "Uluslararası turnuvalarda ülkemizi başarıyla temsil etmiş ve Dünya Şampiyonası'nda"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 74.68,
            "width": 78.0,
            "text": "altın madalya kazanarak dünya rekoru kırmıştır. Azim ve sıkı çalışmanın her engeli"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 77.24,
            "width": 78.0,
            "text": "aşacağını ispatlayarak hepimize ilham veren örnek ve başarılı bir millî sporcu olmuştur."
          }
        ]
      }
    ],
    "46": [
      {
        "id": "p46_etk7",
        "title": "7. Etkinlik: Şiirlerde Söz Sanatları",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 53.0,
            "top": 26.47,
            "width": 39.5,
            "text": "Söz Sanatı: Teşhis (Kişileştirme)."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 29.04,
            "width": 39.5,
            "text": "Ağaçlar, bulutlar, yağmur ve güneş"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 31.6,
            "width": 39.5,
            "text": "zaferi bekleyen birer insan gibi"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 34.17,
            "width": 39.5,
            "text": "canlı varlıklar olarak kişileştirilmiştir."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 36.79,
            "width": 39.5,
            "text": "Bu sanat zafere olan inancı pekiştirmiştir."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 55.13,
            "width": 39.5,
            "text": "Söz Sanatı: Teşhis ve Tezat vardır."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 57.69,
            "width": 39.5,
            "text": "Şair kuşlara dert ortağı gibi seslenerek"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 60.26,
            "width": 39.5,
            "text": "teşhis sanatı yapmıştır."
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 62.82,
            "width": 39.5,
            "text": "Memleket ve gurbet karşıtlığıyla da"
          },
          {
            "type": "lines",
            "left": 53.0,
            "top": 65.38,
            "width": 39.5,
            "text": "derin sıla hasreti pekiştirilmiştir."
          }
        ]
      }
    ],
    "48": [
      {
        "id": "p48_etk9_a",
        "title": "9. Etkinlik A: Noktalı Virgül Kullanım Görevleri Eşleştirmesi",

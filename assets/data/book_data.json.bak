    "58": [
      {
        "id": "p58_uret",
        "title": "Nasrettin Hoca Betimleme",
        "button": {
          "left": 5.2,
          "top": 45.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 48.0,
            "width": 71.0,
            "height": 2.2,
            "text": "Konu: Nasrettin Hoca'nın fiziksel ve kişisel özelliklerini betimleme."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.8,
            "width": 71.0,
            "height": 2.2,
            "text": "Fiziksel Özellikler: Ak sakallı, güler yüzlü, kavuklu ve cübbeli bir bilge."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 53.6,
            "width": 71.0,
            "height": 2.2,
            "text": "Kişisel Özellikler: Zeki, hazırcevap, hoşgörülü ve nükteci bir halk bilgesi."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 56.4,
            "width": 71.0,
            "height": 2.2,
            "text": "Kullanılacak İfadeler: Ak sakalı, sevimli kavuğu, tebessümü, bilge sözleri."
          },
          {
            "type": "box",
            "left": 14.5,
            "top": 64.0,
            "width": 71.0,
            "height": 22.0,
            "text": "Nasrettin Hoca, Türk mizahının ve bilgeliğinin en önemli simgesidir. Başındaki kocaman kavuğu, pamuk gibi ak sakalı ve yüzünden eksik olmayan tebessümüyle tanınır. Sırtındaki cübbesi ve sevimli eşeğiyle Akşehir sokaklarında gezerken karşılaştığı her olaya zekice çözümler bulur. İnsanları güldürürken aynı zamanda düşündüren, haksızlıklara ince nüktelerle cevap veren, adaletli ve engin gönüllü bir halk bilgesidir. Eşeğine ters binmesi bile insanlara olaylara farklı bir açıdan bakmayı öğreten derin bir mesaj taşır."
          }
        ]
      }
    ],
    "59": [
      {
        "id": "p59_uret",
        "title": "Keloğlan Betimleme",
        "button": {
          "left": 5.2,
          "top": 45.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 48.0,
            "width": 71.0,
            "height": 2.2,
            "text": "Konu: Masal kahramanı Keloğlan'ın özelliklerini betimleme."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.8,
            "width": 71.0,
            "height": 2.2,
            "text": "Fiziksel Özellikler: Saçsız parlak bir baş, yamalı yelek ve şalvar."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 53.6,
            "width": 71.0,
            "height": 2.2,
            "text": "Kişisel Özellikler: Saf görünüşlü fakat çok zeki, dürüst ve cesur."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 56.4,
            "width": 71.0,
            "height": 2.2,
            "text": "Kullanılacak İfadeler: Işıldayan başı, gülen gözleri, pratik zekâsı."
          },
          {
            "type": "box",
            "left": 14.5,
            "top": 64.0,
            "width": 71.0,
            "height": 22.0,
            "text": "Keloğlan, masallarımızın en sevilen ve en zeki kahramanıdır. Saçsız, güneşte pırıl pırıl parlayan başı, sırtındaki yamalı yeleği ve omzunda taşıdığı azık çıkınıyla tanınır. İlk bakışta saf ve naif gibi görünse de karşısına çıkan zorlukları keskin zekâsı ve pratik çözümleriyle aşmayı başarır. Devlere, zalim vezirlere ve haksızlıklara karşı aklını ve dürüstlüğünü silah olarak kullanır. Annesine olan derin sevgisi, alçakgönüllülüğü ve yoksullara yardım etme arzusu onu herkesin gözünde bir halk kahramanı yapar."
          }
        ]
      }
    ],
    "60": [
      {
        "id": "p60_uret",
        "title": "Emekli Öğretmen Betimleme",
        "button": {
          "left": 5.2,
          "top": 34.0
        },
        "items": [
          {
            "type": "lines",
            "left": 14.5,
            "top": 37.0,
            "width": 53.0,
            "height": 2.2,
            "text": "Konu: Metindeki fedakâr emekli öğretmeni betimleme."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 40.0,
            "width": 53.0,
            "height": 2.2,
            "text": "Fiziksel: Ak saçlı, gözlüklü, güler yüzlü bir dede."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 43.0,
            "width": 53.0,
            "height": 2.2,
            "text": "Kişisel: Çocukları seven, sabırlı, cömert ve merhametli."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 46.0,
            "width": 71.0,
            "height": 2.2,
            "text": "Kullanılacak İfadeler: Ak saçları, şefkatli bakışları, sıcacık tebessümü."
          },
          {
            "type": "box",
            "left": 14.5,
            "top": 53.5,
            "width": 71.0,
            "height": 22.0,
            "text": "Mahallemizin emekli öğretmeni, saçlarına yılların akı düşmüş, gözlüklerinin ardında sevgi dolu gözleri parıldayan tonton bir ihtiyardır. Yıllarca öğrencilerine ilim öğrettikten sonra emekliliğinde de çocuklardan kopamamış, evini adeta bir uçurtma atölyesine çevirmiştir. Maharetli elleriyle çıtaları birleştirir, renkli kâğıtları kesip rengârenk uçurtmalar hazırlar. Çocukların neşeli kahkahalarını duymak onun en büyük mutluluk kaynağıdır. Karşılık beklemeden herkese el uzatan, yüreği çocuk sevgisiyle çarpan bu fedakâr öğretmen, mahallenin neşe ve huzur kaynağıdır."
          }
        ]
      }
    ],
    "62": [
      {
        "id": "p62_6_b",
        "title": "6. Etkinlik (b)",
        "button": {
          "left": 5.2,
          "top": 37.0
        },
        "items": [
          {
            "type": "lines",
            "left": 20.0,
            "top": 40.0,
            "width": 65.0,
            "height": 2.2,
            "text": "Deniz Kaya"
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 43.3,
            "width": 58.5,
            "height": 6.8,
            "text": "Dalgalı kumral saçları, meraklı ela gözleri, sportif yapısı ve her zaman giydiği mavi dedektif yeleği."
          },
          {
            "type": "lines",
            "left": 23.5,
            "top": 52.0,
            "width": 61.5,
            "height": 4.5,
            "text": "Karanlık yerler ve en yakın dostlarının kalbini kırmak."
          },
          {
            "type": "lines",
            "left": 25.5,
            "top": 59.6,
            "width": 59.5,
            "height": 4.5,
            "text": "İz sürmek, gizli ipuçlarını hızlıca fark etmek ve hızlı problem çözmek."
          },
          {
            "type": "lines",
            "left": 25.0,
            "top": 66.2,
            "width": 60.0,
            "height": 4.5,
            "text": "Dedektiflik kitapları okumak, harita çizmek ve gizemli bilmeceleri çözmek."
          },
          {
            "type": "lines",
            "left": 26.5,
            "top": 74.9,
            "width": 58.5,
            "height": 4.5,
            "text": "Her zaman cebinde bir büyüteç ve küçük bir not defteri taşımak."
          }
        ]

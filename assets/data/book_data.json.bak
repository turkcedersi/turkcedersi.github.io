            "width": 29.0,
            "text": "Karşımızdakinin duygularını anlamaya çalışmalıyız."
          }
        ]
      }
    ],
    "161": [
      {
        "id": "p161_etk7",
        "title": "7. Etkinlik: İçeriğin Mesajı",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 20.26,
            "width": 79.0,
            "text": "İletişim, insanların duygu, düşünce ve ihtiyaçlarını birbirine aktarmasının temel yoludur."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 23.33,
            "width": 79.0,
            "text": "Sağlıklı iletişimde sadece konuşmak yetmez; saygıyla dinlemek ve nezaketi elden bırakmamak gerekir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 26.35,
            "width": 79.0,
            "text": "Empati kurarak başkalarının bakış açısını kavramak çatışmaları önler ve hoşgörüyü pekiştirir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 29.17,
            "width": 79.0,
            "text": "Böylece toplumda birlik, güven ve barış ortamı kalıcı ve güçlü bir şekilde sağlanmış olur."
          }
        ]
      }
    ],
    "162": [
      {
        "id": "p162_etk9_a",
        "title": "9. Etkinlik A: Eğik Çizginin Görevleri",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 64.0,
            "top": 24.42,
            "width": 22.0,
            "text": "Eklerin farklı biçimlerini"
          },
          {
            "type": "lines",
            "left": 59.0,
            "top": 26.92,
            "width": 27.0,
            "text": "göstermek amacıyla aralarına konur."
          },
          {
            "type": "lines",
            "left": 64.0,
            "top": 38.27,
            "width": 22.0,
            "text": "Tarihlerin yazılışında gün,"
          },
          {
            "type": "lines",
            "left": 59.0,
            "top": 40.77,
            "width": 27.0,
            "text": "ay ve yılı gösteren sayıları ayırmak için."
          },
          {
            "type": "lines",
            "left": 64.0,
            "top": 52.05,
            "width": 22.0,
            "text": "Adres yazımında apartman no"
          },
          {
            "type": "lines",
            "left": 59.0,
            "top": 54.55,
            "width": 27.0,
            "text": "ile daire no arasına ve semt ile şehir arasına."
          }
        ]
      },
      {
        "id": "p162_etk9_b",
        "title": "9. Etkinlik B: Örnek Cümleler",
        "button": {
          "left": 6.0,
          "top": 64.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 70.38,
            "width": 79.0,
            "text": "1. Fiilden isim yapma eki olan -lık/-lik eki sözcüğe yeni bir anlam kazandırır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 72.95,
            "width": 79.0,
            "text": "2. Kardeşim 15/09/2012 tarihinde dünyaya gözlerini açtı."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 75.51,
            "width": 79.0,
            "text": "3. Okul mektubumuzu Atatürk Caddesi No.: 28/4 Çankaya/Ankara adresine postaladık."
          }
        ]
      }
    ],
    "163": [
      {
        "id": "p163_etk10",
        "title": "10. Etkinlik: Nezaket Kuralları ve Toplumsal Düzen",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 48.08,
            "width": 79.0,
            "text": "Toplumsal Yaşamda Nezaketin Gücü"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 50.64,
            "width": 79.0,
            "text": "Toplu taşıma, hastane ve kütüphane gibi kamuya açık alanlarda bir arada huzurla"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 53.21,
            "width": 79.0,
            "text": "yaşayabilmenin temeli yasalardan çok nezaket ve görgü kurallarına dayanır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 55.83,
            "width": 79.0,
            "text": "Elbette kamu otoritesinin düzenleyici kuralları vardır; fakat her davranışın başına"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 58.4,
            "width": 79.0,
            "text": "bir polis veya yasa koymak imkânsızdır. Asıl önemli olan, bireylerin otokontrol"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 60.96,
            "width": 79.0,
            "text": "geliştirmesi ve başkalarının haklarına içtenlikle saygı duymayı öğrenmesidir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 63.53,
            "width": 79.0,
            "text": "Örneğin otobüste yüksek sesle telefonla konuşmamak ceza korkusuyla değil, diğer"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 66.09,
            "width": 79.0,
            "text": "yolcuların rahatını düşünme inceliğinden kaynaklanmalıdır. İnsanları birbirine"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 68.65,
            "width": 79.0,
            "text": "gerçek anlamda bağlayan şey katı yaptırımlar değil, gönüller arasında kurulan"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 71.28,
            "width": 79.0,
            "text": "karşılıklı sevgi, saygı ve empati bağlarıdır. Sonuç olarak, nezaket kuralları toplumun"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 73.85,
            "width": 79.0,
            "text": "görünmez vicdanıdır ve bu vicdan geliştikçe hayat herkes için güzelleşir."
          }
        ]
      }
    ],
    "164": [
      {
        "id": "p164_uretim",
        "title": "Üretim Vakti: Şiir Yazma",
        "button": {
          "left": 6.0,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 28.0,
            "top": 64.49,
            "width": 44.0,
            "text": "Gönül Köprüsü",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 28.0,
            "top": 68.14,
            "width": 44.0,
            "text": "Tatlı bir sözle başlar dostluk bağı,",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 28.0,
            "top": 70.71,
            "width": 44.0,
            "text": "Gönülden gönüle kurulur otağı.",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 28.0,
            "top": 73.27,
            "width": 44.0,
            "text": "Sevgiyle bakarsan güler her insan,",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 28.0,
            "top": 75.83,
            "width": 44.0,
            "text": "Nezaketle aşılır hasretin dağı.",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 28.0,
            "top": 78.4,
            "width": 44.0,
            "text": "Kırma bir kalbi ki tamiri zordur,",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 28.0,
            "top": 80.96,
            "width": 44.0,
            "text": "İyilik eyleyen huzuru bulur.",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 28.0,
            "top": 83.53,
            "width": 44.0,
            "text": "Dostun meclisinde güler yüzlü ol,",
            "align": "center"
          },
          {
            "type": "lines",
            "left": 28.0,
            "top": 86.09,
            "width": 44.0,
            "text": "Vefa kalesinde sevgi baki kalır.",
            "align": "center"
          }
        ]
      }
    ],
    "166": [
      {
        "id": "p166_soru1",
        "title": "1. Soru: Giriş, Gelişme ve Sonuç Bölümleri",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 49.5,
            "top": 64.94,
            "width": 40.0,
            "text": "Sözün değerinin kalıcı etkisinde ve"
          },
          {
            "type": "lines",
            "left": 43.5,
            "top": 67.5,
            "width": 46.0,
            "text": "karşılıklı anlayışta saklı olduğu vurgulanmıştır."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 73.46,
            "width": 38.0,
            "text": "İletişimin empati ve sorumluluk"
          },
          {
            "type": "lines",
            "left": 43.5,
            "top": 76.03,
            "width": 46.0,
            "text": "gerektiren iki yönlü bir süreç olduğu açıklanmıştır."
          },
          {
            "type": "lines",
            "left": 50.5,
            "top": 82.24,
            "width": 39.0,
            "text": "Nezaket ve ölçülülüğün güven bağını"
          },
          {
            "type": "lines",
            "left": 43.5,
            "top": 84.81,
            "width": 46.0,
            "text": "güçlendirerek ilişkileri sağlamlaştırdığı ifade edilmiştir."
          }
        ]
      }
    ],
    "167": [
      {
        "id": "p167_soru2",
        "title": "2. Soru: Düşünceyi Geliştirme Yolları",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 55.0,
            "top": 14.94,
            "width": 34.0,
            "text": "Karşılaştırma"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 21.03,
            "width": 35.0,
            "text": "\"Açık ve ölçülü ifade, aceleci ifadeden daha etkilidir.\""
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 27.18,
            "width": 37.0,
            "text": "Ölçülü ifadenin üstünlüğüyle düşünce inandırıcı kılınmıştır."
          },
          {
            "type": "lines",
            "left": 55.0,
            "top": 37.12,
            "width": 34.0,
            "text": "Tanımlama / Benzetme"
          },
          {
            "type": "lines",
            "left": 54.0,
            "top": 43.27,
            "width": 35.0,
            "text": "\"Nezaket ve ölçülülük, iletişimin sağlam zemini gibidir.\""
          },
          {
            "type": "lines",
            "left": 52.0,
            "top": 49.42,
            "width": 37.0,
            "text": "İletişimin şartları benzetmeyle zihinde canlandırılmıştır."
          }
        ]
      },
      {
        "id": "p167_soru3",
        "title": "3. Soru: Noktalama İşaretleri",
        "button": {
          "left": 6.0,
          "top": 58.0
        },
        "items": [
          {

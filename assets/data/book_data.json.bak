    "88": [
      {
        "id": "p88_etk9_yazma",
        "title": "9. Etkinlik C: Dijitalleşme ve Kütüphaneler Yazısı",
        "button": {
          "left": 88.0,
          "top": 15.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.0,
            "top": 29.68,
            "width": 76.0,
            "text": "Başlık: Sayfaların Kokusu ve Dijitalin Hızı"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 32.24,
            "width": 76.0,
            "text": "Kütüphaneler, insanlığın ortak aklının ve binlerce yıllık birikiminin"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 34.81,
            "width": 76.0,
            "text": "muhafaza edildiği en kıymetli kültür mabedleridir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 37.37,
            "width": 76.0,
            "text": "Bugün teknolojinin hızla gelişmesiyle birlikte raflar yerini"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 39.94,
            "width": 76.0,
            "text": "yavaş yavaş dijital ekranlara ve veri tabanlarına bırakmaktadır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 42.5,
            "width": 76.0,
            "text": "Dijital kütüphanecilik şüphesiz zaman ve mekân sınırlarını kaldırır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 45.06,
            "width": 76.0,
            "text": "Bir tıkla dünyanın öbür ucundaki nadide bir esere ulaşmak büyük nimettir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 47.63,
            "width": 76.0,
            "text": "Ayrıca basım ve lojistik maliyetlerini düşürerek tasarruf sağlar."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 50.19,
            "width": 76.0,
            "text": "Ancak bir kitapsever olarak kalbim, daima basılı kitaptan yanadır."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 52.76,
            "width": 76.0,
            "text": "Ekrana dokunmak ile kâğıdın kokusunu hissetmek asla aynı değildir."
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 55.32,
            "width": 76.0,
            "text": "Cemil Meriç'in dediği gibi: 'Kitap, istikbale yollanan bir mektuptur.'"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 57.88,
            "width": 76.0,
            "text": "Sonuç olarak dijital dönüşüm pratiklik için büyük bir imkândır;"
          },
          {
            "type": "lines",
            "left": 10.0,
            "top": 60.45,
            "width": 76.0,
            "text": "fakat kütüphaneyi yaşatan asıl unsur, kitap kokulu o derin sessizliktir."
          }
        ]
      }
    ],
    "90": [
      {
        "id": "p90_etk1",
        "title": "1. Etkinlik: Kelime ve Anlam İlişkileri",
        "button": {

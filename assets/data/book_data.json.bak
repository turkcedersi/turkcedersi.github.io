    "168": [
      {
        "id": "p168_soru4",
        "title": "4. Soru: Akış İncelemesi",
        "button": {
          "left": 6.0,
          "top": 21.0
        },
        "items": [
          {
            "type": "lines",
            "left": 10.5,
            "top": 25.83,
            "width": 79.0,
            "text": "İçerikte giriş bölümünde dünyanın tüm canlıların ortak yaşam alanı olduğu belirtilmiş;"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 28.4,
            "width": 79.0,
            "text": "gelişme bölümünde çevre sorunları ve insanların doğaya karşı sorumlulukları aktarılmış,"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 30.96,
            "width": 79.0,
            "text": "sonuç bölümünde ise küresel dayanışma ve ortak bilinç çağrısı yapılarak"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 33.53,
            "width": 79.0,
            "text": "akıcı ve tutarlı bir mantıksal sıralama ile metin tamamlanmıştır."
          }
        ]
      },
      {
        "id": "p168_soru5",
        "title": "5. Soru: Ana Fikir",
        "button": {
          "left": 6.0,
          "top": 40.0
        },
        "items": [
          {
            "type": "lines",
            "left": 20.5,
            "top": 48.08,
            "width": 69.0,
            "text": "Dünya üzerindeki tüm canlılar birbiriyle bağlantılıdır ve geleceğe temiz bir dünya"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 50.64,
            "width": 79.0,
            "text": "bırakabilmek için her birey üzerine düşen çevresel ve insani sorumluluğu yerine getirmelidir."
          }
        ]
      },
      {
        "id": "p168_soru6",
        "title": "6. Soru: Yardımcı Fikirler",
        "button": {
          "left": 6.0,
          "top": 59.0
        },
        "items": [
          {
            "type": "lines",
            "left": 26.0,
            "top": 66.86,
            "width": 63.5,
            "text": "1. Doğal kaynaklar sınırsız değildir, tasarruflu kullanılmalıdır."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 69.42,
            "width": 79.0,
            "text": "2. Çevre kirliliği yalnızca yerel değil, tüm insanlığı ilgilendiren küresel bir problemdir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 71.98,
            "width": 79.0,
            "text": "3. Gelecek nesillere yaşanabilir bir çevre bırakmak hepimizin ortak vicdani borcudur."
          }
        ]
      }
    ],
    "169": [
      {
        "id": "p169_kitap",
        "title": "Kitap Vakti: Kitap İnceleme ve Değerlendirme",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "blank",
            "left": 27.5,
            "top": 13.27,
            "width": 25.0,
            "text": "Gümüş Kanat"
          },
          {
            "type": "blank",
            "left": 22.5,
            "top": 15.9,
            "width": 20.0,
            "text": "Cahit Uçuk"
          },
          {
            "type": "blank",
            "left": 83.5,
            "top": 15.9,
            "width": 6.0,
            "text": "144"
          },
          {
            "type": "blank",
            "left": 24.5,
            "top": 18.46,
            "width": 62.0,
            "text": "Bir çocuğun güvercin sevgisi, sabrı ve ailesine destek olma mücadelesi."
          },
          {
            "type": "blank",
            "left": 36.0,
            "top": 23.72,
            "width": 50.0,
            "text": "Ali, annesi, babası, mahalle arkadaşları ve güvercin Gümüş Kanat."
          },
          {
            "type": "blank",
            "left": 33.0,
            "top": 28.91,
            "width": 53.0,
            "text": "Ali fedakâr, azimli ve hayvansever; ailesi dürüst ve sevgi doludur."
          },
          {
            "type": "blank",
            "left": 19.5,
            "top": 34.1,
            "width": 22.0,
            "text": "Cumhuriyet dönemi İstanbul'u"
          },
          {
            "type": "blank",
            "left": 60.5,
            "top": 34.1,
            "width": 25.0,
            "text": "Bahar ve yaz ayları"
          },
          {
            "type": "blank",
            "left": 22.0,
            "top": 36.67,
            "width": 30.0,
            "text": "Üçüncü şahıs (İlahi / Hâkim Anlatıcı)"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 43.59,
            "width": 79.0,
            "text": "Ali'nin hayvan sevgisini ve zorluklar karşısında asla pes etmeyen sabırlı kişiliğini"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 46.22,
            "width": 79.0,
            "text": "ve olayların sıcak bir aile ortamında geçmesini çok beğendim."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 51.03,
            "width": 79.0,
            "text": "Yazar olsaydım güvercinin yaralandığı sahneyi daha detaylandırır ve mahalledeki"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 53.65,
            "width": 79.0,
            "text": "diğer çocukların da güvercinin iyileşmesi için Ali'ye yardım etmesini sağlardım."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 60.64,
            "width": 79.0,
            "text": "Ali, İstanbul'un tarihi bir mahallesinde yaşayan, güvercinlere büyük tutku duyan çalışkan bir çocuktur."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 63.21,
            "width": 79.0,
            "text": "Bir gün sokakta kanadı incinmiş beyaz bir güvercin bulur ve ona Gümüş Kanat adını verir."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 65.83,
            "width": 79.0,
            "text": "Onu çatıda gizlice besler, yaralarını şefkatle tedavi eder. Bu süreçte ailesinin maddi zorluklar"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 68.4,
            "width": 79.0,
            "text": "yaşadığını öğrenen Ali, okuldan arta kalan zamanlarda çıraklık yaparak evine katkı sağlar."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 70.96,
            "width": 79.0,
            "text": "Gümüş Kanat iyileşip uçmaya başladığında Ali onu özgürlüğüne kavuşturur. Güvercin özgür kalsa da"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 73.65,
            "width": 79.0,
            "text": "Ali'nin vefasını unutmaz ve her gün evin penceresine konar. Eser fedakârlığı etkileyici bir dille anlatır."
          }
        ]
      }
    ],
    "170": [
      {
        "id": "p170_film",
        "title": "Film Vakti: Film İnceleme ve Değerlendirme",
        "button": {
          "left": 6.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "blank",
            "left": 25.5,
            "top": 13.33,
            "width": 20.0,
            "text": "Ayla"
          },
          {
            "type": "blank",
            "left": 21.5,
            "top": 16.03,
            "width": 25.0,
            "text": "Dram, Tarih, Biyografi"
          },
          {
            "type": "blank",
            "left": 83.5,
            "top": 16.03,
            "width": 6.0,
            "text": "125 dk."
          },
          {
            "type": "blank",
            "left": 24.5,
            "top": 18.65,
            "width": 62.0,
            "text": "Kore Savaşı'nda Türk astsubayı ile yetim kalan Koreli minik kızın sevgi bağı."
          },
          {
            "type": "blank",
            "left": 28.0,
            "top": 23.91,
            "width": 58.0,
            "text": "Astsubay Süleyman Dilbirliği, Ayla (Kim Eun-ja), Ali Üsteğmen."
          },
          {
            "type": "blank",
            "left": 33.0,
            "top": 29.17,
            "width": 53.0,
            "text": "Süleyman merhametli, cesur ve koruyucu; Ayla sevimli, masum ve vefalıdır."
          },
          {
            "type": "blank",
            "left": 19.5,
            "top": 34.42,
            "width": 25.0,
            "text": "Kore ve Türkiye (İskenderun/İstanbul)"
          },
          {
            "type": "blank",
            "left": 60.5,
            "top": 34.42,
            "width": 25.0,
            "text": "1950 yılı ve günümüz"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 42.05,
            "width": 79.0,
            "text": "Farklı milletlerden ve dillerden iki insanın hiçbir karşılık beklemeden kurduğu baba-kız sevgisinin gerçek bir hayat hikâyesine dayanması beni derinden etkiledi."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 49.94,
            "width": 79.0,
            "text": "Süleyman'ın Türkiye'ye döndükten sonraki arayış sürecine ve bürokratik engellere biraz daha fazla sahne ayrılarak kavuşma anının hazırlığı güçlendirilebilirdi."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 57.88,
            "width": 79.0,
            "text": "Yönetmen olsaydım Süleyman ile Ayla'nın yıllar sonraki ilk sarılma anını daha uzun tutardım."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 65.58,
            "width": 79.0,
            "text": "1950'de Kore Savaşı'na gönderilen Türk tugayındaki Astsubay Süleyman, dondurucu bir gecede"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 68.21,
            "width": 79.0,
            "text": "katledilen köyde yapayalnız kalmış beş yaşında bir kız çocuğu bulur. Ona ay yüzlü olduğu için"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 70.77,
            "width": 79.0,
            "text": "Ayla adını verir ve birlikte geçirdikleri bir buçuk yıl boyunca ona öz babası gibi bakar."
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 73.4,
            "width": 79.0,
            "text": "Savaş bitip tugay yurda dönerken Süleyman Ayla'yı Türkiye'ye getirmek istese de yasalar engel"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 75.96,
            "width": 79.0,
            "text": "olur ve ikili gözyaşlarıyla ayrılır. Aradan tam 60 yıl geçtikten sonra Süleyman Amca, büyük"
          },
          {
            "type": "lines",
            "left": 10.5,
            "top": 78.59,
            "width": 79.0,
            "text": "bir vefa ve gayretle Ayla'nın izini bularak Kore'de onunla yeniden kucaklaşır."
          }
        ]
      }
    ],

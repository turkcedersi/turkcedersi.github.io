  "book5_inpage_answers": {
    "11": [
      {
        "id": "p11_hazirlik",
        "title": "Hazırlık Vakti: Ön Değerlendirme",
        "button": {
          "left": 6.5,
          "top": 6.5
        },
        "items": [
          {
            "type": "mark",
            "left": 23.6,
            "top": 19.0,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          }
        ]
      }
    ],
    "14": [
      {
        "id": "p14_etk1a",
        "title": "1. Etkinlik (A): Metin Tahmin ve Gerekçeleri",
        "button": {
          "left": 6.0,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 13.0,
            "top": 22.0,
            "width": 74.0,
            "height": 2.2,
            "text": "Tahminim: Bir martının diğer kuşlardan farklı hayallerini"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 24.5,
            "width": 74.0,
            "height": 2.2,
            "text": "ve gökyüzünde yaşayacağı maceralarını anlatmaktadır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 27.1,
            "width": 74.0,
            "height": 2.2,
            "text": "Gerekçem: Metnin başlığı ve martı görseli bana bir"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 29.5,
            "width": 74.0,
            "height": 2.2,
            "text": "bireysellik ve başarı hikâyesini düşündürdü."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 38.1,
            "width": 74.0,
            "height": 2.2,
            "text": "Tahminim: Jonathan ailesinin sözünü dinleyip sürüye"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 40.6,
            "width": 74.0,
            "height": 2.2,
            "text": "katılmaya çalışsa da uçma tutkusundan vazgeçmeyecektir."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 43.2,
            "width": 74.0,
            "height": 2.2,
            "text": "Gerekçem: Çünkü onun için uçmak sadece karın doyurmak"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 45.7,
            "width": 74.0,
            "height": 2.2,
            "text": "değil, hayatın asıl amacı ve en büyük mutluluğudur."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 54.3,
            "width": 74.0,
            "height": 2.2,
            "text": "Tahminim: Kısa kanat tekniğiyle büyük hızlara ulaşarak"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 56.8,
            "width": 74.0,
            "height": 2.2,
            "text": "uçuş denemesinde tarihi bir başarı yakalayacaktır."
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 59.3,
            "width": 74.0,
            "height": 2.2,
            "text": "Gerekçem: Şahinin kanat yapısını gözlemleyip aklını"
          },
          {
            "type": "lines",
            "left": 13.0,
            "top": 61.8,
            "width": 74.0,
            "height": 2.2,
            "text": "kullanarak yeni bir yöntem geliştirmeyi başarmıştır."
          }
        ]
      },
      {
        "id": "p14_etk1b",
        "title": "1. Etkinlik (B): Tahminlerin Doğruluğu",
        "button": {
          "left": 6.0,
          "top": 67.5
        },
        "items": [
          {
            "type": "lines",
            "left": 11.0,
            "top": 72.7,
            "width": 78.0,
            "height": 2.2,
            "text": "Metni okumadan önce ve okuma esnasında yaptığım tahminler"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 75.3,
            "width": 78.0,
            "height": 2.2,
            "text": "metnin genel akışıyla ve ana düşüncesiyle büyük oranda"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 77.8,
            "width": 78.0,
            "height": 2.2,
            "text": "uyumlu ve doğru çıkmıştır. Başlıktan, görselden ve metin"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 80.3,
            "width": 78.0,
            "height": 2.2,
            "text": "içindeki ipuçlarından hareketle mantıklı gerekçeler"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 82.9,
            "width": 78.0,
            "height": 2.2,
            "text": "oluşturmam, olayların gelişimini doğru öngörmemi sağladı."
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 85.4,
            "width": 78.0,
            "height": 2.2,
            "text": "Jonathan'ın pes etmeyen azmi, tahmin ettiğim gibi onu"
          },
          {
            "type": "lines",
            "left": 11.0,
            "top": 87.9,
            "width": 78.0,
            "height": 2.2,
            "text": "büyük bir başarıya ve özgürlüğe ulaştırmıştır."
          }
        ]
      }
    ],
    "15": [
      {
        "id": "p15_etk2a",
        "title": "2. Etkinlik (A): Anahtar Söz Varlığı ve Anlam İlişkileri",
        "button": {
          "left": 6.0,
          "top": 8.5
        },
        "items": [
          {
            "type": "lines",
            "left": 51.5,
            "top": 21.7,
            "width": 37.0,
            "height": 2.2,
            "text": "İstediği gibi uçup sınırları aşabilmek."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 27.2,
            "width": 37.0,
            "height": 2.2,
            "text": "Herhangi bir kısıtlamaya bağlı olmayan."
          },
          {
            "type": "lines",
            "left": 57.0,
            "top": 33.0,
            "width": 31.0,
            "height": 2.2,
            "text": "Bağımsızlık, gökyüzü, hürriyet, kanat."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 40.2,
            "width": 37.0,
            "height": 2.2,
            "text": "Uçuş hızını en üst noktaya taşımak."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 45.8,
            "width": 37.0,
            "height": 2.2,
            "text": "Gücünün son noktasına kadar çabalamak."
          },
          {
            "type": "lines",
            "left": 57.0,
            "top": 51.5,
            "width": 31.0,
            "height": 2.2,
            "text": "Gayret, cesaret, rekor, azim."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 58.7,
            "width": 37.0,
            "height": 2.2,
            "text": "Diğer martılardan farklı ve özgün olan."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 64.2,
            "width": 37.0,
            "height": 2.2,
            "text": "Alışılmışın dışında olan, olağan dışı."
          },
          {
            "type": "lines",
            "left": 57.0,
            "top": 70.0,
            "width": 31.0,
            "height": 2.2,
            "text": "Farklılık, özgünlük, yenilik."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 77.2,
            "width": 37.0,
            "height": 2.2,
            "text": "Jonathan'ın uçmaya duyduğu büyük sevgi."
          },
          {
            "type": "lines",
            "left": 51.5,
            "top": 82.7,
            "width": 37.0,
            "height": 2.2,
            "text": "Güçlü ve coşkulu sevgi, aşırı istek."
          },
          {
            "type": "lines",
            "left": 57.0,
            "top": 88.5,
            "width": 31.0,
            "height": 2.2,
            "text": "Aşk, coşku, bağlanma, heves."
          }
        ]
      }
    ],
    "16": [
      {
        "id": "p16_etk2_b",
        "title": "2. Etkinlik B: Kelimeler Arası İlişki",
        "button": {
          "left": 6.5,
          "top": 7.5
        },
        "items": [
          {
            "type": "lines",
            "left": 15.0,
            "top": 16.6,
            "width": 73.0,
            "height": 2.2,
            "text": "Özgürlük, bireyin kendi tutkularının peşinden gitmesini"
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 19.17,
            "width": 75.5,
            "height": 2.2,
            "text": "ve dayatılan kalıpların dışına çıkabilmesini sağlar."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 28.4,
            "width": 73.0,
            "height": 2.2,
            "text": "Sınırlarını zorlamak, kişinin potansiyelini keşfetmesi ve"
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 30.96,
            "width": 75.5,
            "height": 2.2,
            "text": "özgürlüğe giden yolda engelleri aşması için gereklidir."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 40.13,
            "width": 73.0,
            "height": 2.2,
            "text": "Sıra dışı olmak, sıradanlıktan sıyrılıp kendi sınırlarını"
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 42.69,
            "width": 75.5,
            "height": 2.2,
            "text": "aşarak özgün ve bağımsız bir kimlik kazanmaktır."
          },
          {
            "type": "lines",
            "left": 15.0,
            "top": 51.92,
            "width": 73.0,
            "height": 2.2,
            "text": "Tutku, tüm bu süreçleri başlatan, sınırları zorlama ve"
          },
          {
            "type": "lines",
            "left": 12.5,
            "top": 54.49,
            "width": 75.5,
            "height": 2.2,
            "text": "özgürleşme arzusunu besleyen en temel içsel güçtür."
          }
        ]
      }
    ],
    "17": [
      {
        "id": "p17_etk4_a",
        "title": "4. Etkinlik A: Metnin Bölümleri",
        "button": {
          "left": 6.5,
          "top": 6.5
        },
        "items": [
          {
            "type": "lines",
            "left": 18.8,
            "top": 21.35,
            "width": 70.0,
            "height": 2.2,
            "text": "Martı Jonathan Livingston'ın diğer martılar gibi sadece"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 23.91,
            "width": 77.5,
            "height": 2.2,
            "text": "yiyecek bulmak için değil, uçmanın sınırlarını keşfetmek"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 26.54,
            "width": 77.5,
            "height": 2.2,
            "text": "ve daha hızlı, kusursuz uçabilmek için tek başına sahilde"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 29.1,
            "width": 77.5,
            "height": 2.2,
            "text": "büyük bir tutkuyla uçuş denemeleri yapması anlatılmaktadır."
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 32.63,
            "width": 69.0,
            "height": 2.2,
            "text": "Jonathan'ın hız ve alçalış denemelerinde defalarca"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 35.19,
            "width": 77.5,
            "height": 2.2,
            "text": "başarısız olup denize düşmesi, ailesinin ve sürünün onu"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 37.76,
            "width": 77.5,
            "height": 2.2,
            "text": "anlamayarak uyarılarda bulunması ve onun tüm zorluklara"
          },
          {
            "type": "lines",
            "left": 11.5,
            "top": 40.38,
            "width": 77.5,
            "height": 2.2,
            "text": "ve açlığa rağmen uçma tutkusundan asla vazgeçmemesi işlenir."
          },
          {
            "type": "lines",

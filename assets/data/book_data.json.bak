          },
          {
            "type": "lines",
            "left": 16.0,
            "top": 33.0,
            "width": 20.0,
            "height": 2.2,
            "text": "Hazineleri listesine girdi."
          },
          {
            "type": "mark",
            "left": 21.6,
            "top": 39.5,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 41.8,
            "width": 49.0,
            "height": 2.4,
            "text": "\"Mesleğinin örnek ustalarından biri olan"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 44.4,
            "width": 70.5,
            "height": 2.4,
            "text": "Kocataş, hâlen Keçeciler Çarşısı'nda mesleğini icra etmektedir.\""
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 46.8,
            "width": 70.5,
            "height": 2.4,
            "text": "Girişteki yaşayan temsilci vurgusu sonuçtaki ustalıkla tam bir uyum içindedir."
          }
        ]
      }
    ],
    "43": [
      {
        "id": "p43_metin_analizi",
        "title": "Ebru Sanatı Çalışma Kâğıdı",
        "button": {
          "left": 5.0,
          "top": 36.0
        },
        "items": [
          {
            "type": "lines",
            "left": 22.0,
            "top": 38.6,
            "width": 64.0,
            "height": 2.4,
            "text": "Geleneksel Türk ebru sanatı ve yapım aşamaları"
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 41.6,
            "width": 43.0,
            "height": 2.4,
            "text": "Kitreli suyun hazırlanması ve öd ile"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 44.2,
            "width": 70.5,
            "height": 2.4,
            "text": "ezilen doğal boyaların fırçayla serpilip desen verilmesi anlatılmıştır."
          },
          {
            "type": "mark",
            "left": 21.6,
            "top": 48.9,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 52.0,
            "width": 49.0,
            "height": 2.4,
            "text": "\"Ebru, su yüzeyinde desenlerin kâğıda"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 54.6,
            "width": 70.5,
            "height": 2.4,
            "text": "aktarılmasıyla yapılan eşsiz bir geleneksel Türk sanatıdır.\""
          },
          {
            "type": "blank",
            "left": 19.5,
            "top": 67.2,
            "width": 12.0,
            "height": 2.2,
            "text": "Önce"
          },
          {
            "type": "blank",
            "left": 38.0,
            "top": 67.2,
            "width": 12.0,
            "height": 2.2,
            "text": "Ardından"
          },
          {
            "type": "blank",
            "left": 55.0,
            "top": 67.2,
            "width": 12.0,
            "height": 2.2,
            "text": "Sonra"
          },
          {
            "type": "blank",
            "left": 72.5,
            "top": 67.2,
            "width": 12.0,
            "height": 2.2,
            "text": "En sonunda"
          },
          {
            "type": "mark",
            "left": 21.6,
            "top": 72.8,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 78.8,
            "width": 49.0,
            "height": 2.4,
            "text": "\"Bu aşamaların tamamlanmasıyla ebru sanatı"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 81.0,
            "width": 55.0,
            "height": 2.4,
            "text": "son bulur ve eşsiz bir eser ortaya çıkar.\""
          }
        ]
      }
    ],
    "47": [
      {
        "id": "p47_metin_analizi",
        "title": "Çömlekçilik Çalışma Kâğıdı",
        "button": {
          "left": 5.0,
          "top": 12.0
        },
        "items": [
          {
            "type": "lines",
            "left": 22.0,
            "top": 17.0,
            "width": 64.0,
            "height": 2.4,
            "text": "Geleneksel Türk çömlekçilik sanatı ve üretim basamakları"
          },
          {
            "type": "lines",
            "left": 44.0,
            "top": 20.1,
            "width": 43.0,
            "height": 2.4,
            "text": "Killi toprağın elenip çarkta şekillendirilmesi"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 22.7,
            "width": 70.5,
            "height": 2.4,
            "text": "ve fırınlarda pişirilerek dayanıklı kaplara dönüştürülmesi aktarılmıştır."
          },
          {
            "type": "mark",
            "left": 21.6,
            "top": 28.9,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 30.5,
            "width": 49.0,
            "height": 2.4,
            "text": "\"İnsanoğlunun en eski mesleklerindendir."
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 33.1,
            "width": 70.5,
            "height": 2.4,
            "text": "Kazılarda çıkarılan eski eserler içerisinde çömlekler çoğunluktadır.\""
          },
          {
            "type": "blank",
            "left": 19.5,
            "top": 45.2,
            "width": 12.0,
            "height": 2.2,
            "text": "Öncelikle"
          },
          {
            "type": "blank",
            "left": 38.0,
            "top": 45.2,
            "width": 12.0,
            "height": 2.2,
            "text": "Daha sonra"
          },
          {
            "type": "blank",
            "left": 55.0,
            "top": 45.2,
            "width": 12.0,
            "height": 2.2,
            "text": "Ardından"
          },
          {
            "type": "blank",
            "left": 72.5,
            "top": 45.2,
            "width": 12.0,
            "height": 2.2,
            "text": "Son olarak"
          },
          {
            "type": "mark",
            "left": 21.6,
            "top": 51.9,
            "width": 3.5,
            "height": 3.0,
            "text": "✓"
          },
          {
            "type": "lines",
            "left": 38.0,
            "top": 57.2,
            "width": 49.0,
            "height": 2.4,
            "text": "\"Çömlekçilik mesleği günümüzde de sürdürülmekte,"
          },
          {
            "type": "lines",
            "left": 16.5,
            "top": 59.3,
            "width": 55.0,
            "height": 2.4,
            "text": "kültürel kimliğimizi ve tarihimizi yaşatmaktadır.\""
          }
        ]
      }
    ],
    "48": [
      {
        "id": "p48_4_b",
        "title": "4. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 40.0
        },
        "items": [
          {
            "type": "lines",
            "left": 21.0,
            "top": 47.2,
            "width": 66.0,
            "height": 2.4,
            "text": "Kırmızı killi toprak elenerek yabancı maddelerden arındırılır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 50.3,
            "width": 72.0,
            "height": 2.4,
            "text": "Su ile karıştırılıp dinlendirilir ve elastik kıvama gelene kadar yoğrulur."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 53.4,
            "width": 72.0,
            "height": 2.4,
            "text": "İçindeki hava kabarcıkları tamamen çıkarılarak şekil vermeye hazır hale getirilir."
          },
          {
            "type": "lines",
            "left": 34.0,
            "top": 57.2,
            "width": 53.0,
            "height": 2.4,
            "text": "Kıvamındaki çamur dönen çarkın tam ortasına yerleştirilir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 60.3,
            "width": 72.0,
            "height": 2.4,
            "text": "Ustanın parmak uçlarının hüneriyle çamur yukarı doğru yükseltilerek açılır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 63.4,
            "width": 72.0,
            "height": 2.4,
            "text": "İçten ve dıştan hafif baskılarla testi, çömlek veya vazo formu verilir."
          },
          {
            "type": "lines",
            "left": 46.0,
            "top": 67.2,
            "width": 41.0,
            "height": 2.4,
            "text": "Şekillenen kaplar çatlamaması için gölgede dinlendirilir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 70.3,
            "width": 72.0,
            "height": 2.4,
            "text": "Yavaş yavaş kurutulan çömlekler özel fırınlara özenle dizilir."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 73.4,
            "width": 72.0,
            "height": 2.4,
            "text": "Yaklaşık 900 derecede saatlerce pişirilerek taş gibi sert ve dayanıklı hale getirilir."
          }
        ]
      }
    ],
    "49": [
      {
        "id": "p49_5_b",
        "title": "5. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 8.0
        },
        "items": [
          {
            "type": "lines",
            "left": 25.0,
            "top": 13.8,
            "width": 62.0,
            "height": 2.4,
            "text": "Metin sade, açık ve akıcı bir dille yazıldığı için aşamalar çok rahat anlaşılıyor."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 16.8,
            "width": 72.0,
            "height": 2.4,
            "text": "Terimlerin günlük benzetmelerle sunulması okuyucunun zihninde süreci canlandırmaktadır."
          },
          {
            "type": "lines",
            "left": 25.0,
            "top": 20.8,
            "width": 62.0,
            "height": 2.4,
            "text": "Yazar kendi kişisel duygularını katmadan çömlek yapımını nesnel olarak anlatmıştır."
          },
          {
            "type": "lines",
            "left": 14.5,
            "top": 23.8,
            "width": 72.0,
            "height": 2.4,
            "text": "Tarihi ve teknik bilgiler kronolojik sıraya sadık kalınarak tarafsızca verilmiştir."
          }
        ]
      },
      {
        "id": "p49_6_b",
        "title": "6. Etkinlik (b)",
        "button": {
          "left": 5.0,
          "top": 50.0
        },
        "items": [
          {
            "type": "badge",
            "left": 18.5,
            "top": 83.5,
            "width": 23.0,
            "height": 2.5,
            "text": "Geçmişte Çömlekler"
          },
          {
            "type": "lines",
            "left": 21.0,
            "top": 60.0,
            "width": 18.0,
            "height": 2.2,
            "text": "Tahıl saklama kabı"
          },
          {
            "type": "lines",
            "left": 20.0,
            "top": 62.5,
            "width": 20.0,
            "height": 2.2,
            "text": "Yemek güveci"
          },
          {
            "type": "lines",
            "left": 19.0,
            "top": 65.0,
            "width": 22.0,
            "height": 2.2,
            "text": "Soğuk su testisi"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 67.5,
            "width": 24.0,
            "height": 2.2,
            "text": "Yağ ve zeytin küpü"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 70.0,
            "width": 24.0,
            "height": 2.2,
            "text": "Günlük mutfak kabı"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 72.5,
            "width": 24.0,
            "height": 2.2,
            "text": "Doğal toprak eşya"
          },
          {
            "type": "lines",
            "left": 18.0,
            "top": 75.0,
            "width": 24.0,
            "height": 2.2,
            "text": "Her evde bulunan temel eşya"
          },
          {
            "type": "badge",
            "left": 56.5,
            "top": 83.5,
            "width": 23.0,
            "height": 2.5,
            "text": "Günümüzde Çömlekler"
          },
          {
            "type": "lines",
            "left": 59.0,
            "top": 60.0,
            "width": 18.0,
            "height": 2.2,
            "text": "Dekoratif süs eşyası"
          },
          {
            "type": "lines",
            "left": 58.0,
            "top": 62.5,
            "width": 20.0,
            "height": 2.2,
            "text": "Turistik hediyelik"
          },
          {
            "type": "lines",
            "left": 57.0,
            "top": 65.0,
            "width": 22.0,
            "height": 2.2,
            "text": "Sanat atölyesi hobisi"
          },
          {
            "type": "lines",
            "left": 56.0,
            "top": 67.5,
            "width": 24.0,
            "height": 2.2,
            "text": "Geleneksel lokanta sunumu"
          },
          {
            "type": "lines",
            "left": 56.0,
            "top": 70.0,
            "width": 24.0,
            "height": 2.2,
            "text": "Kültürel sergi ürünü"
          },
          {
            "type": "lines",
            "left": 56.0,
            "top": 72.5,
            "width": 24.0,
            "height": 2.2,
            "text": "Müze hatırası"
          },
          {
            "type": "lines",
            "left": 56.0,
            "top": 75.0,
            "width": 24.0,
            "height": 2.2,
            "text": "Estetik koleksiyon parçası"
          }
        ]
      }
    ],
